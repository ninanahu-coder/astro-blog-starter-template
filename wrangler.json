{
	"name": "astro-blog-starter-template",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "BACCARAT_TABLE",
				"class_name": "BaccaratTable"
			},
			{
				"name": "EARTH_WORLD",
				"class_name": "EarthWorld"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BaccaratTable"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["EarthWorld"]
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
