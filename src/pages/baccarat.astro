			}
			.msg.winmsg {
				color: #ffd76a;
			}
			.msg.lose {
				color: #ff8f8f;
			}

			/* 路单 */
			.road-wrap {
				margin: 8px 10px 0;
				background: rgba(255, 255, 255, 0.94);
				border-radius: 12px;
				padding: 6px 8px;
				color: #333;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
			}
			.stats {
				display: flex;
				gap: 14px;
				font-size: 11px;
				margin-bottom: 4px;
			}
			.stat b {
				font-size: 12px;
			}
			.stat-banker {
				color: var(--red);
			}
			.stat-player {
				color: var(--blue);
			}
			.stat-tie {
				color: var(--green);
			}
			.road {
				display: grid;
				grid-auto-flow: column;
				grid-template-rows: repeat(6, 17px);
				gap: 2px;
				overflow-x: auto;
				min-height: 112px;
				scrollbar-width: thin;
			}
			.bead {
				position: relative;
				width: 17px;
				height: 17px;
				border-radius: 50%;
				color: #fff;
				font-size: 10px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
			}
			.bead-B {
				background: var(--red);
			}
			.bead-P {
				background: var(--blue);
			}
			.bead-T {
				background: var(--green);
			}
			.dot {
				position: absolute;
				width: 5px;
				height: 5px;
				border-radius: 50%;
				border: 1px solid #fff;
			}
			.dot-b {
				top: -1px;
				left: -1px;
				background: var(--red);
			}
			.dot-p {
				bottom: -1px;
				right: -1px;
				background: var(--blue);
			}

			/* 下注区 */
			.bets {
				display: grid;
				grid-template-columns: 1fr 1.25fr 1fr 1.25fr 1fr;
				gap: 6px;
				margin: 8px 10px 0;
			}
			.spot {
				position: relative;
				border-radius: 12px;
				padding: 10px 2px 22px;
				color: #fff;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 2px;
				border: 1px solid rgba(255, 255, 255, 0.28);
				box-shadow:
					inset 0 1px 0 rgba(255, 255, 255, 0.25),
					0 3px 8px rgba(0, 0, 0, 0.3);
				transition:
					transform 0.08s,
					box-shadow 0.2s;
			}
			.spot:active {
				transform: scale(0.95);
			}
			.spot.won {
				box-shadow:
					0 0 0 2px var(--gold),
					0 0 20px rgba(233, 194, 95, 0.75);
				animation: won-pulse 0.9s ease 2;
			}
			@keyframes won-pulse {
				50% {
					box-shadow:
						0 0 0 3px var(--gold-2),
						0 0 30px rgba(233, 194, 95, 1);
				}
			}
			.spot-player {
				background: linear-gradient(#4a86ee, #2a5cc0);
			}
			.spot-banker {
				background: linear-gradient(#df4d58, #a72933);
			}
			.spot-tie {
				background: linear-gradient(#35aa64, #1f7a43);
			}
			.spot-side {
				background: linear-gradient(#5b6a80, #3d485b);
			}
			.spot-name {
				font-size: 16px;
				font-weight: 800;
				text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
			}
			.spot-odds {
				font-size: 10px;
				opacity: 0.9;
			}
			.spot-amt {
				position: absolute;
				bottom: 4px;
				font-size: 11px;
				font-weight: 700;
				color: #ffe9ad;
				background: rgba(0, 0, 0, 0.4);
				border-radius: 999px;
				padding: 0 8px;
				min-height: 15px;
				opacity: 0;
			}
			.spot-amt.on {
				opacity: 1;
			}

			/* 筹码 */
			.chips {
				display: flex;
				justify-content: center;
				gap: 10px;
				margin: 12px 10px 0;
			}
			.chip {
				position: relative;
				width: 54px;
				height: 54px;
				border-radius: 50%;
				background: radial-gradient(circle at 50% 40%, #fffdf5 0 34%, var(--chip-color) 35% 100%);
				box-shadow:
					0 4px 8px rgba(0, 0, 0, 0.45),
					inset 0 -2px 4px rgba(0, 0, 0, 0.25);
				color: #23283b;
				font-weight: 800;
				font-size: 13px;
				transition:
					transform 0.14s,
					box-shadow 0.14s;
			}
			.chip::before {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: 50%;
				background: repeating-conic-gradient(
					rgba(255, 255, 255, 0.95) 0 14deg,
					transparent 14deg 30deg
				);
				-webkit-mask: radial-gradient(circle, transparent 0 64%, #000 65%);
				mask: radial-gradient(circle, transparent 0 64%, #000 65%);
			}
			.chip span {
				position: relative;
				z-index: 1;
			}
			.chip.sel {
				transform: translateY(-8px) scale(1.1);
				box-shadow:
					0 10px 16px rgba(0, 0, 0, 0.5),
					0 0 0 3px var(--gold-2);
			}

			/* 操作按钮 */
			.actions {
				display: flex;
				gap: 10px;
				padding: 12px 10px 14px;
			}
			.btn {
				border-radius: 999px;
				padding: 13px 0;
				font-size: 15px;
				font-weight: 800;
				letter-spacing: 2px;
			}
			.btn:disabled {
				opacity: 0.4;
				cursor: default;
			}
			.btn-ghost {
				flex: 1;
				background: rgba(255, 255, 255, 0.1);
				color: #e5efe9;
				border: 1px solid rgba(255, 255, 255, 0.25);
			}
			.btn-gold {
				flex: 2;
				background: linear-gradient(#f6d47c, #dfa42c);
				color: #4a3505;
				box-shadow:
					0 5px 14px rgba(0, 0, 0, 0.4),
					inset 0 1px 0 rgba(255, 255, 255, 0.6);
			}
			.btn-gold:active:not(:disabled) {
				transform: scale(0.97);
			}

			/* 弹层 / 商店 */
			.overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.62);
				backdrop-filter: blur(3px);
				-webkit-backdrop-filter: blur(3px);
				display: flex;
				align-items: flex-end;
				justify-content: center;
				z-index: 50;
			}
			.sheet {
				width: 100%;
				max-width: 560px;
				background: linear-gradient(#10432f, #0a3023);
				border: 1px solid rgba(233, 194, 95, 0.4);
				border-bottom: none;
				border-radius: 20px 20px 0 0;
				padding: 16px 16px calc(18px + env(safe-area-inset-bottom));
				max-height: 84dvh;
				overflow-y: auto;
				animation: slide-up 0.28s ease-out;
			}
			@keyframes slide-up {
				from {
					transform: translateY(40px);
					opacity: 0;
				}
				to {
					transform: none;
					opacity: 1;
				}
			}
			.sheet-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 17px;
				font-weight: 800;
				color: var(--gold-2);
				letter-spacing: 1px;
			}
			.sheet-head .x {
				background: rgba(255, 255, 255, 0.1);
				color: #fff;
				border-radius: 50%;
				width: 28px;
				height: 28px;
				font-size: 17px;
				line-height: 1;
			}
			.sim-note {
				font-size: 11px;
				color: #a9cbba;
				background: rgba(0, 0, 0, 0.25);
				border-radius: 8px;
				padding: 7px 10px;
				margin: 10px 0;
				line-height: 1.5;
			}
			.bonus-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				background: rgba(255, 255, 255, 0.07);
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 12px;
				padding: 10px 12px;
				margin-bottom: 8px;
			}
			.bonus-info {
				display: flex;
				flex-direction: column;
				gap: 2px;
			}
			.bonus-info b {
				font-size: 14px;
			}
			.bonus-info span {
				font-size: 11px;
				color: #9cc7b3;
			}
			.btn-mini {
				background: linear-gradient(#f6d47c, #dfa42c);
				color: #4a3505;
				font-weight: 800;
				font-size: 12px;
				border-radius: 999px;
				padding: 7px 14px;
				white-space: nowrap;
			}
			.btn-mini:disabled {
				opacity: 0.45;
			}
			.packs {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 8px;
				margin: 10px 0;
			}
			.pack {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 6px;
				background: rgba(255, 255, 255, 0.07);
				border: 1.5px solid rgba(255, 255, 255, 0.16);
				border-radius: 12px;
				padding: 14px 4px 10px;
				color: #f2ede0;
				transition:
					border-color 0.15s,
					background 0.15s;
			}
			.pack.sel {
				border-color: var(--gold);
				background: rgba(233, 194, 95, 0.12);
				box-shadow: 0 0 14px rgba(233, 194, 95, 0.35);
			}
			.pack-chips {
				font-size: 13px;
				font-weight: 800;
				color: var(--gold-2);
			}
			.pack-tag {
				position: absolute;
				top: -7px;
				right: -4px;
				background: #d8404a;
				color: #fff;
				font-size: 10px;
				font-weight: 700;
				border-radius: 999px;
				padding: 1px 7px;
			}
			.pack-price {
				font-size: 13px;
				font-weight: 700;
				background: rgba(0, 0, 0, 0.3);
				border-radius: 999px;
				padding: 3px 12px;
			}
			.pay-methods {
				display: flex;
				gap: 8px;
				margin-bottom: 12px;
			}
			.pay {
				flex: 1;
			}
			.pay input {
				display: none;
			}
			.pay span {
				display: block;
				text-align: center;
				font-size: 12px;
				font-weight: 700;
				padding: 9px 2px;
				border-radius: 10px;
				background: rgba(255, 255, 255, 0.07);
				border: 1.5px solid rgba(255, 255, 255, 0.16);
			}
			.pay input:checked + span {
				border-color: var(--gold);
				background: rgba(233, 194, 95, 0.12);
			}
			.btn-buy {
				width: 100%;
			}
			.steps {
				margin: 12px 0;
				padding-left: 22px;
				font-size: 14px;
				line-height: 2.1;
				color: #e5efe9;
			}
			.kbd {
				background: rgba(255, 255, 255, 0.12);
				border-radius: 6px;
				padding: 1px 6px;
			}

			/* 轻提示 */
			.toast {
				position: fixed;
				top: calc(14px + env(safe-area-inset-top));
				left: 50%;
				transform: translate(-50%, -16px);
				background: rgba(4, 18, 13, 0.92);
				border: 1px solid rgba(233, 194, 95, 0.6);
				color: #ffe9ad;
				font-size: 13px;
				font-weight: 700;
				border-radius: 999px;
				padding: 9px 18px;
				opacity: 0;
				pointer-events: none;
				transition:
					opacity 0.25s,
					transform 0.25s;
				z-index: 99;
				max-width: 86vw;
			}
			.toast.show {
				opacity: 1;
				transform: translate(-50%, 0);
			}

			/* 收银台（模拟） */
			.order-card {
				background: rgba(0, 0, 0, 0.25);
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 14px;
				padding: 14px 14px 6px;
				margin: 12px 0;
			}
			.order-amount {
				text-align: center;
				font-size: 30px;
				font-weight: 800;
				color: var(--gold-2);
				margin-bottom: 10px;
			}
			.order-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 12px;
				padding: 7px 0;
				border-top: 1px dashed rgba(255, 255, 255, 0.12);
			}
			.order-row span {
				color: #9cc7b3;
			}
			.order-row b {
				color: #f2ede0;
				font-weight: 700;
				max-width: 65%;
				text-align: right;
				word-break: break-all;
			}
			.sandbox-tag {
				color: #67dd96 !important;
			}
			.qr-box {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 8px;
				margin: 6px 0 12px;
			}
			.qr-box canvas {
				background: #fff;
				border-radius: 10px;
				padding: 8px;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
			}
			.qr-note {
				font-size: 11px;
				color: #9cc7b3;
			}
			.applepay-note {
				text-align: center;
				font-size: 14px;
				font-weight: 700;
				margin: 16px 0 20px;
			}
			.cashier-actions {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}
			.cashier-actions .btn-gold {
				width: 100%;
			}
			.cashier-sub {
				display: flex;
				gap: 8px;
			}
			.cashier-sub .btn {
				flex: 1;
			}
			.btn.danger {
				color: #ff9a9a;
				border-color: rgba(255, 120, 120, 0.4);
			}
			#cashier-result {
				text-align: center;
				padding: 8px 0 4px;
			}
			.result-icon {
				font-size: 46px;
				margin: 12px 0 6px;
			}
			.result-title {
				font-size: 18px;
				font-weight: 800;
			}
			.result-sub {
				font-size: 12px;
				color: #9cc7b3;
				margin: 8px 0 16px;
				line-height: 1.6;
				word-break: break-all;
			}

			/* 交易记录 */
			.head-actions {
				display: flex;
				align-items: center;
				gap: 10px;
			}
			.link-btn {
				background: none;
				color: #9cc7b3;
				font-size: 12px;
				text-decoration: underline;
				font-weight: 400;
			}
			.orders-list {
				margin-top: 10px;
				display: flex;
				flex-direction: column;
				gap: 8px;
				min-height: 120px;
			}
			.orders-empty {
				text-align: center;
				color: #9cc7b3;
				font-size: 13px;
				padding: 34px 0;
			}
			.order-item {
				background: rgba(255, 255, 255, 0.06);
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 12px;
				padding: 10px 12px;
			}
			.oi-main {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 14px;
			}
			.oi-status {
				font-weight: 800;
				font-size: 12px;
			}
			.order-success .oi-status {
				color: #67dd96;
			}
			.order-failed .oi-status {
				color: #ff8f8f;
			}
			.order-canceled .oi-status {
				color: #b9c6bf;
			}
			.oi-sub {
				display: flex;
				justify-content: space-between;
				font-size: 11px;
				color: #9cc7b3;
				margin-top: 4px;
			}
			.oi-id {
				font-size: 10px;
				color: #6f9483;
				margin-top: 3px;
			}

			@media (min-width: 561px) {
				#app {
					border-left: 1px solid rgba(255, 255, 255, 0.08);
					border-right: 1px solid rgba(255, 255, 255, 0.08);
				}
				.overlay {
					align-items: center;
				}
				.sheet {
					border-radius: 20px;
					border-bottom: 1px solid rgba(233, 194, 95, 0.4);
				}
			}
		</style>
	</body>
</html>
