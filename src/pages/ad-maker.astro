			const CHECK_FIELDS = { headline: '主标题', sub: '副标题', points: '卖点', badge: '角标', prefix: '价格前缀', cta: '按钮', note: '底部说明' };

			function scan(text) {
				const all = [];
				for (const rule of RULES) {
					rule.re.lastIndex = 0;
					for (const m of String(text).matchAll(rule.re)) {
						all.push({ start: m.index, end: m.index + m[0].length, word: m[0], rule });
					}
				}
				all.sort((a, b) => a.start - b.start || b.end - b.start - (a.end - a.start) || a.rule.prio - b.rule.prio);
				const out = [];
				let lastEnd = -1;
				for (const h of all) {
					if (h.start >= lastEnd) {
						out.push(h);
						lastEnd = h.end;
					}
				}
				return out;
			}
			function complianceHits(st) {
				const hits = [];
				for (const [k, label] of Object.entries(CHECK_FIELDS)) {
					for (const h of scan(st[k] || '')) hits.push({ ...h, field: k, label });
				}
				return hits;
			}
			function autofix(st) {
				let n = 0;
				for (const k of Object.keys(CHECK_FIELDS)) {
					const hits = scan(st[k] || '').filter((h) => h.rule.fix !== undefined);
					let s = st[k];
					for (const h of hits.reverse()) {
						s = s.slice(0, h.start) + h.rule.fix + s.slice(h.end);
						n++;
					}
					st[k] = s;
				}
				return n;
			}

