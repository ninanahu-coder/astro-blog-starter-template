					if (region || delivery) lines.push(`📍 ${[region, delivery].filter(Boolean).join(' · ')}`);
					if (st.note.trim()) lines.push(`ℹ️ ${st.note.trim()}`);
					lines.push('', `${cta && !/message/i.test(cta) ? `${cta} — ` : ''}Message me to check availability 🙂`);
					return { kind: 'Facebook Marketplace', title, titleNote: `${title.length} 字符`, price: price ? `${cur}${price}` : '', body: lines.join('\n') };
				}
				let title = `${city ? city[1] : '澳洲'}${P ? '｜' + P : ''}${pts[0] ? ' ' + pts[0] : ''}`;
				if ([...title].length > 20) title = [...title].slice(0, 20).join('');
				const nums = ['1️⃣', '2️⃣', '3️⃣', '4️⃣'];
				const lines = [];
