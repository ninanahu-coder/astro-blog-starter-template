			// ============================================================
			// 背景与装饰（按模板）
			// ============================================================
			const BG = {
				promo(ctx, W, H, L, c) {
					const P = L.prod, u = L.u;
					ctx.fillStyle = paint(ctx, c.bg, 0, H);
					ctx.fillRect(0, 0, W, H);
					const R = Math.hypot(W, H);
					ctx.fillStyle = c.ray;
					for (let i = 0; i < 36; i += 2) {
						const a0 = (i / 36) * Math.PI * 2, a1 = ((i + 1) / 36) * Math.PI * 2;
						ctx.beginPath();
						ctx.moveTo(P.cx, P.cy);
						ctx.arc(P.cx, P.cy, R, a0, a1);
						ctx.closePath();
						ctx.fill();
					}
					const g = ctx.createRadialGradient(P.cx, P.cy, 0, P.cx, P.cy, P.r * 1.25);
					g.addColorStop(0, c.glow);
					g.addColorStop(1, 'rgba(255,226,140,0)');
					ctx.fillStyle = g;
					ctx.fillRect(0, 0, W, H);
					const rnd = mulberry32(7);
					for (let i = 0; i < 30; i++) {
						const x = rnd() * W, y = rnd() * H, s = u * (0.5 + rnd() * 1.1);
						ctx.save();
						ctx.globalAlpha = 0.35 + rnd() * 0.3;
						ctx.fillStyle = c.confetti[i % 3];
						ctx.translate(x, y);
						ctx.rotate(rnd() * Math.PI);
						if (i % 2) ctx.fillRect(-s, -s * 0.35, s * 2, s * 0.7);
						else {
							ctx.beginPath();
							ctx.arc(0, 0, s * 0.55, 0, Math.PI * 2);
							ctx.fill();
						}
						ctx.restore();
					}
					basePodium(ctx, L, c);
				},
				minimal(ctx, W, H, L, c) {
					const P = L.prod, u = L.u;
					ctx.fillStyle = c.bg;
					ctx.fillRect(0, 0, W, H);
					ctx.fillStyle = c.disc;
					ctx.beginPath();
					ctx.arc(P.cx, P.cy, P.r * 0.96, 0, Math.PI * 2);
					ctx.fill();
					ctx.strokeStyle = c.line;
					ctx.lineWidth = Math.max(1, u * 0.18);
					ctx.beginPath();
					ctx.arc(P.cx + P.r * 0.14, P.cy - P.r * 0.1, P.r * 1.04, 0, Math.PI * 2);
					ctx.stroke();
					ctx.lineWidth = Math.max(1, u * 0.14);
					ctx.strokeRect(u * 2.4, u * 2.4, W - u * 4.8, H - u * 4.8);
					basePodium(ctx, L, c);
				},
				natural(ctx, W, H, L, c) {
					const P = L.prod, m = Math.min(W, H);
					ctx.fillStyle = paint(ctx, c.bg, 0, H);
					ctx.fillRect(0, 0, W, H);
					ctx.fillStyle = c.blob;
					ctx.beginPath();
					ctx.arc(W * 0.94, H * 0.04, m * 0.4, 0, Math.PI * 2);
					ctx.fill();
					ctx.beginPath();
					ctx.arc(W * 0.04, H * 0.94, m * 0.32, 0, Math.PI * 2);
					ctx.fill();
					ctx.fillStyle = c.disc;
					ctx.beginPath();
					ctx.arc(P.cx, P.cy, P.r * 0.94, 0, Math.PI * 2);
					ctx.fill();
					for (const [a, rot, s] of [
						[-2.5, -2.2, 0.5],
						[-2.05, -1.4, 0.36],
						[-0.55, -0.9, 0.42],
						[0.45, 0.2, 0.34],
						[2.55, 2.9, 0.4],
					]) {
						leaf(ctx, P.cx + Math.cos(a) * P.r * 0.86, P.cy + Math.sin(a) * P.r * 0.86, P.r * s, rot, c.leaf, c.vein);
					}
					basePodium(ctx, L, c);
				},
				tech(ctx, W, H, L, c) {
					const P = L.prod, u = L.u, d = P.draw;
					ctx.fillStyle = paint(ctx, c.bg, 0, H);
					ctx.fillRect(0, 0, W, H);
					// 透视网格地面
					const hy = Math.min(H * 0.92, d.y + d.h);
					const vpY = hy - (H - hy) * 0.9;
					ctx.save();
					ctx.beginPath();
					ctx.rect(0, hy, W, H - hy);
					ctx.clip();
					const gg = ctx.createLinearGradient(0, hy, 0, H);
					gg.addColorStop(0, rgba(c.grid, 0));
					gg.addColorStop(1, rgba(c.grid, 0.3));
					ctx.strokeStyle = gg;
					ctx.lineWidth = Math.max(1, u * 0.14);
					for (let i = -16; i <= 16; i++) {
						ctx.beginPath();
						ctx.moveTo(P.cx, vpY);
						ctx.lineTo(P.cx + i * W * 0.09, H);
						ctx.stroke();
					}
					for (let j = 1; j <= 9; j++) {
						const y = hy + (H - hy) * (j / 9) ** 1.8;
						ctx.beginPath();
						ctx.moveTo(0, y);
						ctx.lineTo(W, y);
						ctx.stroke();
					}
					ctx.restore();
					const g = ctx.createRadialGradient(P.cx, P.cy, 0, P.cx, P.cy, P.r * 1.35);
					g.addColorStop(0, c.glow);
					g.addColorStop(1, rgba(c.grid, 0));
					ctx.fillStyle = g;
					ctx.fillRect(0, 0, W, H);
					ctx.save();
					ctx.strokeStyle = c.ring;
					ctx.lineWidth = u * 0.35;
					ctx.shadowColor = c.grid;
					ctx.shadowBlur = u * 3 * SK;
					ctx.beginPath();
					ctx.arc(P.cx, P.cy, P.r * 0.9, 0, Math.PI * 2);
					ctx.stroke();
					ctx.setLineDash([u * 0.6, u * 1.6]);
					ctx.lineWidth = u * 0.2;
					ctx.shadowBlur = 0;
					ctx.beginPath();
					ctx.arc(P.cx, P.cy, P.r * 1.0, 0, Math.PI * 2);
					ctx.stroke();
					ctx.restore();
					const rnd = mulberry32(3);
					for (let i = 0; i < 42; i++) {
						ctx.fillStyle = rgba(c.grid, 0.2 + rnd() * 0.5);
						ctx.beginPath();
						ctx.arc(rnd() * W, rnd() * H, u * (0.12 + rnd() * 0.32), 0, Math.PI * 2);
						ctx.fill();
					}
					if (P.cutout) {
						const rx = d.w * 0.62, ry = rx * 0.16, y = d.y + d.h - ry * 0.2;
						ctx.save();
						ctx.fillStyle = rgba(c.grid, 0.14);
						ctx.strokeStyle = c.ring;
						ctx.lineWidth = u * 0.35;
						ctx.shadowColor = c.grid;
						ctx.shadowBlur = u * 2.5 * SK;
						ctx.beginPath();
						ctx.ellipse(P.cx, y, rx, ry, 0, 0, Math.PI * 2);
						ctx.fill();
						ctx.stroke();
						ctx.restore();
					}
				},
				warm(ctx, W, H, L, c) {
					const P = L.prod, u = L.u;
					ctx.fillStyle = paint(ctx, c.bg, 0, H);
					ctx.fillRect(0, 0, W, H);
					const rnd = mulberry32(11);
					for (let i = 0; i < 16; i++) {
						paw(ctx, rnd() * W, rnd() * H, u * (3.5 + rnd() * 4), rnd() * 1.6 - 0.8, c.paw);
					}
					ctx.fillStyle = c.disc;
					ctx.beginPath();
					ctx.arc(P.cx, P.cy, P.r * 0.94, 0, Math.PI * 2);
					ctx.fill();
					ctx.save();
					ctx.strokeStyle = c.dot;
					ctx.lineWidth = u * 0.7;
					ctx.lineCap = 'round';
					ctx.setLineDash([0.01, u * 1.8]);
					ctx.beginPath();
					ctx.arc(P.cx, P.cy, P.r * 1.03, 0, Math.PI * 2);
					ctx.stroke();
					ctx.restore();
					basePodium(ctx, L, c);
				},
			};

			function basePodium(ctx, L, c) {
				const P = L.prod, d = P.draw;
				if (!P.cutout || !c.podium) return;
				const w = Math.min(Math.max(d.w * 1.35, P.r * 1.15), P.w * 0.98);
				const ry = w * 0.12;
				podium(ctx, P.cx, d.y + d.h - ry * 0.35, w, c.podium[0], c.podium[1], c.podium[2]);
			}

			// ============================================================
			// 示例产品图（参数化绘制的立式包装袋，颜色随模板变化）
			// ============================================================
			let sampleCache = { key: '', cv: null };
			function samplePouch(body, ink, brand, name, lang) {
				const key = [body, ink, brand, name, lang].join('|');
				if (sampleCache.key === key) return sampleCache.cv;
				const W = 760, H = 980, cv = makeCanvas(W, H), x = cv.getContext('2d');
				const bx = 60, by = 40, bw = 640, bh = 900;
				x.beginPath();
				x.moveTo(bx + 24, by);
				x.lineTo(bx + bw - 24, by);
				x.quadraticCurveTo(bx + bw, by, bx + bw, by + 24);
				x.lineTo(bx + bw - 6, by + bh - 70);
				x.quadraticCurveTo(bx + bw - 10, by + bh, bx + bw - 80, by + bh);
				x.lineTo(bx + 80, by + bh);
				x.quadraticCurveTo(bx + 10, by + bh, bx + 6, by + bh - 70);
				x.lineTo(bx, by + 24);
				x.quadraticCurveTo(bx, by, bx + 24, by);
				x.closePath();
				const g = x.createLinearGradient(bx, 0, bx + bw, 0);
				g.addColorStop(0, darken(body, 0.28));
				g.addColorStop(0.18, body);
				g.addColorStop(0.5, lighten(body, 0.12));
				g.addColorStop(0.82, body);
				g.addColorStop(1, darken(body, 0.32));
				x.fillStyle = g;
				x.fill();
				x.save();
				x.clip();
				x.fillStyle = 'rgba(0,0,0,.16)';
				x.fillRect(bx, by, bw, 70);
				for (let i = 0; i < 6; i++) {
					x.fillStyle = i % 2 ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.08)';
					x.fillRect(bx, by + 10 + i * 9, bw, 4);
				}
				x.fillStyle = 'rgba(0,0,0,.22)';
				x.fillRect(bx, by + 96, bw, 5);
				const gl = x.createLinearGradient(bx + 90, 0, bx + 190, 0);
				gl.addColorStop(0, 'rgba(255,255,255,0)');
				gl.addColorStop(0.5, 'rgba(255,255,255,.28)');
				gl.addColorStop(1, 'rgba(255,255,255,0)');
				x.fillStyle = gl;
				x.fillRect(bx + 90, by, 100, bh);
				const bg = x.createLinearGradient(0, by + bh - 130, 0, by + bh);
				bg.addColorStop(0, 'rgba(0,0,0,0)');
				bg.addColorStop(1, 'rgba(0,0,0,.22)');
				x.fillStyle = bg;
				x.fillRect(bx, by + bh - 130, bw, 130);
				x.restore();
				// 标签
				const lx = bx + 80, ly = by + 250, lw = bw - 160, lh = 500;
				x.save();
				x.shadowColor = 'rgba(0,0,0,.18)';
				x.shadowBlur = 18;
				x.shadowOffsetY = 6;
				rr(x, lx, ly, lw, lh, 44);
				x.fillStyle = '#fffdf8';
				x.fill();
				x.restore();
				paw(x, W / 2, ly + 96, 84, 0, ink);
				x.textAlign = 'center';
				x.textBaseline = 'middle';
				const b = fitText(x, brand || 'BRAND', lw - 70, 1, 64, 28, 900, SANS);
				x.font = b.font;
				x.fillStyle = darken(ink, 0.1);
				x.fillText(b.lines[0], W / 2, ly + 205);
				x.fillStyle = rgba(ink, 0.35);
				x.fillRect(W / 2 - 60, ly + 250, 120, 4);
				const n = fitText(x, name || '产品名称', lw - 80, 2, 50, 26, 700, SANS, true);
				x.font = n.font;
				x.fillStyle = '#2b2b2b';
				n.lines.forEach((ln, i) => x.fillText(ln, W / 2, ly + 310 + i * n.size * 1.25 + n.size / 2));
				x.font = `600 24px ${SANS}`;
				x.fillStyle = '#8a8a8a';
				x.fillText(lang === 'en' ? 'PREMIUM RECIPE' : 'PREMIUM · 精选配方', W / 2, ly + lh - 44);
				sampleCache = { key, cv };
				return cv;
			}

			// ============================================================
			// 产品图处理：抠图（边缘泛洪 + 羽化）、裁边
			// ============================================================
			const IMG = { src: null, proc: null, cutout: true, alpha: false, name: '' };

			function borderInfo(cv) {
				const w = cv.width, h = cv.height;
				const d = cv.getContext('2d', { willReadFrequently: true }).getImageData(0, 0, w, h).data;
				const bins = new Map();
				let n = 0, transparent = 0;
				const sample = (px, py) => {
					const i = (py * w + px) * 4;
					n++;
					if (d[i + 3] < 250) transparent++;
					const key = ((d[i] >> 4) << 8) | ((d[i + 1] >> 4) << 4) | (d[i + 2] >> 4);
					const b = bins.get(key) || { n: 0, r: 0, g: 0, b: 0 };
					b.n++;
					b.r += d[i];
					b.g += d[i + 1];
					b.b += d[i + 2];
					bins.set(key, b);
				};
				const sx = Math.max(1, w >> 6), sy = Math.max(1, h >> 6);
				for (let i = 0; i < w; i += sx) {
					sample(i, 0);
					sample(i, h - 1);
				}
				for (let j = 0; j < h; j += sy) {
					sample(0, j);
					sample(w - 1, j);
				}
				let best = { n: 0, r: 0, g: 0, b: 0 };
				for (const b of bins.values()) if (b.n > best.n) best = b;
				const ref = [best.r / best.n, best.g / best.n, best.b / best.n];
				return { ref, uniform: best.n / n, alpha: transparent / n > 0.05, data: d };
			}

			function removeBg(src, tol) {
				const w = src.width, h = src.height;
				const cv = makeCanvas(w, h), x = cv.getContext('2d', { willReadFrequently: true });
				x.drawImage(src, 0, 0);
				const im = x.getImageData(0, 0, w, h), d = im.data;
				const [r, g, b] = borderInfo(src).ref;
				const t2 = tol * tol;
				const dist2 = (i) => {
					const dr = d[i] - r, dg = d[i + 1] - g, db = d[i + 2] - b;
					return dr * dr + dg * dg + db * db;
				};
				const seen = new Uint8Array(w * h), q = new Int32Array(w * h);
				let qh = 0, qt = 0;
				const push = (p) => {
					if (!seen[p] && dist2(p * 4) <= t2) {
						seen[p] = 1;
						q[qt++] = p;
					}
				};
				for (let i = 0; i < w; i++) {
					push(i);
					push((h - 1) * w + i);
				}
				for (let j = 0; j < h; j++) {
					push(j * w);
					push(j * w + w - 1);
				}
				while (qh < qt) {
					const p = q[qh++], px = p % w;
					if (px > 0) push(p - 1);
					if (px < w - 1) push(p + 1);
					if (p >= w) push(p - w);
					if (p < w * (h - 1)) push(p + w);
				}
				for (let p = 0; p < w * h; p++) if (seen[p]) d[p * 4 + 3] = 0;
				// 边缘羽化：与背景相邻、颜色接近背景的像素做半透明过渡
				const soft = tol * 1.8;
				for (let p = 0; p < w * h; p++) {
					if (seen[p]) continue;
					const px = p % w;
					if (
						(px > 0 && seen[p - 1]) ||
						(px < w - 1 && seen[p + 1]) ||
						(p >= w && seen[p - w]) ||
						(p < w * (h - 1) && seen[p + w])
					) {
						const dd = Math.sqrt(dist2(p * 4));
						if (dd < soft) d[p * 4 + 3] = Math.round(d[p * 4 + 3] * clamp((dd - tol) / (soft - tol), 0.15, 1));
					}
				}
				x.putImageData(im, 0, 0);
				return cv;
			}

			function trimAlpha(cv) {
				const w = cv.width, h = cv.height;
				const d = cv.getContext('2d', { willReadFrequently: true }).getImageData(0, 0, w, h).data;
				let x0 = w, y0 = h, x1 = -1, y1 = -1;
				for (let y = 0; y < h; y++) {
					for (let x = 0; x < w; x++) {
						if (d[(y * w + x) * 4 + 3] > 16) {
							if (x < x0) x0 = x;
							if (x > x1) x1 = x;
							if (y < y0) y0 = y;
							if (y > y1) y1 = y;
						}
					}
				}
				if (x1 < 0 || (x0 === 0 && y0 === 0 && x1 === w - 1 && y1 === h - 1)) return cv;
				const out = makeCanvas(x1 - x0 + 1, y1 - y0 + 1);
				out.getContext('2d').drawImage(cv, -x0, -y0);
				return out;
			}

			function processImage() {
				if (!IMG.src) {
					IMG.proc = null;
					return;
				}
				if (IMG.alpha) {
					IMG.proc = trimAlpha(IMG.src);
					IMG.cutout = true;
				} else if (state.removeBg) {
					IMG.proc = trimAlpha(removeBg(IMG.src, +state.tol));
					IMG.cutout = true;
				} else {
					IMG.proc = IMG.src;
					IMG.cutout = false;
				}
			}

			function currentImage(th, accent) {
				if (IMG.proc) return { canvas: IMG.proc, w: IMG.proc.width, h: IMG.proc.height, cutout: IMG.cutout };
				const [body, ink] = th.pouch(accent);
				const cv = samplePouch(body, ink, state.brand.trim(), (state.product || state.headline).trim(), state.lang);
				return { canvas: cv, w: cv.width, h: cv.height, cutout: true };
			}

			// ============================================================
			// 布局
			// ============================================================
			const parsePoints = (s) =>
				String(s || '')
					.split('\n')
					.map((t) => t.trim())
					.filter(Boolean)
					.slice(0, 4);

			function prodGeom(R, img, scale) {
				const cx = R.x + R.w / 2;
				const cy = R.y + R.h * (img.cutout ? 0.46 : 0.5);
				const P = { x: R.x, y: R.y, w: R.w, h: R.h, cx, cy, r: Math.min(R.w, R.h) / 2, cutout: img.cutout };
				const s = Math.min((R.w * 0.9) / img.w, (R.h * (img.cutout ? 0.82 : 0.9)) / img.h) * scale;
				const w = img.w * s, h = img.h * s;
				P.draw = { x: cx - w / 2, y: cy - h / 2, w, h };
				return P;
			}

			// 方图/接近方图：卖点竖排在左，产品在右
			function layoutSide(ctx, pts, R, u, k) {
				let size = 3.3 * u * k;
				const min = 2.2 * u;
				for (;;) {
					ctx.font = `600 ${size}px ${SANS}`;
					const ih = size * 2.1, gap = size * 0.6, ir = size * 0.62, padL = size * 0.55, padR = size * 0.9;
					const maxText = R.w - padL - ir * 2 - size * 0.45 - padR;
					const widths = pts.map((p) => ctx.measureText(p).width);
					let n = pts.length;
					let total = n * ih + (n - 1) * gap;
					const fits = Math.max(...widths) <= maxText && total <= R.h;
					if (fits || size <= min) {
						if (total > R.h) {
							n = Math.max(1, Math.floor((R.h + gap) / (ih + gap)));
							total = n * ih + (n - 1) * gap;
						}
						const y0 = R.y + (R.h - total) / 2;
						const items = pts.slice(0, n).map((p, i) => {
							const t = clip(ctx, p, maxText);
							const tw = ctx.measureText(t).width;
							return { t, x: R.x, y: y0 + i * (ih + gap), w: padL + ir * 2 + size * 0.45 + tw + padR, h: ih };
						});
						return { size, ir, padL, items, font: ctx.font, ok: fits };
					}
					size = Math.max(min, size * 0.93);
				}
			}

			// 竖版长图：卖点 2 列卡片
			function layoutGrid(ctx, pts, x0, cw, bottom, u, k) {
				const gap = 2 * u * k;
				let size = 3.7 * u * k;
				const min = 2.6 * u;
				for (;;) {
					ctx.font = `600 ${size}px ${SANS}`;
					const ir = size * 0.62, padL = size * 0.7, padR = size * 0.7, padY = size * 0.8, lh = size * 1.3;
					const n = pts.length, colW = (cw - gap) / 2;
					let over = false;
					const cells = pts.map((t, i) => {
						const full = n % 2 === 1 && i === n - 1;
						const w = full ? cw : colW;
						const textW = w - padL - ir * 2 - size * 0.45 - padR;
						const lines = wrap(ctx, t, textW);
						if (lines.length > 2) over = true;
						return { t, w, textW, lines, col: full ? 0 : i % 2, row: Math.floor(i / 2) };
					});
					if (!over || size <= min) {
						for (const cl of cells) {
							if (cl.lines.length > 2) cl.lines = [cl.lines[0], clip(ctx, cl.lines.slice(1).join(''), cl.textW)];
						}
						const rows = Math.ceil(n / 2);
						const h = Math.max(...cells.map((cl) => cl.lines.length)) * lh + padY * 2;
						const top = bottom - (rows * h + (rows - 1) * gap);
						for (const cl of cells) {
							cl.x = x0 + cl.col * (colW + gap);
							cl.y = top + cl.row * (h + gap);
							cl.h = h;
						}
						return { size, ir, padL, items: cells, top, font: ctx.font, lh, ok: true };
					}
					size = Math.max(min, size * 0.93);
				}
			}

			// 横版：卖点胶囊流式排列
			function layoutChips(ctx, pts, maxW, size0, minSize, maxRows) {
				let size = size0;
				for (;;) {
					ctx.font = `600 ${size}px ${SANS}`;
					const h = size * 2, gap = size * 0.55, ir = size * 0.55, padL = size * 0.5, padR = size * 0.85;
					const maxT = maxW - padL - ir * 2 - size * 0.45 - padR;
					let row = 0, x = 0;
					const items = pts.map((p) => {
						const t = clip(ctx, p, maxT);
						const w = padL + ir * 2 + size * 0.45 + ctx.measureText(t).width + padR;
						if (x > 0 && x + w > maxW) {
							row++;
							x = 0;
						}
						const it = { t, w, h, row, dx: x };
						x += w + gap;
						return it;
					});
					if (row < maxRows || size <= minSize) {
						const kept = items.filter((it) => it.row < maxRows);
						const rows = Math.min(row + 1, maxRows);
						return { size, h, gap, ir, padL, items: kept, height: rows * h + (rows - 1) * gap, font: ctx.font, ok: true };
					}
					size = Math.max(minSize, size * 0.93);
				}
			}

			const hasBar = (st) => !!(String(st.price).trim() || String(st.cta).trim());

			function layoutTall(ctx, W, H, st, th, img, pts) {
				let L;
				for (let k = 1; k >= 0.6; k -= 0.06) {
					L = tryTall(ctx, W, H, st, th, img, pts, k);
					if (L.ok) break;
				}
				return L;
			}
			function tryTall(ctx, W, H, st, th, img, pts, k) {
				const ratio = W / H;
				const mode = ratio < 0.7 ? 'grid' : 'side';
				const u = Math.min(W, H) / 100;
				const pad = 6 * u;
				const x0 = pad, cw = W - pad * 2;
				const L = { W, H, u, x0, cw, align: th.align, tx: th.align === 'center' ? W / 2 : x0 };
				let y = pad * 0.95;
				if (st.brand.trim()) {
					L.brand = { y, size: 3.4 * u * k };
					y += L.brand.size + 2.4 * u * k;
				}
				L.head = fitText(ctx, st.headline, cw, 2, (mode === 'grid' ? 11 : 9) * u * k, 5 * u, th.headW, th.head, true);
				if (L.head) {
					L.head.y = y;
					L.head.lh = L.head.size * 1.18;
					y += L.head.lines.length * L.head.lh + 1.2 * u * k;
				}
				L.sub = fitText(ctx, st.sub, cw, ratio < 0.85 ? 2 : 1, 4.3 * u * k, 3 * u, 500, SANS, true);
				if (L.sub) {
					L.sub.y = y;
					L.sub.lh = L.sub.size * 1.38;
					y += L.sub.lines.length * L.sub.lh + 2.2 * u * k;
				}
				const top = y;
				let yb = H - pad * 0.9;
				if (st.note.trim()) {
					L.note = { size: 2.6 * u * k };
					L.note.y = yb - L.note.size;
					yb = L.note.y - 1.8 * u * k;
				}
				if (hasBar(st)) {
					const P = (mode === 'grid' ? 15 : 13.5) * u * k;
					L.bar = { x: x0, y: yb - P, w: cw, h: P };
					yb = L.bar.y - 2.6 * u * k;
				}
				if (mode === 'grid' && pts.length) {
					L.pts = layoutGrid(ctx, pts, x0, cw, yb, u, k);
					yb = L.pts.top - 2.6 * u * k;
				}
				const band = { x: x0, y: top, w: cw, h: yb - top };
				let R = band;
				if (mode === 'side' && pts.length) {
					const sw = cw * 0.42;
					L.pts = layoutSide(ctx, pts, { x: x0, y: band.y, w: sw, h: band.h }, u, k);
					R = { x: x0 + sw + 2 * u, y: band.y, w: cw - sw - 2 * u, h: band.h };
				}
				L.prod = prodGeom(R, img, st.imgScale / 100);
				L.ok = band.h >= H * (mode === 'grid' ? 0.34 : 0.36) && (!L.pts || L.pts.ok);
				return L;
			}

			function layoutWide(ctx, W, H, st, th, img, pts) {
				let L;
				for (let k = 1; k >= 0.6; k -= 0.05) {
					L = tryWide(ctx, W, H, st, th, img, pts, k);
					if (L.ok) break;
				}
				return L;
			}
			function tryWide(ctx, W, H, st, th, img, pts, k) {
				const u = H / 100;
				const x0 = 7 * u;
				const tw = Math.min(W * 0.52 - x0, 130 * u);
				const L = { W, H, u, x0, cw: tw, align: 'left', tx: x0, wide: true };
				const parts = [];
				if (st.brand.trim()) {
					L.brand = { size: 3.6 * u * k };
					parts.push(['brand', L.brand.size, 2.4 * u * k]);
				}
				L.head = fitText(ctx, st.headline, tw, 2, 11.5 * u * k, 6 * u * k, th.headW, th.head, true);
				if (L.head) {
					L.head.lh = L.head.size * 1.16;
					parts.push(['head', L.head.lines.length * L.head.lh, 1.6 * u * k]);
				}
				L.sub = fitText(ctx, st.sub, tw, 2, 4.8 * u * k, 3.2 * u * k, 500, SANS, true);
				if (L.sub) {
					L.sub.lh = L.sub.size * 1.4;
					parts.push(['sub', L.sub.lines.length * L.sub.lh, 3.4 * u * k]);
				}
				if (pts.length) {
					L.pts = layoutChips(ctx, pts, tw, 3.4 * u * k, 2.4 * u, 2);
					parts.push(['pts', L.pts.height, 4 * u * k]);
				}
				if (hasBar(st)) {
					L.bar = { x: x0, w: tw, h: 13 * u * k, fit: true };
					parts.push(['bar', L.bar.h, 2.6 * u * k]);
				}
				if (st.note.trim()) {
					L.note = { size: 2.7 * u * k };
					parts.push(['note', L.note.size * 1.2, 0]);
				}
				const total = parts.reduce((s, p, i) => s + p[1] + (i < parts.length - 1 ? p[2] : 0), 0);
				let y = Math.max(5 * u, (H - total) / 2);
				for (const [key, h, gap] of parts) {
					L[key].y = y;
					y += h + gap;
				}
				if (L.pts) {
					for (const it of L.pts.items) {
						it.x = x0 + it.dx;
						it.y = L.pts.y + it.row * (L.pts.h + L.pts.gap);
					}
				}
				const px = x0 + tw + 4 * u;
				L.prod = prodGeom({ x: px, y: 6 * u, w: W - px - 6 * u, h: 88 * u }, img, st.imgScale / 100);
				L.ok = total <= H - 10 * u;
				return L;
			}

			// ============================================================
			// 元素绘制
			// ============================================================
			function drawBlock(ctx, B, x, align, fill, shadow) {
				if (!B) return;
				ctx.save();
				ctx.font = B.font;
				ctx.textAlign = align;
				ctx.textBaseline = 'middle';
				ctx.fillStyle = paint(ctx, fill, B.y, B.y + B.lines.length * B.lh);
				if (shadow) {
					ctx.shadowColor = shadow;
					ctx.shadowBlur = B.size * 0.12 * SK;
					ctx.shadowOffsetY = B.size * 0.05 * SK;
				}
				B.lines.forEach((ln, i) => ctx.fillText(ln, x, B.y + i * B.lh + B.lh / 2));
				ctx.restore();
			}

			function drawBrand(ctx, L, st, c, th) {
				if (!L.brand) return;
				const B = L.brand;
				ctx.save();
				ctx.font = `800 ${B.size}px ${SANS}`;
				ctx.textAlign = L.align;
				ctx.textBaseline = 'middle';
				ctx.fillStyle = c.brand;
				let text = st.brand.trim();
				if (th.brandSpaced) {
					text = text.toUpperCase();
					if ('letterSpacing' in ctx) ctx.letterSpacing = `${B.size * 0.28}px`;
				}
				ctx.fillText(clip(ctx, text, L.cw), L.tx, B.y + B.size / 2);
				ctx.restore();
			}

			function drawProduct(ctx, L, img, c) {
				const d = L.prod.draw;
				ctx.save();
				if (img.cutout) {
					const sx = d.x + d.w / 2, sy = d.y + d.h - d.w * 0.012;
					const g = ctx.createRadialGradient(sx, sy, 0, sx, sy, d.w * 0.48);
					g.addColorStop(0, `rgba(0,0,0,${c.shadowA})`);
					g.addColorStop(1, 'rgba(0,0,0,0)');
					ctx.fillStyle = g;
					ctx.beginPath();
					ctx.ellipse(sx, sy, d.w * 0.48, d.w * 0.07, 0, 0, Math.PI * 2);
					ctx.fill();
					ctx.drawImage(img.canvas, d.x, d.y, d.w, d.h);
				} else {
					const r = Math.min(d.w, d.h) * 0.045;
					ctx.shadowColor = 'rgba(0,0,0,.28)';
					ctx.shadowBlur = d.w * 0.06 * SK;
					ctx.shadowOffsetY = d.w * 0.025 * SK;
					rr(ctx, d.x, d.y, d.w, d.h, r);
					ctx.fillStyle = '#ffffff';
					ctx.fill();
					ctx.shadowColor = 'transparent';
					ctx.clip();
					ctx.drawImage(img.canvas, d.x, d.y, d.w, d.h);
				}
				ctx.restore();
			}

			function drawBadge(ctx, L, st, c, th) {
				const t = st.badge.trim();
				if (!t) return;
				const P = L.prod, d = P.draw, u = L.u;
				ctx.save();
				if (th.badge === 'rect' || th.badge === 'pill') {
					const fs = 3.3 * u;
					ctx.font = `800 ${fs}px ${SANS}`;
					const text = clip(ctx, t, P.w * 0.7);
					const w = ctx.measureText(text).width + fs * 1.6, h = fs * 2.1;
					const x = Math.min(d.x + d.w - w * 0.55, P.x + P.w - w);
					const y = Math.max(d.y - h * 0.2, P.y);
					rr(ctx, x, y, w, h, th.badge === 'pill' ? h / 2 : 0);
					ctx.fillStyle = c.badgeBg;
					ctx.shadowColor = 'rgba(0,0,0,.2)';
					ctx.shadowBlur = fs * 0.5 * SK;
					ctx.fill();
					ctx.shadowColor = 'transparent';
					ctx.fillStyle = c.badgeText;
					ctx.textAlign = 'center';
					ctx.textBaseline = 'middle';
					ctx.fillText(text, x + w / 2, y + h / 2);
				} else {
					const r = clamp(Math.min(P.w, P.h) * 0.17, 7 * u, 12 * u);
					const cx = Math.min(d.x + d.w - r * 0.1, P.x + P.w - r * 1.02);
					const cy = Math.max(d.y + r * 0.35, P.y + r * 1.02);
					ctx.translate(cx, cy);
					ctx.rotate(th.badge === 'burst' ? -0.2 : 0);
					ctx.shadowColor = 'rgba(0,0,0,.22)';
					ctx.shadowBlur = r * 0.18 * SK;
					ctx.shadowOffsetY = r * 0.06 * SK;
					ctx.fillStyle = c.badgeBg;
					if (th.badge === 'burst') {
						starPath(ctx, 0, 0, r, 16, 0.84, 0);
						ctx.fill();
					} else if (th.badge === 'scallop') {
						ctx.beginPath();
						ctx.arc(0, 0, r * 0.86, 0, Math.PI * 2);
						ctx.fill();
						ctx.shadowColor = 'transparent';
						for (let i = 0; i < 14; i++) {
							const a = (i / 14) * Math.PI * 2;
							ctx.beginPath();
							ctx.arc(Math.cos(a) * r * 0.84, Math.sin(a) * r * 0.84, r * 0.17, 0, Math.PI * 2);
							ctx.fill();
						}
					} else {
						ctx.beginPath();
						ctx.arc(0, 0, r, 0, Math.PI * 2);
						ctx.fill();
					}
					ctx.shadowColor = 'transparent';
					const f = fitText(ctx, t, r * 1.36, 2, r * 0.5, r * 0.24, 900, SANS, true);
					ctx.font = f.font;
					ctx.fillStyle = c.badgeText;
					ctx.textAlign = 'center';
					ctx.textBaseline = 'middle';
					const lh = f.size * 1.12;
					f.lines.forEach((ln, i) => ctx.fillText(ln, 0, (i - (f.lines.length - 1) / 2) * lh));
				}
				ctx.restore();
			}

			function drawPoints(ctx, L, c, th) {
				const P = L.pts;
				if (!P) return;
				ctx.save();
				ctx.textBaseline = 'middle';
				ctx.textAlign = 'left';
				const grid = !!P.lh;
				for (const it of P.items) {
					if (th.chip === 'line') {
						ctx.fillStyle = c.line || 'rgba(0,0,0,.15)';
						ctx.fillRect(it.x, it.y + it.h - Math.max(1, P.size * 0.05), it.w, Math.max(1, P.size * 0.05));
					} else {
						rr(ctx, it.x, it.y, it.w, it.h, grid ? P.size * 0.7 : it.h / 2);
						ctx.save();
						if (c.chipShadow) {
							ctx.shadowColor = c.chipShadow;
							ctx.shadowBlur = P.size * 0.6 * SK;
							ctx.shadowOffsetY = P.size * 0.15 * SK;
						}
						ctx.fillStyle = c.chipBg;
						ctx.fill();
						ctx.restore();
						if (c.chipStroke) {
							ctx.strokeStyle = c.chipStroke;
							ctx.lineWidth = Math.max(1, P.size * 0.06);
							ctx.stroke();
						}
					}
					const icx = it.x + P.padL + P.ir, icy = it.y + it.h / 2;
					if (th.chip === 'line') {
						ctx.fillStyle = c.icon;
						const s = P.ir * 0.62;
						ctx.fillRect(icx - s / 2, icy - s / 2, s, s);
					} else checkIcon(ctx, icx, icy, P.ir, c.icon, c.iconFg);
					ctx.font = P.font;
					ctx.fillStyle = c.chipText;
					const tx = icx + P.ir + P.size * 0.45;
					const lines = it.lines || [it.t];
					const lh = P.lh || P.size * 1.3;
					const y0 = icy - ((lines.length - 1) * lh) / 2;
					lines.forEach((ln, i) => ctx.fillText(ln, tx, y0 + i * lh));
				}
				ctx.restore();
			}

			function priceSegments(ctx, st, size) {
				const price = String(st.price).trim();
				if (!price) return { seg: [], w: 0, size };
				const cur = st.currency || '¥';
				const prefix = String(st.prefix).trim(), orig = String(st.orig).trim();
				const seg = [];
				if (prefix) seg.push({ t: prefix, f: `700 ${size * 0.34}px ${SANS}`, k: 'prefix', gap: size * 0.16 });
				seg.push({ t: cur, f: `800 ${size * 0.48}px ${SANS}`, k: 'price', gap: size * 0.04 });
				seg.push({ t: price, f: `900 ${size}px ${SANS}`, k: 'price', gap: size * 0.22, main: true });
				if (orig) seg.push({ t: cur + orig, f: `500 ${size * 0.32}px ${SANS}`, k: 'orig', gap: 0, strike: true });
				let w = 0;
				seg.forEach((s, i) => {
					ctx.font = s.f;
					s.w = ctx.measureText(s.t).width;
					w += s.w + (i < seg.length - 1 ? s.gap : 0);
				});
				return { seg, w, size };
			}
			function drawPriceSegments(ctx, m, x, baseline, c) {
				let cx = x;
				ctx.save();
				ctx.textAlign = 'left';
				ctx.textBaseline = 'alphabetic';
				for (const s of m.seg) {
					ctx.font = s.f;
					ctx.fillStyle = c[s.k];
					if (s.main && c.priceGlow) {
						ctx.shadowColor = c.priceGlow;
						ctx.shadowBlur = m.size * 0.25 * SK;
					}
					ctx.fillText(s.t, cx, baseline);
					ctx.shadowColor = 'transparent';
					if (s.strike) {
						ctx.fillStyle = c.orig;
						ctx.fillRect(cx, baseline - m.size * 0.11, s.w, Math.max(1, m.size * 0.025));
					}
					cx += s.w + s.gap;
				}
				ctx.restore();
			}
			function ctaMetrics(ctx, text, h) {
				const fs = h * 0.42;
				ctx.font = `800 ${fs}px ${SANS}`;
				const tw = ctx.measureText(text).width;
				const aw = fs * 0.5;
				return { text, h, fs, tw, aw, w: tw + fs * 0.45 + aw + h * 0.8 };
			}
			function drawCta(ctx, m, x, y, c, th) {
				ctx.save();
				rr(ctx, x, y, m.w, m.h, th.ctaSquare ? m.h * 0.06 : m.h / 2);
				ctx.fillStyle = paint(ctx, c.cta, y, y + m.h);
				ctx.fill();
				ctx.font = `800 ${m.fs}px ${SANS}`;
				ctx.fillStyle = c.ctaText;
				ctx.textAlign = 'left';
				ctx.textBaseline = 'middle';
				const tx = x + m.h * 0.4;
				ctx.fillText(m.text, tx, y + m.h / 2);
				const ax = tx + m.tw + m.fs * 0.45, ay = y + m.h / 2, s = m.aw * 0.55;
				ctx.beginPath();
				ctx.moveTo(ax, ay - s);
				ctx.lineTo(ax + s * 0.85, ay);
				ctx.lineTo(ax, ay + s);
				ctx.strokeStyle = c.ctaText;
				ctx.lineWidth = m.fs * 0.14;
				ctx.lineCap = 'round';
				ctx.lineJoin = 'round';
				ctx.stroke();
				ctx.restore();
			}

			function drawBar(ctx, L, st, c, th) {
				const B = L.bar;
				if (!B) return;
				const P = B.h;
				const ctaText = String(st.cta).trim();
				const cta = ctaText ? ctaMetrics(ctx, ctaText, P * 0.64) : null;
				const inset = (P - (cta ? cta.h : 0)) / 2;
				const lined = th.barStyle === 'line';
				const pl = lined ? 0 : P * 0.28;
				const avail = B.w - pl * 2 - (cta ? cta.w + P * 0.3 : 0);
				let size = P * 0.6;
				let m = priceSegments(ctx, st, size);
				while (m.w > avail && size > P * 0.28) {
					size *= 0.94;
					m = priceSegments(ctx, st, size);
				}
				// 只有按钮没有价格：放大按钮，不画价格条
				if (!m.w) {
					if (!cta) return;
					const big = ctaMetrics(ctx, ctaText, P * 0.78);
					const bx = L.wide ? B.x : B.x + (B.w - big.w) / 2;
					drawCta(ctx, big, bx, B.y + (P - big.h) / 2, c, th);
					return;
				}
				let bw = B.w;
				if (B.fit) bw = Math.min(B.w, pl + m.w + (cta ? P * 0.3 + cta.w + inset : pl));
				ctx.save();
				if (lined) {
					ctx.fillStyle = c.line || 'rgba(0,0,0,.2)';
					ctx.fillRect(B.x, B.y, bw, Math.max(1, L.u * 0.14));
				} else if (c.bar) {
					rr(ctx, B.x, B.y, bw, P, th.barR === 'full' ? P / 2 : P * th.barR);
					if (c.barShadow) {
						ctx.shadowColor = c.barShadow;
						ctx.shadowBlur = P * 0.3 * SK;
						ctx.shadowOffsetY = P * 0.06 * SK;
					}
					ctx.fillStyle = paint(ctx, c.bar, B.y, B.y + P);
					ctx.fill();
					ctx.shadowColor = 'transparent';
					if (c.barStroke) {
						ctx.strokeStyle = c.barStroke;
						ctx.lineWidth = Math.max(1, L.u * 0.18);
						ctx.stroke();
					}
				}
				ctx.restore();
				const baseline = B.y + P / 2 + m.size * 0.36;
				const priceX = cta || B.fit ? B.x + pl : B.x + (bw - m.w) / 2;
				drawPriceSegments(ctx, m, priceX, baseline, c);
				if (cta) drawCta(ctx, cta, B.x + bw - (lined ? 0 : inset) - cta.w, B.y + inset, c, th);
			}

			function drawNote(ctx, L, st, c) {
				if (!L.note) return;
				ctx.save();
				ctx.font = `500 ${L.note.size}px ${SANS}`;
				ctx.fillStyle = c.note;
				ctx.textAlign = L.wide ? 'left' : 'center';
				ctx.textBaseline = 'middle';
				ctx.fillText(clip(ctx, st.note.trim(), L.wide ? L.cw : L.cw), L.wide ? L.x0 : L.W / 2, L.note.y + L.note.size / 2);
				ctx.restore();
			}

			// ============================================================
			// 主渲染
			// ============================================================
			function render(ctx, W, H, st, k = 1) {
				SK = k;
				const th = THEMES[st.theme] || THEMES.promo;
				const accent = /^#[0-9a-f]{6}$/i.test(st.accent) ? st.accent : th.accent;
				const c = th.make(accent);
				const img = currentImage(th, accent);
				const pts = parsePoints(st.points);
				ctx.save();
				ctx.clearRect(0, 0, W, H);
				const L = W / H >= 1.3 ? layoutWide(ctx, W, H, st, th, img, pts) : layoutTall(ctx, W, H, st, th, img, pts);
				BG[st.theme in BG ? st.theme : 'promo'](ctx, W, H, L, c);
				drawProduct(ctx, L, img, c);
				drawBadge(ctx, L, st, c, th);
				drawBrand(ctx, L, st, c, th);
				drawBlock(ctx, L.head, L.tx, L.align, c.headline, c.headShadow);
				drawBlock(ctx, L.sub, L.tx, L.align, c.sub);
				drawPoints(ctx, L, c, th);
				drawBar(ctx, L, st, c, th);
				drawNote(ctx, L, st, c);
				ctx.restore();
			}

