			function copyIdeas(st) {
				const P = (st.product || '').trim() || st.headline.trim();
				const B = st.brand.trim(), A = st.audience.trim(), pain = st.pain.trim(), badge = st.badge.trim();
				const pts = parsePoints(st.points);
				const [p1, p2, p3] = pts;
				const cur = st.currency;
				const price = String(st.price).trim(), orig = String(st.orig).trim();
				const save = price && orig && +orig > +price && !isNaN(+orig - +price) ? fmtNum(+orig - +price) : '';
				const H = [], S = [];
				const add = (arr, ok, text, tag) => ok && arr.push({ text, tag });
				if (st.lang === 'en') {
					add(H, P && pain, `Say goodbye to ${pain} with ${[B, P].filter(Boolean).join(' ')}`, 'Pain point');
					add(H, P && pain, `${pain}? Try ${P}`, 'Question');
					add(H, p1 && p2, `${p1} · ${p2}`, 'Benefit');
					add(H, P && A, `${P}, made for ${A}`, 'Audience');
					add(H, P && pts.length >= 2, `${EN_NUM[pts.length]} reasons to try ${P}`, 'Number');
					add(H, P && save, `Save ${cur}${save} on ${P}`, 'Price');
					add(H, P && badge && price, `${badge}: ${P} now ${cur}${price}`, 'Promo');
					add(H, P && B && p1, `${B} ${P} | ${p1}`, 'Brand');
					add(S, pts.length >= 2, pts.length >= 3 ? `${p1}, ${p2} & ${p3}` : `${p1} & ${p2}`, 'Benefits');
					add(S, A && p1, `Made for ${A} — ${p1}`, 'Audience');
					add(S, pain && (p2 || p1), `No more ${pain}: ${p2 || p1}`, 'Pain point');
					add(S, B && p1 && p2, `By ${B} · ${p1} · ${p2}`, 'Brand');
					const C = ['Message me', 'Buy now', 'Shop now', 'Order today', 'DM to order', 'Learn more', 'Grab yours'];
					return { H, S, C };
				}
				add(H, P && pain, `告别${pain}，就选${B}${P}`, '痛点');
				add(H, P && pain, `${pain}？试试${P}`, '提问');
				add(H, p1 && p2, `${p1} · ${p2}`, '利益');
				add(H, P && A, `专为${A}打造的${P}`, '人群');
				add(H, P && A, `${A}都爱的${P}`, '从众');
				add(H, P && pts.length >= 2, `${CN_NUM[pts.length]}大亮点，${P}值得入手`, '数字');
				add(H, P && save, `立省${cur}${save}！${P}限时特惠`, '价格');
				add(H, P && badge && price, `${badge}！${P}${st.prefix.trim()}${cur}${price}`, '促销');
				add(H, P && B && p1, `${B} ${P}｜${p1}`, '品牌');
				add(S, pts.length >= 2, pts.slice(0, 3).join('，'), '卖点');
				add(S, A && p1, `专为${A}打造，${p1}`, '人群');
				add(S, pain && (p2 || p1), `解决${pain}，${p2 || p1}`, '痛点');
				add(S, B && p1 && p2, `${B}出品 · ${p1} · ${p2}`, '品牌');
				add(S, p3 && P, `${P}，${p3}`, '利益');
				const C = ['私信下单', '立即抢购', '限时特惠', '马上咨询', '点击了解', '新客专享'];
				return { H, S, C };
			}

			// ============================================================
			// 状态与界面
			// ============================================================
			const PRESETS = [
				{ key: 'main', name: '主图 1:1', note: '淘宝/京东/拼多多', w: 800, h: 800 },
				{ key: 'xhs', name: '小红书 3:4', note: '笔记封面', w: 1080, h: 1440 },
				{ key: 'story', name: '抖音 9:16', note: '视频号/快手', w: 1080, h: 1920 },
				{ key: 'feed', name: '信息流 16:9', note: '朋友圈/头条', w: 1280, h: 720 },
				{ key: 'banner', name: '店铺横幅', note: '首页海报', w: 1920, h: 700 },
				{ key: 'fb', name: 'Facebook 1:1', note: 'Marketplace 商品图', w: 1080, h: 1080 },
			];
			// 两个独立版本：中文（小红书）与 English（Facebook Marketplace），各自保存文字与设置
			const DEFAULTS = {
				zh: {
					lang: 'zh',
					brand: 'FluffyWA',
					product: '冻干双拼粮',
					headline: '金毛专属冻干双拼粮',
					sub: '鲜肉冻干 + 营养主粮，挑食毛孩子也爱吃',
					points: '高鲜肉含量\n冻干颗粒添加\n美毛护肤配方\n无谷低敏',
					prefix: '到手价',
					currency: 'A$',
					price: '39',
					orig: '55',
					badge: '第2件半价',
					cta: '私信下单',
					note: '现货 · 当天可自提',
					audience: '挑食狗狗',
					pain: '狗狗挑食不爱吃',
					region: '珀斯 Canning Vale',
					delivery: '可自提 / 全澳邮寄',
					theme: 'warm',
					accent: THEMES.warm.accent,
					preset: 'xhs',
					cw: 1200,
					ch: 1200,
					imgScale: 100,
					removeBg: false,
					tol: 40,
					format: 'jpg',
				},
				en: {
					lang: 'en',
					brand: 'FluffyWA',
					product: 'Freeze-Dried Dog Food',
					headline: 'Freeze-Dried Mix for Golden Retrievers',
					sub: 'Real meat + complete kibble. Fussy eaters love it.',
					points: 'High real-meat content\nFreeze-dried bites inside\nShiny-coat formula\nGrain-free recipe',
					prefix: 'Now',
					currency: 'A$',
					price: '39',
					orig: '55',
					badge: '2nd bag half price',
					cta: 'Message me',
					note: 'In stock · Same-day pickup',
					audience: 'fussy eaters',
					pain: 'fussy eating',
					region: 'Canning Vale, Perth WA',
					delivery: 'Pickup or local delivery',
					theme: 'natural',
					accent: THEMES.natural.accent,
					preset: 'fb',
					cw: 1200,
					ch: 1200,
					imgScale: 100,
					removeBg: false,
					tol: 40,
					format: 'jpg',
				},
			};
			const STORE_KEY = 'ad-studio:v2';
			const store = { active: 'zh', zh: { ...DEFAULTS.zh }, en: { ...DEFAULTS.en } };
			try {
				const saved = JSON.parse(localStorage.getItem(STORE_KEY) || 'null');
				if (saved && typeof saved === 'object') {
					for (const v of ['zh', 'en']) {
						const s = saved[v];
						if (!s || typeof s !== 'object') continue;
						for (const k of Object.keys(DEFAULTS[v])) {
							if (k !== 'lang' && k in s && typeof s[k] === typeof DEFAULTS[v][k]) store[v][k] = s[k];
						}
						if (!(store[v].theme in THEMES)) store[v].theme = DEFAULTS[v].theme;
					}
					if (saved.active === 'en') store.active = 'en';
				}
			} catch {}
			let state = store[store.active];

			const canvas = $('#canvas');
			const stage = $('#stage');

			function allPresets() {
				const cw = clamp(parseInt(state.cw, 10) || 1200, 200, 3000);
				const ch = clamp(parseInt(state.ch, 10) || 1200, 200, 3000);
				return [...PRESETS, { key: 'custom', name: '自定义', note: '任意尺寸', w: cw, h: ch }];
			}
			const currentPreset = () => allPresets().find((p) => p.key === state.preset) || PRESETS[0];

			function syncForm() {
				for (const el of $$('[data-k]')) {
					const k = el.dataset.k;
					if (el.type === 'checkbox') el.checked = !!state[k];
					else el.value = state[k];
				}
				for (const r of $$('input[name="theme"]')) r.checked = r.value === state.theme;
			}

			// 风格卡片
			const themesEl = $('#themes');
			for (const [key, th] of Object.entries(THEMES)) {
				const [a, b] = th.swatch(th.accent);
				const lab = document.createElement('label');
				lab.className = 'theme';
				const input = document.createElement('input');
				input.type = 'radio';
				input.name = 'theme';
				input.value = key;
				const span = document.createElement('span');
				const sw = document.createElement('i');
				sw.style.background = `linear-gradient(135deg, ${a} 0 55%, ${b} 55% 100%)`;
				span.append(sw, th.name);
				lab.append(input, span);
				themesEl.append(lab);
			}

			// 尺寸缩略图
			const sizesEl = $('#sizes');
			const thumbs = {};
			for (const p of allPresets()) {
				const b = document.createElement('button');
				b.type = 'button';
				b.className = 'size';
				b.dataset.key = p.key;
				b.setAttribute('role', 'option');
				const cv = document.createElement('canvas');
				const name = document.createElement('b');
				name.textContent = p.name;
				const dims = document.createElement('small');
				b.append(cv, name, dims);
				sizesEl.append(b);
				thumbs[p.key] = { b, cv, dims };
				b.addEventListener('click', () => {
					state.preset = p.key;
					schedule();
				});
			}

			function renderThumbs() {
				const dpr = Math.min(2, window.devicePixelRatio || 1);
				for (const p of allPresets()) {
					const t = thumbs[p.key];
					const s = Math.min((88 * dpr) / p.h, (150 * dpr) / p.w);
					t.cv.width = Math.round(p.w * s);
					t.cv.height = Math.round(p.h * s);
					t.cv.style.width = `${t.cv.width / dpr}px`;
					t.cv.style.height = `${t.cv.height / dpr}px`;
					const ctx = t.cv.getContext('2d');
					ctx.setTransform(s, 0, 0, s, 0, 0);
					render(ctx, p.w, p.h, state, s);
					t.dims.textContent = `${p.w}×${p.h}`;
					t.b.classList.toggle('active', p.key === state.preset);
					t.b.setAttribute('aria-selected', String(p.key === state.preset));
					t.b.title = `${p.name} · ${p.note}`;
				}
			}

			function ideaButton(text, tag, target) {
				const b = document.createElement('button');
				b.type = 'button';
				b.className = 'idea';
				const s = document.createElement('span');
				s.textContent = text;
				b.append(s);
				if (tag) {
					const em = document.createElement('em');
					em.textContent = tag;
					b.append(em);
				}
				b.addEventListener('click', () => {
					state[target] = text;
					syncForm();
					schedule();
					toast('已填入');
				});
				return b;
			}
			function renderIdeas() {
				if (!$('#ideasCard').open) return;
				const { H, S, C } = copyIdeas(state);
				const fill = (el, list, target, empty) => {
					el.replaceChildren(...list.map((x) => (typeof x === 'string' ? ideaButton(x, '', target) : ideaButton(x.text, x.tag, target))));
					if (!list.length) {
						const p = document.createElement('p');
						p.className = 'muted';
						p.textContent = empty;
						el.append(p);
					}
				};
				fill($('#ideasH'), H, 'headline', '填写产品名、卖点、人群或痛点后自动生成');
				fill($('#ideasS'), S, 'sub', '至少填写两条卖点后自动生成');
				fill($('#ideasC'), C, 'cta', '');
			}

			let listing = { title: '', body: '' };
			function renderListing() {
				listing = listingCopy(state);
				$('#listingKind').textContent = listing.kind;
				$('#listingTitle').textContent = listing.title || '—';
				$('#listingTitleNote').textContent = listing.titleNote;
				$('#listingPriceRow').hidden = !listing.price;
				$('#listingPrice').textContent = listing.price;
				const body = $('#listingBody');
				if (body.value !== listing.body) body.value = listing.body;
				$('#listingHint').textContent =
					state.lang === 'en'
						? 'Facebook Marketplace：第一张图建议用干净的实拍图，本页生成的广告图放第二张；分类选对、价格与图中一致。'
						: '小红书：封面用 3:4 尺寸；标题控制在 20 字内，正文末尾的话题标签可按需增删。';
			}

			function renderCompliance() {
				const hits = complianceHits(state);
				const list = $('#hits');
				list.replaceChildren();
				const badge = $('#riskBadge');
				const line = $('#riskLine');
				if (!hits.length) {
					const li = document.createElement('li');
					li.className = 'ok';
					li.textContent = '✓ 未发现常见违规用语';
					list.append(li);
					badge.textContent = '通过';
					badge.className = 'pill ok';
					line.hidden = true;
					$('#fixAll').hidden = true;
					return;
				}
				for (const h of hits) {
					const li = document.createElement('li');
					li.className = h.rule.lv;
					const w = document.createElement('b');
					w.textContent = `「${h.word}」`;
					const meta = document.createElement('span');
					meta.textContent = `${h.label} · ${h.rule.why}`;
					const fix = document.createElement('small');
					fix.textContent =
						h.rule.fix === undefined ? '建议人工改写' : h.rule.fix === '' ? '建议删除' : `建议改为「${h.rule.fix}」`;
					li.append(w, meta, fix);
					list.append(li);
				}
				const high = hits.filter((h) => h.rule.lv === 'high').length;
				badge.textContent = `${hits.length} 处`;
				badge.className = `pill ${high ? 'bad' : 'warn'}`;
				line.hidden = false;
				line.className = `risk-line ${high ? 'bad' : 'warn'}`;
				line.textContent = `⚠ 画面文字中有 ${hits.length} 处可能违规或误导的表述，建议导出前在「⑥ 合规自查」中修改。`;
				$('#fixAll').hidden = !hits.some((h) => h.rule.fix !== undefined);
			}

			function updateOutputs() {
				for (const o of $$('output[data-out]')) o.textContent = `${state[o.dataset.out]}${o.dataset.out === 'imgScale' ? '%' : ''}`;
				$('#headCount').textContent = `${[...state.headline.replace(/\s/g, '')].length} 字`;
				$('#tolRow').classList.toggle('disabled', !state.removeBg || IMG.alpha || !IMG.src);
				$('[data-k="tol"]').disabled = !state.removeBg || IMG.alpha || !IMG.src;
				$('#customSize').hidden = state.preset !== 'custom';
				$('#fileName').textContent = IMG.src ? `当前：${IMG.name}` : '当前：示例包装（可替换）';
				$('#useSample').hidden = !IMG.src;
			}

			let saveTimer = 0;
			function save() {
				clearTimeout(saveTimer);
				saveTimer = setTimeout(() => {
					try {
						localStorage.setItem(STORE_KEY, JSON.stringify(store));
					} catch {}
				}, 300);
			}

			let pending = false;
			function schedule() {
				if (pending) return;
				pending = true;
				requestAnimationFrame(renderAll);
			}
			function renderAll() {
				pending = false;
				const p = currentPreset();
				if (canvas.width !== p.w || canvas.height !== p.h) {
					canvas.width = p.w;
					canvas.height = p.h;
				}
				render(canvas.getContext('2d'), p.w, p.h, state, 1);
				renderThumbs();
				renderIdeas();
				renderListing();
				renderCompliance();
				for (const b of $$('#versions [data-v]')) b.setAttribute('aria-selected', String(b.dataset.v === store.active));
				updateOutputs();
				updatePip();
				save();
			}

			// 表单输入
			document.addEventListener('input', (e) => {
				const el = e.target;
				if (!(el instanceof HTMLElement)) return;
				if (el.matches('input[name="theme"]')) {
					state.theme = el.value;
					state.accent = THEMES[el.value].accent;
					syncForm();
					schedule();
					return;
				}
				const k = el.dataset.k;
				if (!k) return;
				const v = el.type === 'checkbox' ? el.checked : el.type === 'range' ? +el.value : el.value;
				state[k] = typeof DEFAULTS.zh[k] === 'number' && el.type !== 'checkbox' ? +v || 0 : v;
				if (k === 'removeBg' || k === 'tol') processImage();
				schedule();
			});
			$('#ideasCard').addEventListener('toggle', schedule);
			$('#accentReset').addEventListener('click', () => {
				state.accent = THEMES[state.theme].accent;
				syncForm();
				schedule();
			});
			$('#fixAll').addEventListener('click', () => {
				const n = autofix(state);
				syncForm();
				schedule();
				toast(n ? `已替换 ${n} 处` : '没有可自动替换的词');
			});
			$('#reset').addEventListener('click', () => {
				if (!confirm('恢复当前版本的示例内容？当前版本填写的文字和设置会被覆盖。')) return;
				state = store[store.active] = { ...DEFAULTS[store.active] };
				IMG.src = IMG.proc = null;
				IMG.alpha = false;
				syncForm();
				schedule();
			});
			for (const b of $$('#versions [data-v]')) {
				b.addEventListener('click', () => {
					if (store.active === b.dataset.v) return;
					store.active = b.dataset.v;
					state = store[store.active];
					syncForm();
					processImage();
					schedule();
				});
			}
			for (const b of $$('[data-copy]')) {
				b.addEventListener('click', async () => {
					const what = b.dataset.copy;
					const text = what === 'title' ? listing.title : what === 'body' ? listing.body : `${listing.title}\n\n${listing.body}`;
					try {
						await navigator.clipboard.writeText(text);
						toast('已复制');
					} catch {
						toast('复制失败，请手动选择文字');
					}
				});
			}

			// 产品图：上传 / 拖拽 / 粘贴
			async function loadFile(file) {
				if (!file || !/^image\//.test(file.type)) {
					toast('请选择图片文件');
					return;
				}
				const url = URL.createObjectURL(file);
				try {
					const im = new Image();
					im.src = url;
					await im.decode();
					const MAX = 1400;
					const s = Math.min(1, MAX / Math.max(im.naturalWidth, im.naturalHeight));
					const cv = makeCanvas(im.naturalWidth * s, im.naturalHeight * s);
					cv.getContext('2d').drawImage(im, 0, 0, cv.width, cv.height);
					const info = borderInfo(cv);
					IMG.src = cv;
					IMG.name = file.name || '粘贴的图片';
					IMG.alpha = info.alpha;
					// 边缘是均匀的浅色背景时自动抠图
					const light = info.ref.reduce((a, b) => a + b, 0) / 3 > 200;
					if (!info.alpha && info.uniform > 0.85 && light && !state.removeBg) {
						state.removeBg = true;
						syncForm();
						toast('检测到纯色背景，已自动抠图（可在「产品图」中关闭）');
					}
					processImage();
					schedule();
				} catch {
					toast('图片读取失败，请换一张试试');
				} finally {
					URL.revokeObjectURL(url);
				}
			}
			$('#file').addEventListener('change', (e) => {
				const f = e.target.files && e.target.files[0];
				if (f) loadFile(f);
				e.target.value = '';
			});
			$('#useSample').addEventListener('click', () => {
				IMG.src = IMG.proc = null;
				IMG.alpha = false;
				schedule();
			});
			let dragDepth = 0;
			document.addEventListener('dragenter', (e) => {
				if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) {
					dragDepth++;
					stage.classList.add('drag');
				}
			});
			document.addEventListener('dragleave', () => {
				dragDepth = Math.max(0, dragDepth - 1);
				if (!dragDepth) stage.classList.remove('drag');
			});
			document.addEventListener('dragover', (e) => e.preventDefault());
			document.addEventListener('drop', (e) => {
				e.preventDefault();
				dragDepth = 0;
				stage.classList.remove('drag');
				const f = e.dataTransfer && e.dataTransfer.files[0];
				if (f) loadFile(f);
			});
			document.addEventListener('paste', (e) => {
				const item = [...(e.clipboardData ? e.clipboardData.items : [])].find((i) => i.type.startsWith('image/'));
				if (item) {
					e.preventDefault();
					loadFile(item.getAsFile());
				}
			});

			// 导出
			const safeName = (s) => String(s || 'ad').trim().replace(/[\\/:*?"<>|\s]+/g, '-').slice(0, 40) || 'ad';
			function renderBlob(p) {
				const cv = makeCanvas(p.w, p.h);
				render(cv.getContext('2d'), p.w, p.h, state, 1);
				const jpg = state.format === 'jpg';
				return new Promise((res) => cv.toBlob(res, jpg ? 'image/jpeg' : 'image/png', 0.92));
			}
			function download(blob, name) {
				const a = document.createElement('a');
				a.href = URL.createObjectURL(blob);
				a.download = name;
				document.body.append(a);
				a.click();
				a.remove();
				setTimeout(() => URL.revokeObjectURL(a.href), 5000);
			}
			const kb = (n) => (n > 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.round(n / 1024)} KB`);
			async function exportPreset(p) {
				const blob = await renderBlob(p);
				if (!blob) throw new Error('export failed');
				const ext = state.format === 'jpg' ? 'jpg' : 'png';
				download(blob, `${safeName(state.product || state.headline)}-${state.lang}-${p.key}-${p.w}x${p.h}.${ext}`);
				return blob;
			}
			$('#dl').addEventListener('click', async () => {
				try {
					const p = currentPreset();
					const blob = await exportPreset(p);
					const big = p.key === 'main' && blob.size > 3 * 1024 * 1024 ? '（超过 3MB，主图建议改用 JPG）' : '';
					toast(`已导出 ${p.w}×${p.h}，${kb(blob.size)}${big}`);
				} catch {
					toast('导出失败');
				}
			});
			$('#dlAll').addEventListener('click', async () => {
				const list = allPresets().filter((p) => p.key !== 'custom' || state.preset === 'custom');
				try {
					for (const p of list) {
						await exportPreset(p);
						await new Promise((r) => setTimeout(r, 350));
					}
					toast(`已导出 ${list.length} 张（浏览器若询问“允许下载多个文件”，请选择允许）`);
				} catch {
					toast('导出失败');
				}
			});
			const canCopy = !!(navigator.clipboard && window.ClipboardItem);
			$('#copyImg').hidden = !canCopy;
			$('#copyImg').addEventListener('click', async () => {
				try {
					const p = currentPreset();
					const cv = makeCanvas(p.w, p.h);
					render(cv.getContext('2d'), p.w, p.h, state, 1);
					const blob = new Promise((res) => cv.toBlob(res, 'image/png'));
					await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
					toast('图片已复制到剪贴板');
				} catch {
					toast('当前浏览器不支持复制图片，请使用下载');
				}
			});

			// 手机端：预览区滚出屏幕时显示悬浮小预览
			const pip = $('#pip');
			const pipCv = $('#pipCanvas');
			let stageVisible = true;
			function updatePip() {
				const show = !stageVisible && window.matchMedia('(max-width: 960px)').matches;
				pip.hidden = !show;
				if (!show) return;
				const s = Math.min(240 / canvas.width, 240 / canvas.height);
				pipCv.width = Math.round(canvas.width * s);
				pipCv.height = Math.round(canvas.height * s);
				pipCv.getContext('2d').drawImage(canvas, 0, 0, pipCv.width, pipCv.height);
			}
			if ('IntersectionObserver' in window) {
				new IntersectionObserver((entries) => {
					stageVisible = entries[0].isIntersecting;
					updatePip();
				}).observe(canvas);
			}
			pip.addEventListener('click', () => stage.scrollIntoView({ behavior: 'smooth', block: 'center' }));

			// 提示
			let toastTimer = 0;
			function toast(msg) {
				const t = $('#toast');
				t.textContent = msg;
				t.classList.add('show');
				clearTimeout(toastTimer);
				toastTimer = setTimeout(() => t.classList.remove('show'), 2600);
			}

			syncForm();
			processImage();
			schedule();
		</script>

