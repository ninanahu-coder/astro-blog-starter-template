---
// 电商产品广告制作工具 — 纯前端，全部在浏览器本地完成（产品图不会上传到任何服务器）。
// 填写产品信息 + 上传产品图 → 一键生成主图 / 小红书 / 抖音 / 信息流 / 店铺横幅等多尺寸广告图并导出，
// 附带公式化文案灵感与《广告法》极限词自查。
const title = '电商广告制作 · Ad Studio';
const description =
	'在线制作电商产品广告图：淘宝/京东主图、小红书、抖音竖版、信息流与店铺横幅多尺寸一键导出，支持抠图、风格模板、文案灵感与广告法极限词自查。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#ff5b2e" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
	</head>
	<body>
		<header class="topbar">
			<a class="back" href="/" aria-label="返回首页">‹ 首页</a>
			<h1>电商广告制作 <small>Ad Studio</small></h1>
			<button type="button" id="reset" class="ghost small">恢复示例</button>
		</header>

		<main class="app">
			<section class="preview" aria-label="广告预览">
				<div class="versions" id="versions" role="tablist" aria-label="版本（各自保存文字与设置）">
					<button type="button" role="tab" data-v="zh">中文 · 小红书</button>
					<button type="button" role="tab" data-v="en">English · Facebook</button>
				</div>
				<div class="sizes" id="sizes" role="listbox" aria-label="选择尺寸"></div>
				<div class="custom-size" id="customSize" hidden>
					<label>宽 <input type="number" data-k="cw" min="200" max="3000" step="10" /></label>
					<span>×</span>
					<label>高 <input type="number" data-k="ch" min="200" max="3000" step="10" /></label>
					<span class="muted">px</span>
				</div>
				<div class="stage" id="stage">
					<canvas id="canvas" width="800" height="800" aria-label="广告图预览"></canvas>
					<div class="drop-hint">松开即可替换产品图</div>
				</div>
				<div class="exportbar">
					<select data-k="format" aria-label="导出格式">
						<option value="png">PNG</option>
						<option value="jpg">JPG</option>
					</select>
					<button type="button" id="dl" class="primary">下载当前尺寸</button>
					<button type="button" id="dlAll">导出全部尺寸</button>
					<button type="button" id="copyImg">复制图片</button>
				</div>
				<p class="risk-line" id="riskLine" hidden></p>
			</section>

			<section class="controls" aria-label="编辑">
				<details class="card" open>
					<summary>① 产品信息</summary>
					<div class="card-body">
						<div class="grid2">
							<label>品牌名<input data-k="brand" maxlength="20" /></label>
							<label>产品名（简短）<input data-k="product" maxlength="20" /></label>
						</div>
						<label
							>主标题 <span class="count" id="headCount"></span>
							<textarea data-k="headline" rows="2" maxlength="40"></textarea>
						</label>
						<label>副标题<input data-k="sub" maxlength="40" /></label>
						<label
							>核心卖点（每行一条，最多 4 条）
							<textarea data-k="points" rows="4"></textarea>
						</label>
						<div class="grid3">
							<label>价格前缀<input data-k="prefix" maxlength="6" /></label>
							<label>现价<input data-k="price" inputmode="decimal" maxlength="10" /></label>
							<label>原价<input data-k="orig" inputmode="decimal" maxlength="10" /></label>
						</div>
						<div class="grid2">
							<label
								>货币
								<select data-k="currency">
									<option value="¥">¥ 人民币</option>
									<option value="$">$ 美元</option>
									<option value="A$">A$ 澳元</option>
									<option value="€">€ 欧元</option>
									<option value="£">£ 英镑</option>
								</select>
							</label>
							<label>促销角标<input data-k="badge" maxlength="10" /></label>
						</div>
						<div class="grid2">
							<label>按钮文字<input data-k="cta" maxlength="10" /></label>
							<label>底部说明<input data-k="note" maxlength="30" /></label>
						</div>
						<p class="hint">任一项留空，该元素就不会出现在画面上。</p>
					</div>
				</details>

				<details class="card" open>
					<summary>② 产品图</summary>
					<div class="card-body">
						<div class="upload">
							<label class="file-btn">
								<input type="file" id="file" accept="image/*" />
								上传产品图
							</label>
							<button type="button" id="useSample" class="ghost">用示例图</button>
							<span id="fileName" class="muted"></span>
						</div>
						<p class="hint">也可以把图片直接拖到预览区，或按 Ctrl/⌘+V 粘贴。白底或纯色底的产品图效果最好。</p>
						<label class="check"><input type="checkbox" data-k="removeBg" /> 去除纯色背景（抠图）</label>
						<label class="range" id="tolRow"
							>抠图容差 <output data-out="tol"></output>
							<input type="range" data-k="tol" min="8" max="90" />
						</label>
						<label class="range"
							>产品大小 <output data-out="imgScale"></output>
							<input type="range" data-k="imgScale" min="50" max="140" />
						</label>
					</div>
				</details>

				<details class="card" open>
					<summary>③ 风格模板</summary>
					<div class="card-body">
						<div class="themes" id="themes" role="radiogroup" aria-label="风格模板"></div>
						<div class="row">
							<label class="color">主色 <input type="color" data-k="accent" /></label>
							<button type="button" id="accentReset" class="ghost small">恢复模板色</button>
						</div>
					</div>
				</details>

				<details class="card" id="ideasCard">
					<summary>④ 文案助手</summary>
					<div class="card-body">
						<div class="grid2">
							<label>目标人群<input data-k="audience" maxlength="16" /></label>
							<label>用户痛点<input data-k="pain" maxlength="20" /></label>
						</div>
						<h4>主标题灵感 <span class="muted">点击填入</span></h4>
						<div class="ideas" id="ideasH"></div>
						<h4>副标题灵感</h4>
						<div class="ideas" id="ideasS"></div>
						<h4>按钮文字</h4>
						<div class="ideas chips" id="ideasC"></div>
						<p class="hint">按常见电商文案公式（痛点 / 利益 / 人群 / 数字 / 价格）自动组合，仅作灵感参考。</p>
					</div>
				</details>

				<details class="card" id="listingCard" open>
					<summary>⑤ 发布文案 <span id="listingKind" class="pill ok"></span></summary>
					<div class="card-body">
						<div class="grid2">
							<label>所在地区<input data-k="region" maxlength="40" /></label>
							<label>交易方式<input data-k="delivery" maxlength="40" /></label>
						</div>
						<div class="listing">
							<div class="listing-head">
								<b>标题</b>
								<span class="muted" id="listingTitleNote"></span>
								<button type="button" class="ghost small" data-copy="title">复制</button>
							</div>
							<output id="listingTitle"></output>
							<div class="listing-head" id="listingPriceRow">
								<b>价格</b>
								<output id="listingPrice"></output>
							</div>
							<div class="listing-head">
								<b>正文</b>
								<button type="button" class="ghost small" data-copy="body">复制</button>
							</div>
							<textarea id="listingBody" rows="12" readonly></textarea>
							<button type="button" data-copy="all">复制标题 + 正文</button>
						</div>
						<p class="hint" id="listingHint"></p>
					</div>
				</details>

				<details class="card" id="complianceCard" open>
					<summary>⑥ 合规自查 <span id="riskBadge" class="pill"></span></summary>
					<div class="card-body">
						<p class="hint">
							中文检查《广告法》极限词、绝对化用语、医疗功效、权威背书与虚假紧迫表述；英文检查澳洲消费者法（ACL）下常见的误导性宣传。结果仅供参考，不构成法律意见。
						</p>
						<ul class="hits" id="hits"></ul>
						<button type="button" id="fixAll" hidden>一键替换可替换项</button>
					</div>
				</details>

				<p class="footnote">所有处理都在你的浏览器本地完成，产品图不会被上传。</p>
			</section>
		</main>

		<button type="button" class="pip" id="pip" hidden aria-label="回到预览"><canvas id="pipCanvas"></canvas></button>
		<div class="toast" id="toast" role="status" aria-live="polite"></div>

		<script>
			// ============================================================
			// 基础工具
			// ============================================================
			const $ = (s, r = document) => r.querySelector(s);
			const $$ = (s, r = document) => [...r.querySelectorAll(s)];
			const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
			const makeCanvas = (w, h) => {
				const c = document.createElement('canvas');
				c.width = Math.max(1, Math.round(w));
				c.height = Math.max(1, Math.round(h));
				return c;
			};
			const SANS =
				'"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC","Source Han Sans SC","WenQuanYi Zen Hei",system-ui,sans-serif';
			const SERIF = '"Songti SC","STSong","Noto Serif CJK SC","Source Han Serif SC","SimSun",' + SANS;

			function hex2rgb(h) {
				h = String(h || '#000').replace('#', '');
				if (h.length === 3) h = h.split('').map((x) => x + x).join('');
				const n = parseInt(h, 16) || 0;
				return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
			}
			const rgb2hex = (c) =>
				'#' + c.map((v) => Math.round(clamp(v, 0, 255)).toString(16).padStart(2, '0')).join('');
			const mix = (a, b, t) => {
				const A = hex2rgb(a), B = hex2rgb(b);
				return rgb2hex(A.map((v, i) => v + (B[i] - v) * t));
			};
			const lighten = (h, t) => mix(h, '#ffffff', t);
			const darken = (h, t) => mix(h, '#000000', t);
			const rgba = (h, a) => {
				const [r, g, b] = hex2rgb(h);
				return `rgba(${r},${g},${b},${a})`;
			};
			const luminance = (h) => {
				const [r, g, b] = hex2rgb(h).map((v) => {
					v /= 255;
					return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
				});
				return 0.2126 * r + 0.7152 * g + 0.0722 * b;
			};
			const onColor = (h) => (luminance(h) > 0.45 ? '#141414' : '#ffffff');

			function mulberry32(a) {
				return function () {
					a |= 0;
					a = (a + 0x6d2b79f5) | 0;
					let t = Math.imul(a ^ (a >>> 15), 1 | a);
					t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
					return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
				};
			}

			// 画布阴影参数不受 transform 影响，缩略图渲染时需要按比例缩放
			let SK = 1;

			// ============================================================
			// 图形工具
			// ============================================================
			function rr(ctx, x, y, w, h, r) {
				r = Math.max(0, Math.min(r, w / 2, h / 2));
				ctx.beginPath();
				ctx.moveTo(x + r, y);
				ctx.arcTo(x + w, y, x + w, y + h, r);
				ctx.arcTo(x + w, y + h, x, y + h, r);
				ctx.arcTo(x, y + h, x, y, r);
				ctx.arcTo(x, y, x + w, y, r);
				ctx.closePath();
			}
			function paint(ctx, fill, y0, y1) {
				if (Array.isArray(fill)) {
					const g = ctx.createLinearGradient(0, y0, 0, y1);
					fill.forEach((c, i) => g.addColorStop(i / (fill.length - 1), c));
					return g;
				}
				return fill;
			}
			function checkIcon(ctx, cx, cy, r, bg, fg) {
				ctx.beginPath();
				ctx.arc(cx, cy, r, 0, Math.PI * 2);
				ctx.fillStyle = bg;
				ctx.fill();
				ctx.beginPath();
				ctx.moveTo(cx - r * 0.45, cy + r * 0.02);
				ctx.lineTo(cx - r * 0.1, cy + r * 0.36);
				ctx.lineTo(cx + r * 0.48, cy - r * 0.32);
				ctx.strokeStyle = fg;
				ctx.lineWidth = r * 0.26;
				ctx.lineCap = 'round';
				ctx.lineJoin = 'round';
				ctx.stroke();
			}
			function paw(ctx, x, y, s, rot, fill) {
				ctx.save();
				ctx.translate(x, y);
				ctx.rotate(rot);
				ctx.fillStyle = fill;
				ctx.beginPath();
				ctx.ellipse(0, s * 0.28, s * 0.42, s * 0.34, 0, 0, Math.PI * 2);
				ctx.fill();
				for (const [tx, ty, a] of [
					[-0.46, -0.14, -0.35],
					[-0.17, -0.42, -0.1],
					[0.17, -0.42, 0.1],
					[0.46, -0.14, 0.35],
				]) {
					ctx.beginPath();
					ctx.ellipse(tx * s, ty * s, s * 0.15, s * 0.2, a, 0, Math.PI * 2);
					ctx.fill();
				}
				ctx.restore();
			}
			function leaf(ctx, x, y, len, rot, fill, vein) {
				ctx.save();
				ctx.translate(x, y);
				ctx.rotate(rot);
				ctx.beginPath();
				ctx.moveTo(0, 0);
				ctx.quadraticCurveTo(len * 0.5, -len * 0.34, len, 0);
				ctx.quadraticCurveTo(len * 0.5, len * 0.34, 0, 0);
				ctx.fillStyle = fill;
				ctx.fill();
				ctx.beginPath();
				ctx.moveTo(len * 0.06, 0);
				ctx.lineTo(len * 0.9, 0);
				ctx.strokeStyle = vein;
				ctx.lineWidth = len * 0.025;
				ctx.stroke();
				ctx.restore();
			}
			function starPath(ctx, cx, cy, r, n, inner, rot) {
				ctx.beginPath();
				for (let i = 0; i < n * 2; i++) {
					const a = rot + (i * Math.PI) / n;
					const rad = i % 2 ? r * inner : r;
					ctx.lineTo(cx + Math.cos(a) * rad, cy + Math.sin(a) * rad);
				}
				ctx.closePath();
			}
			function podium(ctx, cx, topY, w, top, side, edge) {
				const rx = w / 2, ry = w * 0.12, depth = ry * 1.25;
				ctx.save();
				ctx.fillStyle = paint(ctx, side, topY, topY + depth + ry);
				ctx.fillRect(cx - rx, topY, w, depth);
				ctx.beginPath();
				ctx.ellipse(cx, topY + depth, rx, ry, 0, 0, Math.PI * 2);
				ctx.fill();
				ctx.beginPath();
				ctx.ellipse(cx, topY, rx, ry, 0, 0, Math.PI * 2);
				ctx.fillStyle = paint(ctx, top, topY - ry, topY + ry);
				ctx.fill();
				if (edge) {
					ctx.strokeStyle = edge;
					ctx.lineWidth = Math.max(1, w * 0.006);
					ctx.stroke();
				}
				ctx.restore();
				return ry;
			}

			// ============================================================
			// 文字排版：中英混排换行、自动缩放、行宽均衡
			// ============================================================
			const NO_START = '，。！？、；：）」』】》,.!?;:)…%～~—-';
			const TOKEN_RE = /[A-Za-z0-9¥$€£%.,'’+\-&\/×]+|\s+|[\s\S]/gu;
			const LATIN_RE = /^[A-Za-z0-9¥$€£%.,'’+\-&\/×]+$/;
			// 有分词能力的浏览器按词断行（避免「冻|干」这类拆词），英文单词与价格保持整体
			const SEG = typeof Intl !== 'undefined' && Intl.Segmenter ? new Intl.Segmenter('zh', { granularity: 'word' }) : null;
			const tokenCache = new Map();
			function tokenize(s) {
				if (!SEG) return s.match(TOKEN_RE) || [];
				let out = tokenCache.get(s);
				if (out) return out;
				out = [];
				for (const { segment } of SEG.segment(s)) {
					const prev = out[out.length - 1];
					if (prev !== undefined && LATIN_RE.test(prev) && LATIN_RE.test(segment)) out[out.length - 1] = prev + segment;
					else out.push(segment);
				}
				if (tokenCache.size > 500) tokenCache.clear();
				tokenCache.set(s, out);
				return out;
			}
			function wrap(ctx, text, maxW) {
				const out = [];
				for (const para of String(text).split('\n')) {
					let line = '';
					for (const tok of tokenize(para)) {
						const blank = /^\s+$/.test(tok);
						if (!line && blank) continue;
						const test = line + tok;
						if (ctx.measureText(test).width <= maxW) {
							line = test;
							continue;
						}
						if (blank) {
							out.push(line.trimEnd());
							line = '';
							continue;
						}
						// 行首禁则：标点挂在上一行末尾
						if (tok.length === 1 && NO_START.includes(tok) && line) {
							line = test;
							continue;
						}
						if (line.trim()) out.push(line.trimEnd());
						if (ctx.measureText(tok).width > maxW) {
							line = '';
							for (const ch of tok) {
								if (line && ctx.measureText(line + ch).width > maxW) {
									out.push(line);
									line = ch;
								} else line += ch;
							}
						} else line = tok;
					}
					if (line.trim()) out.push(line.trimEnd());
				}
				return out.length ? out : [''];
			}
			function clip(ctx, s, maxW) {
				if (ctx.measureText(s).width <= maxW) return s;
				let chars = [...s];
				while (chars.length && ctx.measureText(chars.join('') + '…').width > maxW) chars.pop();
				return chars.join('') + '…';
			}
			function fitText(ctx, text, maxW, maxLines, size, minSize, weight, family, balance) {
				text = String(text || '').trim();
				if (!text) return null;
				let s = size, lines;
				for (;;) {
					ctx.font = `${weight} ${s}px ${family}`;
					lines = wrap(ctx, text, maxW);
					if (lines.length <= maxLines || s <= minSize) break;
					s = Math.max(minSize, s * 0.93);
				}
				// 标题：若缩小不超过 20% 就能少占一行，优先少行（避免中文被拆词换行）
				if (balance && lines.length > 1 && lines.length <= maxLines && !text.includes('\n')) {
					for (let s2 = s * 0.95; s2 >= Math.max(minSize, size * 0.8); s2 *= 0.95) {
						ctx.font = `${weight} ${s2}px ${family}`;
						const l2 = wrap(ctx, text, maxW);
						if (l2.length < lines.length) {
							s = s2;
							lines = l2;
							if (l2.length === 1) break;
						}
					}
					ctx.font = `${weight} ${s}px ${family}`;
				}
				if (lines.length > maxLines) {
					lines = lines.slice(0, maxLines);
					const chars = [...lines[maxLines - 1]];
					while (chars.length && ctx.measureText(chars.join('') + '…').width > maxW) chars.pop();
					lines[maxLines - 1] = chars.join('') + '…';
				} else if (balance && lines.length > 1 && !text.includes('\n')) {
					const widest = Math.max(...tokenize(text).map((t) => ctx.measureText(t).width));
					let lo = Math.min(maxW, Math.max(maxW * 0.4, widest)), hi = maxW;
					for (let i = 0; i < 10; i++) {
						const mid = (lo + hi) / 2;
						if (wrap(ctx, text, mid).length <= lines.length) hi = mid;
						else lo = mid;
					}
					lines = wrap(ctx, text, hi);
				}
				return { lines, size: s, font: ctx.font };
			}

			// ============================================================
			// 风格模板
			// ============================================================
			const THEMES = {
				promo: {
					name: '大促爆款',
					accent: '#e3262f',
					swatch: (a) => [lighten(a, 0.1), '#ffd84d'],
					badge: 'burst',
					align: 'center',
					head: SANS,
					headW: 900,
					chip: 'pill',
					barR: 0.28,
					pouch: (a) => ['#ffc93a', a],
					make: (a) => ({
						bg: [lighten(a, 0.1), darken(a, 0.3)],
						ray: 'rgba(255,255,255,.075)',
						glow: 'rgba(255,226,140,.55)',
						confetti: ['#ffd84d', '#fff3c4', '#ffb23a'],
						headline: ['#ffffff', '#ffe08a'],
						headShadow: rgba(darken(a, 0.6), 0.55),
						sub: '#ffe9b0',
						brand: 'rgba(255,255,255,.92)',
						chipBg: '#fff4cf',
						chipText: darken(a, 0.3),
						icon: a,
