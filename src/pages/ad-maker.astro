			const cityOf = (region) => CITIES.find(([re]) => re.test(region || '')) || null;
			const tagify = (s) => String(s || '').replace(/[\s#·|｜,，、.。!！?？:：'"“”()（）\-]+/g, '');

			// 平台发布文案：中文 → 小红书笔记；English → Facebook Marketplace
			function listingCopy(st) {
				const P = (st.product || '').trim() || st.headline.trim();
