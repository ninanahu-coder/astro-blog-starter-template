				else if (badge) lines.push(`🎁 ${badge}`);
				if (region || delivery) lines.push(`📍 ${[region, delivery].filter(Boolean).join('｜')}`);
				if (st.note.trim()) lines.push(`📦 ${st.note.trim()}`);
				lines.push('', cta && /私信|咨询|联系/.test(cta) ? `👉 ${cta}～` : `${cta ? `👉 ${cta}，` : ''}感兴趣的宝子私信我～`);
				const tags = ['澳洲生活', '澳洲华人', city ? `${city[1]}华人` : '', city ? `${city[1]}生活` : '', P, A, B]
					.map(tagify)
					.filter(Boolean);
				lines.push('', [...new Set(tags)].map((t) => `#${t}`).join(' '));
				return { kind: '小红书笔记', title, titleNote: `${[...title].length}/20 字`, price: '', body: lines.join('\n') };
