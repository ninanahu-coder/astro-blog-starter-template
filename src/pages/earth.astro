---
// 「地球人生 / Terra Life」第一阶段客户端：西澳大利亚。
// 手机优先的单页应用；规则在 src/game/core/engine.ts（纯函数），本页只负责渲染、输入、同步。
const title = '地球人生 · 西澳';
const description = '在真实地图上生活的在线人生模拟：出行、打工、探索，到达地点触发事件，多端云同步。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#f5f2ec" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#12171d" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href="/earth/icon.svg" />
		<link rel="manifest" href="/earth/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/earth/icon-180.png" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="地球人生" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<div id="app">
			<section id="create" class="hidden">
				<div class="cover">
					<img src="/earth/icon.svg" alt="" width="64" height="64" />
					<h1>地球人生</h1>
					<p class="sub">在真实的西澳大利亚过另一种人生</p>
					<ul class="points">
						<li><b>真实地图</b>18 个西澳地点，出行、打工、租房买房</li>
						<li><b>人到现场</b>本人走进真实的餐馆、健身房、公园，游戏里也能做事</li>
						<li><b>多端同步</b>手机电脑用同一个存档，和同地点的玩家聊天</li>
					</ul>
				</div>
				<label class="field"><span class="step">1</span>名字<input id="c-name" maxlength="12" placeholder="给自己起个名字" autocomplete="off" /></label>
				<div class="field"><span class="step">2</span>形象<div id="c-avatars" class="chips"></div></div>
				<div class="field"><span class="step">3</span>出身<div id="c-origins"></div></div>
				<div class="field"><span class="step">4</span>性格特质（选 2 个）<div id="c-traits" class="chips"></div></div>
				<button id="c-start" class="primary">开始生活</button>
				<details class="import">
					<summary>已有存档？用同步码恢复</summary>
					<input id="c-code" placeholder="粘贴同步码" aria-label="同步码" autocomplete="off" />
					<button id="c-import">从云端恢复</button>
				</details>
			</section>

			<section id="game" class="hidden">
				<header id="hud"></header>
				<div id="map-wrap"><svg id="map" role="img" aria-label="西澳地图：点地点看去那里的走法；下面的列表是同样的内容"></svg></div>
				<nav id="tabs"></nav>
				<main id="panel" tabindex="-1" aria-live="off"></main>
			</section>
		</div>
		<div id="modal" class="hidden"></div>
		<div id="toast" class="hidden" role="status" aria-live="polite"></div>

		<style is:global>
			:root {
				--bg: #f5f2ec; --card: #ffffff; --card2: #fbfaf7; --line: #e4ded4; --text: #17212b; --dim: #5b6672;
				--accent: #1d5fd1; --accent-ink: #ffffff; --warm: #c2541b; --warm-bg: #fff6ef; --ink: #17212b; --ink-dim: #c9d2db;
				--ocean: #dce8f2; --land: #efe3cc; --ok: #2e8b57; --mid: #b7791f; --bad: #c23b3b; --soft: #ece7de;
				--nav-h: 64px;
				--text2: #3a4550; --shadow: rgba(23, 33, 43, 0.06); --halo: rgba(255, 255, 255, 0.85); --land-line: #d9c7a6; --seg-bg: #e9e3d8; --tick-line: #c9c1b4;
				--tint-blue: #eef3fb; --tint-blue-ink: #1d4fa8; --tint-green: #e6f2ea; --tint-green-ink: #1f6b40; --tint-amber: #fbf0dc; --tint-amber-ink: #7a4f0f;
				--sky-dawn: #f8ede2; --sky-dusk: #f7e6dc; --sky-night: #e9edf5;
				--ocean-night: #1e3350; --land-night: #354058; --land-night-line: #4b5875; --map-night-text: #eef2f7; --map-night-halo: rgba(10, 16, 28, 0.8);
				--tint-red: #fbe4e4; --tint-red-ink: #9b2c2c; --tint-cost: #fdede3; --tint-cost-ink: #a2400f; --warm-line: #f2cdb4; --low-ink: #a62f2f; --mid-ink: #8a5a12;
				color-scheme: light;
			}
			/* 深色：跟随系统设置。主色换成浅蓝，按钮上的字换成深色，保证对比度 */
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #12171d; --card: #1b232c; --card2: #212b35; --line: #2f3a46; --text: #e8edf2; --dim: #9aa6b2;
					--accent: #7fb0ff; --accent-ink: #0d1b33; --warm: #f08a4b; --warm-bg: #2a2018; --ink: #24313d; --ink-dim: #c9d2db;
					--ocean: #13283a; --land: #2b2a24; --ok: #4ecb8f; --mid: #e0a23a; --bad: #ef6464; --soft: #2a333d;
					--text2: #c3ccd5; --shadow: rgba(0, 0, 0, 0.3); --halo: rgba(0, 0, 0, 0.75); --land-line: #4a4436; --seg-bg: #232c36; --tick-line: #4a5562;
					--tint-blue: #1c2a40; --tint-blue-ink: #a9c7ff; --tint-green: #17301f; --tint-green-ink: #8fe0b0; --tint-amber: #3a2c12; --tint-amber-ink: #f0c674;
					--sky-dawn: #1f1b19; --sky-dusk: #221a1b; --sky-night: #0d1220;
					--ocean-night: #0a1522; --land-night: #1c2029; --land-night-line: #2c3240; --map-night-text: #e8edf2; --map-night-halo: rgba(0, 0, 0, 0.8);
					--tint-red: #3a1c1c; --tint-red-ink: #ffaaaa; --tint-cost: #3a2216; --tint-cost-ink: #ffb385; --warm-line: #5a3a24; --low-ink: #ff9a9a; --mid-ink: #f0c674;
					color-scheme: dark;
				}
			}
			* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
			html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; }
			#app { max-width: 560px; margin: 0 auto; min-height: 100dvh; display: flex; flex-direction: column; }
			.hidden { display: none !important; }
			/* 字号（设置页，只在本机）：整页按比例放大 */
			html.fs-l #app, html.fs-l #modal .sheet, html.fs-l #toast { zoom: 1.12; }
			html.fs-xl #app, html.fs-xl #modal .sheet, html.fs-xl #toast { zoom: 1.25; }
			/* 减少动画（设置页「减少」，或「跟随系统」且系统要求减少动态效果）：关掉所有过渡和动画 */
			html.calm *, html.calm *::before, html.calm *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
			body.busy #panel, body.busy #modal { opacity: 0.6; pointer-events: none; }
			button { font: inherit; color: var(--text); background: var(--card2); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; min-height: 44px; cursor: pointer; }
			button:disabled { opacity: 0.5; cursor: not-allowed; }
			button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 700; }
			button:focus-visible, a:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			input { font: inherit; color: var(--text); background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 11px 14px; width: 100%; min-width: 0; min-height: 44px; }

			#create { padding: 28px 20px calc(28px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 16px; }
			#create h1 { margin: 10px 0 0; font-size: 30px; font-weight: 900; }
			.cover { background: var(--card); border-radius: 24px; padding: 22px 20px; box-shadow: 0 1px 2px var(--shadow); }
			.cover img { display: block; border-radius: 16px; }
			.cover .points { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
			.cover .points li { font-size: 14px; color: var(--dim); padding-left: 14px; border-left: 3px solid var(--accent); }
			.cover .points b { display: block; color: var(--text); font-size: 15px; }
			.field .step { display: inline-flex; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-size: 12px; font-weight: 700; align-items: center; justify-content: center; margin-right: 6px; }
			#c-start { min-height: 52px; font-size: 17px; }
			.sub { margin: 0; color: var(--dim); }
			.field { display: flex; flex-direction: column; gap: 8px; color: var(--dim); font-size: 13px; font-weight: 600; }
			.chips { display: flex; flex-wrap: wrap; gap: 8px; }
			.chip { font-size: 22px; padding: 6px 10px; background: var(--card); }
			.chip.on, .origin.on, .trait.on { border-color: var(--accent); background: var(--tint-blue); box-shadow: inset 0 0 0 1px var(--accent); }
			.origin { display: block; width: 100%; text-align: left; margin-bottom: 8px; background: var(--card); padding: 12px 14px; }
			.origin small { display: block; color: var(--dim); font-weight: 400; }
			.import { color: var(--dim); font-size: 13px; }
			#c-traits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
			.trait { font-size: 14px; padding: 10px 12px; text-align: left; background: var(--card); }
			.trait small { display: block; color: var(--dim); font-size: 12px; }
			.tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
			.tag { font-size: 13px; padding: 4px 10px; border-radius: 10px; background: var(--soft); color: var(--text); }
			.import input { margin: 8px 0; }

			#game { flex: 1; display: flex; flex-direction: column; min-height: 100dvh; }
			#hud { padding: calc(10px + env(safe-area-inset-top)) 16px 10px; background: var(--bg); position: sticky; top: 0; z-index: 5; border-bottom: 1px solid transparent; }
			.hud-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
			.hud-title { display: flex; flex-direction: column; min-width: 0; }
			.hud-sub { font-size: 12px; color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			#hud h1 { margin: 0; font-size: 22px; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.hud-right { display: flex; align-items: center; gap: 6px; flex: none; }
			.wx-pill { flex: none; padding: 6px 10px; border-radius: 999px; background: var(--tint-blue); color: var(--tint-blue-ink); font-size: 13px; font-weight: 600; white-space: nowrap; }
			.wx-pill.storm { background: var(--tint-red); color: var(--tint-red-ink); }
			.hud-chips { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 6px; font-variant-numeric: tabular-nums; }
			.chip { padding: 4px 10px; border-radius: 8px; background: var(--soft); color: var(--text); font-size: 13px; white-space: nowrap; }
			.chip.cash { background: var(--tint-green); color: var(--tint-green-ink); font-weight: 700; }
			.hud-chips .moodchip { min-height: 32px; }
			.hud-chips .sync-dot { margin-left: auto; font-size: 12px; color: var(--dim); }
			em.lack { font-style: normal; font-size: 11px; font-weight: 700; color: var(--low-ink); }
			.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; margin-top: 10px; }
			.tile { min-height: 64px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 2px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--card2); color: var(--text); text-align: left; }
			.tile b { font-size: 14px; }
			.tile small { font-size: 12px; color: var(--dim); }
			.tile.on { border: 2px solid var(--accent); background: var(--tint-blue); }
			.tile.on small { color: var(--tint-blue-ink); }
			.tile:disabled { opacity: 0.55; }
			.budget { margin-top: 10px; padding: 8px 10px; border-radius: 8px; background: var(--tint-amber); color: var(--tint-amber-ink); font-size: 13px; }
			.budget.tight { background: var(--tint-red); color: var(--tint-red-ink); }
			.dest .primary.wide { margin-top: 10px; }
			.hud-row { display: flex; align-items: center; gap: 10px; font-variant-numeric: tabular-nums; min-height: 32px; }
			.hud-row .who { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
			.hud-row .stat { white-space: nowrap; font-size: 13px; color: var(--dim); }
			.hud-row .cash { font-weight: 800; color: var(--text); font-size: 15px; }
			/* 按钮本身 44px 高（点按区），胶囊外观画在里面的 span 上 */
			.moodchip { min-height: 44px; padding: 0; border: 0; background: none; display: inline-flex; align-items: center; justify-content: flex-end; }
			.moodchip > span { padding: 4px 10px; border-radius: 16px; background: var(--tint-green); color: var(--tint-green-ink); font-size: 13px; font-weight: 600; white-space: nowrap; }
			.moodchip.mid > span { background: var(--tint-amber); color: var(--tint-amber-ink); }
			.moodchip.low > span { background: var(--tint-red); color: var(--tint-red-ink); }
			.hud-time { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--dim); margin-top: 2px; }
			.sync-dot { display: inline-flex; align-items: center; gap: 5px; }
			.sync-dot::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--ok); }
			.sync-dot.off::before { background: var(--mid); }
			.mini-needs { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; margin-top: 8px; }
			.mini-needs .need { font-size: 11px; color: var(--dim); text-align: center; }
			.bar { height: 8px; border-radius: 4px; background: var(--soft); overflow: hidden; margin-top: 4px; }
			.mini-needs .bar { height: 5px; margin-top: 2px; }
			.bar i { display: block; height: 100%; border-radius: inherit; background: var(--ok); }
			.bar i.mid { background: var(--mid); }
			.bar i.low { background: var(--bad); }

			#map-wrap { margin: 4px 16px 0; background: var(--ocean); border-radius: 20px; overflow: hidden; }
			#map { display: block; width: 100%; height: 36vh; min-height: 220px; touch-action: manipulation; }
			#map .land { fill: var(--land); stroke: var(--land-line); stroke-width: 1; }
			/* 昼夜：顶栏底色跟着时段变；夜里地图变成夜色、海上有星星 */
			#hud { transition: background-color 0.6s; }
			.p-dawn #hud { background: var(--sky-dawn); }
			.p-dusk #hud { background: var(--sky-dusk); }
			.p-night #hud { background: var(--sky-night); }
			.p-night #map-wrap { background: var(--ocean-night); }
			.p-night #map .land { fill: var(--land-night); stroke: var(--land-night-line); }
			.p-night #map text { fill: var(--map-night-text); stroke: var(--map-night-halo); }
			#map .star { fill: #fff; opacity: 0.7; }
			#map .route { stroke: var(--accent); stroke-width: 1; fill: none; opacity: 0.3; }
			#map .route.air { stroke-dasharray: 2 4; opacity: 0.25; }
			#map .route.ferry { stroke-dasharray: 1 2; }
			#map .route.track { stroke-dasharray: 4 2; }
			#map .route.live { opacity: 0.9; stroke-width: 1.6; }
			#map .route.air.live { opacity: 0.6; }
			#map .dot { fill: #fff; stroke: var(--accent); stroke-width: 1.6; }
			#map .dot.new { fill: var(--warm); stroke: #fff; }
			#map .dot.sel { stroke: var(--warm); stroke-width: 3; }
			#map .here { fill: var(--accent); stroke: #fff; stroke-width: 2; }
			#map .pulse { fill: none; stroke: var(--accent); stroke-width: 1.5; animation: pulse 1.8s ease-out infinite; transform-box: fill-box; transform-origin: center; }
			@keyframes pulse { from { transform: scale(0.6); opacity: 1; } to { transform: scale(2.4); opacity: 0; } }
			#map text { font-size: 9px; fill: var(--text); paint-order: stroke; stroke: var(--halo); stroke-width: 2.6px; pointer-events: none; }
			#map text.cnt, #map tspan.cnt { fill: var(--warm); font-weight: 700; }
			#map .hit { fill: transparent; cursor: pointer; }
			#map tspan.wx { font-size: 8px; }

			#tabs { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; justify-content: center; background: var(--card); border-top: 1px solid var(--line); padding-bottom: env(safe-area-inset-bottom); }
			#tabs .tabs-in { display: flex; width: 100%; max-width: 560px; }
			#tabs button { flex: 1; border: 0; border-radius: 0; background: none; min-height: var(--nav-h); padding: 6px 0; font-size: 11px; font-weight: 600; color: var(--dim); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; }
			#tabs button.on { color: var(--accent); }
			#tabs svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
			#panel:focus { outline: none; }
			#panel { flex: 1; padding: 12px 16px calc(var(--nav-h) + 28px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 12px; }
			.card { background: var(--card); border-radius: 20px; padding: 16px; box-shadow: 0 1px 2px var(--shadow); }
			.card h3 { margin: 0 0 4px; font-size: 17px; font-weight: 700; }
			.card p { margin: 0; color: var(--dim); font-size: 13px; }
			.hero { height: 140px; border-radius: 14px; margin-bottom: 12px; display: flex; align-items: center; justify-content: center; font-size: 48px; background: #123a5e; overflow: hidden; }
			.hero img { width: 100%; height: 100%; object-fit: cover; }
			.row { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; min-height: 56px; }
			button.row { background: var(--card); border: 0; border-radius: 16px; padding: 10px 14px; box-shadow: 0 1px 2px var(--shadow); }
			.card button.row { background: var(--card2); box-shadow: none; border: 1px solid var(--line); }
			.row .ico { font-size: 22px; width: 40px; height: 40px; border-radius: 12px; background: var(--soft); display: flex; align-items: center; justify-content: center; flex: none; }
			.row .body { flex: 1; min-width: 0; font-weight: 600; }
			.row .body small { display: block; color: var(--dim); font-size: 12px; font-weight: 400; }
			.row .meta { font-size: 12px; color: var(--dim); text-align: right; white-space: nowrap; flex: none; }
			.row .meta b { display: block; font-size: 15px; color: var(--text); }
			.row.sel { box-shadow: inset 0 0 0 2px var(--warm); }
			.row.new { background: var(--warm-bg); }
			.list { display: flex; flex-direction: column; gap: 8px; }
			.skill { display: grid; grid-template-columns: 30px 1fr 44px; align-items: center; gap: 8px; margin: 8px 0; font-size: 13px; }
			.skill .bar i { background: var(--accent); }
			.muted { color: var(--dim); font-size: 13px; }
			.chat { display: flex; flex-direction: column; gap: 4px; max-height: 180px; overflow-y: auto; font-size: 14px; margin: 8px 0; }
			.chat b { color: var(--accent); font-weight: 600; }
			.inline { display: flex; gap: 8px; flex-wrap: wrap; }
			.note { display: flex; gap: 8px; align-items: flex-start; padding: 8px 0; border-top: 1px solid var(--line); }
			.note .body { flex: 1; overflow-wrap: anywhere; }
			.coop-item { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
			.coop-item p { margin: 0; }
			.coop-item .inline button { min-height: 44px; }
			.inline button { flex: none; }
			.code { font-family: ui-monospace, monospace; font-size: 12px; word-break: break-all; background: var(--soft); padding: 10px; border-radius: 10px; margin: 8px 0; user-select: all; }
			.emotes button { padding: 4px 8px; font-size: 16px; min-height: 44px; min-width: 44px; }
			.mood-row { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; padding: 6px 0; border-bottom: 1px solid var(--line); }
			.mood-row:last-child { border-bottom: 0; }
			.mood-row .up { color: var(--ok); }
			.mood-row .down { color: var(--bad); }

			/* 今天页：角色卡与「下一步」 */
			.me-card { display: flex; flex-direction: column; gap: 14px; }
			.me-head { display: flex; align-items: center; gap: 12px; }
			.avatar { width: 52px; height: 52px; border-radius: 50%; background: var(--tint-blue); display: flex; align-items: center; justify-content: center; font-size: 28px; flex: none; }
			.me-head .name { flex: 1; min-width: 0; display: flex; flex-direction: column; }
			.me-head .name b { font-size: 19px; }
