				return `
					${wishHtml}
					<div class="card">${hero(loc.id, KIND_ICON[loc.kind])}
						<h3>${esc(loc.name)} <span class="muted">${esc(loc.en)}</span></h3><p>${esc(loc.blurb)}</p>
						${lastOutcome ? `<p style="margin-top:8px;color:var(--text)">💡 ${esc(lastOutcome)}</p>` : ''}
					</div>
