			type Offer = { id: string; kind: 'gift' | 'sale' | 'swap'; item: string; price: number; name: string; avatar: string; toName: string; loc: string; mine: boolean; taking: boolean; give?: SwapSide; want?: SwapSide };
			let tradeOffers: Offer[] = [];
