			const myOffersSeen = new Set<string>(); // 我挂出去的单：消失了（被收下或买走）就拉一次最新进度
			const myCancelled = new Set<string>();
			function takeTrade(data: any) {
				if (!Array.isArray(data?.offers)) return;
