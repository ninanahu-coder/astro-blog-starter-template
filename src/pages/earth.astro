			};
			// 本机显示设置（第 28 轮）：动画、字号、提示开关
			let prefs: Prefs = parsePrefs(store.get(PREFS_KEY), { big: store.get(LEGACY_BIG_KEY) });
			function applyPrefs() {
				const cl = document.documentElement?.classList;
				if (!cl) return;
				const mm = (window as { matchMedia?: (q: string) => { matches: boolean } }).matchMedia;
				const sys = typeof mm === 'function' && mm.call(window, '(prefers-reduced-motion: reduce)').matches;
				cl.toggle('calm', calmMotion(prefs, sys));
				for (const [f] of FONT_OPTIONS) cl.toggle(`fs-${f}`, prefs.font === f);
			}
			// 音效（第 29 轮）：设置里打开才响；AudioContext 等第一次要出声时再建（那时一定是玩家点过按钮之后）
			let audio: AudioLike | null = null;
			function sfx(cue: Cue) {
				if (!prefs.sound) return;
				try {
					if (!audio) {
						const w = window as unknown as { AudioContext?: new () => AudioLike; webkitAudioContext?: new () => AudioLike };
						const Ctx = w.AudioContext ?? w.webkitAudioContext;
						if (!Ctx) return;
						audio = new Ctx();
					}
					playCue(audio, cue);
				} catch {}
			}
			function setPrefs(next: Partial<Prefs>) {
				prefs = { ...prefs, ...next };
				store.set(PREFS_KEY, JSON.stringify(prefs));
				applyPrefs();
			}
			const randId = (n: number) => {
				const a = new Uint8Array(n);
				crypto.getRandomValues(a);
				return [...a].map((b) => 'abcdefghijklmnopqrstuvwxyz0123456789'[b % 36]).join('');
			};

			let toastTimer = 0;
