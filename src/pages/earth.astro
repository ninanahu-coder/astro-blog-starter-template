			/** 取一次高精度定位，存在本机内存里（不写 localStorage） */
			function locate(): Promise<typeof nearFix> {
				if (!navigator.geolocation) { toast('这台设备不支持定位'); return Promise.resolve(null); }
				toast('正在定位…');
				return new Promise((done) => navigator.geolocation.getCurrentPosition(
					(pos) => { nearFix = { lat: pos.coords.latitude, lon: pos.coords.longitude, acc: pos.coords.accuracy, at: Date.now() }; done(nearFix); },
					() => { toast('无法获取定位，请检查定位权限'); done(null); },
					{ enableHighAccuracy: true, timeout: 10000, maximumAge: 0 },
				));
			}

			/** 真实地点动作：先重新定位；游戏里不在那个地点时先用真实定位抵达 */
			async function venueDo(venueId: string, op: VenueOp) {
				const v = region.venues.find((x) => x.id === venueId);
				const type = v ? getVenueType(v.type) : undefined;
				if (!v || !type || !state) return;
				const preview = opOutcome(state, op, type, v);
				if (preview?.cost && !confirmLowCash(`在${v.name}${preview.notes[0] ?? '消费'}`, preview.cost)) return;
				const f = await locate();
				if (!f || !state) return;
				if (state.loc !== v.loc) {
					const g = await act({ t: 'gps', lat: f.lat, lon: f.lon, acc: f.acc });
					if (!g || state.pending) { render(); return; }
				}
				const r = await act({ t: 'venue', venue: venueId, op, lat: f.lat, lon: f.lon, acc: f.acc });
				if (r) { lastOutcome = r.msg; toast(r.msg); }
				render();
			}

			/** 主要路线：先重新定位；游戏里不在路线所在城市时先用真实定位抵达（同真实地点） */
			async function trailDo(id: string) {
				const t = getTrail(id);
				if (!t || !state) return;
				const f = await locate();
				if (!f || !state) return;
				if (state.loc !== t.loc) {
					const g = await act({ t: 'gps', lat: f.lat, lon: f.lon, acc: f.acc }); // 定位精度必须带上，否则 GPS 防作弊按旧页面拒绝
					if (!g || state.pending) { render(); return; }
				}
				const r = await act({ t: 'trail', lat: f.lat, lon: f.lon, acc: f.acc });
				if (r) { lastOutcome = r.msg; toast(r.msg); }
				render();
			}

			/** 商户赞助的优惠：重新定位，服务端核对在店里后发核销码；不改存档 */
			async function redeemDo(dealId: string) {
				if (!cred || busy) return;
				const f = await locate();
				if (!f) return;
				try {
					const { data } = await api({ action: 'redeem', op: 'claim', id: cred.id, key: cred.key, deal: dealId, lat: f.lat, lon: f.lon, acc: f.acc });
					const view = data?.ok ? parseRedeemView(data.redeem) : null;
					if (view) redeemed.set(view.deal, view);
					toast(typeof data?.msg === 'string' ? data.msg : view ? '已领取' : '没领到，稍后再试');
				} catch {
					toast('联网后才能用优惠');
				}
				render();
			}

			/** 店员在玩家手机上输入店铺 PIN，确认核销（只有确认过的才向商户计费） */
			async function redeemConfirm(dealId: string) {
				if (!cred || busy) return;
				const input = document.getElementById(pinInputId(dealId)) as HTMLInputElement | null;
				const pin = (input?.value ?? '').trim();
				if (!/^\d{6}$/.test(pin)) { toast('PIN 是 6 位数字'); return; }
				try {
					const { data } = await api({ action: 'redeem', op: 'confirm', id: cred.id, key: cred.key, deal: dealId, pin });
					if (input) input.value = '';
					const view = data?.ok ? parseRedeemView(data.redeem) : null;
					if (view) redeemed.set(view.deal, view);
					toast(typeof data?.msg === 'string' ? data.msg : view ? '核销成功' : '没确认成功，稍后再试');
				} catch {
					toast('联网后才能确认');
				}
				render();
			}

			function checkIn() {
				if (!navigator.geolocation) return toast('这台设备不支持定位');
				toast('正在定位…');
				navigator.geolocation.getCurrentPosition(
					(pos) => {
						if (!state) return;
						act({ t: 'gps', lat: pos.coords.latitude, lon: pos.coords.longitude, acc: pos.coords.accuracy }).then((r) => { if (r) { if (!state!.pending) toast(r.msg); render(); } });
					},
					() => toast('无法获取定位，请检查定位权限'),
					{ enableHighAccuracy: true, timeout: 10000 },
				);
			}

			// ---------- 创建角色 ----------
			let pickAvatar = AVATARS[0];
			let pickOrigin = ORIGINS[0].id;
			let pickTraits: string[] = [];
			function renderCreate() {
				$('c-avatars').innerHTML = AVATARS.map((a) => `<button class="ac-ava${a === pickAvatar ? ' on' : ''}" data-avatar="${a}" aria-pressed="${a === pickAvatar}" aria-label="照片 ${a}">${a}</button>`).join('');
				$('c-photo').innerHTML = photoHtml(pickOrigin, pickAvatar);
				$('c-origins').innerHTML = ORIGINS.map((o) => `<button class="ac-opt${o.id === pickOrigin ? ' on' : ''}" data-origin="${o.id}" aria-pressed="${o.id === pickOrigin}"><span class="ac-box" aria-hidden="true"></span><span><b>${o.icon} ${esc(o.name)}</b><small>${esc(o.desc)}</small></span><span class="ac-fx">$${o.cash}${o.vehicle !== 'none' ? '<small><br>有车</small>' : ''}</span></button>`).join('');
				// 起步能力：出身没写的项从 5 开始（和 createPlayer 一致）；指针 0–100 映射到 -60°…60°
				const og = ORIGINS.find((o) => o.id === pickOrigin) ?? ORIGINS[0];
				const box = $('c-gauges');
				const vals = Object.keys(SKILL_META).map((k) => [k, (og.skills as Record<string, number | undefined>)[k] ?? 5] as const);
				if (!box.children?.length) {
					box.innerHTML = vals.map(([k]) => `<li data-gauge="${k}"><svg viewBox="0 0 44 28" aria-hidden="true" focusable="false"><path class="arc" d="M5 24a17 17 0 0 1 34 0" />${[-60, -30, 0, 30, 60].map((d) => `<line class="tick" x1="22" y1="5.5" x2="22" y2="8.5" transform="rotate(${d} 22 24)" />`).join('')}<line class="needle" x1="22" y1="24" x2="22" y2="9" /><circle class="hub" cx="22" cy="24" r="2" /></svg><b></b><span>${esc(SKILL_META[k].name)}</span></li>`).join('');
				}
				for (const [k, v] of vals) {
					const li = box.querySelector?.<HTMLElement>(`[data-gauge="${k}"]`);
					if (typeof li?.querySelector !== 'function') continue;
					(li.querySelector('.needle') as SVGElement | null)?.style.setProperty('transform', `rotate(${-60 + Math.min(100, v) * 1.2}deg)`);
					const b = li.querySelector('b');
					if (b) b.textContent = String(v);
				}
				$('c-traits').innerHTML = TRAITS.map((t) => {
					const on = pickTraits.includes(t.id);
					const ok = on || validTraits([...pickTraits, t.id], MAX_TRAITS);
					return `<button class="ac-opt trait${on ? ' on' : ''}" data-trait="${t.id}" aria-pressed="${on}" ${ok ? '' : 'disabled'}><span class="ac-box" aria-hidden="true"></span><span><b>${esc(t.name)}</b><small>${esc(t.desc)}</small></span></button>`;
				}).join('');
				const left = MAX_TRAITS - pickTraits.length;
				$('c-trait-n').textContent = left ? `勾选 ${MAX_TRAITS} 项 · 已勾 ${pickTraits.length}` : `已勾 ${MAX_TRAITS} 项`;
				$('c-trait-n').classList.toggle('done', !left);
				($('c-start') as HTMLButtonElement).disabled = left !== 0;
				$('c-start').textContent = left ? `再勾选 ${left} 个性格特质` : '盖章入境 · 开始生活';
				const spawn = getLocation(region, region.spawn);
				// 章上的城市写英文大写：标题字体子集只含 A–Z 和开场用到的汉字
				$('c-stamp-city').textContent = spawn ? spawn.en.toUpperCase() : '';
				const d = new Date();
				$('c-stamp-date').textContent = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
			}
			// 登机牌「填写入境卡」：滚到入境卡，焦点放在卡上（不直接弹键盘）
			$('c-go').addEventListener('click', (e) => {
				e.preventDefault();
				const card = $('c-card') as HTMLElement;
				const calm = !!document.documentElement?.classList?.contains('calm');
				card.scrollIntoView?.({ behavior: calm ? 'auto' : 'smooth', block: 'start' });
				card.focus?.({ preventScroll: true });
			});
			/** 盖章：没有减少动态效果时让入境章落下再进游戏；测试环境、减少动效时立刻继续 */
			function stampDown(): Promise<void> {
				$('c-card').classList.add('stamped');
				sfx('stamp'); // 入境章落下的一声（v37 音效，音效关着时不响）
				const calm = !!document.documentElement?.classList?.contains('calm') || typeof matchMedia !== 'function' || matchMedia('(prefers-reduced-motion: reduce)').matches;
				return calm ? Promise.resolve() : new Promise((r) => setTimeout(r, 700));
			}
			$('create').addEventListener('click', (e) => {
				const t = (e.target as Element).closest<HTMLElement>('[data-avatar],[data-origin],[data-trait]');
				if (!t || (t as HTMLButtonElement).disabled) return;
				if (t.dataset.avatar) pickAvatar = t.dataset.avatar;
				if (t.dataset.origin) pickOrigin = t.dataset.origin;
				const tr = t.dataset.trait;
				if (tr) pickTraits = pickTraits.includes(tr) ? pickTraits.filter((x) => x !== tr) : [...pickTraits, tr];
				renderCreate();
			});
			function begin() { loadQueue(); render(); connect(); }
			$('c-start').addEventListener('click', async () => {
				const btn = $('c-start') as HTMLButtonElement;
				// 本机还存着一个角色的同步码（缓存坏了还没从云端恢复）：新建会替换它，先问一句
				if (parseCred(readJson(CRED_KEY)) && !confirm('这台设备上还保存着一个角色的同步码（本机缓存坏了，还没能从云端恢复）。新建角色会替换它，旧角色只能靠你记下的同步码找回。继续新建？')) return;
				const c = { id: 'p' + randId(15), key: randId(24) };
				const profile = { name: ($('c-name') as HTMLInputElement).value, avatar: pickAvatar, origin: pickOrigin, traits: pickTraits };
				btn.disabled = true;
				try {
					const { data } = await api({ action: 'create', id: c.id, key: c.key, profile });
					if (!data.ok) return toast(data.msg || '创建失败');
					cred = c;
					store.set(CRED_KEY, JSON.stringify(cred));
					if (adopt(data.state)) { await stampDown(); begin(); }
				} catch {
					toast('需要联网才能创建角色');
				} finally {
					btn.disabled = false;
				}
			});
			/** 用同步码从云端恢复（还没有角色的设备）：服务器认这个码才写进本机 */
			async function restoreFrom(c: Cred, why = '已恢复云端存档') {
				try {
					const { data } = await api({ action: 'get', id: c.id, key: c.key });
					if (!data.ok) return toast(data.msg || '恢复失败');
					// 网络来的存档先清洗、核对是这个角色的，合格才写凭证（不合格时本机什么都不动）
					const clean = cloudSave(data.state, c.id);
					if (!clean) return toast('云端存档已损坏');
					cred = c;
					store.set(CRED_KEY, JSON.stringify(cred));
					recoverCred = null;
					adopt(clean, why);
					render();
					begin();
				} catch { toast(recoverCred ? '本机存档读不出来：联网后会自动从云端恢复' : '网络错误，请稍后再试'); }
			}
			/** 服务器发来的存档：清洗后必须还是这个角色的，否则当作损坏 */
			function cloudSave(raw: unknown, id: string): PlayerState | null {
				const clean = sanitizeState(raw, LOC_IDS, { fallbackLoc: region.spawn });
				return clean && clean.id === id ? clean : null;
			}
			$('c-import').addEventListener('click', () => {
				const c = parseSyncCode(($('c-code') as HTMLInputElement).value);
				if (!c) return toast('同步码格式不对');
				void restoreFrom(c);
			});
			/**
			 * 扫二维码打开的：地址栏带 #sync=同步码。先从地址栏抹掉（不留在历史和截图里），再按这台设备的情况处理。
			 * 启动时先等它处理完，才给本机原有的角色连在线频道、同步、补交排队（不然换角色等服务器回话的时候，原角色的排队可能已经交出去一部分）。
			 * 返回 true：这台设备的角色已经定了（恢复好了、或换了要重新载入），不用再为原角色启动
			 */
			async function fromSyncLink(): Promise<boolean> {
				const code = readSyncHash(location.hash);
				if (!code) return false;
				try { history.replaceState(null, '', location.pathname + location.search); } catch {}
				const inc = parseSyncCode(code)!;
				const act = hashAction(state ? cred : null, inc);
				if (act === 'same') { toast('这台设备已经是这个角色了'); return false; }
				if (act === 'restore') { await restoreFrom(inc); return true; }
				// 这台设备已经有别的角色：换之前问一句；服务器认这个码、存档合格才换，换完重新载入页面
				if (!confirm(`这台设备上已经有角色「${state!.name}」。换成扫码带来的角色吗？\n原来的角色要记下它的同步码（我 · 同步）才能再找回。`)) return false;
				try {
					const { data } = await api({ action: 'get', id: inc.id, key: inc.key });
					if (!data.ok) { toast(data.msg || '换角色失败'); return false; }
					const clean = cloudSave(data.state, inc.id);
					if (!clean) { toast('云端存档已损坏，没有换角色'); return false; }
					pullSeq++;
					actGen++;
					cred = inc;
					store.set(CRED_KEY, JSON.stringify(inc));
					store.set(SAVE_KEY, JSON.stringify(clean));
					location.reload();
					return true;
				} catch { toast('网络错误，请稍后再试'); return false; }
			}

			// ---------- 启动 ----------
			cred = parseCred(readJson(CRED_KEY));
			// 本地缓存里的所在地如果已经不存在，先挪到出生点而不是判损坏：不然凭证会被清掉，连云端完好的存档都拉不回来
			try { state = sanitizeState(readJson(SAVE_KEY), LOC_IDS, { fallbackLoc: region.spawn }); } catch { state = null; }
			// 凭证在、本机缓存坏了（或没了、或是别的角色的）：存档一直在服务器上，用凭证从云端恢复，而不是当成新设备显示创建页
			// （第 50 批）。以前这里连凭证一起丢掉，玩家一新建角色就把凭证覆盖了，旧角色只能靠记下的同步码找回
			let recoverCred: Cred | null = cred && (!state || state.id !== cred.id) ? cred : null;
			if (recoverCred) { state = null; cred = null; }
			else if (!cred) state = null;
			applyPrefs();
			// 创建角色页的统计告知：可以直接关
			const renderStatsNote = () => { $('c-stats-text').textContent = STATS_NOTE; $('c-stats').textContent = statsOn ? '关闭统计' : '统计已关闭，点此开启'; };
			$('c-stats').addEventListener('click', () => { setStats(!statsOn); renderStatsNote(); });
			renderStatsNote();
			renderCreate();
			render();
			fetch('/earth/media/manifest.json').then((r) => (r.ok ? r.json() : {})).then((m: unknown) => { media = parseMedia(m); if (state) renderPanel(); }).catch(() => {});
			fetch('/earth/cgi/manifest.json').then((r) => (r.ok ? r.json() : {})).then((m: any) => { cgiRaw = m.images && typeof m.images === 'object' ? m.images : {}; cgi = cgiForPreset(cgiRaw, fx.hiDpi); if (state) { renderPanel(); renderEvent(); } }).catch(() => {});
			// 有扫码链接时先处理完它（期间 syncing：原角色不连线、不同步、不补交、不能操作），再决定要不要为原角色启动
			syncing = !!readSyncHash(location.hash);
			void (async () => {
				let decided = false;
				try { decided = await fromSyncLink(); }
				// 换了角色、等重新载入时（凭证已是新角色、存档还是原角色）保持 syncing：原角色什么都不再做
				finally { syncing = !!state && !!cred && state.id !== cred.id; }
				if (!decided && state) { loadQueue(); connect(); pullCloud(); }
				else if (!decided && !state && recoverCred) await restoreFrom(recoverCred, '本机存档读不出来，已从云端恢复');
			})();
			document.addEventListener('visibilitychange', () => {
				// 切到后台时暂停声音（省电，也不打扰）；回来接着放
				try { if (document.hidden) void audio?.suspend?.(); else if (audio && (prefs.sound || prefs.ambience || prefs.music)) void audio.resume?.(); } catch {}
				if (!document.hidden && state) { connect(); pullCloud(); }
			});
			// 画面档换了之后：省流量档拆掉真实地图（不再请求图块），环境音按这一档重新放
			function visualChanged() {
				if (!fx.basemap) dropBasemap();
				syncScene();
			}
			// 系统的省流量、减少动态效果在玩的时候改了：「跟随系统」时跟着换档，重画当前页
			const followSystem = () => {
				const before = preset;
				applyPrefs();
				if (preset === before) return;
				visualChanged();
				if (state) renderPanel();
			};
			try {
				const mq = typeof matchMedia === 'function' ? matchMedia('(prefers-reduced-motion: reduce)') : null;
				mq?.addEventListener?.('change', followSystem);
				(navigator as { connection?: { addEventListener?: (t: string, f: () => void) => void } }).connection?.addEventListener?.('change', followSystem);
			} catch {}
			// 手机断网时立刻显示离线，恢复后自动重连并同步
			if (typeof window.addEventListener === 'function') {
				window.addEventListener('offline', () => { syncStatus = '离线：可以查看，联网后才能行动'; if (state) { renderHud(); if (tab === 'go') renderMap(); } });
				window.addEventListener('online', () => {
					retryVenues();
					// 断网导致真实地图没加载出来的，联网后再试一次（v42）；设置里关掉的不会打开
					if (basemapFailed) { basemapFailed = false; if (state && tab === 'go') renderMap(); }
					if (!state && recoverCred && !syncing) void restoreFrom(recoverCred, '本机存档读不出来，已从云端恢复');
					if (state) { connect(); pullCloud(); if (tab === 'near') renderPanel(); }
				});
			}
			// 离线外壳：能「添加到主屏幕」、断网时也能打开查看。注册失败不影响游戏
			// 首屏加载耗时（抽样，见 telemetry.ts）
			tm.track('perf', 'load', performance.now());
			if ('serviceWorker' in navigator && location.protocol === 'https:') navigator.serviceWorker.register('/earth/sw.js', { scope: '/earth/' }).catch(() => {});
		</script>
	</body>
</html>
