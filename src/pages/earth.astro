			let dailyNote = '';
			let clockSkew = 0; // 服务器时间 − 本机时间（毫秒）
			// 净资产排行榜：打开「社交」页时拉取，一分钟内不重复拉
			type BoardRow = { rank: number; name: string; avatar: string; worth: number; day: number; me: boolean };
			let board: { top: BoardRow[]; me: BoardRow | null; total: number } | null = null;
			let boardAt = 0;
			let boardLoading = false;
			let boardError = '';
			async function loadBoard(force = false) {
				if (!cred || boardLoading || (!force && Date.now() - boardAt < 60_000)) return;
				boardLoading = true;
				try {
					const { data } = await api({ action: 'board', id: cred.id, key: cred.key });
					if (data?.ok && Array.isArray(data.top)) { board = { top: data.top, me: data.me ?? null, total: data.total ?? 0 }; boardError = ''; }
					else boardError = data?.msg || '排行榜暂时拿不到';
				} catch {
					boardError = '排行榜需要联网';
				}
				boardAt = Date.now();
				boardLoading = false;
				if (tab === 'social') renderPanel();
			}
			// 共同事件：同一地点的大厅列表（服务端为准）；打开社交页和收到在线频道的提醒时拉取
			type CoopLobby = { id: string; coop: string; loc?: string; host: boolean; mine: boolean; away?: boolean; starting?: boolean; members: { name: string; avatar: string; role: number; me: boolean }[] };
			let coopLobbies: CoopLobby[] = [];
			let coopAt = 0;
			let coopLoading = false;
			let coopPrimed = false; // 第一次拉到的旧结果只记下，不弹提示
			const coopSeen = new Set<string>();
			function takeCoop(data: any) {
				if (Array.isArray(data?.lobbies)) coopLobbies = data.lobbies;
				for (const r of Array.isArray(data?.results) ? data.results : []) {
					if (typeof r?.id !== 'string' || coopSeen.has(r.id)) continue;
					coopSeen.add(r.id);
					const def = getCoop(String(r.coop));
					if (!def || !coopPrimed) continue;
					// 队友开始的：结果已经写进我的存档，拉一次最新进度
					lastOutcome = `${def.icon} ${def.title}：${String(r.text ?? '')}`;
					toast(lastOutcome);
					pullCloud();
				}
				coopPrimed = true;
			}
			// 在线频道的「队伍有变化」提醒：合并成最多每 3 秒拉一次，别人刷提醒也不会让我不停请求服务器
			let coopHintTimer: ReturnType<typeof setTimeout> | 0 = 0;
			function coopHint() {
				if (coopHintTimer) return;
				coopHintTimer = setTimeout(() => { coopHintTimer = 0; loadCoop(true); }, Math.max(300, 3000 - (Date.now() - coopAt)));
			}
			async function loadCoop(force = false) {
				if (!cred || !state || coopLoading || (!force && Date.now() - coopAt < 15_000)) return;
				coopLoading = true;
				try {
					const { data } = await api({ action: 'coop', op: 'list', id: cred.id, key: cred.key });
					takeCoop(data);
				} catch {}
				coopAt = Date.now();
				coopLoading = false;
				if (tab === 'social') renderPanel();
			}
			async function coopOp(op: string, extra: Record<string, unknown>) {
				if (!state || !cred || busy) return;
				busy = true;
				actGen++;
				document.body.classList.add('busy');
				const before = state;
				try {
					if (op === 'start' && typeof extra.lobby === 'string') coopSeen.add(extra.lobby); // 自己开始的，结果直接在这次返回里
					const { status, data } = await api({ action: 'coop', op, id: cred.id, key: cred.key, rev: before.rev, ...extra });
					if (status === 409 && data.state) { lastDelta = []; adopt(data.state, data.msg); }
					else if (data.state) {
						adopt(data.state);
						if (data.ok && state && state.rev === nextRev(before.rev)) { lastDelta = stateDelta(before, state); lastOutcome = data.msg; }
					}
					takeCoop(data);
					coopAt = Date.now();
					if (data.msg) toast(data.msg);
					// 提醒同一地点的人去拉一次列表
					if (data.ok && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'coop' }));
				} catch {
					syncStatus = '离线：可以查看，联网后才能行动';
					toast('网络断开了，联网后才能行动');
				} finally {
					busy = false;
					document.body.classList.remove('busy');
				}
				render();
			}
			// 送礼与二手摊：挂单以服务端为准；打开社交页、收到在线频道的 trade 提醒时拉取
			type Offer = { id: string; kind: 'gift' | 'sale'; item: string; price: number; name: string; avatar: string; toName: string; loc: string; mine: boolean; taking: boolean };
			let tradeOffers: Offer[] = [];
			let tradeAt = 0;
			let tradeLoading = false;
			let giftTo: { hash: string; name: string } | null = null; // 正在选要送什么
			let sellPick = false; // 正在选要摆到二手摊的东西
			const myOffersSeen = new Set<string>(); // 我挂出去的单：消失了（被收下或买走）就拉一次最新进度
			const myCancelled = new Set<string>();
			function takeTrade(data: any) {
				if (!Array.isArray(data?.offers)) return;
				tradeOffers = data.offers;
				const now = new Set(tradeOffers.filter((o) => o.mine).map((o) => o.id));
				let gone = false;
				for (const id of myOffersSeen) if (!now.has(id)) { myOffersSeen.delete(id); if (!myCancelled.delete(id)) gone = true; }
				for (const id of now) myOffersSeen.add(id);
				if (gone) pullCloud(); // 可能是过期撤下，也可能被拿走了：以服务端存档为准
			}
			async function loadTrade(force = false) {
				if (!cred || !state || tradeLoading || (!force && Date.now() - tradeAt < 15_000)) return;
				tradeLoading = true;
				try {
					const { data } = await api({ action: 'trade', op: 'list', id: cred.id, key: cred.key });
					takeTrade(data);
				} catch {}
				tradeAt = Date.now();
				tradeLoading = false;
				if (tab === 'social') renderPanel();
			}
			let tradeHintTimer: ReturnType<typeof setTimeout> | 0 = 0;
			function tradeHint() {
				if (tradeHintTimer) return;
				tradeHintTimer = setTimeout(() => { tradeHintTimer = 0; loadTrade(true); }, Math.max(300, 3000 - (Date.now() - tradeAt)));
			}
			async function tradeOp(op: string, extra: Record<string, unknown>) {
				if (!state || !cred || busy) return;
				busy = true;
				actGen++;
				document.body.classList.add('busy');
				const before = state;
				try {
					const { status, data } = await api({ action: 'trade', op, id: cred.id, key: cred.key, rev: before.rev, ...extra });
					// 撤回成功才算主动撤下；撤回失败而单子没了（被人拿走了），交给 takeTrade 去拉最新存档
					if (op === 'cancel' && data.ok && typeof extra.offer === 'string') myCancelled.add(extra.offer);
					if (status === 409 && data.state) { lastDelta = []; adopt(data.state, data.msg); }
					else if (data.state) {
						adopt(data.state);
						if (data.ok && state && state.rev === nextRev(before.rev)) { lastDelta = stateDelta(before, state); lastOutcome = data.msg; }
					}
					takeTrade(data);
					tradeAt = Date.now();
					if (data.ok) { giftTo = null; sellPick = false; }
					if (data.msg) toast(data.msg);
					if (data.ok && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'trade' }));
				} catch {
					syncStatus = '离线：可以查看，联网后才能行动';
					toast('网络断开了，联网后才能行动');
				} finally {
					busy = false;
					document.body.classList.remove('busy');
				}
				render();
			}
			// 全服周目标：进度以服务端为准，打开社交页时最多每分钟拉一次
			type WeekView = { week: number; goal: WeeklyGoal; count: number; daysLeft: number; mine: { n: number; claimed: boolean } };
			let weekView: WeekView | null = null;
			let weekAt = 0;
			let weekLoading = false;
			async function loadWeek(force = false) {
				if (!cred || !state || weekLoading || (!force && Date.now() - weekAt < 60_000)) return;
				weekLoading = true;
				try {
					const { data } = await api({ action: 'weekly', op: 'status', id: cred.id, key: cred.key });
					if (data?.week?.goal) weekView = data.week;
				} catch {}
				weekAt = Date.now();
				weekLoading = false;
				if (tab === 'social') renderPanel();
			}
			async function claimWeek() {
				if (!state || !cred || busy) return;
				busy = true;
				actGen++;
				document.body.classList.add('busy');
				const before = state;
				try {
					const { status, data } = await api({ action: 'weekly', op: 'claim', id: cred.id, key: cred.key, rev: before.rev });
					if (status === 409 && data.state) { lastDelta = []; adopt(data.state, data.msg); }
					else if (data.state) {
						adopt(data.state);
						if (data.ok && state && state.rev === nextRev(before.rev)) { lastDelta = stateDelta(before, state); lastOutcome = data.msg; }
					}
					if (data?.week?.goal) weekView = data.week;
					weekAt = Date.now();
					if (data.msg) toast(data.msg);
				} catch {
					syncStatus = '离线：可以查看，联网后才能行动';
					toast('网络断开了，联网后才能行动');
				} finally {
					busy = false;
					document.body.classList.remove('busy');
				}
				render();
			}
			// 地点留言板：打开附近页时拉取（每个地点 30 秒内不重复拉）
			type NoteView = { id: string; name: string; avatar: string; text: string; at: number; mine: boolean };
			let notesLoc = '';
			let notesList: NoteView[] = [];
			let notesAt = 0;
			let notesLoading = false;
			async function loadNotes(force = false) {
				if (!cred || !state || notesLoading || (!force && notesLoc === state.loc && Date.now() - notesAt < 30_000)) return;
				notesLoading = true;
				const loc = state.loc;
				try {
					const { data } = await api({ action: 'notes', op: 'list', id: cred.id, key: cred.key });
					if (Array.isArray(data?.notes)) { notesList = data.notes; notesLoc = loc; }
				} catch {}
				notesAt = Date.now();
				notesLoading = false;
				if (tab === 'place') renderPanel();
			}
			async function noteOp(op: string, extra: Record<string, unknown>) {
				if (!state || !cred || busy) return;
				busy = true;
				try {
					const { data } = await api({ action: 'notes', op, id: cred.id, key: cred.key, ...extra });
					if (Array.isArray(data?.notes)) { notesList = data.notes; notesLoc = state.loc; notesAt = Date.now(); }
					if (data?.msg) toast(data.msg);
				} catch {
					toast('网络断开了，联网后才能留言');
				} finally {
					busy = false;
				}
				if (tab === 'place') renderPanel();
			}
			const srvNow = () => Date.now() + clockSkew;
			async function api(body: unknown) {
				const res = await fetch('/api/earth/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
				const data = (await res.json()) as any;
				// 冷却和上班卡都按服务器时间算：用服务器返回的时间校准，手机时钟不准也不影响
				if (typeof data?.at === 'number' && Number.isFinite(data.at)) clockSkew = data.at - Date.now();
				if (typeof data?.daily === 'string') dailyNote = data.daily;
				return { status: res.status, data };
			}
			/** 采用服务器返回的存档；位置变了就通知在线频道 */
			function adopt(remote: unknown, why?: string) {
				const clean = sanitizeState(remote, LOC_IDS, { fallbackLoc: region.spawn });
				if (!clean) return false;
				const moved = !state || state.loc !== clean.loc;
				if (state && clean.rev !== state.rev && !busy) lastDelta = [];
				state = clean;
				syncStatus = `已同步 · 版本 ${clean.rev}`;
				cache();
				if (moved && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'move', loc: state.loc }));
				if (why) toast(why);
				return true;
			}
			/** 每发一次同步请求加一：只有最后发出的那次能采用结果 */
			let pullSeq = 0;
			async function pullCloud() {
				if (!cred) return;
				const gen = actGen;
				const seq = ++pullSeq;
				try {
					const { data } = await api({ action: 'get', id: cred.id, key: cred.key });
					// 同步请求在路上时玩家做了动作：这份存档可能比动作的结果旧，采用了会把进度倒回去、下一个动作版本冲突被丢掉
					// 后面又发了同步：先发的可能后到，带回的是更旧的存档，只认最后一次
					if (seq !== pullSeq || gen !== actGen || busy) return;
					// 本机缓存只用于离线显示，联网时一律以服务器为准（即使版本号相同，缓存也可能被改过）
					if (data.ok) {
						const newer = !!state && data.state.rev !== state.rev;
						adopt(data.state, newer ? '已载入最新进度' : undefined);
						render();
					} else syncStatus = '同步失败：' + (data.msg || '');
				} catch {
					syncStatus = '离线：可以查看，联网后才能行动';
				}
				if (tab === 'me') renderPanel();
				else renderHud();
			}

			// ---------- 在线状态 ----------
			function connect() {
				if (!state || !cred || (ws && ws.readyState <= WebSocket.OPEN)) return;
				const q = new URLSearchParams({ region: region.id, id: cred.id, name: state.name, avatar: state.avatar, loc: state.loc });
				const sock = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/api/earth/ws?${q}`);
				ws = sock;
				sock.onmessage = (e) => {
					let m: any;
					try { m = JSON.parse(e.data); } catch { return; }
					if (m.t === 'hello') {
						myPeerId = m.you;
						emotes = m.emotes || [];
						peers = new Map((m.players as Peer[]).map((p) => [p.id, p]));
					} else if (m.t === 'join') peers.set(m.p.id, m.p);
					else if (m.t === 'leave') peers.delete(m.id);
					else if (m.t === 'move') { const p = peers.get(m.id); if (p) p.loc = m.loc; }
					else if (m.t === 'chat') { chats.push(m); chats = chats.slice(-50); if (tab !== 'social') toast(`${m.name}: ${m.text}`); }
					else if (m.t === 'emote') toast(`${m.name} 向你 ${m.kind}`);
					else if (m.t === 'coop') { coopHint(); return; }
					else if (m.t === 'trade') { tradeHint(); return; }
					else return;
					renderMap();
					renderTabs();
					if (tab === 'social') renderPanel();
				};
				sock.onclose = () => {
					if (ws !== sock) return;
					ws = null;
					peers.clear();
					// 断开后在线人数清零：标签角标、地图和社交页跟着更新
					renderTabs();
					renderMap();
					if (tab === 'social') renderPanel();
					setTimeout(connect, 5000);
				};
			}
			setInterval(() => { if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'ping' })); }, 20000);
			// 「附近」页的按钮状态随现实时间变化（上班满 15 分钟才能打下班卡、各动作的冷却）：有这类倒计时的时候每半分钟刷新一次
			setInterval(() => {
				if (tab !== 'near' || document.hidden || !state || state.pending) return;
				if (state.clockIn || Object.keys(state.venueCd).length) renderPanel();
			}, 30000);

			// ---------- 动作（发给服务器结算） ----------
			let busy = false;
			/** 每发起一次会改存档的请求就加一（留言不改存档，不算）：后台同步用它判断回来的存档是不是已经过时 */
			let actGen = 0;
			async function act(a: GameAction): Promise<{ ok: boolean; msg: string } | null> {
				if (!state || !cred || busy) return null;
				busy = true;
				actGen++;
				document.body.classList.add('busy');
				// 动作前的存档：请求期间后台同步可能替换 state，所以在发请求前记下
				const before = state;
				try {
					const { status, data } = await api({ action: 'act', id: cred.id, key: cred.key, rev: before.rev, act: a });
					if (status === 409 && data.state) { lastDelta = []; adopt(data.state, data.msg); render(); return null; }
					if (data.state) adopt(data.state);
					// 只有返回的正好是动作前那一版的下一版，变化才是这个动作带来的
					if (data.ok && state && state.rev === nextRev(before.rev)) {
						lastDelta = stateDelta(before, state);
						const got = newAchievements(before, state, region);
						lastAch = got.map((d) => `${d.icon} ${d.name}`);
						if (got.length && prefs.achToast) setTimeout(() => toast(`🏅 达成成就：${got.map((d) => d.name).join('、')}`), 1200);
						sfx(got.length ? 'ach' : 'ok');
					}
					else { lastDelta = []; lastAch = []; }
					if (!data.ok) { sfx('fail'); toast(data.msg || '操作失败'); render(); return null; }
					return { ok: true, msg: data.msg };
				} catch {
					syncStatus = '离线：可以查看，联网后才能行动';
					toast('网络断开了，联网后才能行动');
					renderHud();
					return null;
				} finally {
					busy = false;
					document.body.classList.remove('busy');
				}
			}

			// ---------- 渲染 ----------
			function barCls(v: number) { return v < 25 ? 'low' : v < 50 ? 'mid' : ''; }
			/** 健康 + 5 项需求，今天页和顶栏共用 */
			function needList(s: PlayerState) {
				return [{ name: '健康', icon: '❤️', v: Math.round(s.health) }, ...NEED_KEYS.map((k) => ({ name: NEED_META[k].name, icon: NEED_META[k].icon, v: Math.round(s.needs[k]) }))];
			}
			function moodCls(m: number) { return m < 25 ? ' low' : m < 50 ? ' mid' : ''; }
			const PERIOD_ICON: Record<string, string> = { dawn: '🌅', day: '🌤️', dusk: '🌇', night: '🌙' };
			function renderHud() {
				const s = state!;
				const m = mood(s);
				const stars = wantedStars(s.heat);
				const online = !/失败|离线|未同步/.test(syncStatus);
				const loc = getLocation(region, s.loc)!;
				const w = weatherAt(s);
				const p = period(s.clock);
				const time = `${PERIOD_ICON[p.id]} ${dateLabel(s.clock)} · ${WEEKDAYS[weekdayOf(s.clock)]} ${formatClock(s.clock).split(' ')[1]} ${p.name}`;
				const sync = `<span class="sync-dot${online ? '' : ' off'}">${online ? '已同步' : '离线'}</span>`;
				const cash = `<span class="chip cash">$${s.cash.toLocaleString()}</span>`;
				const moodBtn = `<button class="moodchip${moodCls(m)}" data-tab="me" title="看心情的来源"><span>心情 ${moodTier(m).name} ${m}</span></button>`;
				const starHtml = stars ? `<span class="chip" title="通缉星级（麻烦值 ${Math.round(s.heat)}）">${'★'.repeat(stars)}</span>` : '';
				let top: string;
				if (tab === 'place') {
					// 今天页：时间 + 地点大标题 + 天气；下面一排现金、工作/等级、心情（需求条在页面里）
					const career = s.job ? getCareer(s.job.career) : undefined;
					const lv = level(s.respect);
					const role = career ? `${career.name} · ${career.levels[s.job!.level]?.title ?? ''}` : `Lv${lv.lv} ${lv.title}`;
					top = `<div class="hud-top"><div class="hud-title"><span class="hud-sub" title="${formatClock(s.clock)}">${time}</span><h1>${esc(loc.name)}</h1></div>
						<span class="wx-pill${w.closesSea ? ' storm' : ''}">${w.icon} ${esc(w.name)}${w.closesSea ? ' · 海上关闭' : ''}</span></div>
						<div class="hud-chips">${cash}<span class="chip">${esc(role)}</span>${starHtml}${moodBtn}${sync}</div>`;
				} else {
					// 其他页：副标题 + 页名；右边现金和心情，下面一条迷你需求条
					const here = [...peers.values()].filter((p) => p.loc === s.loc && p.id !== myPeerId).length;
					const sub: Record<string, string> = {
						go: `从${loc.name}出发 · ${time}`,
						near: '真实地点 · 本人到场才能用',
						social: `${loc.name} · ${here ? `${here} 位玩家在线` : '没有其他玩家在线'}`,
						me: `${dateLabel(s.clock)} · 已过 ${dayOf(s.clock) + 1} 天`,
					};
					const title = TABS.find(([id]) => id === tab)?.[1] ?? '';
					top = `<div class="hud-top"><div class="hud-title"><span class="hud-sub">${esc(sub[tab] ?? time)}</span><h1>${title}</h1></div>
						<div class="hud-right">${cash}${starHtml}</div></div>
						<div class="hud-chips">${moodBtn}${sync}</div>
						<div class="mini-needs">${needList(s).map((n) => `<div class="need" title="${n.name} ${n.v}">${n.icon}<div class="bar"><i class="${barCls(n.v)}" style="width:${n.v}%"></i></div></div>`).join('')}</div>`;
				}
				$('hud').innerHTML = `${top}${syncStatus.startsWith('离线') ? '<div class="offline" role="status">现在离线：可以查看，联网后才能行动</div>' : ''}`;
			}

			const proj = makeProjection(region);
			/** 夜里地图上的星星：固定的伪随机位置，每次画都一样 */
			function starField(w: number, h: number) {
				let x = 2463534242;
				const next = () => { x ^= x << 13; x ^= x >>> 17; x ^= x << 5; return (x >>> 0) / 4294967296; };
				return Array.from({ length: 36 }, () => `<circle class="star" cx="${(next() * w).toFixed(1)}" cy="${(next() * h).toFixed(1)}" r="${(0.4 + next() * 0.8).toFixed(2)}"/>`).join('');
			}
			function renderMap() {
				// 地图只在「出行」页显示：其他页不画，切到出行页时 renderPanel 会补画
				if (tab !== 'go' || !state) return;
				const s = state!;
				const pt = (id: string) => { const l = getLocation(region, id)!; return proj.project(l.lon, l.lat); };
				const outline = region.outline.map(([lon, lat]) => proj.project(lon, lat).join(',')).join(' ');
				const routes = region.routes.map((r) => {
					const [x1, y1] = pt(r.a), [x2, y2] = pt(r.b);
					const live = r.a === s.loc || r.b === s.loc ? ' live' : '';
					return `<line class="route ${r.mode}${live}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`;
				}).join('');
				const counts = new Map<string, number>();
				for (const p of peers.values()) if (p.id !== myPeerId) counts.set(p.loc, (counts.get(p.loc) || 0) + 1);
				const dots = region.locations.map((l) => {
					const [x, y] = proj.project(l.lon, l.lat);
					const here = l.id === s.loc;
					const cls = here ? 'here' : `dot${s.visited[l.id] ? '' : ' new'}${selected === l.id ? ' sel' : ''}`;
					const [dx, dy, anchor] = LABEL[l.id] ?? (x > proj.width * 0.7 ? [-8, 3, 'end'] : [8, 3, 'start']);
					const n = counts.get(l.id);
					return `${here ? `<circle class="pulse" cx="${x}" cy="${y}" r="7"/>` : ''}
						<circle class="${cls}" cx="${x}" cy="${y}" r="${here ? 6 : 4.5}"/>
						<text x="${x + dx}" y="${y + dy}" text-anchor="${anchor}">${esc(l.name)}<tspan class="wx">${weatherOn(l.id, dayOf(s.clock)).icon}</tspan>${n ? ` <tspan class="cnt">👥${n}</tspan>` : ''}</text>
						<circle class="hit" data-loc="${l.id}" cx="${x}" cy="${y}" r="15"/>`;
				}).join('');
				const map = $('map');
				map.setAttribute('viewBox', `0 0 ${proj.width} ${proj.height}`);
				const stars = period(s.clock).id === 'night' ? starField(proj.width, proj.height) : '';
				map.innerHTML = `${stars}<polygon class="land" points="${outline}"/>${routes}${dots}`;
			}

			function hero(key: string, fallback: string) {
				return `<div class="hero">${cgi[key] ? `<img src="${esc(cgi[key])}" alt="" loading="lazy" />` : fallback}</div>`;
			}

			const minutesLabel = (m: number) => (m >= 60 ? (m / 60).toFixed(m % 60 ? 1 : 0) + ' 小时' : m + ' 分钟');
			const NEED_LOW: Record<string, string> = { health: '身体不太舒服', hunger: '肚子有点饿了', energy: '有点累了', hygiene: '该洗个澡了', fun: '有点无聊', social: '想找人说说话' };
			/** 今天页的状态卡：健康 + 5 项需求；低于 60 的最低一项标「最缺」（名字、现金、心情在顶栏） */
			function needsCard(s: PlayerState) {
				const list = needList(s);
				const min = Math.min(...list.map((n) => n.v));
				return `<div class="card"><h3>状态</h3><div class="needs-grid">${list.map((n) => `<div class="need"><div class="top"><span>${n.icon} ${n.name}${n.v === min && min < 60 ? ' <em class="lack">最缺</em>' : ''}</span><b class="${barCls(n.v)}">${n.v}</b></div><div class="bar"><i class="${barCls(n.v)}" style="width:${n.v}%"></i></div></div>`).join('')}</div></div>`;
			}
			/** 「下一步」：最缺的那项需求 → 这里能补它最多的事；需求都还行时提示上班或出门。只是建议，结算仍由服务器做 */
			function nextCard(s: PlayerState, homeHere: boolean, canWork: boolean) {
				// 有没处理的事件时什么都做不了（引擎会拒绝），不给按钮
				if (s.pending) return '';
				const loc = getLocation(region, s.loc)!;
				const vals: [string, string, number][] = [['health', '健康', s.health], ...NEED_KEYS.map((k) => [k, NEED_META[k].name, s.needs[k]] as [string, string, number])];
				const [key, name, v] = vals.reduce((a, b) => (b[2] < a[2] ? b : a));
				let title = '', text = '', btn = '', attr = '';
				const open = activitiesAt(s, region).filter((x) => !x.blocked).map((x) => x.act);
				const costLabel = (c?: number) => (c ? (c > 0 ? '+' : '') + '$' + Math.abs(c) : '免费');
				const suggestAct = (act: (typeof open)[number]) => { btn = `${esc(act.name)} · ${costLabel(act.fx.cash)} · ${minutesLabel(act.minutes)}`; attr = `data-act="${act.id}"`; };
				/** 最缺的那项需求：推荐补它最多的事（精力在家就回家睡） */
				const fixNeed = () => {
					title = NEED_LOW[key];
					const best = open
						.map((act) => ({ act, gain: key === 'health' ? act.fx.health ?? 0 : act.fx.needs?.[key as keyof typeof s.needs] ?? 0 }))
						.filter((x) => x.gain > 0)
						.sort((x, y) => y.gain - x.gain)[0];
					if (key === 'energy' && homeHere) {
						text = `精力只剩 ${Math.round(v)}，回家睡一觉能回满`; btn = '回家睡觉'; attr = 'data-home="sleep"';
					} else if (best) {
						text = `${name}只剩 ${Math.round(v)}，在${esc(loc.name)}${esc(best.act.name)}能补回来`; suggestAct(best.act);
					} else {
						text = `${name}只剩 ${Math.round(v)}，这里没有能补的事，换个地方看看`; btn = '去出行'; attr = 'data-tab="go"';
					}
				};
				// 周结算钱不够：能上班就上班，否则推荐这里最赚钱的事
				const wc = weeklyCosts(s);
				const short = wc.total > 0 && s.nextWeek - dayOf(s.clock) <= 2 && s.cash < wc.total ? wc.total - s.cash : 0;
				const earner = open.filter((act) => (act.fx.cash ?? 0) > 0).sort((x, y) => (y.fx.cash ?? 0) - (x.fx.cash ?? 0))[0];
				// 今天的心愿里有在这里就能完成的
				const hr = Math.floor((s.clock % 1440) / 60);
				const night = hr >= 22 || hr < 6;
				const wishAct = s.wishes.map((id) => getWish(id)).flatMap((w) => (w && w.done.t === 'activity' ? w.done.ids.map((aid) => ({ w, act: open.find((x) => x.id === aid) })) : [])).find((x) => x.act);
				if (v < 40) fixNeed();
				else if (short && canWork) { title = '周结算钱不够'; text = `还差 $${short.toLocaleString()}，正好在工作的地方，先上个班`; btn = '上班'; attr = 'data-job="work"'; }
				else if (short && earner) { title = '周结算钱不够'; text = `还差 $${short.toLocaleString()}，在${esc(loc.name)}${esc(earner.name)}能挣一点`; suggestAct(earner); }
				else if (v < 60) fixNeed();
				else if (night && s.needs.energy < 80) {
					// 夜深了：有家回家睡，有露营车睡车里，否则找这里能补精力最多的（旅馆、露营）
					title = '夜深了';
					const van = getVehicle(s.vehicle)?.sleep;
					const bed = open.filter((act) => (act.fx.needs?.energy ?? 0) > 0).sort((x, y) => (y.fx.needs?.energy ?? 0) - (x.fx.needs?.energy ?? 0))[0];
					if (homeHere) { text = '回家睡一觉，明天精神满满'; btn = '回家睡觉'; attr = 'data-home="sleep"'; }
					else if (van) { text = '在车里睡一晚，不花钱'; btn = '在车里睡'; attr = 'data-veh="sleep"'; }
					else if (bed) { text = `在${esc(loc.name)}找个地方过夜`; suggestAct(bed); }
					else { text = '这里没地方过夜，换个地方看看'; btn = '去出行'; attr = 'data-tab="go"'; }
				}
				else if (canWork) { title = '该上班了'; text = '状态不错，正好在工作的地方'; btn = '上班'; attr = 'data-job="work"'; }
				else if (wishAct) { title = '完成一个心愿'; text = `「${esc(wishAct.w!.text)}」在这里就能做到`; suggestAct(wishAct.act!); }
				else { title = '状态不错'; text = s.wishes.length ? `今天还有 ${s.wishes.length} 个心愿没完成` : '出去走走，看看会遇到什么'; btn = '去出行'; attr = 'data-tab="go"'; }
				return `<div class="next"><span class="lbl">下一步</span><h2>${title}</h2><p>${text}</p><button ${attr}>${btn}</button></div>`;
			}

			// 新手指南（第 26 轮）：前三天分步解开，做到了自动打勾；点「知道了」或在设置里关掉后不再显示（只记在本机）
			function guideCard(s: PlayerState) {
				if (!prefs.guide) return '';
				const g = guideView(s);
				if (!g) return '';
				const item = (st: GuideView['steps'][number]) => {
					const now = st.id === g.current;
					const go = now && st.tab && st.tab !== tab ? `<button class="guide-go" data-tab="${st.tab}">去看看</button>` : '';
					return `<li class="${st.done ? 'done' : now ? 'now' : ''}"${now ? ' aria-current="step"' : ''}><span class="tick" aria-hidden="true">${st.done ? '✓' : ''}</span><span>${esc(st.title)}${now ? '<em class="now-tag">现在</em>' : ''}<small>${esc(st.hint)}</small>${go}</span><span class="sr">${st.done ? '（已完成）' : now ? '（下一步）' : ''}</span></li>`;
				};
				return `<div class="card guide"><div class="guide-head"><h3>新手指南 · 第 ${g.day} 天 <span class="muted">${g.done}/${g.total}</span></h3><button data-guide-close>知道了</button></div>
					<ol>${g.steps.map(item).join('')}</ol>${g.next ? `<p class="guide-next">做完这些或到第 ${g.day + 1} 天解开：${esc(g.next)}</p>` : ''}</div>`;
			}

			// 每日摘要（第 27 轮）：跨过午夜后的那一天，今天页顶上显示上一天的变化和日志；点「知道了」后这一天不再显示（只记在本机）
			const RECAP_KEY = 'earth.recap.v1';
			function recapCard(s: PlayerState) {
				const y = recapFor(s);
				if (!prefs.recap || !y || store.get(RECAP_KEY) === String(y.day)) return '';
				const title = y.days > 1 ? `过去 ${y.days} 天回顾（第 ${y.day + 1}–${y.day + y.days} 天）` : `昨天回顾（第 ${y.day + 1} 天）`;
				const money = y.cash === 0 ? '现金没变' : `现金 ${y.cash > 0 ? '+' : '−'}$${Math.abs(y.cash).toLocaleString()}`;
				const rep = Math.round(y.respect * 10) / 10;
				const parts = [money, rep ? `声望 ${rep > 0 ? '+' : '−'}${Math.abs(rep)}` : '', y.places ? `新去了 ${y.places} 个地方` : ''].filter(Boolean);
				const lines = recapLog(s, y).map((j) => `<li><span class="muted">${formatClock(j.t).split(' ')[1]}</span> ${esc(j.text)}</li>`).join('');
				return `<div class="card recap"><div class="guide-head"><h3>${title}</h3><button data-recap-close="${y.day}">知道了</button></div>
					<p>${parts.join(' · ')}</p>${lines ? `<ul class="recap-log">${lines}</ul>` : '<p class="muted">那天没有记下什么特别的事。</p>'}</div>`;
			}

			/** 周结算预警：两天内要结算、现金不够付这周的固定开销时提醒（出租收入不计入，按最坏情况算） */
			function settleCard(s: PlayerState) {
				const wc = weeklyCosts(s);
				const days = Math.max(0, s.nextWeek - dayOf(s.clock));
				if (!wc.total || days > 2 || s.cash >= wc.total) return '';
				const parts = [wc.rent ? `房租 $${wc.rent}` : '', wc.property ? `房产 $${wc.property}` : '', wc.vehicle ? `车辆 $${wc.vehicle}` : ''].filter(Boolean).join(' + ');
				const risks = [wc.rent ? '付不起房租会被收回住处（家具半价折现）' : '', wc.property ? `房产连续欠款超过 ${FINANCE.graceWeeks} 次会被强制卖掉` : '', wc.vehicle ? '付不起车辆保险麻烦值 +8' : ''].filter(Boolean).join('；');
				return `<div class="card warn" role="status"><h3>${days ? `${days} 天后` : '今天'}周结算，钱不够</h3><p>要付 $${wc.total.toLocaleString()}（${parts}），现在只有 $${s.cash.toLocaleString()}，还差 $${(wc.total - s.cash).toLocaleString()}。</p><p style="margin-top:4px">${risks}。</p></div>`;
			}

			/** 分享用的一段文字：只放展示信息，不含存档 id 和同步码 */
			function shareText(s: PlayerState) {
				const lv = level(s.respect);
				const places = region.locations.filter((l) => s.visited[l.id]).length;
				const ach = achievements(s, region);
				return `我在「地球人生 · 西澳」里是 ${s.name}（Lv${lv.lv} ${lv.title}），过了 ${dayOf(s.clock) + 1} 天，去过 ${places}/${region.locations.length} 个地方，净资产 $${Math.round(netWorth(s)).toLocaleString()}，成就 ${ach.filter((a) => a.done).length}/${ach.length}。`;
			}
			async function shareProgress() {
				const s = state!;
				const text = shareText(s);
				const url = `${location.protocol}//${location.host}/earth/`;
				const nav = navigator as Navigator & { share?: (d: { title: string; text: string; url: string }) => Promise<void> };
				try {
					if (nav.share) { await nav.share({ title: '地球人生', text, url }); return; }
					await navigator.clipboard.writeText(`${text} ${url}`);
					toast('已复制，可以粘贴给朋友');
				} catch (e) {
					// 用户取消分享不提示；其他失败（不支持剪贴板）给出文字让人手动复制
					if ((e as Error)?.name !== 'AbortError') toast('分享失败，可以在「设置」里手动复制');
				}
			}

			/** 留言板：这个地点最近的留言，和留一句的输入框 */
			function notesCard(s: PlayerState) {
				loadNotes();
				const list = notesLoc === s.loc ? notesList : [];
				const ago = (at: number) => { const m = Math.max(0, Math.round((srvNow() - at) / 60_000)); return m < 60 ? `${m} 分钟前` : m < 1440 ? `${Math.round(m / 60)} 小时前` : `${Math.round(m / 1440)} 天前`; };
				const rows = list.map((n) => `<div class="note"><span class="ico">${esc(n.avatar)}</span><span class="body"><b>${esc(n.name)}</b> <small class="muted">${ago(n.at)}</small><br />${esc(n.text)}</span>${n.mine ? `<button data-note="delete" data-note-id="${esc(n.id)}" aria-label="删掉这条留言">删</button>` : ''}</div>`).join('');
				return `<div class="card"><h3>📝 留言板</h3><p class="muted">给后来到${esc(getLocation(region, s.loc)!.name)}的人留一句话。不能带网址和联系方式；每人每天最多 3 条，同一个地方一天一条。</p>
					${rows || '<p class="muted">还没有人在这里留言。</p>'}
					<form class="inline" id="note-form" style="margin-top:8px"><input id="note-input" maxlength="${NOTE_MAX}" placeholder="写一句给后来的人…" aria-label="留言内容" autocomplete="off" /><button class="primary">贴上</button></form></div>`;
			}

			function panelPlace() {
				const s = state!;
				const loc = getLocation(region, s.loc)!;
				const acts = activitiesAt(s, region).map(({ act, blocked }) => `
					<button class="row" data-act="${act.id}" ${blocked ? 'disabled' : ''}>
						<span class="ico">${act.icon}</span>
						<span class="body">${esc(act.name)}<small>${esc(blocked ?? act.desc)}</small></span>
						<span class="meta"><b>${act.fx.cash ? (act.fx.cash > 0 ? '+' : '−') + '$' + Math.abs(act.fx.cash) : '免费'}</b>${minutesLabel(act.minutes)}</span>
					</button>`).join('');
				const pois = region.pois.filter((p) => p.loc === loc.id);
				const poiHtml = pois.length ? `<div class="card"><h3>打卡点</h3><p>人到现场、打开定位即可打卡（${pois.filter((p) => s.checkins.includes(p.id)).length}/${pois.length}）</p>
					<div class="list" style="margin-top:8px">${pois.map((p) => `<div class="row"><span class="ico">${s.checkins.includes(p.id) ? '✅' : '📌'}</span><span class="body">${esc(p.name)}<small>${esc(p.category)}</small></span></div>`).join('')}</div></div>` : '';
				const people = npcsAt(s, region);
				const absent = NPCS.filter((n) => !people.some((a) => a.npc.id === n.id)).map((n) => ({ n, plan: npcStatus(n, s.clock).plan }))
					.filter(({ n, plan }) => plan.loc === loc.id || n.loc === loc.id);
				const bagIds = Object.keys(s.inventory).filter((id) => s.inventory[id] > 0 && getItem(id));
				const giftLabel = (npcId: string, itemId: string) => {
					const n = NPCS.find((x) => x.id === npcId)!;
					return getRelation(s, npcId).known.includes(itemId) ? `（${GIFT_LABEL[giftReaction(n, itemId)]}）` : '';
				};
				const peopleHtml = people.length || absent.length ? `<div class="card"><h3>这里的人</h3>${people.map(({ npc, rel, tier, blocked, nextStory }) => `
					<div style="margin-top:10px"><div class="row"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${esc(npc.bio)}</small></span><span class="meta">${tier}<br/>${Math.round(rel.score)}/100</span></div>
					<div class="inline" style="margin-top:6px">${(['chat', 'help'] as const).map((a) => `<button data-npc="${npc.id}" data-npc-act="${a}" ${blocked[a] ? `disabled title="${esc(blocked[a])}"` : ''}>${{ chat: '聊天', help: '帮忙' }[a]}</button>`).join('')}${npc.perk ? `<button data-npc="${npc.id}" data-npc-act="perk" ${blocked.perk ? `disabled title="${esc(blocked.perk)}"` : ''}>✨ ${esc(npc.perk.name)}</button>` : ''}</div>
					${bagIds.length ? `<div class="inline" style="margin-top:6px"><span class="muted">送礼：</span>${bagIds.map((id) => `<button data-npc="${npc.id}" data-npc-act="gift" data-npc-item="${id}" ${blocked.gift ? `disabled title="${esc(blocked.gift)}"` : ''}>${getItem(id)!.icon} ${esc(getItem(id)!.name)}${giftLabel(npc.id, id)}</button>`).join('')}</div>` : ''}
					${Object.values(blocked).some(Boolean) ? `<p style="margin-top:4px">${esc([...new Set(Object.values(blocked).filter(Boolean))].join('；'))}</p>` : ''}
					${nextStory !== undefined ? `<p style="margin-top:4px" class="muted">关系到 ${nextStory}（${relationTier(nextStory)}）会有新故事。</p>` : ''}</div>`).join('')}
					${absent.map(({ n, plan }) => `<p style="margin-top:8px">${esc(n.name)}（${esc(n.role)}）现在不在。${plan.loc === loc.id ? `今天 ${hoursLabel(plan.hours)} 在这里${plan.note ? `：${esc(plan.note)}` : ''}。` : `今天去了${esc(getLocation(region, plan.loc)?.name ?? '')}${plan.note ? `（${esc(plan.note)}）` : ''}，平时 ${hoursLabel(n.hours)} 在这里。`}</p>`).join('')}</div>` : '';
				const job = s.job;
				const career = job ? getCareer(job.career) : undefined;
				const workHere = job && job.loc === loc.id && career;
				const offers = careersAt(s, region).filter((o) => !(workHere && o.career.id === job!.career));
				const shiftWhy = shiftBlocked(s);
				const workHtml = workHere || offers.length ? `<div class="card"><h3>工作</h3>
					${workHere ? `<div class="row" style="margin-top:8px"><span class="body">${esc(career!.name)} · ${esc(career!.levels[job!.level].title)}<small>每班 $${careerPay(s, job!.career, job!.level)}${certBonus(s, job!.career) ? `（含证书 +${Math.round(certBonus(s, job!.career) * 100)}%）` : ''} · ${Math.round(career!.minutes / 60)} 小时 · ${hoursLabel(career!.start)} 开工</small></span><button class="primary" data-job="work" ${shiftWhy ? 'disabled' : ''}>上班</button></div>${shiftWhy ? `<p style="margin-top:4px">${esc(shiftWhy)}</p>` : ''}` : ''}
					${offers.map(({ career: c, blocked }) => `<div class="row" style="margin-top:8px"><span class="body">${esc(c.name)} · 招${esc(c.levels[0].title)}<small>${esc(blocked ?? `每班 $${careerPay(s, c.id, 0)}，最高可升到${c.levels[c.levels.length - 1].title}`)}</small></span><button data-job="apply" data-career="${c.id}" ${blocked ? 'disabled' : ''}>${job ? '跳槽' : '应聘'}</button></div>`).join('')}</div>` : '';
				const homeHere = s.home && s.home.loc === loc.id ? getHome(s.home.type) : undefined;
				const rentals = homesAt(s, region);
				const cookWhy = homeActionBlocked(s, 'cook');
				const relaxWhy = homeActionBlocked(s, 'relax');
				const homeHtml = homeHere || rentals.length ? `<div class="card"><h3>住处</h3>
					${homeHere ? `<div class="row" style="margin-top:8px"><span class="body">你的${esc(homeHere.name)}<small>${s.home!.owned ? '自有房产，不交房租' : `每周 $${homeHere.rentWeek}`} · ${Math.max(0, s.nextWeek - dayOf(s.clock))} 天后结算 · 心情 +${homeComfort(s)}</small></span><button class="primary" data-home="sleep">回家睡觉</button></div>
					<div class="inline" style="margin-top:8px"><button data-home="cook" ${cookWhy ? 'disabled' : ''}>做饭 $${HOME_COOK.cost}</button><button data-home="relax" ${relaxWhy ? 'disabled' : ''}>放松</button></div>
					${cookWhy || relaxWhy ? `<p style="margin-top:4px">${esc([...new Set([cookWhy, relaxWhy].filter(Boolean))].join('；'))}</p>` : ''}
					<details style="margin-top:8px"><summary class="muted">添置家具（已有 ${Object.keys(s.home!.furniture).length}/${Object.keys(FURNITURE_SLOTS).length} 类，折现值 $${furnitureValue(s)}）</summary>
