			/** 目的地卡里的走法：并排方块选一种（默认最便宜能走的），下面写路费后剩多少，再一个「出发」大按钮 */
			function waysHtml(s: PlayerState, destId: string, ways: ReturnType<typeof travelOptions>) {
				const open = ways.filter((o) => o.available);
				const cheapest = [...open].sort((a, b) => a.cost - b.cost)[0];
				const chosen = (destMode?.dest === destId && open.find((o) => o.mode === destMode!.mode)) || cheapest;
				const tiles = ways.map((o) => {
					const on = o === chosen;
					return `<button class="tile${on ? ' on' : ''}" data-dmode="${o.mode}" data-dest="${destId}" aria-pressed="${on}" ${o.available ? '' : 'disabled'}><b>${o.label}</b><small>$${o.cost} · ${minutesLabel(o.minutes)}</small>${o.reason ? `<small>${esc(o.reason)}</small>` : ''}</button>`;
				}).join('');
				if (!chosen) return `<div class="tiles">${tiles}</div>`;
				const left = s.cash - chosen.cost;
				const wc = weeklyCosts(s);
				const days = s.nextWeek - dayOf(s.clock);
				const settle = wc.total > 0 && days <= 2 ? `，${days ? `${days} 天后` : '今天'}周结算要付 $${wc.total.toLocaleString()}${left < wc.total ? '，会不够' : '，还够'}` : '';
				const name = getLocation(region, destId)!.name;
				return `<div class="tiles">${tiles}</div>
					<p class="budget${settle && left < wc.total ? ' tight' : ''}">${esc(chosen.label)}路费后剩 $${left.toLocaleString()}${settle}。</p>
					<button class="primary wide" data-go="${destId}" data-mode="${chosen.mode}">出发去${esc(name)} · ${esc(chosen.label)} $${chosen.cost}</button>`;
			}

			function panelGo() {
				const s = state!;
				const opts = travelOptions(s, region);
				// 点了地图上的某个地点：先给一张目的地卡片（介绍、今天的天气、谁在那里、签名事件、从这里怎么去）
				const dest = selected && selected !== s.loc ? getLocation(region, selected) : undefined;
				let note = '';
				if (dest) {
					const w = weatherOn(dest.id, dayOf(s.clock));
					const sig = EVENTS.some((e) => e.once && e.locs?.includes(dest.id) && !s.seen.includes(e.id));
					const people = NPCS.filter((n) => { const x = npcStatus(n, s.clock); return x.plan.loc === dest.id && x.state !== 'after'; }).map((n) => esc(n.name));
					const ways = opts.filter((o) => o.to === dest.id);
					note = `<div class="card dest"><div class="dest-head"><h3>${KIND_ICON[dest.kind]} ${esc(dest.name)} <span class="muted">${esc(dest.en)}</span></h3><button data-loc="${dest.id}" aria-label="关闭">✕</button></div>
						<p>${esc(dest.blurb)}</p>
						<div class="pills" style="margin-top:8px"><span class="pill">${w.icon} 今天${esc(w.name)}</span>${s.visited[dest.id] ? `<span class="pill up">去过 ${s.visited[dest.id]} 次</span>` : '<span class="pill cost">没去过</span>'}${sig ? '<span class="pill cost">首次到达有专属事件</span>' : ''}${people.length ? `<span class="pill">今天在那里：${people.join('、')}</span>` : ''}</div>
						${ways.length ? waysHtml(s, dest.id, ways)
							: `<p style="margin-top:8px">从${esc(getLocation(region, s.loc)!.name)}没有直达的路线，需要先到别处中转。</p>`}</div>`;
				}
				// 周结算两天内到：路费付完会不够付这周固定开销的，提醒一下
				const wcGo = weeklyCosts(s);
				const settleSoon = wcGo.total > 0 && s.nextWeek - dayOf(s.clock) <= 2;
				const rows = opts.map((o) => {
					const to = getLocation(region, o.to)!;
					const tight = settleSoon && o.available && s.cash - o.cost < wcGo.total;
					const h = Math.floor(o.minutes / 60), m = o.minutes % 60;
					const fresh = !s.visited[o.to];
					return `<button class="row${selected === o.to ? ' sel' : ''}${fresh && o.available ? ' new' : ''}" data-go="${o.to}" data-mode="${o.mode}" ${o.available ? '' : 'disabled'}>
						<span class="ico">${KIND_ICON[to.kind]}</span>
						<span class="body">${esc(to.name)} <span title="今天的天气">${weatherOn(o.to, dayOf(s.clock)).icon}</span><small>${fresh ? '没去过 · ' : ''}${o.label} · ${o.km} km${o.reason ? ' · ' + esc(o.reason) : ''}${tight ? ` · <span class="warn-text">去了周结算会不够（要付 $${wcGo.total}）</span>` : ''}</small></span>
						<span class="meta"><b>$${o.cost}</b>${h ? h + ' 小时 ' : ''}${m} 分</span></button>`;
				}).join('');
				return `${note}<p class="section-title">从${esc(getLocation(region, s.loc)!.name)}出发</p><div class="list">${rows}</div><p class="muted">点地图上的地点可以高亮对应路线。虚线是航班，长虚线是越野土路（需四驱），橙色点是没去过的地方。</p>`;
			}

			function panelMe() {
				const s = state!;
				const origin = ORIGINS.find((o) => o.id === s.origin)!;
				// 每项能力在哪练：涨得最多的 3 个互动（只看数据，不管当前在哪）
				const trainers = (k: (typeof SKILL_KEYS)[number]) => ACTIVITIES.filter((a) => (a.fx.skills?.[k] ?? 0) > 0).sort((a, b) => (b.fx.skills![k] ?? 0) - (a.fx.skills![k] ?? 0)).slice(0, 3).map((a) => a.name).join('、');
				const skills = SKILL_KEYS.map((k) => `<div class="skill"><span>${SKILL_META[k].icon}</span><div>${SKILL_META[k].name} <span class="muted">${SKILL_META[k].hint}</span>${trainers(k) ? `<small class="train">怎么练：${esc(trainers(k))}</small>` : ''}<div class="bar"><i style="width:${s.skills[k]}%"></i></div></div><b title="含特质、装备、心情的检定分">${checkScore(s, k).total}</b></div>`).join('');
				const vdef = getVehicle(s.vehicle);
				const veh = vdef ? `${vdef.icon} ${vdef.name}（值 $${resaleValue(vdef.id).toLocaleString()}）· 开了 ${s.car.km.toLocaleString()} 公里，离上次保养 ${s.car.since.toLocaleString()} 公里${breakdownChance(s) > 0 ? `，该保养了（每趟抛锚几率 ${Math.round(breakdownChance(s) * 100)}%）` : ''}` : '无（坐巴士）';
				const titles = areaTitles(s);
				const album = Object.entries(AREAS).map(([id, a]) => {
					const all = EXPERIENCES.filter((e) => e.area === id);
					const got = all.filter((e) => s.collected.includes(e.id));
					return `<div class="row" style="margin-top:6px"><span class="body">${esc(a.name)} ${got.length}/${all.length}<small>${all.map((e) => (s.collected.includes(e.id) ? '✅' : '⬜') + esc(e.name)).join(' · ')}</small></span></div>`;
				}).join('');
				const lv = level(s.respect);
				const m = mood(s);
				const tier = moodTier(m);
				const mb = moodBreakdown(s);
				const traits = s.traits.map((id) => getTrait(id)).filter(Boolean).map((t) => `<span class="tag" title="${esc(t!.desc)}">${esc(t!.name)}</span>`).join('');
				const jc = s.job ? getCareer(s.job.career) : undefined;
				const promo = promotionStatus(s);
				const hd = s.home ? getHome(s.home.type) : undefined;
				const wc = weeklyCosts(s);
				const estate = s.properties.map((op) => {
					const pr = getProperty(op.id);
					if (!pr) return '';
					const living = s.home?.owned === op.id;
					const status = living ? '自住' : op.rented ? (op.fresh ? `刚挂牌，下个结算日后起收租 $${pr.rentIncome}/周` : `出租中 +$${pr.rentIncome}/周`) : '空置';
					return `<div style="margin-top:10px"><div class="row"><span class="body">${esc(pr.name)} · ${esc(getLocation(region, pr.loc)!.name)}<small>${status} · 物业费 $${pr.weekly}/周${op.loan ? ` · 贷款 $${op.loan.toLocaleString()}，每周还 $${loanPayment(pr, op.loan)}` : ' · 无贷款'}${op.missed ? ` · ⚠️ 已欠款 ${op.missed} 次（超过 ${FINANCE.graceWeeks} 次强制卖房）` : ''}</small></span><span class="meta">卖出到手<br/>$${saleProceeds(pr, op.loan).toLocaleString()}</span></div>
					<div class="inline" style="margin-top:6px;flex-wrap:wrap">${living ? '' : `<button data-prop="movein" data-prop-id="${op.id}">搬进去</button>`}<button data-prop="rentout" data-prop-id="${op.id}">${op.rented ? '停止出租' : '出租'}</button>${op.loan ? `<button data-prop="repay" data-prop-id="${op.id}">提前还贷</button>` : ''}<button data-prop="sell" data-prop-id="${op.id}">卖掉</button></div></div>`;
				}).join('');
				const life = `
					<p>${jc ? `${esc(jc.name)}（${esc(getLocation(region, s.job!.loc)!.name)}）· ${esc(jc.levels[s.job!.level].title)} · 每班 $${careerPay(s, s.job!.career, s.job!.level)}` : '无业。'}${s.certs.length ? ` 证书：${s.certs.map((id) => esc(CERTS.find((c) => c.id === id)?.name ?? id)).join('、')}。` : ''}${jc ? '' : '到城镇、海滩、矿区等地方找工作。'}</p>
					${promo ? `<p>升职到${esc(promo.next.title)}：已上 ${promo.shifts}/${PROMOTE_SHIFTS} 班，表现好 ${promo.good}/${PROMOTE_GOOD} 班${promo.blocked ? `，还需${esc(promo.blocked)}` : ''}</p>` : jc ? '<p>已是最高职位。</p>' : ''}
					<p>${hd ? `住在${esc(getLocation(region, s.home!.loc)!.name)}的${esc(hd.name)}，家具：${Object.values(s.home!.furniture).map((id) => esc(getFurniture(id)?.name ?? '')).join('、') || '无'}` : '没有住处。在城镇可以租房，回家睡觉免费且恢复更多。'}</p>
					<p>每周固定开销 $${wc.total}${wc.total ? `（房租 $${wc.rent} + 车辆 $${wc.vehicle} + 房产 $${wc.property}）· ${Math.max(0, s.nextWeek - dayOf(s.clock))} 天后结算` : ''}</p>
					<div class="inline" style="margin-top:8px">${jc ? '<button data-job="quit">辞职</button>' : ''}${hd ? '<button data-home="leave">退租</button>' : ''}</div>`;
				const npcName = (id: string) => NPCS.find((n) => n.id === id)?.name ?? id;
				const duoHtml = `<div class="card"><h3>朋友之间 ${s.duos.length}/${NPC_DUOS.length}</h3><p>两位朋友的好感都够了，和其中一位互动时会发生的事。</p><div class="ach-grid">${NPC_DUOS.map((d) => s.duos.includes(d.id)
					? `<div class="ach done"><span class="ach-ico" aria-hidden="true">🤝</span><span><b>${esc(d.title)}</b><small>${esc(d.text)}</small></span></div>`
					: `<div class="ach"><span class="ach-ico" aria-hidden="true">❔</span><span><b>${esc(npcName(d.a))} 和 ${esc(npcName(d.b))}</b><small>两人好感都到 ${d.at}</small></span></div>`).join('')}</div></div>`;
				const rels = Object.entries(s.relations).map(([id, r]) => {
					const npc = NPCS.find((n) => n.id === id);
					if (!npc) return '';
					const plan = npcStatus(npc, s.clock).plan;
					const where = `今天在${getLocation(region, plan.loc)?.name ?? ''} ${hoursLabel(plan.hours)}`;
					const known = r.known.map((i) => `${getItem(i)?.icon ?? ''}${GIFT_LABEL[giftReaction(npc, i)]}`).join(' ');
					return `<div class="skill"><span></span><div>${esc(npc.name)} <span class="muted">${esc(npc.role)} · ${esc(where)} · 故事 ${r.seen.length}/${npc.stories.length}${known ? ` · ${esc(known)}` : ''}</span><div class="bar"><i style="width:${Math.max(0, r.score)}%"></i></div></div><b title="${relationTier(r.score)}">${relationTier(r.score)}</b></div>`;
				}).join('');
				const bag = Object.entries(s.inventory).map(([id, n]) => {
					const it = getItem(id);
					if (!it) return '';
					return `<div class="row" style="margin-top:8px"><span class="ico">${it.icon}</span><span class="body">${esc(it.name)} ×${n}<small>${esc(it.desc)}</small></span>${it.use ? `<button data-use="${it.id}">使用</button>` : '<span class="meta">装备中</span>'}</div>`;
				}).join('');
				const ach = achievements(s, region);
				const achDone = ach.filter((a) => a.done).length;
				const achHtml = `<div class="card"><h3>成就 ${achDone}/${ach.length}</h3><div class="ach-grid">${ach.map((a) => `<div class="ach${a.done ? ' done' : ''}"><span class="ach-ico" aria-hidden="true">${a.def.icon}</span><span><b>${esc(a.def.name)}</b><small>${esc(a.def.desc)}${a.done ? '' : ` · ${a.cur.toLocaleString()}/${a.goal.toLocaleString()}`}</small></span><span class="sr">${a.done ? '（已达成）' : '（未达成）'}</span></div>`).join('')}</div></div>`;
				// 足迹：全部地点，去过的标出次数；点一下看去那里的走法（当前所在地回今天页）
				const placesVisited = region.locations.filter((l) => s.visited[l.id]).length;
				const trailHtml = `<div class="card"><h3>足迹 ${placesVisited}/${region.locations.length}</h3><div class="trail">${region.locations.map((l) => `<button class="${s.visited[l.id] ? 'been' : ''}" data-loc="${l.id}">${KIND_ICON[l.kind]} ${esc(l.name)}${s.visited[l.id] ? `<small>${l.id === s.loc ? '在这里' : `${s.visited[l.id]} 次`}</small>` : '<small>没去过</small>'}</button>`).join('')}</div></div>`;
				// 天气相册：每个地点一行，五种天气，拍到的点亮
				const photos = new Set(s.photos);
				const photoHtml = `<div class="card"><h3>天气相册 ${s.photos.length}/${region.locations.length * WEATHERS.length}</h3><p>抵达一个地方时，会按当天的天气收一张照片。同一个地方换个天气再来，能收到不一样的。</p>
					<div class="album">${region.locations.map((l) => `<div class="album-row"><span>${esc(l.name)}</span><span>${WEATHERS.map((w) => `<i class="${photos.has(`${l.id}|${w.id}`) ? 'got' : ''}" title="${esc(w.name)}">${w.icon}</i>`).join('')}</span><span class="sr">${WEATHERS.filter((w) => photos.has(`${l.id}|${w.id}`)).map((w) => w.name).join('、') || '还没有'}</span></div>`).join('')}</div></div>`;
				// 野生动物图鉴：见过的显示名字，没见过的只显示所属分组
				const dex = new Set(s.dex);
				const dexHtml = `<div class="card"><h3>野生动物图鉴 ${s.dex.length}/${ANIMALS.length}</h3><p>到了各地有机会看见动物，有的只在某个季节或清晨傍晚出现。一组集齐加声望。</p>
					<p>${dexProgress(s).map((g) => `${esc(g.name)} ${g.got}/${g.total}${g.done ? ' ✅' : ''}`).join(' · ')}</p>
					<div class="ach-grid">${ANIMALS.map((a) => dex.has(a.id)
						? `<div class="ach done"><span class="ach-ico" aria-hidden="true">${a.icon}</span><span><b>${esc(a.name)}</b><small>${esc(a.desc)}</small></span></div>`
						: `<div class="ach"><span class="ach-ico" aria-hidden="true">❔</span><span><b>？？？</b><small>${esc(({ sea: '海洋', land: '陆地', bird: '飞鸟' } as Record<string, string>)[a.group])}</small></span><span class="sr">（还没见过）</span></div>`).join('')}</div></div>`;
				const fishHtml2 = `<div class="card"><h3>鱼获 ${Object.keys(s.fish).length}/${FISH.length}</h3><div class="ach-grid">${FISH.map((f) => s.fish[f.id]
					? `<div class="ach done"><span class="ach-ico" aria-hidden="true">${f.icon}</span><span><b>${esc(f.name)} ×${s.fish[f.id]}</b><small>${esc(f.desc)}</small></span></div>`
					: `<div class="ach"><span class="ach-ico" aria-hidden="true">❔</span><span><b>？？？</b><small>还没钓到</small></span></div>`).join('')}</div></div>`;
				// 见闻录：一次性的专属事件，见过的显示标题，没见过的只提示在哪
				const onceEvents = EVENTS.filter((e) => e.once && !e.venueTypes);
				const seenOnce = onceEvents.filter((e) => s.seen.includes(e.id)).length;
				// 和事件触发相同的匹配规则（地点、标签、类型任一命中）
				const where = (e: (typeof onceEvents)[number]) => region.locations.filter((l) => e.locs?.includes(l.id) || e.tags?.some((t) => l.tags.includes(t)) || e.kinds?.includes(l.kind)).map((l) => l.name).join('、') || '某个地方';
				const storyHtml = `<div class="card"><h3>见闻录 ${seenOnce}/${onceEvents.length}</h3><p>只会遇到一次的事。没见过的只告诉你在哪。</p><div class="ach-grid">${onceEvents.map((e) => s.seen.includes(e.id)
					? `<div class="ach done"><span class="ach-ico" aria-hidden="true">${e.icon}</span><span><b>${esc(e.title)}</b><small>${esc(where(e))}</small></span></div>`
					: `<div class="ach"><span class="ach-ico" aria-hidden="true">❔</span><span><b>？？？</b><small>${esc(where(e))}</small></span><span class="sr">（还没遇到）</span></div>`).join('')}</div></div>`;
				const card = {
					story: storyHtml,
					dex: dexHtml,
					fish: fishHtml2,
					photo: photoHtml,
					trail: trailHtml,
					ach: achHtml,
					me: `<div class="card"><h3>档案</h3><p>${origin.icon} ${origin.name} · 座驾：${veh}</p>
					<p>已探索 ${Object.keys(s.visited).length}/${region.locations.length} 个地点 · 麻烦值 ${Math.round(s.heat)}/100（${wantedStars(s.heat)} 星）</p>
						<p>Lv${lv.lv} ${lv.title} · 声望 ${Math.floor(s.respect)}${lv.next !== null ? ` / ${lv.next}` : ''} · 心情 ${m}（${tier.name}，检定 ${tier.check >= 0 ? '+' : ''}${tier.check}）</p>
						<div class="tags">${traits || '<span class="muted">没有性格特质</span>'}</div>
						<div class="inline" style="margin-top:10px"><button data-share>分享我的进度</button></div></div>`,
					mood: `<div class="card"><h3>心情 ${mb.total}（${tier.name}，检定 ${tier.check >= 0 ? '+' : ''}${tier.check}）</h3>
						<div style="margin-top:6px">
							<div class="mood-row"><span>生活需求（最低的一项拉低整体）</span><b>${mb.needs}</b></div>
							${mb.traits ? `<div class="mood-row"><span>性格特质</span><b class="${mb.traits > 0 ? 'up' : 'down'}">${mb.traits > 0 ? '+' : ''}${mb.traits}</b></div>` : ''}
							${mb.home ? `<div class="mood-row"><span>住处</span><b class="up">+${mb.home}</b></div>` : ''}
							${mb.moodlets.map((x) => `<div class="mood-row"><span>${x.def.icon} ${esc(x.def.name)} <span class="muted">还剩 ${x.minutesLeft >= 120 ? Math.round(x.minutesLeft / 60) + ' 小时' : Math.max(1, Math.round(x.minutesLeft)) + ' 分钟'}</span></span><b class="${x.def.value > 0 ? 'up' : 'down'}">${x.def.value > 0 ? '+' : ''}${x.def.value}</b></div>`).join('')}
						</div>
						${mb.moodlets.length ? '' : '<p style="margin-top:6px">做点开心的事——好好吃一顿、睡个好觉、完成心愿、去新地方——会留下几小时到几天的好心情。</p>'}
					</div>`,
					daily: (() => {
						// 一周 7 格：今天在第几格；明天接着来能领多少
						const pos = ((Math.max(1, s.daily.streak) - 1) % DAILY.cap) + 1;
						const tomorrow = dailyReward(s.daily.streak + 1);
						const dots = Array.from({ length: DAILY.cap }, (_, i) => `<span class="dot${i < pos ? ' on' : ''}${i === DAILY.cap - 1 ? ' big' : ''}" aria-hidden="true">${i === DAILY.cap - 1 ? '🎁' : i + 1}</span>`).join('');
						return `<div class="card"><h3>每日奖励 · 连续 ${s.daily.streak} 天</h3><div class="streak" role="img" aria-label="这一轮 7 天里已到第 ${pos} 天">${dots}</div>
							<p style="margin-top:8px">明天接着来能领 $${tomorrow.cash}${tomorrow.full ? `（满 ${DAILY.cap} 天大礼，含额外 $${DAILY.bonus}）` : ''}。断一天从头算（$${DAILY.base} 起）。</p></div>`;
					})(),
					assets: `<div class="card"><h3>资产 · 净值 $${netWorth(s).toLocaleString()}</h3><p>现金 $${s.cash.toLocaleString()}${vdef ? ` · ${esc(vdef.name)} $${resaleValue(vdef.id).toLocaleString()}` : ''}${furnitureValue(s) ? ` · 家具 $${furnitureValue(s)}` : ''}</p>${estate || '<p>还没有房产。在卡尔古利、珀斯、弗里曼特尔、玛格丽特河可以买房。</p>'}</div>`,
					album: `<div class="card"><h3>收藏册 ${s.collected.length}/${EXPERIENCES.length}</h3>${titles.length ? `<div class="tags">${titles.map((t) => `<span class="tag">🏅 ${esc(t)}</span>`).join('')}</div>` : '<p>在各地体验收费项目，集齐一个片区可获得称号。</p>'}${album}</div>`,
					life: `<div class="card"><h3>工作与住处</h3>${life}</div>`,
					rels: `<div class="card"><h3>人际关系</h3>${rels || '<p>还没认识什么人。去各地看看谁在那里。</p>'}</div>${duoHtml}`,
					bag: `<div class="card"><h3>背包</h3>${bag || '<p>空的。在地点页的商店里买东西。</p>'}</div>`,
					skills: `<div class="card"><h3>能力</h3><p>用得越多涨得越快。</p>${skills}</div>`,
					derived: `<div class="card"><h3>派生属性</h3>${(() => {
						const d = derivedStats(s);
						return `<p>体质 ${d.fitness}（体能 50% + 力量 30% + 游泳 20%）</p>
							<p>吸引力 ${d.appeal}（魅力 + 体质 15% + 心情修正${s.needs.hygiene < 30 ? ' − 邋遢 10' : ''}）</p>
							<p>体力消耗 ×${d.exertion} · 恢复 ×${d.recovery}</p>
							<p>状态系数 ×${d.efficiency.total}（心情 ×${d.efficiency.mood} · 健康 ×${d.efficiency.health} · 疲劳 ×${d.efficiency.fatigue}），训练收益和工作表现都乘它</p>`;
					})()}</div>`,
				};
				const sections: Record<string, string[]> = { overview: ['daily', 'ach', 'photo', 'mood', 'me', 'story', 'dex', 'fish', 'trail', 'skills', 'derived'], assets: ['assets', 'life', 'bag', 'album'], people: ['rels'] };
				const head = `<div class="card me-head"><span class="avatar">${s.avatar}</span><span class="name"><b>${esc(s.name)}</b><span>${esc(origin.name)}${s.traits.length ? ' · ' + s.traits.map((id) => esc(getTrait(id)?.name ?? '')).join(' · ') : ''} · 第 ${dayOf(s.clock) + 1} 天</span></span></div>`;
				const seg = `<div class="seg" role="tablist">${ME_TABS.map(([id, label]) => `<button role="tab" data-metab="${id}" class="${meTab === id ? 'on' : ''}" aria-selected="${meTab === id}">${label}</button>`).join('')}</div>`;
				const bodyHtml = meTab === 'log' ? panelLog() : meTab === 'sync' ? panelSync() : (sections[meTab] ?? sections.overview).map((k) => card[k as keyof typeof card]).join('');
				return head + seg + bodyHtml;
			}

			/** 共同事件：这里的队伍（加入/开始/退出）和这里能发起的事 */
			function coopCard(s: PlayerState) {
				loadCoop();
				const loc = getLocation(region, s.loc)!;
				const others = [...peers.values()].filter((p) => p.loc === s.loc && p.id !== myPeerId).length;
				const defs = coopsAt(s, region);
				const inLobby = coopLobbies.some((l) => l.mine);
				if (!defs.length && !coopLobbies.length) return `<div class="card coop"><h3>一起做点什么</h3><p class="muted">${esc(loc.name)}没有能和别人一起做的事。海滩、城里、小镇、港口、峡谷和内陆都有。</p></div>`;
				const lobbies = coopLobbies.map((l) => {
					const def = getCoop(l.coop);
					if (!def) return '';
					const blocked = coopBlocked(s, region, def);
					const members = l.members.map((m) => `<span class="tag">${esc(m.avatar)} ${esc(m.name)}${m.me ? '（你）' : ''} · ${esc(def.roles[m.role]?.label ?? '')}</span>`).join('');
					const canStart = l.host && l.members.length >= def.min;
					const lid = esc(l.id);
					const where = l.loc ? getLocation(region, l.loc)?.name ?? '' : '';
					const actions = l.starting
						? '<span class="muted">正在开始…</span>'
						: l.mine && l.away
						? `<span class="muted">队伍在${esc(where)}，你已经走开了，回去才能参加</span><button data-coop="leave" data-lobby="${lid}">${l.host ? '解散' : '退出'}</button>`
						: l.mine
						? `${l.host ? `<button class="primary" data-coop="start" data-lobby="${lid}" ${canStart ? '' : 'disabled'}>${canStart ? `开始（${l.members.length} 人）` : `等人加入（至少 ${def.min} 人）`}</button>` : '<span class="muted">等发起人开始</span>'}<button data-coop="leave" data-lobby="${lid}">${l.host ? '解散' : '退出'}</button>`
						: l.members.length >= def.max ? '<span class="muted">人满了</span>'
						: inLobby ? '<span class="muted">你已经在别的队伍里</span>'
						: def.roles.map((r, i) => `<button data-coop="join" data-lobby="${lid}" data-role="${i}" ${blocked ? 'disabled' : ''}>加入：${esc(r.label)}</button>`).join('');
					return `<div class="coop-item"><b>${def.icon} ${esc(def.title)}</b> <span class="muted">${l.members.length}/${def.max} 人${coopCostLabel(def)}</span><div class="tags">${members}</div>${blocked && !l.mine ? `<p class="muted">${esc(blocked)}</p>` : ''}<div class="inline">${actions}</div></div>`;
				}).join('');
				const open = inLobby ? '' : defs.filter(({ def }) => !coopLobbies.some((l) => l.coop === def.id)).map(({ def, blocked }) => `<div class="coop-item"><b>${def.icon} ${esc(def.title)}</b> <span class="muted">${def.min}–${def.max} 人${coopCostLabel(def)}</span><p>${esc(def.text)}</p>${blocked ? `<p class="muted">${esc(blocked)}</p>` : ''}
					<div class="inline">${def.roles.map((r, i) => `<button data-coop="open" data-coop-id="${def.id}" data-role="${i}" ${blocked ? 'disabled' : ''}>发起：${esc(r.label)}</button>`).join('')}</div></div>`).join('');
				return `<div class="card coop"><h3>一起做点什么</h3><p>和同一地点的玩家一起做：每人选一个分工，合起来检定，人越多越容易成功。${others ? `这里现在有 ${others} 位其他玩家。` : '这里暂时没有其他玩家：可以先发起，5 分钟内有人来就能开始。'}</p>
					${lobbies}${open}<div class="inline" style="margin-top:10px"><button data-coop="list" ${coopLoading ? 'disabled' : ''}>刷新</button></div></div>`;
			}

			/** 全服周目标：进度条、我出的力、领奖 */
			function weekCard(s: PlayerState) {
				loadWeek();
				if (!weekView) return '';
				const { goal, count, daysLeft, mine } = weekView;
				const pct = Math.min(100, Math.round((count / goal.target) * 100));
				// 我这边的份数以存档为准（刚做完的事服务端已经记上）
				const n = s.weekly?.week === weekView.week ? Math.max(s.weekly.n, mine.n) : mine.n;
				const why = mine.claimed ? '这周的奖励已经领过了。' : count < goal.target ? `全服还差 ${goal.target - count} 次。` : n < 1 ? '这周还没出过力，先去做一次吧。' : '';
				return `<div class="card week"><h3>${goal.icon} 全服周目标：${esc(goal.title)}</h3><p>${esc(goal.desc)}。还剩 ${daysLeft} 天。</p>
					<div class="bar" role="progressbar" aria-valuenow="${Math.min(count, goal.target)}" aria-valuemin="0" aria-valuemax="${goal.target}"><i style="width:${pct}%"></i></div>
					<p class="muted">全服 ${Math.min(count, goal.target)} / ${goal.target} · 我出了 ${n} 份力 · 达成后出过力的人各领 $${goal.reward.cash}、声望 +${goal.reward.respect}</p>
					<div class="inline" style="margin-top:8px"><button class="primary" data-week="claim" ${why ? 'disabled' : ''}>${mine.claimed ? '已领取' : '领奖'}</button>${why && !mine.claimed ? `<span class="muted">${esc(why)}</span>` : ''}</div></div>`;
			}

			/** 常遇见的人：一起做过共同事件、交易过的玩家；在线的标出在哪 */
			function metCard(s: PlayerState) {
				const list = metList(s);
				if (!list.length) return '';
				const today = realDayOf(srvNow());
				const rows = list.slice(0, 12).map((m) => {
					const p = peers.get(m.hash);
					const where = p ? (p.loc === s.loc ? '就在这里' : `在线 · ${esc(getLocation(region, p.loc)?.name ?? '')}`) : today - m.last <= 0 ? '今天见过' : `${today - m.last} 天前见过`;
					return `<div class="row"><span class="ico">${esc(m.avatar)}</span><span class="body">${esc(m.name)}<small>一起做过 ${m.n} 次事 · ${where}</small></span>${p && p.loc === s.loc && p.id !== myPeerId ? `<span class="meta"><button data-giftpick="${esc(m.hash)}" data-gift-name="${esc(m.name)}" aria-label="送${esc(m.name)}一件东西">🎁</button></span>` : ''}</div>`;
				}).join('');
				return `<div class="card"><h3>常遇见的人</h3><p class="muted">一起做过共同事件、送过礼或做过买卖的玩家。</p><div class="list" style="margin-top:8px">${rows}</div></div>`;
			}

			/** 送礼与二手摊：选要送的东西、别人送我的、我挂出去的 */
			function tradeCard(s: PlayerState) {
				loadTrade();
				const day = realDayOf(srvNow());
				const parts: string[] = [];
				const owned = Object.entries(s.inventory).filter(([, n]) => n > 0).map(([id]) => getItem(id)).filter((x): x is NonNullable<typeof x> => !!x);
				if (sellPick) {
					// 每件给三个价：最低、商店价、最高（在 50%–150% 之间）
					const rows = owned.map((it) => {
						const why = giveBlocked(s, it.id, day);
						const r = saleRange(it.id)!;
						const prices = [...new Set([r.min, Math.min(r.max, Math.max(r.min, it.price)), r.max])];
						return `<div class="row"><span class="ico">${it.icon}</span><span class="body">${esc(it.name)} ×${s.inventory[it.id]}<small>${why ? esc(why) : `商店价 $${it.price}`}</small></span><span class="meta">${prices.map((pr) => `<button data-trade="sale" data-item="${it.id}" data-price="${pr}" ${why ? 'disabled' : ''}>$${pr}</button>`).join(' ')}</span></div>`;
					}).join('');
					parts.push(`<div class="trade-pick"><b>摆到${esc(getLocation(region, s.loc)!.name)}的二手摊，卖多少？</b>${rows ? `<div class="list" style="margin-top:8px">${rows}</div>` : '<p class="muted">背包里没有能卖的东西。</p>'}<div class="inline" style="margin-top:8px"><button data-trade="pickcancel">不卖了</button></div></div>`);
				}
				if (giftTo) {
					const rows = owned.map((it) => {
						const why = giveBlocked(s, it.id, day);
						return `<button class="row" data-trade="gift" data-item="${it.id}" ${why ? 'disabled' : ''}><span class="ico">${it.icon}</span><span class="body">${esc(it.name)} ×${s.inventory[it.id]}${why ? `<small>${esc(why)}</small>` : ''}</span></button>`;
					}).join('');
					parts.push(`<div class="trade-pick"><b>送给${esc(giftTo.name)}什么？</b>${rows ? `<div class="list" style="margin-top:8px">${rows}</div>` : '<p class="muted">背包里没有能送的东西。</p>'}<div class="inline" style="margin-top:8px"><button data-trade="pickcancel">不送了</button></div></div>`);
				}
				for (const o of tradeOffers) {
					const it = getItem(o.item);
					if (!it) continue;
					const lid = esc(o.id);
					if (o.mine) {
						const where = o.loc !== s.loc ? `（在${esc(getLocation(region, o.loc)?.name ?? '')}）` : '';
						const what = o.kind === 'gift' ? `等${esc(o.toName)}收下 ${it.icon} ${esc(it.name)}` : `二手摊上的 ${it.icon} ${esc(it.name)} · $${o.price}`;
						parts.push(`<div class="row"><span class="body">${what}${where}</span><span class="meta">${o.taking ? '正在交接…' : `<button data-trade="cancel" data-offer="${lid}">撤回</button>`}</span></div>`);
					} else if (o.kind === 'gift') {
						const why = takeBlocked(s, o.item, 0, day);
						parts.push(`<div class="row"><span class="ico">${esc(o.avatar)}</span><span class="body">${esc(o.name)}想送你 ${it.icon} ${esc(it.name)}${why ? `<small>${esc(why)}</small>` : ''}</span><span class="meta"><button class="primary" data-trade="accept" data-offer="${lid}" ${why || o.taking ? 'disabled' : ''}>收下</button> <button data-trade="decline" data-offer="${lid}" ${o.taking ? 'disabled' : ''}>不要</button></span></div>`);
					} else {
						const why = takeBlocked(s, o.item, o.price, day);
						parts.push(`<div class="row"><span class="ico">${esc(o.avatar)}</span><span class="body">${esc(o.name)}的二手摊 · ${it.icon} ${esc(it.name)}<small>${why ? esc(why) : `商店价 $${it.price}`}</small></span><span class="meta"><button class="primary" data-trade="accept" data-offer="${lid}" ${why || o.taking ? 'disabled' : ''}>$${o.price} 买下</button></span></div>`);
					}
				}
				const sellBtn = !sellPick && !giftTo && owned.length ? `<div class="inline" style="margin-top:8px"><button data-trade="sellpick">摆个二手摊</button></div>` : '';
				if (!parts.length && !sellBtn) return '';
				return `<div class="card trade"><h3>🎁 送礼与二手摊</h3><p class="muted">每人每天最多送出、收下各 5 次（买卖也算）；挂着的单 30 分钟没人接就撤下，价格在商店价的一半到一倍半之间。</p>${parts.join('')}${sellBtn}</div>`;
			}

			function boardCard() {
				loadBoard();
				const row = (r: BoardRow) => `<div class="row"><span class="ico">${r.rank}</span><span class="body">${esc(r.avatar)} ${r.me ? `<b>${esc(r.name)}（你）</b>` : esc(r.name)}<small>净资产 $${r.worth.toLocaleString()} · 第 ${r.day + 1} 天</small></span></div>`;
				const body = board
					? `${board.top.map(row).join('') || '<p class="muted">还没有人上榜。</p>'}${board.me && !board.top.some((r) => r.me) ? `<p class="muted" style="margin:6px 0">……</p>${row(board.me)}` : ''}`
					: `<p class="muted">${boardLoading ? '正在加载…' : esc(boardError || '正在加载…')}</p>`;
				return `<div class="card"><h3>🏆 净资产排行</h3><p>全服按净资产排名（现金 + 车 + 家具 + 房产 − 贷款），结果由服务端计算。${board ? `共 ${board.total} 人上榜。` : ''}</p>
					<div class="list" style="margin-top:8px">${body}</div>
					<div class="inline" style="margin-top:8px"><button data-board ${boardLoading ? 'disabled' : ''}>刷新</button></div></div>`;
			}

			// 手机上打字麻烦：本地频道的快捷短语，点一下直接发
			const QUICK_CHAT = ['你好！', '有人一起吗？', '这里天气不错', '谢谢！', '回头见'];
			function panelSocial() {
				const s = state!;
				const online = ws?.readyState === WebSocket.OPEN;
				const here = [...peers.values()].filter((p) => p.loc === s.loc && p.id !== myPeerId);
				const people = here.length ? here.map((p) => `<div class="row"><span class="ico">${esc(p.avatar)}</span><span class="body">${esc(p.name)}</span>
					<span class="emotes">${emotes.map((e) => `<button data-emote="${esc(e)}" data-to="${esc(p.id)}" aria-label="向${esc(p.name)}发送 ${esc(e)}">${esc(e)}</button>`).join(' ')} <button data-giftpick="${esc(p.id)}" data-gift-name="${esc(p.name)}" aria-label="送${esc(p.name)}一件东西">🎁</button></span></div>`).join('') : '<p class="muted">这里暂时只有你一个人。</p>';
				// 认识的当地人今天在哪：就在这里的标出来，在别处的可以直接看去那里的走法
				const presentIds = new Set(npcsAt(s, region).map((x) => x.npc.id));
				const known = Object.entries(s.relations)
					.map(([id, r]) => ({ npc: NPCS.find((n) => n.id === id), r }))
					.filter((x): x is { npc: (typeof NPCS)[number]; r: (typeof s.relations)[string] } => !!x.npc)
					.sort((a, b) => b.r.score - a.r.score);
				const knownHtml = known.length ? `<div class="card"><h3>认识的人今天在哪</h3><div class="list" style="margin-top:8px">${known.map(({ npc, r }) => {
					// 和引擎同一套判断（跨午夜沿用前一天的作息）
					const { plan, state: st } = npcStatus(npc, s.clock);
					const where = getLocation(region, plan.loc)?.name ?? '';
					const here = presentIds.has(npc.id);
					const sub = `${relationTier(r.score)} ${Math.round(r.score)} · ${here ? '就在这里' : `${esc(where)} ${hoursLabel(plan.hours)}${st === 'after' ? '（今天已经走了）' : ''}`}${plan.note ? ` · ${esc(plan.note)}` : ''}`;
					return here
						? `<button class="row" data-tab="place"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${sub}</small></span><span class="meta"><b>去打招呼</b></span></button>`
						: plan.loc === s.loc
							? `<div class="row"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${sub}</small></span><span class="meta">${st === 'after' ? '今天已经走了' : '还没到时间'}</span></div>`
							: `<button class="row" data-loc="${plan.loc}"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${sub}</small></span><span class="meta"><b>怎么去</b></span></button>`;
				}).join('')}</div></div>` : '';
				return `${knownHtml}<div class="card"><h3>${esc(getLocation(region, s.loc)!.name)}的人</h3><p>${online ? `全区在线 ${peers.size} 人` : '未连接，稍后自动重连…'}</p><div class="list" style="margin-top:8px">${people}</div></div>
					${weekCard(s)}
					${tradeCard(s)}
					${coopCard(s)}
					${metCard(s)}
					<div class="card"><h3>本地频道</h3><p>只有同一地点的玩家能看到。</p>
						<div class="chat" id="chat">${chats.map((c) => `<div>${esc(c.avatar)} <b>${esc(c.name)}</b> ${esc(c.text)}</div>`).join('')}</div>
						<div class="quick">${QUICK_CHAT.map((q, i) => `<button data-quick="${i}" ${online ? '' : 'disabled'}>${q}</button>`).join('')}</div>
						<form class="inline" id="chat-form"><input id="chat-input" maxlength="120" placeholder="说点什么…" aria-label="聊天消息" autocomplete="off" ${online ? '' : 'disabled'} /><button class="primary" ${online ? '' : 'disabled'}>发送</button></form></div>
					${boardCard()}`;
			}

			function panelLog() {
				// 按游戏日分组，新的在上面；每组一个日期标题
				const groups = new Map<number, typeof state.journal>();
				for (const j of [...state!.journal].reverse()) {
					const d = dayOf(j.t);
					if (!groups.has(d)) groups.set(d, []);
					groups.get(d)!.push(j);
				}
				const rows = [...groups].map(([d, items]) => `<h4 class="log-day">第 ${d + 1} 天 · ${dateLabel(d * 1440)}</h4>${items.map((j) => `<div class="log-row"><span class="t">${formatClock(j.t).split(' ')[1] ?? ''}</span><span>${esc(j.text)}</span></div>`).join('')}`).join('');
				return `<div class="card"><h3>人生日志</h3><p>最近 ${state!.journal.length} 条</p>${rows}</div>`;
			}

			function panelNear() {
				const s = state!;
				const intro = `<div class="card"><h3>附近能做的事</h3><p>人在真实的餐馆、健身房、公园、图书馆、超市……打开定位，就能在游戏里吃饭、训练、打卡上班。服务端会检查定位精度、距离和移动速度。</p>
					${nearFix ? '<div class="inline" style="margin-top:8px"><button data-locate>📍 重新定位</button></div>' : '<button class="primary wide" data-locate>📍 打开定位，看看附近</button><p style="margin-top:6px">点店里的动作时，定位会发给服务器核对你是不是在店里；存档只记最近一次的大致位置（约 100 米），用来检查移动速度。</p>'}
					${nearFix ? `<p style="margin-top:6px" class="muted">定位误差约 ${Math.round(nearFix.acc)} 米 · ${Math.max(0, Math.round((Date.now() - nearFix.at) / 60000))} 分钟前</p>` : ''}</div>`;
				const ci = s.clockIn;
				const ciVenue = ci ? region.venues.find((v) => v.id === ci.venue) : undefined;
				// 上班中：深色卡，大字计时、离 8 小时上限的进度；人在这家店范围内时直接给「打下班卡」大按钮
				const clockCard = (clockOutBtn: string) => {
					if (!ci) return '';
					const mins = Math.max(0, Math.round((srvNow() - ci.at) / 60000));
					const stale = clockStale(s, srvNow());
					const pct = Math.min(100, Math.round(mins / FIX_RULES.shiftMaxMin * 100));
					const note = stale ? '这张卡太久没打下班卡，已经过期，不计薪：在任何带上班按钮的地点点一下就会作废；那里还能上班的话，会顺便打一张新卡。'
						: mins < FIX_RULES.clockInMinMin ? `至少上满 ${FIX_RULES.clockInMinMin} 分钟才能打下班卡。`
						: `离开前在这家店打下班卡（一次最多计 ${FIX_RULES.shiftMaxMin / 60} 小时）。`;
					return `<div class="next clock"><span class="lbl">${stale ? '上班卡已过期' : '上班中'}${ci.career ? ` · ${esc(getCareer(ci.career)?.name ?? '')}` : ' · 零工'}</span>
						<div class="clock-time"><b>${Math.floor(mins / 60)}:${String(mins % 60).padStart(2, '0')}</b><span>${esc(ciVenue?.name ?? ci.venue)}</span></div>
						<div class="bar dark"><i style="width:${pct}%"></i></div><p>${note}</p>${clockOutBtn}</div>`;
				};
				const clockHtml = clockCard('');
				if (!region.venues.length) return intro + clockHtml + '<div class="card"><p>这个区域的真实地点数据还在采集中（来自 OpenStreetMap）。</p></div>';
				if (!nearFix) return intro + clockHtml;
				const list = venuesNear(s, region, nearFix.lat, nearFix.lon, nearFix.acc, srvNow());
				if (!list.length) return intro + clockHtml + '<div class="card"><p>1.5 公里内没有收录的地点。</p></div>';
				const cards = list.slice(0, 20).map(({ venue, type, distM, inRange, ops }) => `<div class="card"><h3>${type.icon} ${esc(venue.name)} <span class="muted">${esc(type.name)} · ${distM} 米</span></h3>
					${inRange ? ops.map(({ op, outcome, blocked, voids, renews }) => {
						const clockOut = op.id === 'work' && s.clockIn?.venue === venue.id;
						const label = op.id === 'work' ? (voids ? '作废上班卡' : renews ? '作废旧卡并重新打卡' : clockOut ? '打下班卡' : '打上班卡') : op.name;
						const detail = blocked ?? (voids ? voids : renews ? renews : outcome ? outcome.notes.join(' · ') : op.desc);
						return `<button class="row" data-venue="${esc(venue.id)}" data-venue-op="${op.id}" ${blocked ? 'disabled' : ''}><span class="ico">${op.icon}</span><span class="body">${label}<small>${esc(detail)}</small></span></button>`;
					}).join('') : `<p>再走近 ${Math.max(0, distM - type.radiusM)} 米就能${ops.map((o) => o.op.name).join('、')}。</p>`}</div>`).join('');
				const here = ci ? list.find((x) => x.venue.id === ci.venue && x.inRange) : undefined;
				const outOp = here?.ops.find((o) => o.op.id === 'work');
				const outBtn = here && outOp && !outOp.blocked && !outOp.voids && !outOp.renews ? `<button data-venue="${esc(here.venue.id)}" data-venue-op="work">打下班卡</button>` : '';
				return intro + clockCard(outBtn) + cards;
			}

			// 玩法说明（静态文字，放在「设置」里）
			const HELP: [string, string][] = [
				['生活需求', '饱食、精力、清洁、娱乐、社交会随时间下降，最低的那项最影响心情；饱食或精力见底会掉健康。今天页的「下一步」会告诉你先做什么。'],
				['出行与事件', '在「出行」选地方和交通方式。第一次到一个地方常有专属事件，选项上标了花费和成功率。'],
				['真实地点', '本人走进真实的餐馆、健身房、公园、超市，在「附近」打开定位就能在游戏里吃饭、训练、打卡上班。'],
				['工作与住处', '在城镇应聘、每天上一个班；租房后回家睡觉恢复更多。每 7 天一次周结算，付房租、房贷和车辆保险。'],
				['天气', '每个地方每天的天气不一样，所有玩家看到的一样。风暴天海上活动取消，但可以去海边看风暴；抵达时会按天气收一张照片。'],
				['多设备', '同步码等同于密码：在另一台设备选「用同步码恢复」就能接着玩。所有结算都在服务器上，改本机数据没有用。'],
			];
			// 大字模式：整页放大约 12%，只记在本机
			function panelSync() {
				const seg = (key: 'font' | 'motion', label: string, opts: [string, string][]) =>
					`<div class="pref-row" role="group" aria-label="${label}"><span>${label}</span><div class="seg">${opts.map(([v, name]) => `<button data-pref="${key}" data-val="${v}" class="${prefs[key] === v ? 'on' : ''}" aria-pressed="${prefs[key] === v}">${name}</button>`).join('')}</div></div>`;
				const tips = TIP_OPTIONS.map(([k, name, hint]) => `<div class="row" style="margin-top:8px"><span class="body">${name}<small>${hint}</small></span><button data-pref="${k}" aria-pressed="${prefs[k]}">${prefs[k] ? '已开启' : '已关闭'}</button></div>`).join('');
				const sound = `<div class="row" style="margin-top:8px"><span class="body">音效<small>做事、事件、成就时的轻提示音，默认关闭</small></span><button data-pref="sound" aria-pressed="${prefs.sound}">${prefs.sound ? '已开启' : '已关闭'}</button></div>`;
				return `<div class="card"><h3>显示</h3><p class="muted">只在这台设备上生效。</p>${seg('font', '字号', FONT_OPTIONS)}${seg('motion', '动画', MOTION_OPTIONS)}${sound}</div>
					<div class="card"><h3>提示</h3>${tips}</div>
					<div class="card"><h3>玩法说明</h3><dl class="help">${HELP.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('')}</dl></div>
					<div class="card"><h3>多设备同步</h3><p>${esc(syncStatus)}</p>
						<p style="margin-top:8px">在另一台手机或电脑打开本页，选择“用同步码恢复”，粘贴下面这串码即可接着玩。</p>
						<div class="code">${esc(cred!.id)}.${esc(cred!.key)}</div>
						<div class="inline"><button data-copy>复制同步码</button><button data-pull>立即同步</button></div>
						<p style="margin-top:8px">同步码等同于密码，不要发给别人。</p></div>
					<div class="card"><h3>重新开始</h3><p>清除本机存档并创建新角色（云端旧档仍可用同步码找回）。</p><button data-reset style="margin-top:8px">删除本机存档</button></div>`;
			}

			/** 底部标签栏；社交标签上显示同地点在线的其他玩家数 */
			function renderTabs() {
				const hereCount = state ? [...peers.values()].filter((p) => p.loc === state!.loc && p.id !== myPeerId).length : 0;
				$('tabs').innerHTML = `<div class="tabs-in">${TABS.map(([id, label, icon]) => `<button data-tab="${id}" class="${tab === id ? 'on' : ''}" ${tab === id ? 'aria-current="page"' : ''}><svg viewBox="0 0 24 24" aria-hidden="true">${icon}</svg>${label}${id === 'social' && hereCount ? `<span class="badge" aria-label="这里有 ${hereCount} 位玩家在线">${hereCount}</span>` : ''}</button>`).join('')}</div>`;
			}

			function renderPanel() {
				renderTabs();
				// 地图只在「出行」页显示
				$('map-wrap').classList.toggle('hidden', tab !== 'go');
				renderMap();
				renderHud();
				const html = { place: panelPlace, near: panelNear, go: panelGo, me: panelMe, social: panelSocial }[tab]!();
				$('panel').innerHTML = html;
				const chat = document.getElementById('chat');
				if (chat) chat.scrollTop = chat.scrollHeight;
			}

			// 事件选完后的结果页（在弹窗里），点「继续」关闭；只在本机内存里
			let eventResult: { title: string; icon: string; text: string; delta: { text: string; up: boolean }[]; ach: string[] } | null = null;
			// 弹窗里现在显示的是哪一页（结果对象，或「事件 id@时刻」）：内容换了才移焦点，同一页重画（后台同步）不抢焦点
			let modalShown: unknown = null;
			function renderEvent() {
				const ev = state ? getPendingEvent(state) : null;
				const modal = $('modal');
				const game = $('game') as HTMLElement & { inert: boolean };
				if (!ev && eventResult) {
					// 没有下一个待处理事件时，显示刚才那个事件的结果
					const r = eventResult;
					modal.innerHTML = `<div class="sheet" role="dialog" aria-modal="true" aria-labelledby="ev-title">
						<div class="ev-hero"><span class="kicker">结果</span><h2 id="ev-title">${r.icon} ${esc(r.title)}</h2></div>
						<div class="ev-body"><p>${esc(r.text)}</p>
						${r.delta.length ? `<div class="pills">${r.delta.map((x) => `<span class="pill ${x.text.startsWith('用时') ? '' : x.up ? 'up' : 'bad'}">${esc(x.text)}</span>`).join('')}</div>` : ''}
						${r.ach.length ? `<p class="ach-line">🏅 达成成就：${r.ach.map(esc).join('、')}</p>` : ''}
						<button class="primary" data-result-close>继续</button></div></div>`;
					modal.classList.remove('hidden');
					game.inert = true;
					// 选完选项后原来聚焦的按钮被结果页替换掉了：焦点移到「继续」
					if (modalShown !== r) modal.querySelector<HTMLElement>('button')?.focus();
					modalShown = r;
					return;
				}
				if (!ev) {
					const wasOpen = !modal.classList.contains('hidden');
					modal.classList.add('hidden');
					game.inert = false;
					// 弹窗关掉后焦点不能留在已经隐藏的按钮上：移回页面内容，键盘和读屏用户接着往下读
					if (wasOpen) ($('panel') as HTMLElement).focus?.({ preventScroll: true });
					modalShown = null;
					return;
				}
				const s = state!;
				const loc = getLocation(region, s.loc);
				// 成功率：检定分 + 随机 0–60 ≥ 难度（和引擎同一个公式，只用于显示）
				const odds = (skill: Parameters<typeof checkScore>[1], dc: number) => Math.round(Math.max(0, Math.min(1, (checkScore(s, skill).total + 60 - dc) / 60)) * 100);
				const img = cgi['event:' + ev.id];
				modal.innerHTML = `<div class="sheet" role="dialog" aria-modal="true" aria-labelledby="ev-title">
					<div class="ev-hero">${img ? `<img src="${esc(img)}" alt="" loading="lazy" />` : ''}<span class="kicker">${loc ? `到达 ${esc(loc.name)} · ${formatClock(s.clock).split(' ')[1]}` : '事件'}${weatherAt(s).closesSea ? ' · 风暴天' : ''}</span><h2 id="ev-title">${ev.icon} ${esc(ev.title)}</h2></div>
					<div class="ev-body"><p>${esc(ev.text)}</p>
					<div class="list">${ev.choices.map((c, i) => {
						const poor = !!c.cost && c.cost > s.cash;
						const stormBlocked = c.exposed === 'sea' && !!weatherAt(s).closesSea;
						const pills = [
							stormBlocked ? '<span class="pill bad">今天有风暴，下不了海</span>' : '',
							c.cost ? `<span class="pill ${poor ? 'bad' : 'cost'}">${poor ? `需要 $${c.cost}，钱不够` : `$${c.cost}`}</span>` : '',
							c.check ? `<span class="pill" title="你 ${checkScore(s, c.check.skill).total} + 随机 0–60，难度 ${c.check.dc}">${SKILL_META[c.check.skill].icon} ${SKILL_META[c.check.skill].name}检定 · 成功率约 ${odds(c.check.skill, c.check.dc)}%</span>` : '',
						].join('');
						return `<button class="row choice" data-choice="${i}"${poor || stormBlocked ? ' disabled' : ''}><span class="label">${esc(choiceLabel(c))}</span>${pills ? `<span class="pills">${pills}</span>` : ''}</button>`;
					}).join('')}</div></div></div>`;
				modal.classList.remove('hidden');
				// 弹窗打开期间背后的页面不可点、不可聚焦；换成一个新事件时（刚打开或接着下一个）把焦点移到第一个能选的选项
				game.inert = true;
				const key = `${ev.id}@${s.clock}`;
				if (modalShown !== key) { modal.querySelector<HTMLElement>('button:not([disabled])')?.focus(); sfx('event'); }
				modalShown = key;
			}

			function render() {
				if (!state) { $('game').classList.add('hidden'); $('create').classList.remove('hidden'); return; }
				$('create').classList.add('hidden');
				$('game').classList.remove('hidden');
				const pid = period(state.clock).id;
				for (const p of PERIOD_IDS) document.documentElement?.classList?.toggle('p-' + p, p === pid);
				renderPanel(); // 里面会画顶栏和（出行页的）地图
				renderEvent();
				if (dailyNote) {
					const note = dailyNote;
					dailyNote = '';
					setTimeout(() => toast('🎁 ' + note), 400);
				}
			}

			// ---------- 输入 ----------
			// 键盘：事件结果页按 Esc 等于点「继续」（还没选的事件必须选一个，Esc 不关）
			document.addEventListener('keydown', (e) => {
				if ((e as KeyboardEvent).key !== 'Escape' || !eventResult || (state && getPendingEvent(state))) return;
				eventResult = null;
				renderEvent();
			});
			document.addEventListener('click', (e) => {
				const t = (e.target as Element).closest<HTMLElement>('[data-tab],[data-metab],[data-guide-close],[data-recap-close],[data-share],[data-pref],[data-result-close],[data-quick],[data-act],[data-go],[data-loc],[data-choice],[data-gps],[data-locate],[data-venue],[data-emote],[data-copy],[data-pull],[data-board],[data-reset],[data-buy],[data-use],[data-npc],[data-job],[data-home],[data-veh],[data-course],[data-cert],[data-fish],[data-photo],[data-exp],[data-furn],[data-prop],[data-dmode],[data-coop],[data-giftpick],[data-trade],[data-week],[data-note]');
				if (!t || !state || (t as HTMLButtonElement).disabled) return;
				const d = t.dataset;
				if (d.tab) {
					tab = d.tab;
					if (t.classList.contains('moodchip')) meTab = 'overview';
					renderPanel();
					window.scrollTo({ top: 0 });
					// 键盘和读屏用户：焦点移到新页面的内容上
					($('panel') as HTMLElement).focus?.({ preventScroll: true });
				}
				else if (d.metab) { meTab = d.metab; renderPanel(); }
				else if ('guideClose' in d) { setPrefs({ guide: false }); toast('新手指南已关闭，可以在「我 · 设置」里重新打开'); renderPanel(); }
				else if ('recapClose' in d) { store.set(RECAP_KEY, d.recapClose ?? ''); renderPanel(); }
				else if ('share' in d) shareProgress();
				else if (d.pref) {
					const k = d.pref;
					if (k === 'font' && FONT_OPTIONS.some(([v]) => v === d.val)) setPrefs({ font: d.val as Prefs['font'] });
					else if (k === 'motion' && MOTION_OPTIONS.some(([v]) => v === d.val)) setPrefs({ motion: d.val as Prefs['motion'] });
					else if (TIP_OPTIONS.some(([t]) => t === k)) setPrefs({ [k]: !prefs[k as 'guide' | 'recap' | 'achToast'] });
					else if (k === 'sound') { setPrefs({ sound: !prefs.sound }); sfx('ok'); }
					renderPanel();
				}
				else if (d.quick !== undefined) {
					const text = QUICK_CHAT[+d.quick];
					if (text && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'chat', text }));
				}
				else if (d.npc && d.npcAct) act(d.npcItem ? { t: 'npc', npc: d.npc, act: 'gift', item: d.npcItem } : { t: 'npc', npc: d.npc, act: d.npcAct as NpcAction }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.veh) {
					if (d.veh === 'sell' && !confirm('确定把车卖掉？')) return;
					const a: GameAction = d.veh === 'buy' ? { t: 'vehicle', op: 'buy', id: d.vehId! } : { t: 'vehicle', op: d.veh as 'sell' | 'sleep' | 'service' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.course) act({ t: 'course', id: d.course }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if ('photo' in d) act({ t: 'photo' }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if ('fish' in d) act({ t: 'fish' }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.cert) act({ t: 'cert', id: d.cert }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.exp) act({ t: 'experience', id: d.exp }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.job) {
					if (d.job === 'quit' && !confirm('确定辞职？当前等级的进度会清零。')) return;
					const a: GameAction = d.job === 'apply' ? { t: 'job', op: 'apply', career: d.career! } : { t: 'job', op: d.job as 'work' | 'quit' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.prop) {
					const id = d.propId!;
					const pr = getProperty(id);
					if (!pr) return;
					let a: GameAction;
					if (d.prop === 'buy' || d.prop === 'buyloan') {
						if (!confirm(`确定${d.prop === 'buy' ? '全款' : '贷款'}买下${pr.name}？以后卖出只能拿回房价的 95%。`)) return;
						a = { t: 'property', op: 'buy', id, loan: d.prop === 'buyloan' };
					} else if (d.prop === 'repay') {
						const amount = Number(prompt('提前还多少？', String(Math.min(state.cash, state.properties.find((x) => x.id === id)?.loan ?? 0))));
						if (!(amount > 0)) return;
						a = { t: 'property', op: 'repay', id, amount };
					} else {
						if (d.prop === 'sell' && !confirm(`确定卖掉${pr.name}？`)) return;
						if (d.prop === 'movein' && state.home && !confirm('搬进去会退掉现在的住处，家具半价折现。确定？')) return;
						a = { t: 'property', op: d.prop as 'sell' | 'movein' | 'rentout', id };
					}
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.furn) {
					const a: GameAction = d.furn === 'buy' ? { t: 'furniture', op: 'buy', id: d.furnId! } : { t: 'furniture', op: 'sell', slot: d.slot! };
					act(a).then((r) => { if (r) { toast(r.msg); render(); } });
				}
				else if (d.home) {
					if (d.home === 'leave' && !confirm('确定退租？已付的房租不退，家具半价折现。')) return;
					if (d.home === 'rent' && state.home && !confirm('搬家会退掉现在的住处，家具半价折现。确定？')) return;
					const a: GameAction = d.home === 'rent' ? { t: 'home', op: 'rent', home: d.homeId! } : { t: 'home', op: d.home as 'sleep' | 'leave' | 'cook' | 'relax' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.buy) act({ t: 'buy', item: d.buy }).then((r) => { if (r) { toast(r.msg); render(); } });
				else if (d.use) act({ t: 'use', item: d.use }).then((r) => { if (r) { toast(r.msg); render(); } });
				else if (d.act) act({ t: 'activity', id: d.act }).then((r) => { if (r) { lastOutcome = null; toast(r.msg); render(); } });
				else if (d.go) {
					act({ t: 'travel', to: d.go, mode: d.mode as TravelMode }).then((r) => { if (r) { selected = null; lastOutcome = null; tab = 'place'; if (!state!.pending) toast(r.msg); render(); window.scrollTo({ top: 0 }); } });
				}
				else if (d.dmode) { destMode = { dest: d.dest!, mode: d.dmode }; renderPanel(); }
				else if (d.loc) {
					// 点当前所在地回今天页；再点一次已选中的地点（或卡片上的关闭）取消选择、留在出行页
					const here = d.loc === state.loc;
					selected = here || d.loc === selected ? null : d.loc;
					tab = here ? 'place' : 'go';
					renderPanel();
				}
				else if (d.choice) {
					const ev = getPendingEvent(state);
					act({ t: 'event', choice: +d.choice }).then((r) => {
						if (r) {
							lastOutcome = r.msg;
							if (ev) eventResult = { title: ev.title, icon: ev.icon, text: r.msg, delta: lastDelta, ach: lastAch };
							tab = 'place';
							render();
						}
					});
				}
				else if ('resultClose' in d) { eventResult = null; renderEvent(); }
				else if ('gps' in d) checkIn();
				else if ('locate' in d) locate().then((f) => { if (f) renderPanel(); });
				else if (d.venue && d.venueOp) venueDo(d.venue, d.venueOp as VenueOp);
				else if (d.emote && d.to) { ws?.send(JSON.stringify({ t: 'emote', to: d.to, kind: d.emote })); toast(`你向对方 ${d.emote}`); }
				else if ('copy' in d) navigator.clipboard?.writeText(`${cred!.id}.${cred!.key}`).then(() => toast('已复制'), () => toast('复制失败，请长按手动复制'));
				else if ('pull' in d) pullCloud();
				else if ('board' in d) loadBoard(true);
				else if (d.giftpick !== undefined) { giftTo = d.giftpick ? { hash: d.giftpick, name: d.giftName ?? '' } : null; sellPick = false; renderPanel(); }
				else if (d.week === 'claim') claimWeek();
				else if (d.note === 'delete') noteOp('delete', { note: d.noteId });
				else if (d.trade) {
					if (d.trade === 'pickcancel') { giftTo = null; sellPick = false; renderPanel(); }
					else if (d.trade === 'sellpick') { sellPick = true; giftTo = null; renderPanel(); }
					else if (d.trade === 'gift' && giftTo) tradeOp('gift', { to: giftTo.hash, toName: giftTo.name, item: d.item });
					else if (d.trade === 'sale') tradeOp('sale', { item: d.item, price: Number(d.price) });
					else if (d.trade === 'accept' || d.trade === 'decline' || d.trade === 'cancel') tradeOp(d.trade, { offer: d.offer });
				}
				else if (d.coop) {
					if (d.coop === 'list') loadCoop(true);
					else if (d.coop === 'open') coopOp('open', { coop: d.coopId, role: Number(d.role) });
					else if (d.coop === 'join') coopOp('join', { lobby: d.lobby, role: Number(d.role) });
					else if (d.coop === 'leave' || d.coop === 'start') coopOp(d.coop, { lobby: d.lobby });
				}
				else if ('reset' in d) {
					if (!confirm('确定删除本机存档？请先记下同步码。')) return;
					try { localStorage.removeItem(SAVE_KEY); localStorage.removeItem(CRED_KEY); } catch {}
					location.reload();
				}
			});
			document.addEventListener('submit', (e) => {
				if ((e.target as Element).id === 'note-form') {
					e.preventDefault();
					const input = $('note-input') as HTMLInputElement;
					const c = cleanNote(input.value);
					if ('error' in c) { toast(c.error); return; }
					input.value = '';
					noteOp('post', { text: c.text });
					return;
				}
				if ((e.target as Element).id !== 'chat-form') return;
				e.preventDefault();
				const input = $('chat-input') as HTMLInputElement;
				const text = input.value.trim();
				if (text && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'chat', text }));
				input.value = '';
			});

			/** 取一次高精度定位，存在本机内存里（不写 localStorage） */
			function locate(): Promise<typeof nearFix> {
				if (!navigator.geolocation) { toast('这台设备不支持定位'); return Promise.resolve(null); }
				toast('正在定位…');
				return new Promise((done) => navigator.geolocation.getCurrentPosition(
					(pos) => { nearFix = { lat: pos.coords.latitude, lon: pos.coords.longitude, acc: pos.coords.accuracy, at: Date.now() }; done(nearFix); },
					() => { toast('无法获取定位，请检查定位权限'); done(null); },
					{ enableHighAccuracy: true, timeout: 10000, maximumAge: 0 },
				));
			}

			/** 真实地点动作：先重新定位；游戏里不在那个地点时先用真实定位抵达 */
			async function venueDo(venueId: string, op: VenueOp) {
				const v = region.venues.find((x) => x.id === venueId);
				if (!v || !getVenueType(v.type)) return;
				const f = await locate();
				if (!f || !state) return;
				if (state.loc !== v.loc) {
					const g = await act({ t: 'gps', lat: f.lat, lon: f.lon });
					if (!g || state.pending) { render(); return; }
				}
				const r = await act({ t: 'venue', venue: venueId, op, lat: f.lat, lon: f.lon, acc: f.acc });
				if (r) { lastOutcome = r.msg; toast(r.msg); }
				render();
			}

			function checkIn() {
				if (!navigator.geolocation) return toast('这台设备不支持定位');
				toast('正在定位…');
				navigator.geolocation.getCurrentPosition(
					(pos) => {
						if (!state) return;
						act({ t: 'gps', lat: pos.coords.latitude, lon: pos.coords.longitude }).then((r) => { if (r) { if (!state!.pending) toast(r.msg); render(); } });
					},
					() => toast('无法获取定位，请检查定位权限'),
					{ enableHighAccuracy: true, timeout: 10000 },
				);
			}

			// ---------- 创建角色 ----------
			let pickAvatar = AVATARS[0];
			let pickOrigin = ORIGINS[0].id;
			let pickTraits: string[] = [];
			function renderCreate() {
				$('c-avatars').innerHTML = AVATARS.map((a) => `<button class="chip${a === pickAvatar ? ' on' : ''}" data-avatar="${a}" aria-pressed="${a === pickAvatar}" aria-label="形象 ${a}">${a}</button>`).join('');
				$('c-origins').innerHTML = ORIGINS.map((o) => `<button class="origin${o.id === pickOrigin ? ' on' : ''}" data-origin="${o.id}" aria-pressed="${o.id === pickOrigin}">${o.icon} ${o.name} · 起始 $${o.cash}${o.vehicle !== 'none' ? ' · 有车' : ''}<small>${o.desc}</small></button>`).join('');
				$('c-traits').innerHTML = TRAITS.map((t) => {
					const on = pickTraits.includes(t.id);
					const ok = on || validTraits([...pickTraits, t.id], MAX_TRAITS);
					return `<button class="trait${on ? ' on' : ''}" data-trait="${t.id}" aria-pressed="${on}" ${ok ? '' : 'disabled'}>${esc(t.name)}<small>${esc(t.desc)}</small></button>`;
				}).join('');
				($('c-start') as HTMLButtonElement).disabled = pickTraits.length !== MAX_TRAITS;
				$('c-start').textContent = pickTraits.length === MAX_TRAITS ? '开始生活' : `再选 ${MAX_TRAITS - pickTraits.length} 个性格特质`;
			}
			$('create').addEventListener('click', (e) => {
				const t = (e.target as Element).closest<HTMLElement>('[data-avatar],[data-origin],[data-trait]');
				if (!t || (t as HTMLButtonElement).disabled) return;
				if (t.dataset.avatar) pickAvatar = t.dataset.avatar;
				if (t.dataset.origin) pickOrigin = t.dataset.origin;
				const tr = t.dataset.trait;
				if (tr) pickTraits = pickTraits.includes(tr) ? pickTraits.filter((x) => x !== tr) : [...pickTraits, tr];
				renderCreate();
			});
			function begin() { render(); connect(); }
			$('c-start').addEventListener('click', async () => {
				const btn = $('c-start') as HTMLButtonElement;
				const c = { id: 'p' + randId(15), key: randId(24) };
				const profile = { name: ($('c-name') as HTMLInputElement).value, avatar: pickAvatar, origin: pickOrigin, traits: pickTraits };
				btn.disabled = true;
				try {
					const { data } = await api({ action: 'create', id: c.id, key: c.key, profile });
					if (!data.ok) return toast(data.msg || '创建失败');
					cred = c;
					store.set(CRED_KEY, JSON.stringify(cred));
					if (adopt(data.state)) begin();
				} catch {
					toast('需要联网才能创建角色');
				} finally {
					btn.disabled = false;
				}
			});
			$('c-import').addEventListener('click', async () => {
				const m = /^([a-zA-Z0-9_-]{6,40})\.([a-zA-Z0-9]{16,64})$/.exec(($('c-code') as HTMLInputElement).value.trim());
				if (!m) return toast('同步码格式不对');
				try {
					const { data } = await api({ action: 'get', id: m[1], key: m[2] });
					if (!data.ok) return toast(data.msg || '恢复失败');
					cred = { id: m[1], key: m[2] };
					store.set(CRED_KEY, JSON.stringify(cred));
					if (adopt(data.state, '已恢复云端存档')) { render(); begin(); }
					else toast('云端存档已损坏');
				} catch { toast('网络错误，请稍后再试'); }
			});

			// ---------- 启动 ----------
			try { cred = JSON.parse(store.get(CRED_KEY) || 'null'); } catch {}
			// 本地缓存里的所在地如果已经不存在，先挪到出生点而不是判损坏：不然凭证会被清掉，连云端完好的存档都拉不回来
			try { state = sanitizeState(JSON.parse(store.get(SAVE_KEY) || 'null'), LOC_IDS, { fallbackLoc: region.spawn }); } catch {}
			if (!cred || !state || state.id !== cred.id) { state = null; cred = null; }
			applyPrefs();
			renderCreate();
			render();
			fetch('/earth/cgi/manifest.json').then((r) => (r.ok ? r.json() : {})).then((m: any) => { cgi = m.images || {}; if (state) { renderPanel(); renderEvent(); } }).catch(() => {});
			if (state) { connect(); pullCloud(); }
			document.addEventListener('visibilitychange', () => { if (!document.hidden && state) { connect(); pullCloud(); } });
			// 手机断网时立刻显示离线，恢复后自动重连并同步
			if (typeof window.addEventListener === 'function') {
				window.addEventListener('offline', () => { syncStatus = '离线：可以查看，联网后才能行动'; if (state) renderHud(); });
				window.addEventListener('online', () => { if (state) { connect(); pullCloud(); } });
			}
			// 离线外壳：能「添加到主屏幕」、断网时也能打开查看。注册失败不影响游戏
			if ('serviceWorker' in navigator && location.protocol === 'https:') navigator.serviceWorker.register('/earth/sw.js', { scope: '/earth/' }).catch(() => {});
		</script>
	</body>
</html>
