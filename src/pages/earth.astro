---
// 「地球人生 / Terra Life」第一阶段客户端：西澳大利亚。
// 手机优先的单页应用；规则在 src/game/core/engine.ts（纯函数），本页只负责渲染、输入、同步。
const title = '地球人生 · 西澳';
const description = '在真实地图上生活的在线人生模拟：出行、打工、探索，到达地点触发事件，多端云同步。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#f5f2ec" />
		<link rel="icon" type="image/svg+xml" href="/earth/icon.svg" />
		<link rel="manifest" href="/earth/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/earth/icon-180.png" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="地球人生" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<div id="app">
			<section id="create" class="hidden">
				<h1>🌏 地球人生</h1>
				<p class="sub">第一阶段 · 西澳大利亚</p>
				<label class="field">名字<input id="c-name" maxlength="12" placeholder="给自己起个名字" autocomplete="off" /></label>
				<div class="field">形象<div id="c-avatars" class="chips"></div></div>
				<div class="field">出身<div id="c-origins"></div></div>
				<div class="field">性格特质（选 2 个）<div id="c-traits" class="chips"></div></div>
				<button id="c-start" class="primary">开始生活</button>
				<details class="import">
					<summary>已有存档？用同步码恢复</summary>
					<input id="c-code" placeholder="粘贴同步码" autocomplete="off" />
					<button id="c-import">从云端恢复</button>
				</details>
			</section>

			<section id="game" class="hidden">
				<header id="hud"></header>
				<div id="map-wrap"><svg id="map" role="img" aria-label="西澳地图"></svg></div>
				<nav id="tabs"></nav>
				<main id="panel"></main>
			</section>
		</div>
		<div id="modal" class="hidden"></div>
		<div id="toast" class="hidden"></div>

		<style is:global>
			:root {
				--bg: #f5f2ec; --card: #ffffff; --card2: #fbfaf7; --line: #e4ded4; --text: #17212b; --dim: #5b6672;
				--accent: #1d5fd1; --accent-ink: #ffffff; --warm: #c2541b; --warm-bg: #fff6ef; --ink: #17212b; --ink-dim: #c9d2db;
				--ocean: #dce8f2; --land: #efe3cc; --ok: #2e8b57; --mid: #b7791f; --bad: #c23b3b; --soft: #ece7de;
				--nav-h: 64px;
			}
			* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
			html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; }
			#app { max-width: 560px; margin: 0 auto; min-height: 100dvh; display: flex; flex-direction: column; }
			.hidden { display: none !important; }
			body.busy #panel, body.busy #modal { opacity: 0.6; pointer-events: none; }
			button { font: inherit; color: var(--text); background: var(--card2); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; min-height: 44px; cursor: pointer; }
			button:disabled { opacity: 0.5; cursor: not-allowed; }
			button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 700; }
			button:focus-visible, a:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			input { font: inherit; color: var(--text); background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 11px 14px; width: 100%; min-width: 0; min-height: 44px; }

			#create { padding: 28px 20px calc(28px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 16px; }
			#create h1 { margin: 16px 0 0; font-size: 30px; font-weight: 900; }
			.sub { margin: 0; color: var(--dim); }
			.field { display: flex; flex-direction: column; gap: 8px; color: var(--dim); font-size: 13px; font-weight: 600; }
			.chips { display: flex; flex-wrap: wrap; gap: 8px; }
			.chip { font-size: 22px; padding: 6px 10px; background: var(--card); }
			.chip.on, .origin.on, .trait.on { border-color: var(--accent); background: #eef3fb; box-shadow: inset 0 0 0 1px var(--accent); }
			.origin { display: block; width: 100%; text-align: left; margin-bottom: 8px; background: var(--card); padding: 12px 14px; }
			.origin small { display: block; color: var(--dim); font-weight: 400; }
			.import { color: var(--dim); font-size: 13px; }
			#c-traits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
			.trait { font-size: 14px; padding: 10px 12px; text-align: left; background: var(--card); }
			.trait small { display: block; color: var(--dim); font-size: 12px; }
			.tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
			.tag { font-size: 13px; padding: 4px 10px; border-radius: 10px; background: var(--soft); color: var(--text); }
			.import input { margin: 8px 0; }

			#game { flex: 1; display: flex; flex-direction: column; min-height: 100dvh; }
			#hud { padding: calc(10px + env(safe-area-inset-top)) 16px 10px; background: var(--bg); position: sticky; top: 0; z-index: 5; border-bottom: 1px solid transparent; }
			.hud-row { display: flex; align-items: center; gap: 10px; font-variant-numeric: tabular-nums; min-height: 32px; }
			.hud-row .who { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
			.hud-row .stat { white-space: nowrap; font-size: 13px; color: var(--dim); }
			.hud-row .cash { font-weight: 800; color: var(--text); font-size: 15px; }
			/* 按钮本身 44px 高（点按区），胶囊外观画在里面的 span 上 */
			.moodchip { min-height: 44px; padding: 0; border: 0; background: none; display: inline-flex; align-items: center; justify-content: flex-end; }
			.moodchip > span { padding: 4px 10px; border-radius: 16px; background: #e6f2ea; color: #1f6b40; font-size: 13px; font-weight: 600; white-space: nowrap; }
			.moodchip.mid > span { background: #fbf0dc; color: #7a4f0f; }
			.moodchip.low > span { background: #fbe4e4; color: #9b2c2c; }
			.hud-time { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--dim); margin-top: 2px; }
			.sync-dot { display: inline-flex; align-items: center; gap: 5px; }
			.sync-dot::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--ok); }
			.sync-dot.off::before { background: var(--mid); }
			.mini-needs { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; margin-top: 8px; }
			.mini-needs .need { font-size: 11px; color: var(--dim); text-align: center; }
			.bar { height: 8px; border-radius: 4px; background: var(--soft); overflow: hidden; margin-top: 4px; }
			.mini-needs .bar { height: 5px; margin-top: 2px; }
			.bar i { display: block; height: 100%; border-radius: inherit; background: var(--ok); }
			.bar i.mid { background: var(--mid); }
			.bar i.low { background: var(--bad); }

			#map-wrap { margin: 4px 16px 0; background: var(--ocean); border-radius: 20px; overflow: hidden; }
			#map { display: block; width: 100%; height: 36vh; min-height: 220px; touch-action: manipulation; }
			#map .land { fill: var(--land); stroke: #d9c7a6; stroke-width: 1; }
			#map .route { stroke: var(--accent); stroke-width: 1; fill: none; opacity: 0.3; }
			#map .route.air { stroke-dasharray: 2 4; opacity: 0.25; }
			#map .route.ferry { stroke-dasharray: 1 2; }
			#map .route.track { stroke-dasharray: 4 2; }
			#map .route.live { opacity: 0.9; stroke-width: 1.6; }
			#map .route.air.live { opacity: 0.6; }
			#map .dot { fill: #fff; stroke: var(--accent); stroke-width: 1.6; }
			#map .dot.new { fill: var(--warm); stroke: #fff; }
			#map .dot.sel { stroke: var(--warm); stroke-width: 3; }
			#map .here { fill: var(--accent); stroke: #fff; stroke-width: 2; }
			#map .pulse { fill: none; stroke: var(--accent); stroke-width: 1.5; animation: pulse 1.8s ease-out infinite; transform-box: fill-box; transform-origin: center; }
			@keyframes pulse { from { transform: scale(0.6); opacity: 1; } to { transform: scale(2.4); opacity: 0; } }
			@media (prefers-reduced-motion: reduce) { #map .pulse { animation: none; } }
			#map text { font-size: 9px; fill: var(--text); paint-order: stroke; stroke: rgba(255, 255, 255, 0.85); stroke-width: 2.6px; pointer-events: none; }
			#map text.cnt, #map tspan.cnt { fill: var(--warm); font-weight: 700; }
			#map .hit { fill: transparent; cursor: pointer; }

			#tabs { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; justify-content: center; background: var(--card); border-top: 1px solid var(--line); padding-bottom: env(safe-area-inset-bottom); }
			#tabs .tabs-in { display: flex; width: 100%; max-width: 560px; }
			#tabs button { flex: 1; border: 0; border-radius: 0; background: none; min-height: var(--nav-h); padding: 6px 0; font-size: 11px; font-weight: 600; color: var(--dim); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; }
			#tabs button.on { color: var(--accent); }
			#tabs svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
			#panel { flex: 1; padding: 12px 16px calc(var(--nav-h) + 28px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 12px; }
			.card { background: var(--card); border-radius: 20px; padding: 16px; box-shadow: 0 1px 2px rgba(23, 33, 43, 0.06); }
			.card h3 { margin: 0 0 4px; font-size: 17px; font-weight: 700; }
			.card p { margin: 0; color: var(--dim); font-size: 13px; }
			.hero { height: 140px; border-radius: 14px; margin-bottom: 12px; display: flex; align-items: center; justify-content: center; font-size: 48px; background: #123a5e; overflow: hidden; }
			.hero img { width: 100%; height: 100%; object-fit: cover; }
			.row { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; min-height: 56px; }
			button.row { background: var(--card); border: 0; border-radius: 16px; padding: 10px 14px; box-shadow: 0 1px 2px rgba(23, 33, 43, 0.06); }
			.card button.row { background: var(--card2); box-shadow: none; border: 1px solid var(--line); }
			.row .ico { font-size: 22px; width: 40px; height: 40px; border-radius: 12px; background: var(--soft); display: flex; align-items: center; justify-content: center; flex: none; }
			.row .body { flex: 1; min-width: 0; font-weight: 600; }
			.row .body small { display: block; color: var(--dim); font-size: 12px; font-weight: 400; }
			.row .meta { font-size: 12px; color: var(--dim); text-align: right; white-space: nowrap; flex: none; }
			.row .meta b { display: block; font-size: 15px; color: var(--text); }
			.row.sel { box-shadow: inset 0 0 0 2px var(--warm); }
			.row.new { background: var(--warm-bg); }
			.list { display: flex; flex-direction: column; gap: 8px; }
			.skill { display: grid; grid-template-columns: 30px 1fr 44px; align-items: center; gap: 8px; margin: 8px 0; font-size: 13px; }
			.skill .bar i { background: var(--accent); }
			.muted { color: var(--dim); font-size: 13px; }
			.chat { display: flex; flex-direction: column; gap: 4px; max-height: 180px; overflow-y: auto; font-size: 14px; margin: 8px 0; }
			.chat b { color: var(--accent); font-weight: 600; }
			.inline { display: flex; gap: 8px; flex-wrap: wrap; }
			.inline button { flex: none; }
			.code { font-family: ui-monospace, monospace; font-size: 12px; word-break: break-all; background: var(--soft); padding: 10px; border-radius: 10px; margin: 8px 0; user-select: all; }
			.emotes button { padding: 4px 8px; font-size: 16px; min-height: 44px; min-width: 44px; }
			.mood-row { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; padding: 6px 0; border-bottom: 1px solid var(--line); }
			.mood-row:last-child { border-bottom: 0; }
			.mood-row .up { color: var(--ok); }
			.mood-row .down { color: var(--bad); }

			/* 今天页：角色卡与「下一步」 */
			.me-card { display: flex; flex-direction: column; gap: 14px; }
			.me-head { display: flex; align-items: center; gap: 12px; }
			.avatar { width: 52px; height: 52px; border-radius: 50%; background: #eef3fb; display: flex; align-items: center; justify-content: center; font-size: 28px; flex: none; }
			.me-head .name { flex: 1; min-width: 0; display: flex; flex-direction: column; }
			.me-head .name b { font-size: 19px; }
			.me-head .name span { font-size: 13px; color: var(--dim); }
			.me-head .money { text-align: right; }
			.me-head .money b { display: block; font-size: 22px; font-weight: 900; letter-spacing: -0.5px; }
			.needs-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 18px; row-gap: 12px; }
			.needs-grid .need { font-size: 13px; color: #3a4550; }
			.needs-grid .need .top { display: flex; justify-content: space-between; }
			.needs-grid .need b.low { color: #a62f2f; }
			.needs-grid .need b.mid { color: #8a5a12; }
			.next { background: var(--ink); color: #fff; border-radius: 20px; padding: 18px; display: flex; flex-direction: column; gap: 10px; }
			.next .lbl { font-size: 12px; font-weight: 600; letter-spacing: 1px; color: var(--ink-dim); }
			.next h2 { margin: 0; font-size: 21px; }
			.next p { margin: 0; color: #d3dae1; font-size: 14px; }
			.next button { min-height: 52px; border: 0; border-radius: 14px; background: var(--accent); color: #fff; font-size: 17px; font-weight: 700; }
			.seg { display: flex; gap: 4px; padding: 4px; background: #e9e3d8; border-radius: 14px; position: sticky; top: calc(84px + env(safe-area-inset-top)); z-index: 4; }
			.seg button { flex: 1; min-height: 44px; border: 0; border-radius: 10px; background: transparent; font-size: 14px; color: #3a4550; padding: 0 4px; }
			.seg button.on { background: var(--card); color: var(--text); font-weight: 700; box-shadow: 0 1px 2px rgba(23, 33, 43, 0.08); }
			.guide-head { display: flex; justify-content: space-between; align-items: center; }
			.guide-head button { min-height: 44px; border: 0; background: none; color: var(--accent); font-weight: 600; padding: 0 4px; }
			.guide ol { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
			.guide li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; font-weight: 600; }
			.guide li small { display: block; font-weight: 400; color: var(--dim); font-size: 12px; }
			.guide li.done { color: var(--dim); }
			.guide li.done > span:nth-child(2) { text-decoration: line-through; }
			.guide .tick { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #c9c1b4; flex: none; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #fff; }
			.guide li.done .tick { background: var(--ok); border-color: var(--ok); }
			.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
			.ach-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 8px; }
			.ach { display: flex; gap: 8px; align-items: flex-start; padding: 8px; border-radius: 12px; background: var(--card2); border: 1px solid var(--line); font-size: 13px; opacity: 0.75; }
			.ach.done { opacity: 1; background: #fff6ef; border-color: #f2cdb4; }
			.ach .ach-ico { font-size: 20px; filter: grayscale(1); }
			.ach.done .ach-ico { filter: none; }
			.ach b { display: block; font-size: 13px; }
			.ach small { display: block; color: var(--dim); font-size: 11px; }
			.next.clock .clock-time { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
			.next.clock .clock-time b { font-size: 34px; font-weight: 900; letter-spacing: -1px; }
			.next.clock .clock-time span { color: #d3dae1; font-size: 14px; }
			.next.clock button { background: #fff; color: var(--ink); }
			.bar.dark { background: #2e3b48; }
			.bar.dark i { background: var(--accent); }
			.section-title { margin: 8px 2px -2px; font-size: 14px; font-weight: 700; color: #3a4550; }

			#modal { position: fixed; inset: 0; background: rgba(15, 25, 38, 0.55); display: flex; align-items: flex-end; justify-content: center; z-index: 20; }
			#modal .sheet { background: var(--bg); border-radius: 24px 24px 0 0; width: 100%; max-width: 560px; max-height: 92dvh; overflow-y: auto; }
			#modal .ev-hero { background: #123a5e; color: #fff; padding: 22px 20px 20px; display: flex; flex-direction: column; gap: 4px; min-height: 150px; justify-content: flex-end; position: relative; }
			#modal .ev-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; }
			#modal .ev-hero > * { position: relative; }
			#modal .ev-hero .kicker { font-size: 12px; font-weight: 700; letter-spacing: 1px; color: #f2b48c; }
			#modal h2 { margin: 0; font-size: 30px; font-weight: 900; }
			#modal .ev-body { padding: 18px 16px calc(18px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 12px; }
			#modal .ev-body > p { margin: 0; font-size: 17px; line-height: 1.6; }
			#modal .choice { flex-direction: column; align-items: flex-start; gap: 6px; padding: 14px 16px; min-height: 64px; }
			#modal .choice .label { font-size: 16px; font-weight: 700; }
			.pills { display: flex; flex-wrap: wrap; gap: 6px; }
			.pill { font-size: 12px; font-weight: 600; padding: 3px 9px; border-radius: 8px; background: #eef3fb; color: #1d4fa8; }
			.pill.cost { background: #fdede3; color: #a2400f; }
			.pill.up { background: #e6f2ea; color: #1f6b40; }
			.pill.bad { background: #fbe4e4; color: #9b2c2c; }
			#toast { position: fixed; left: 50%; bottom: calc(var(--nav-h) + 16px + env(safe-area-inset-bottom)); transform: translateX(-50%); background: rgba(23, 33, 43, 0.92); color: #fff; padding: 10px 16px; border-radius: 20px; font-size: 14px; z-index: 30; max-width: 88vw; text-align: center; }
		</style>

		<script>
			import { AVATARS, NEED_META, ORIGINS, SKILL_META, START_CLOCK, formatClock, sanitizeState } from '../game/core/character.ts';
			import type { GameAction } from '../game/core/actions.ts';
			import { activitiesAt, choiceLabel, festivalCalendar, getProperty, netWorth, propertiesAt, firstRent, furnitureAt, furnitureValue, getFurniture, homeActionBlocked, areaTitles, coursesAt, dealerAt, experiencesAt, getVehicle, resaleValue, careersAt, getCareer, getHome, homesAt, getRelation, npcsAt, npcPlan, giftReaction, GIFT_LABEL, promotionStatus, relationTier, getLocation, getPendingEvent, shiftBlocked, shopAt, travelOptions } from '../game/core/engine.ts';
			import { PROMOTE_GOOD, PROMOTE_SHIFTS } from '../game/data/careers.ts';
			import { AREAS, EXPERIENCES } from '../game/data/experiences.ts';
			import { FURNITURE_SLOTS, HOME_COOK } from '../game/data/furniture.ts';
			import { FINANCE, loanPayment, saleProceeds, weeksToPayOff } from '../game/core/finance.ts';
			import { dayOf, hoursLabel } from '../game/core/time.ts';
			import { checkScore, moodBreakdown, homeComfort, weeklyCosts, getItem, getTrait, level, mood, moodTier, validTraits, wantedStars } from '../game/core/attributes.ts';
			import { MAX_TRAITS, TRAITS } from '../game/data/traits.ts';
			import { NPCS } from '../game/data/npcs.ts';
			import { dateLabel, period, WEEKDAYS, weekdayOf } from '../game/core/time.ts';
			import { getWish } from '../game/core/wishes.ts';
			import { achievements, newAchievements } from '../game/core/achievements.ts';
			import { weatherAt, weatherOn } from '../game/core/weather.ts';
			import { derivedStats } from '../game/core/formulas.ts';
			import { clockStale, getVenueType, venuesNear } from '../game/core/venues.ts';
			import { FIX_RULES } from '../game/data/venues.ts';
			import type { VenueOp } from '../game/core/types.ts';
			import { DAILY } from '../game/core/daily.ts';
			import { makeProjection } from '../game/core/geo.ts';
			import { NEED_KEYS, SKILL_KEYS } from '../game/core/types.ts';
			import type { NpcAction, PlayerState, TravelMode } from '../game/core/types.ts';
			import { WA } from '../game/data/wa.ts';

			const region = WA;
			const LOC_IDS = new Set(region.locations.map((l) => l.id));
			const SAVE_KEY = 'earth.save.v1';
			const CRED_KEY = 'earth.cred.v1';
			const KIND_ICON: Record<string, string> = { city: '🏙️', port: '⚓', island: '🏝️', coast: '🌊', outback: '🏜️', mining: '⛏️', park: '🏞️', town: '🏘️' };
			// 底部 5 个标签；日志和同步收进「我」
			const TABS: [string, string, string][] = [
				['place', '今天', '<path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z"/>'],
				['go', '出行', '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>'],
				['near', '附近', '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>'],
				['social', '社交', '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c1.8.7 3 2.4 3.5 5.2"/>'],
				['me', '我', '<circle cx="12" cy="8" r="4"/><path d="M4 21c1-4.2 4-6.5 8-6.5s7 2.3 8 6.5"/>'],
			];

			// 「我」页的分栏
			const ME_TABS: [string, string][] = [['overview', '概况'], ['assets', '资产'], ['people', '关系'], ['log', '日志'], ['sync', '设置']];
			let meTab = 'overview';

			type Cred = { id: string; key: string };
			type Peer = { id: string; name: string; avatar: string; loc: string };
			type Chat = { name: string; avatar: string; text: string };

			let state: PlayerState | null = null;
			let cred: Cred | null = null;
			let tab = 'place';
			let selected: string | null = null;
			let lastOutcome: string | null = null;
			// 上一个成功动作带来的数值变化，显示在今天页（只在本机内存里）
			let lastDelta: { text: string; up: boolean }[] = [];
			/** 对比动作前后的存档，列出看得见的变化：现金、健康、声望、需求、能力、用掉的时间 */
			function stateDelta(a: PlayerState, b: PlayerState) {
				const out: { text: string; up: boolean }[] = [];
				const push = (name: string, d: number, min: number, digits = 0, money = false) => {
					if (Math.abs(d) < min) return;
					const v = digits ? Math.abs(d).toFixed(digits) : String(Math.round(Math.abs(d)));
					out.push({ text: `${name} ${d > 0 ? '+' : '−'}${money ? '$' : ''}${money ? Math.round(Math.abs(d)).toLocaleString() : v}`, up: d > 0 });
				};
				push('现金', b.cash - a.cash, 1, 0, true);
				push('健康', b.health - a.health, 1);
				push('声望', b.respect - a.respect, 0.5, 1);
				for (const k of NEED_KEYS) push(NEED_META[k].name, b.needs[k] - a.needs[k], 1);
				for (const k of SKILL_KEYS) push(SKILL_META[k].name, b.skills[k] - a.skills[k], 0.1, 1);
				const mins = b.clock - a.clock;
				if (mins > 0) out.push({ text: `用时 ${mins >= 60 ? Math.floor(mins / 60) + ' 小时' + (mins % 60 ? ' ' + (mins % 60) + ' 分' : '') : mins + ' 分钟'}`, up: true });
				return out;
			}
			let cgi: Record<string, string> = {};
			let ws: WebSocket | null = null;
			let myPeerId = '';
			let peers = new Map<string, Peer>();
			let chats: Chat[] = [];
			let emotes: string[] = [];
			let syncStatus = '未同步';
			let nearFix: { lat: number; lon: number; acc: number; at: number } | null = null; // 只留在本机内存，不存盘
			// 珀斯一带地点密集，标签手动错开：[dx, dy, anchor]
			const LABEL: Record<string, [number, number, string]> = { perth: [8, -3, 'start'], fremantle: [-8, 9, 'end'], rottnest: [-9, -1, 'end'] };

			const $ = (id: string) => document.getElementById(id)!;
			const esc = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
			const store = {
				get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
				set(k: string, v: string) { try { localStorage.setItem(k, v); } catch {} },
			};
			const randId = (n: number) => {
				const a = new Uint8Array(n);
				crypto.getRandomValues(a);
				return [...a].map((b) => 'abcdefghijklmnopqrstuvwxyz0123456789'[b % 36]).join('');
			};

			let toastTimer = 0;
			function toast(msg: string) {
				const el = $('toast');
				el.textContent = msg;
				el.classList.remove('hidden');
				clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => el.classList.add('hidden'), 2600);
			}

			// ---------- 存档与云同步 ----------
			// 服务端权威：本机只缓存最近一次服务器返回的存档用于显示，所有动作都由服务器结算
			function cache() {
				if (state) store.set(SAVE_KEY, JSON.stringify(state));
			}
			let dailyNote = '';
			let clockSkew = 0; // 服务器时间 − 本机时间（毫秒）
			// 净资产排行榜：打开「社交」页时拉取，一分钟内不重复拉
			type BoardRow = { rank: number; name: string; avatar: string; worth: number; day: number; me: boolean };
			let board: { top: BoardRow[]; me: BoardRow | null; total: number } | null = null;
			let boardAt = 0;
			let boardLoading = false;
			let boardError = '';
			async function loadBoard(force = false) {
				if (!cred || boardLoading || (!force && Date.now() - boardAt < 60_000)) return;
				boardLoading = true;
				try {
					const { data } = await api({ action: 'board', id: cred.id, key: cred.key });
					if (data?.ok && Array.isArray(data.top)) { board = { top: data.top, me: data.me ?? null, total: data.total ?? 0 }; boardError = ''; }
					else boardError = data?.msg || '排行榜暂时拿不到';
				} catch {
					boardError = '排行榜需要联网';
				}
				boardAt = Date.now();
				boardLoading = false;
				if (tab === 'social') renderPanel();
			}
			const srvNow = () => Date.now() + clockSkew;
			async function api(body: unknown) {
				const res = await fetch('/api/earth/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
				const data = (await res.json()) as any;
				// 冷却和上班卡都按服务器时间算：用服务器返回的时间校准，手机时钟不准也不影响
				if (typeof data?.at === 'number' && Number.isFinite(data.at)) clockSkew = data.at - Date.now();
				if (typeof data?.daily === 'string') dailyNote = data.daily;
				return { status: res.status, data };
			}
			/** 采用服务器返回的存档；位置变了就通知在线频道 */
			function adopt(remote: unknown, why?: string) {
				const clean = sanitizeState(remote, LOC_IDS, { fallbackLoc: region.spawn });
				if (!clean) return false;
				const moved = !state || state.loc !== clean.loc;
				state = clean;
				syncStatus = `已同步 · 版本 ${clean.rev}`;
				cache();
				if (moved && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'move', loc: state.loc }));
				if (why) toast(why);
				return true;
			}
			async function pullCloud() {
				if (!cred) return;
				try {
					const { data } = await api({ action: 'get', id: cred.id, key: cred.key });
					// 本机缓存只用于离线显示，联网时一律以服务器为准（即使版本号相同，缓存也可能被改过）
					if (data.ok) {
						const newer = !!state && data.state.rev !== state.rev;
						adopt(data.state, newer ? '已载入最新进度' : undefined);
						render();
					} else syncStatus = '同步失败：' + (data.msg || '');
				} catch {
					syncStatus = '离线：可以查看，联网后才能行动';
				}
				if (tab === 'me') renderPanel();
				else renderHud();
			}

			// ---------- 在线状态 ----------
			function connect() {
				if (!state || !cred || (ws && ws.readyState <= WebSocket.OPEN)) return;
				const q = new URLSearchParams({ region: region.id, id: cred.id, name: state.name, avatar: state.avatar, loc: state.loc });
				const sock = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/api/earth/ws?${q}`);
				ws = sock;
				sock.onmessage = (e) => {
					let m: any;
					try { m = JSON.parse(e.data); } catch { return; }
					if (m.t === 'hello') {
						myPeerId = m.you;
						emotes = m.emotes || [];
						peers = new Map((m.players as Peer[]).map((p) => [p.id, p]));
					} else if (m.t === 'join') peers.set(m.p.id, m.p);
					else if (m.t === 'leave') peers.delete(m.id);
					else if (m.t === 'move') { const p = peers.get(m.id); if (p) p.loc = m.loc; }
					else if (m.t === 'chat') { chats.push(m); chats = chats.slice(-50); if (tab !== 'social') toast(`${m.name}: ${m.text}`); }
					else if (m.t === 'emote') toast(`${m.name} 向你 ${m.kind}`);
					else return;
					renderMap();
					if (tab === 'social') renderPanel();
				};
				sock.onclose = () => { if (ws === sock) { ws = null; peers.clear(); setTimeout(connect, 5000); } };
			}
			setInterval(() => { if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'ping' })); }, 20000);
			// 「附近」页的按钮状态随现实时间变化（上班满 15 分钟才能打下班卡、各动作的冷却）：有这类倒计时的时候每半分钟刷新一次
			setInterval(() => {
				if (tab !== 'near' || document.hidden || !state || state.pending) return;
				if (state.clockIn || Object.keys(state.venueCd).length) renderPanel();
			}, 30000);

			// ---------- 动作（发给服务器结算） ----------
			let busy = false;
			async function act(a: GameAction): Promise<{ ok: boolean; msg: string } | null> {
				if (!state || !cred || busy) return null;
				busy = true;
				document.body.classList.add('busy');
				try {
					const { status, data } = await api({ action: 'act', id: cred.id, key: cred.key, rev: state.rev, act: a });
					if (status === 409 && data.state) { adopt(data.state, data.msg); render(); return null; }
					const before = state;
					if (data.state) adopt(data.state);
					if (data.ok && state && before && state !== before) {
						lastDelta = stateDelta(before, state);
						const got = newAchievements(before, state, region);
						if (got.length) setTimeout(() => toast(`🏅 达成成就：${got.map((d) => d.name).join('、')}`), 1200);
					}
					if (!data.ok) { toast(data.msg || '操作失败'); render(); return null; }
					return { ok: true, msg: data.msg };
				} catch {
					toast('网络断开了，联网后才能行动');
					return null;
				} finally {
					busy = false;
					document.body.classList.remove('busy');
				}
			}

			// ---------- 渲染 ----------
			function barCls(v: number) { return v < 25 ? 'low' : v < 50 ? 'mid' : ''; }
			/** 健康 + 5 项需求，今天页和顶栏共用 */
			function needList(s: PlayerState) {
				return [{ name: '健康', icon: '❤️', v: Math.round(s.health) }, ...NEED_KEYS.map((k) => ({ name: NEED_META[k].name, icon: NEED_META[k].icon, v: Math.round(s.needs[k]) }))];
			}
			function moodCls(m: number) { return m < 25 ? ' low' : m < 50 ? ' mid' : ''; }
			function renderHud() {
				const s = state!;
				const m = mood(s);
				const stars = wantedStars(s.heat);
				const online = !/失败|离线|未同步/.test(syncStatus);
				// 今天页有完整的角色卡，顶栏只留一行；其他页加一条迷你需求条
				const mini = tab === 'place' ? '' : `<div class="mini-needs">${needList(s).map((n) => `<div class="need" title="${n.name} ${n.v}">${n.icon}<div class="bar"><i class="${barCls(n.v)}" style="width:${n.v}%"></i></div></div>`).join('')}</div>`;
				$('hud').innerHTML = `
					<div class="hud-row">
						<span class="who">${s.avatar} ${esc(s.name)} <span class="stat">Lv${level(s.respect).lv}</span></span>
						${stars ? `<span class="stat" title="通缉星级（麻烦值 ${Math.round(s.heat)}）">${'★'.repeat(stars)}</span>` : ''}
						<span class="cash">$${s.cash.toLocaleString()}</span>
						<button class="moodchip${moodCls(m)}" data-tab="me" title="看心情的来源"><span>${moodTier(m).name} ${m}</span></button>
					</div>
					<div class="hud-time"><span title="${formatClock(s.clock)}">${weatherAt(s).icon} ${dateLabel(s.clock)} · ${WEEKDAYS[weekdayOf(s.clock)]} ${formatClock(s.clock).split(' ')[1]} ${period(s.clock).name}</span><span class="sync-dot${online ? '' : ' off'}">${online ? '已同步' : '离线'}</span></div>
					${mini}`;
			}

			const proj = makeProjection(region);
			function renderMap() {
				const s = state!;
				const pt = (id: string) => { const l = getLocation(region, id)!; return proj.project(l.lon, l.lat); };
				const outline = region.outline.map(([lon, lat]) => proj.project(lon, lat).join(',')).join(' ');
				const routes = region.routes.map((r) => {
					const [x1, y1] = pt(r.a), [x2, y2] = pt(r.b);
					const live = r.a === s.loc || r.b === s.loc ? ' live' : '';
					return `<line class="route ${r.mode}${live}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`;
				}).join('');
				const counts = new Map<string, number>();
				for (const p of peers.values()) if (p.id !== myPeerId) counts.set(p.loc, (counts.get(p.loc) || 0) + 1);
				const dots = region.locations.map((l) => {
					const [x, y] = proj.project(l.lon, l.lat);
					const here = l.id === s.loc;
					const cls = here ? 'here' : `dot${s.visited[l.id] ? '' : ' new'}${selected === l.id ? ' sel' : ''}`;
					const [dx, dy, anchor] = LABEL[l.id] ?? (x > proj.width * 0.7 ? [-8, 3, 'end'] : [8, 3, 'start']);
					const n = counts.get(l.id);
					return `${here ? `<circle class="pulse" cx="${x}" cy="${y}" r="7"/>` : ''}
						<circle class="${cls}" cx="${x}" cy="${y}" r="${here ? 6 : 4.5}"/>
						<text x="${x + dx}" y="${y + dy}" text-anchor="${anchor}">${esc(l.name)}${n ? ` <tspan class="cnt">👥${n}</tspan>` : ''}</text>
						<circle class="hit" data-loc="${l.id}" cx="${x}" cy="${y}" r="15"/>`;
				}).join('');
				const map = $('map');
				map.setAttribute('viewBox', `0 0 ${proj.width} ${proj.height}`);
				map.innerHTML = `<polygon class="land" points="${outline}"/>${routes}${dots}`;
			}

			function hero(key: string, fallback: string) {
				return `<div class="hero">${cgi[key] ? `<img src="${esc(cgi[key])}" alt="" loading="lazy" />` : fallback}</div>`;
			}

			const minutesLabel = (m: number) => (m >= 60 ? (m / 60).toFixed(m % 60 ? 1 : 0) + ' 小时' : m + ' 分钟');
			const NEED_LOW: Record<string, string> = { health: '身体不太舒服', hunger: '肚子有点饿了', energy: '有点累了', hygiene: '该洗个澡了', fun: '有点无聊', social: '想找人说说话' };
			/** 今天页的角色卡：头像、等级、现金、心情、6 条需求 */
			function meCard(s: PlayerState) {
				const lv = level(s.respect);
				const origin = ORIGINS.find((o) => o.id === s.origin);
				const m = mood(s);
				return `<div class="card me-card">
					<div class="me-head"><span class="avatar">${s.avatar}</span>
						<span class="name"><b>${esc(s.name)}</b><span>Lv${lv.lv} ${esc(lv.title)}${origin ? ` · ${esc(origin.name)}` : ''}</span></span>
						<span class="money"><b>$${s.cash.toLocaleString()}</b><button class="moodchip${moodCls(m)}" data-tab="me"><span>心情 ${moodTier(m).name} ${m}</span></button></span></div>
					<div class="needs-grid">${needList(s).map((n) => `<div class="need"><div class="top"><span>${n.icon} ${n.name}</span><b class="${barCls(n.v)}">${n.v}</b></div><div class="bar"><i class="${barCls(n.v)}" style="width:${n.v}%"></i></div></div>`).join('')}</div></div>`;
			}
			/** 「下一步」：最缺的那项需求 → 这里能补它最多的事；需求都还行时提示上班或出门。只是建议，结算仍由服务器做 */
			function nextCard(s: PlayerState, homeHere: boolean, canWork: boolean) {
				// 有没处理的事件时什么都做不了（引擎会拒绝），不给按钮
				if (s.pending) return '';
				const loc = getLocation(region, s.loc)!;
				const vals: [string, string, number][] = [['health', '健康', s.health], ...NEED_KEYS.map((k) => [k, NEED_META[k].name, s.needs[k]] as [string, string, number])];
				const [key, name, v] = vals.reduce((a, b) => (b[2] < a[2] ? b : a));
				let title: string, text: string, btn: string, attr: string;
				if (v < 60) {
					title = NEED_LOW[key];
					const best = activitiesAt(s, region)
						.filter((x) => !x.blocked)
						.map((x) => ({ act: x.act, gain: key === 'health' ? x.act.fx.health ?? 0 : x.act.fx.needs?.[key as keyof typeof s.needs] ?? 0 }))
						.filter((x) => x.gain > 0)
						.sort((a, b) => b.gain - a.gain)[0];
					if (key === 'energy' && homeHere) {
						text = `精力只剩 ${Math.round(v)}，回家睡一觉能回满`; btn = '回家睡觉'; attr = 'data-home="sleep"';
					} else if (best) {
						const cost = best.act.fx.cash ? (best.act.fx.cash > 0 ? '+' : '') + '$' + Math.abs(best.act.fx.cash) : '免费';
						text = `${name}只剩 ${Math.round(v)}，在${esc(loc.name)}${esc(best.act.name)}能补回来`; btn = `${esc(best.act.name)} · ${cost} · ${minutesLabel(best.act.minutes)}`; attr = `data-act="${best.act.id}"`;
					} else {
						text = `${name}只剩 ${Math.round(v)}，这里没有能补的事，换个地方看看`; btn = '去出行'; attr = 'data-tab="go"';
					}
				} else if (canWork) {
					title = '该上班了'; text = '状态不错，正好在工作的地方'; btn = '上班'; attr = 'data-job="work"';
				} else {
					title = '状态不错'; text = s.wishes.length ? `今天还有 ${s.wishes.length} 个心愿没完成` : '出去走走，看看会遇到什么'; btn = '去出行'; attr = 'data-tab="go"';
				}
				return `<div class="next"><span class="lbl">下一步</span><h2>${title}</h2><p>${text}</p><button ${attr}>${btn}</button></div>`;
			}

			// 新手指南：四步，做到了自动打勾，全部完成或点「知道了」后不再显示（只记在本机）
			const GUIDE_KEY = 'earth.guide.v1';
			function guideCard(s: PlayerState) {
				if (store.get(GUIDE_KEY) === 'done') return '';
				const steps: [boolean, string, string][] = [
					[s.clock > START_CLOCK, '按「下一步」做一件事', '时间会往前走，需求会变化'],
					[Object.keys(s.visited).length > 1, '到「出行」去一个新地方', '第一次到一个地方常有事件'],
					[Object.keys(s.relations).length > 0, '和当地人聊聊天', '在今天页的「这里的人」里'],
					[Object.keys(s.venueCd).length > 0 || !!s.clockIn, '人在真实的餐馆、公园时打开「附近」', '本人到场就能在游戏里吃饭、训练、打卡上班'],
				];
				if (steps.every(([done]) => done)) return '';
				const n = steps.filter(([done]) => done).length;
				return `<div class="card guide"><div class="guide-head"><h3>新手指南 ${n}/${steps.length}</h3><button data-guide-close>知道了</button></div>
					<ol>${steps.map(([done, title, hint]) => `<li class="${done ? 'done' : ''}"><span class="tick" aria-hidden="true">${done ? '✓' : ''}</span><span>${title}<small>${hint}</small></span><span class="sr">${done ? '（已完成）' : ''}</span></li>`).join('')}</ol></div>`;
			}

			function panelPlace() {
				const s = state!;
				const loc = getLocation(region, s.loc)!;
				const acts = activitiesAt(s, region).map(({ act, blocked }) => `
					<button class="row" data-act="${act.id}" ${blocked ? 'disabled' : ''}>
						<span class="ico">${act.icon}</span>
						<span class="body">${esc(act.name)}<small>${esc(blocked ?? act.desc)}</small></span>
						<span class="meta"><b>${act.fx.cash ? (act.fx.cash > 0 ? '+' : '−') + '$' + Math.abs(act.fx.cash) : '免费'}</b>${minutesLabel(act.minutes)}</span>
					</button>`).join('');
				const pois = region.pois.filter((p) => p.loc === loc.id);
				const poiHtml = pois.length ? `<div class="card"><h3>打卡点</h3><p>人到现场、打开定位即可打卡（${pois.filter((p) => s.checkins.includes(p.id)).length}/${pois.length}）</p>
					<div class="list" style="margin-top:8px">${pois.map((p) => `<div class="row"><span class="ico">${s.checkins.includes(p.id) ? '✅' : '📌'}</span><span class="body">${esc(p.name)}<small>${esc(p.category)}</small></span></div>`).join('')}</div></div>` : '';
				const people = npcsAt(s, region);
				const absent = NPCS.filter((n) => !people.some((a) => a.npc.id === n.id)).map((n) => ({ n, plan: npcPlan(n, s.clock) }))
					.filter(({ n, plan }) => plan.loc === loc.id || n.loc === loc.id);
				const bagIds = Object.keys(s.inventory).filter((id) => s.inventory[id] > 0 && getItem(id));
				const giftLabel = (npcId: string, itemId: string) => {
					const n = NPCS.find((x) => x.id === npcId)!;
					return getRelation(s, npcId).known.includes(itemId) ? `（${GIFT_LABEL[giftReaction(n, itemId)]}）` : '';
				};
				const peopleHtml = people.length || absent.length ? `<div class="card"><h3>这里的人</h3>${people.map(({ npc, rel, tier, blocked, nextStory }) => `
					<div style="margin-top:10px"><div class="row"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${esc(npc.bio)}</small></span><span class="meta">${tier}<br/>${Math.round(rel.score)}/100</span></div>
					<div class="inline" style="margin-top:6px">${(['chat', 'help'] as const).map((a) => `<button data-npc="${npc.id}" data-npc-act="${a}" ${blocked[a] ? `disabled title="${esc(blocked[a])}"` : ''}>${{ chat: '聊天', help: '帮忙' }[a]}</button>`).join('')}${npc.perk ? `<button data-npc="${npc.id}" data-npc-act="perk" ${blocked.perk ? `disabled title="${esc(blocked.perk)}"` : ''}>✨ ${esc(npc.perk.name)}</button>` : ''}</div>
					${bagIds.length ? `<div class="inline" style="margin-top:6px"><span class="muted">送礼：</span>${bagIds.map((id) => `<button data-npc="${npc.id}" data-npc-act="gift" data-npc-item="${id}" ${blocked.gift ? `disabled title="${esc(blocked.gift)}"` : ''}>${getItem(id)!.icon} ${esc(getItem(id)!.name)}${giftLabel(npc.id, id)}</button>`).join('')}</div>` : ''}
					${Object.values(blocked).some(Boolean) ? `<p style="margin-top:4px">${esc([...new Set(Object.values(blocked).filter(Boolean))].join('；'))}</p>` : ''}
					${nextStory !== undefined ? `<p style="margin-top:4px" class="muted">关系到 ${nextStory}（${relationTier(nextStory)}）会有新故事。</p>` : ''}</div>`).join('')}
					${absent.map(({ n, plan }) => `<p style="margin-top:8px">${esc(n.name)}（${esc(n.role)}）现在不在。${plan.loc === loc.id ? `今天 ${hoursLabel(plan.hours)} 在这里${plan.note ? `：${esc(plan.note)}` : ''}。` : `今天去了${esc(getLocation(region, plan.loc)?.name ?? '')}${plan.note ? `（${esc(plan.note)}）` : ''}，平时 ${hoursLabel(n.hours)} 在这里。`}</p>`).join('')}</div>` : '';
				const job = s.job;
				const career = job ? getCareer(job.career) : undefined;
				const workHere = job && job.loc === loc.id && career;
				const offers = careersAt(s, region).filter((o) => !(workHere && o.career.id === job!.career));
				const shiftWhy = shiftBlocked(s);
				const workHtml = workHere || offers.length ? `<div class="card"><h3>工作</h3>
					${workHere ? `<div class="row" style="margin-top:8px"><span class="body">${esc(career!.name)} · ${esc(career!.levels[job!.level].title)}<small>每班 $${career!.levels[job!.level].pay} · ${Math.round(career!.minutes / 60)} 小时 · ${hoursLabel(career!.start)} 开工</small></span><button class="primary" data-job="work" ${shiftWhy ? 'disabled' : ''}>上班</button></div>${shiftWhy ? `<p style="margin-top:4px">${esc(shiftWhy)}</p>` : ''}` : ''}
					${offers.map(({ career: c, blocked }) => `<div class="row" style="margin-top:8px"><span class="body">${esc(c.name)} · 招${esc(c.levels[0].title)}<small>${esc(blocked ?? `每班 $${c.levels[0].pay}，最高可升到${c.levels[c.levels.length - 1].title}`)}</small></span><button data-job="apply" data-career="${c.id}" ${blocked ? 'disabled' : ''}>${job ? '跳槽' : '应聘'}</button></div>`).join('')}</div>` : '';
				const homeHere = s.home && s.home.loc === loc.id ? getHome(s.home.type) : undefined;
				const rentals = homesAt(s, region);
				const cookWhy = homeActionBlocked(s, 'cook');
				const relaxWhy = homeActionBlocked(s, 'relax');
				const homeHtml = homeHere || rentals.length ? `<div class="card"><h3>住处</h3>
					${homeHere ? `<div class="row" style="margin-top:8px"><span class="body">你的${esc(homeHere.name)}<small>${s.home!.owned ? '自有房产，不交房租' : `每周 $${homeHere.rentWeek}`} · ${Math.max(0, s.nextWeek - dayOf(s.clock))} 天后结算 · 心情 +${homeComfort(s)}</small></span><button class="primary" data-home="sleep">回家睡觉</button></div>
					<div class="inline" style="margin-top:8px"><button data-home="cook" ${cookWhy ? 'disabled' : ''}>做饭 $${HOME_COOK.cost}</button><button data-home="relax" ${relaxWhy ? 'disabled' : ''}>放松</button></div>
					${cookWhy || relaxWhy ? `<p style="margin-top:4px">${esc([...new Set([cookWhy, relaxWhy].filter(Boolean))].join('；'))}</p>` : ''}
					<details style="margin-top:8px"><summary class="muted">添置家具（已有 ${Object.keys(s.home!.furniture).length}/${Object.keys(FURNITURE_SLOTS).length} 类，折现值 $${furnitureValue(s)}）</summary>
					${furnitureAt(s).map(({ item, owned, net, blocked }) => `<div class="row" style="margin-top:8px"><span class="body">${owned ? '✅ ' : ''}${esc(FURNITURE_SLOTS[item.slot])} · ${esc(item.name)}<small>${esc(item.desc)}${!owned && net !== item.price ? ` 换购价 $${net}` : ''}</small></span>${owned ? `<button data-furn="sell" data-slot="${item.slot}">卖</button>` : `<button data-furn="buy" data-furn-id="${item.id}" ${blocked ? 'disabled' : ''}>$${item.price}</button>`}</div>`).join('')}</details>` : ''}
					${rentals.filter((o) => !(homeHere && o.home.id === s.home!.type)).map(({ home, blocked }) => `<div class="row" style="margin-top:8px"><span class="body">${esc(home.name)} · $${home.rentWeek}/周<small>${esc(blocked ?? `${home.desc}${home.comfort ? ` 心情 +${home.comfort}` : ''} 首期 $${firstRent(s, home)}`)}</small></span><button data-home="rent" data-home-id="${home.id}" ${blocked ? 'disabled' : ''}>${s.home ? '搬来' : '租下'}</button></div>`).join('')}</div>` : '';
				const myVeh = getVehicle(s.vehicle);
				const exps = experiencesAt(s, region);
				const expHtml = exps.length ? `<div class="card"><h3>体验</h3>${exps.map(({ exp, first, blocked }) => `
					<div class="row" style="margin-top:8px"><span class="body">${first ? '✨ ' : '✅ '}${esc(exp.name)} · $${exp.price}<small>${esc(blocked ?? (first ? `${exp.desc} 首次：声望 +${exp.respect}，进收藏册` : '已收藏，再来一次只加心情'))}</small></span><button data-exp="${exp.id}" ${blocked ? 'disabled' : ''}>去</button></div>`).join('')}</div>` : '';
				const courses = coursesAt(s, region);
				const courseHtml = courses.length ? `<div class="card"><h3>课程</h3>${courses.map(({ course, price, blocked }) => `
					<div class="row" style="margin-top:8px"><span class="body">${esc(course.name)} · $${price}<small>${esc(blocked ?? `${SKILL_META[course.skill].name}（现在 ${Math.floor(s.skills[course.skill])}）· ${Math.round(course.minutes / 60 * 10) / 10} 小时 · ${course.desc}`)}</small></span><button data-course="${course.id}" ${blocked ? 'disabled' : ''}>上课</button></div>`).join('')}</div>` : '';
				const dealer = dealerAt(s, region);
				const props = propertiesAt(s, region);
				const propHtml = props.length ? `<div class="card"><h3>房产</h3>${props.map(({ property: pr, owned, down, blockedCash, blockedLoan }) => `
					<div style="margin-top:10px"><div class="row"><span class="body">${owned ? '🔑 ' : ''}${esc(pr.name)} · $${pr.price.toLocaleString()}<small>${esc(pr.desc)} 物业费 $${pr.weekly}/周，出租 $${pr.rentIncome}/周。</small></span></div>
					${owned ? '<p style="margin-top:4px">已是你的房产，在「角色」页管理。</p>' : `<div class="inline" style="margin-top:6px"><button data-prop="buy" data-prop-id="${pr.id}" ${blockedCash ? 'disabled' : ''}>全款买</button><button data-prop="buyloan" data-prop-id="${pr.id}" ${blockedLoan ? 'disabled' : ''}>贷款买（首付 $${down.toLocaleString()}）</button></div>
					<p style="margin-top:4px">${esc(blockedLoan ?? `贷款 $${(pr.price - down).toLocaleString()}，每周还约 $${loanPayment(pr, pr.price - down)}，约 ${weeksToPayOff(pr, pr.price - down)} 周还清。`)}</p>`}</div>`).join('')}</div>` : '';
				const dealerHtml = dealer.length ? `<div class="card"><h3>车行</h3>${myVeh ? `<p>你的${esc(myVeh.name)}可折抵 $${resaleValue(myVeh.id)}</p>` : ''}${dealer.map(({ vehicle, net, blocked }) => `
					<div class="row" style="margin-top:8px"><span class="ico">${vehicle.icon}</span><span class="body">${esc(vehicle.name)} · $${vehicle.price.toLocaleString()}<small>${esc(blocked ?? `${vehicle.desc}${myVeh ? ` 折抵后付 $${net.toLocaleString()}` : ''}`)}</small></span><button data-veh="buy" data-veh-id="${vehicle.id}" ${blocked ? 'disabled' : ''}>${myVeh ? '换' : '买'}</button></div>`).join('')}
					${myVeh ? `<div class="inline" style="margin-top:8px"><button data-veh="sell" ${dealer[0].blocked?.includes('营业') ? 'disabled' : ''}>卖掉${esc(myVeh.name)}（$${resaleValue(myVeh.id)}）</button></div>` : ''}</div>` : '';
				const vanHtml = myVeh?.sleep ? `<button class="row" data-veh="sleep"><span class="ico">${myVeh.icon}</span><span class="body">在${esc(myVeh.name)}里睡一觉<small>免费，开到哪睡到哪</small></span></button>` : '';
				const shop = shopAt(s, region);
				const shopHtml = shop.length ? `<div class="card"><h3>商店</h3><div class="list" style="margin-top:8px">${shop.map(({ item, price, blocked }) => `
					<button class="row" data-buy="${item.id}" ${blocked ? 'disabled' : ''}><span class="ico">${item.icon}</span>
					<span class="body">${esc(item.name)}${s.inventory[item.id] ? ` ×${s.inventory[item.id]}` : ''}<small>${esc(blocked ?? item.desc)}</small></span><span class="meta">$${price}</span></button>`).join('')}</div></div>` : '';
				const wishHtml = s.wishes.length ? `<div class="card"><h3>今天的心愿</h3><p>做到了加心情和声望，过了今天会换一批。</p><div class="tags">${s.wishes.map((id) => `<span class="tag">✨ ${esc(getWish(id)?.text ?? '')}</span>`).join('')}</div></div>` : '';
				const cal = festivalCalendar(s.clock);
				const festHere = cal.find((c) => c.active && c.festival.loc === loc.id);
				const festSoon = cal.filter((c) => c !== festHere).slice(0, 2);
				const festHtml = `<div class="card"><h3>${festHere ? `🎉 ${esc(festHere.festival.name)}进行中` : '节日'}</h3>${festHere ? `<p>${esc(festHere.festival.desc)} 节日专属体验在下面的「体验」里。</p>` : ''}
					${festSoon.map((c) => `<p style="margin-top:4px">${c.active ? '正在举行' : `${c.startsIn} 天后`} · ${esc(c.festival.name)} · ${esc(getLocation(region, c.festival.loc)!.name)}</p>`).join('')}</div>`;
				return `
					${guideCard(s)}
					${meCard(s)}
					${nextCard(s, !!homeHere, !!workHere && !shiftWhy)}
					${wishHtml}
					<div class="card">${hero(loc.id, KIND_ICON[loc.kind])}
						<h3>${esc(loc.name)} <span class="muted">${esc(loc.en)}</span></h3><p>${esc(loc.blurb)}</p>
						<p style="margin-top:6px">今天${weatherAt(s).icon} ${esc(weatherAt(s).name)}：${esc(weatherAt(s).desc)}</p>
						${lastOutcome ? `<p style="margin-top:8px;color:var(--text)">💡 ${esc(lastOutcome)}</p>` : ''}
						${lastDelta.length ? `<div class="pills" style="margin-top:8px" aria-label="刚才的变化">${lastDelta.map((x) => `<span class="pill ${x.text.startsWith('用时') ? '' : x.up ? 'up' : 'bad'}">${esc(x.text)}</span>`).join('')}</div>` : ''}
					</div>
					<button class="row" data-gps><span class="ico">📡</span><span class="body">真实定位打卡<small>你本人到了某个地点？直接抵达并触发事件</small></span></button>
					${festHtml}${peopleHtml}${workHtml}${homeHtml}${expHtml}${vanHtml}<p class="section-title">在${esc(loc.name)}能做的事</p><div class="list">${acts}</div>${courseHtml}${shopHtml}${dealerHtml}${propHtml}${poiHtml}`;
			}

			function panelGo() {
				const s = state!;
				const opts = travelOptions(s, region);
				const note = selected && selected !== s.loc && !opts.some((o) => o.to === selected)
					? `<p class="muted">从这里没有直达${esc(getLocation(region, selected)!.name)}的路线，需要中转。</p>` : '';
				const rows = opts.map((o) => {
					const to = getLocation(region, o.to)!;
					const h = Math.floor(o.minutes / 60), m = o.minutes % 60;
					const fresh = !s.visited[o.to];
					return `<button class="row${selected === o.to ? ' sel' : ''}${fresh && o.available ? ' new' : ''}" data-go="${o.to}" data-mode="${o.mode}" ${o.available ? '' : 'disabled'}>
						<span class="ico">${KIND_ICON[to.kind]}</span>
						<span class="body">${esc(to.name)} <span title="今天的天气">${weatherOn(o.to, dayOf(s.clock)).icon}</span><small>${fresh ? '没去过 · ' : ''}${o.label} · ${o.km} km${o.reason ? ' · ' + esc(o.reason) : ''}</small></span>
						<span class="meta"><b>$${o.cost}</b>${h ? h + ' 小时 ' : ''}${m} 分</span></button>`;
				}).join('');
				return `${note}<p class="section-title">从${esc(getLocation(region, s.loc)!.name)}出发</p><div class="list">${rows}</div><p class="muted">点地图上的地点可以高亮对应路线。虚线是航班，长虚线是越野土路（需四驱），橙色点是没去过的地方。</p>`;
			}

			function panelMe() {
				const s = state!;
				const origin = ORIGINS.find((o) => o.id === s.origin)!;
				const skills = SKILL_KEYS.map((k) => `<div class="skill"><span>${SKILL_META[k].icon}</span><div>${SKILL_META[k].name} <span class="muted">${SKILL_META[k].hint}</span><div class="bar"><i style="width:${s.skills[k]}%"></i></div></div><b title="含特质、装备、心情的检定分">${checkScore(s, k).total}</b></div>`).join('');
				const vdef = getVehicle(s.vehicle);
				const veh = vdef ? `${vdef.icon} ${vdef.name}（值 $${resaleValue(vdef.id).toLocaleString()}）` : '无（坐巴士）';
				const titles = areaTitles(s);
				const album = Object.entries(AREAS).map(([id, a]) => {
					const all = EXPERIENCES.filter((e) => e.area === id);
					const got = all.filter((e) => s.collected.includes(e.id));
					return `<div class="row" style="margin-top:6px"><span class="body">${esc(a.name)} ${got.length}/${all.length}<small>${all.map((e) => (s.collected.includes(e.id) ? '✅' : '⬜') + esc(e.name)).join(' · ')}</small></span></div>`;
				}).join('');
				const lv = level(s.respect);
				const m = mood(s);
				const tier = moodTier(m);
				const mb = moodBreakdown(s);
				const traits = s.traits.map((id) => getTrait(id)).filter(Boolean).map((t) => `<span class="tag" title="${esc(t!.desc)}">${esc(t!.name)}</span>`).join('');
				const jc = s.job ? getCareer(s.job.career) : undefined;
				const promo = promotionStatus(s);
				const hd = s.home ? getHome(s.home.type) : undefined;
				const wc = weeklyCosts(s);
				const estate = s.properties.map((op) => {
					const pr = getProperty(op.id);
					if (!pr) return '';
					const living = s.home?.owned === op.id;
					const status = living ? '自住' : op.rented ? (op.fresh ? `刚挂牌，下个结算日后起收租 $${pr.rentIncome}/周` : `出租中 +$${pr.rentIncome}/周`) : '空置';
					return `<div style="margin-top:10px"><div class="row"><span class="body">${esc(pr.name)} · ${esc(getLocation(region, pr.loc)!.name)}<small>${status} · 物业费 $${pr.weekly}/周${op.loan ? ` · 贷款 $${op.loan.toLocaleString()}，每周还 $${loanPayment(pr, op.loan)}` : ' · 无贷款'}${op.missed ? ` · ⚠️ 已欠款 ${op.missed} 次（超过 ${FINANCE.graceWeeks} 次强制卖房）` : ''}</small></span><span class="meta">卖出到手<br/>$${saleProceeds(pr, op.loan).toLocaleString()}</span></div>
					<div class="inline" style="margin-top:6px;flex-wrap:wrap">${living ? '' : `<button data-prop="movein" data-prop-id="${op.id}">搬进去</button>`}<button data-prop="rentout" data-prop-id="${op.id}">${op.rented ? '停止出租' : '出租'}</button>${op.loan ? `<button data-prop="repay" data-prop-id="${op.id}">提前还贷</button>` : ''}<button data-prop="sell" data-prop-id="${op.id}">卖掉</button></div></div>`;
				}).join('');
				const life = `
					<p>${jc ? `${esc(jc.name)}（${esc(getLocation(region, s.job!.loc)!.name)}）· ${esc(jc.levels[s.job!.level].title)} · 每班 $${jc.levels[s.job!.level].pay}` : '无业。到城镇、海滩、矿区等地方找工作。'}</p>
					${promo ? `<p>升职到${esc(promo.next.title)}：已上 ${promo.shifts}/${PROMOTE_SHIFTS} 班，表现好 ${promo.good}/${PROMOTE_GOOD} 班${promo.blocked ? `，还需${esc(promo.blocked)}` : ''}</p>` : jc ? '<p>已是最高职位。</p>' : ''}
					<p>${hd ? `住在${esc(getLocation(region, s.home!.loc)!.name)}的${esc(hd.name)}，家具：${Object.values(s.home!.furniture).map((id) => esc(getFurniture(id)?.name ?? '')).join('、') || '无'}` : '没有住处。在城镇可以租房，回家睡觉免费且恢复更多。'}</p>
					<p>每周固定开销 $${wc.total}${wc.total ? `（房租 $${wc.rent} + 车辆 $${wc.vehicle} + 房产 $${wc.property}）· ${Math.max(0, s.nextWeek - dayOf(s.clock))} 天后结算` : ''}</p>
					<div class="inline" style="margin-top:8px">${jc ? '<button data-job="quit">辞职</button>' : ''}${hd ? '<button data-home="leave">退租</button>' : ''}</div>`;
				const rels = Object.entries(s.relations).map(([id, r]) => {
					const npc = NPCS.find((n) => n.id === id);
					if (!npc) return '';
					const plan = npcPlan(npc, s.clock);
					const where = `今天在${getLocation(region, plan.loc)?.name ?? ''} ${hoursLabel(plan.hours)}`;
					const known = r.known.map((i) => `${getItem(i)?.icon ?? ''}${GIFT_LABEL[giftReaction(npc, i)]}`).join(' ');
					return `<div class="skill"><span></span><div>${esc(npc.name)} <span class="muted">${esc(npc.role)} · ${esc(where)} · 故事 ${r.seen.length}/${npc.stories.length}${known ? ` · ${esc(known)}` : ''}</span><div class="bar"><i style="width:${Math.max(0, r.score)}%"></i></div></div><b title="${relationTier(r.score)}">${relationTier(r.score)}</b></div>`;
				}).join('');
				const bag = Object.entries(s.inventory).map(([id, n]) => {
					const it = getItem(id);
					if (!it) return '';
					return `<div class="row" style="margin-top:8px"><span class="ico">${it.icon}</span><span class="body">${esc(it.name)} ×${n}<small>${esc(it.desc)}</small></span>${it.use ? `<button data-use="${it.id}">使用</button>` : '<span class="meta">装备中</span>'}</div>`;
				}).join('');
				const ach = achievements(s, region);
				const achDone = ach.filter((a) => a.done).length;
				const achHtml = `<div class="card"><h3>成就 ${achDone}/${ach.length}</h3><div class="ach-grid">${ach.map((a) => `<div class="ach${a.done ? ' done' : ''}"><span class="ach-ico" aria-hidden="true">${a.def.icon}</span><span><b>${esc(a.def.name)}</b><small>${esc(a.def.desc)}${a.done ? '' : ` · ${a.cur.toLocaleString()}/${a.goal.toLocaleString()}`}</small></span><span class="sr">${a.done ? '（已达成）' : '（未达成）'}</span></div>`).join('')}</div></div>`;
				const card = {
					ach: achHtml,
					me: `<div class="card"><h3>${s.avatar} ${esc(s.name)}</h3><p>${origin.icon} ${origin.name} · 座驾：${veh}</p>
					<p>已探索 ${Object.keys(s.visited).length}/${region.locations.length} 个地点 · 麻烦值 ${Math.round(s.heat)}/100（${wantedStars(s.heat)} 星）</p>
						<p>Lv${lv.lv} ${lv.title} · 声望 ${Math.floor(s.respect)}${lv.next !== null ? ` / ${lv.next}` : ''} · 心情 ${m}（${tier.name}，检定 ${tier.check >= 0 ? '+' : ''}${tier.check}）</p>
						<div class="tags">${traits || '<span class="muted">没有性格特质</span>'}</div></div>`,
					mood: `<div class="card"><h3>心情 ${mb.total}（${tier.name}，检定 ${tier.check >= 0 ? '+' : ''}${tier.check}）</h3>
						<div style="margin-top:6px">
							<div class="mood-row"><span>生活需求（最低的一项拉低整体）</span><b>${mb.needs}</b></div>
							${mb.traits ? `<div class="mood-row"><span>性格特质</span><b class="${mb.traits > 0 ? 'up' : 'down'}">${mb.traits > 0 ? '+' : ''}${mb.traits}</b></div>` : ''}
							${mb.home ? `<div class="mood-row"><span>住处</span><b class="up">+${mb.home}</b></div>` : ''}
							${mb.moodlets.map((x) => `<div class="mood-row"><span>${x.def.icon} ${esc(x.def.name)} <span class="muted">还剩 ${x.minutesLeft >= 120 ? Math.round(x.minutesLeft / 60) + ' 小时' : Math.max(1, Math.round(x.minutesLeft)) + ' 分钟'}</span></span><b class="${x.def.value > 0 ? 'up' : 'down'}">${x.def.value > 0 ? '+' : ''}${x.def.value}</b></div>`).join('')}
						</div>
						${mb.moodlets.length ? '' : '<p style="margin-top:6px">做点开心的事——好好吃一顿、睡个好觉、完成心愿、去新地方——会留下几小时到几天的好心情。</p>'}
					</div>`,
					daily: `<div class="card"><h3>每日奖励</h3><p>已连续上线 ${s.daily.streak} 天。每天第一次上线领取，连续越久越多（$${DAILY.base} 起，第 ${DAILY.cap} 天另加 $${DAILY.bonus}），断一天从头算。</p></div>`,
					assets: `<div class="card"><h3>资产 · 净值 $${netWorth(s).toLocaleString()}</h3><p>现金 $${s.cash.toLocaleString()}${vdef ? ` · ${esc(vdef.name)} $${resaleValue(vdef.id).toLocaleString()}` : ''}${furnitureValue(s) ? ` · 家具 $${furnitureValue(s)}` : ''}</p>${estate || '<p>还没有房产。在卡尔古利、珀斯、弗里曼特尔、玛格丽特河可以买房。</p>'}</div>`,
					album: `<div class="card"><h3>收藏册 ${s.collected.length}/${EXPERIENCES.length}</h3>${titles.length ? `<div class="tags">${titles.map((t) => `<span class="tag">🏅 ${esc(t)}</span>`).join('')}</div>` : '<p>在各地体验收费项目，集齐一个片区可获得称号。</p>'}${album}</div>`,
					life: `<div class="card"><h3>工作与住处</h3>${life}</div>`,
					rels: `<div class="card"><h3>人际关系</h3>${rels || '<p>还没认识什么人。去各地看看谁在那里。</p>'}</div>`,
					bag: `<div class="card"><h3>背包</h3>${bag || '<p>空的。在地点页的商店里买东西。</p>'}</div>`,
					skills: `<div class="card"><h3>能力</h3><p>用得越多涨得越快。</p>${skills}</div>`,
					derived: `<div class="card"><h3>派生属性</h3>${(() => {
						const d = derivedStats(s);
						return `<p>体质 ${d.fitness}（体能 50% + 力量 30% + 游泳 20%）</p>
							<p>吸引力 ${d.appeal}（魅力 + 体质 15% + 心情修正${s.needs.hygiene < 30 ? ' − 邋遢 10' : ''}）</p>
							<p>体力消耗 ×${d.exertion} · 恢复 ×${d.recovery}</p>
							<p>状态系数 ×${d.efficiency.total}（心情 ×${d.efficiency.mood} · 健康 ×${d.efficiency.health} · 疲劳 ×${d.efficiency.fatigue}），训练收益和工作表现都乘它</p>`;
					})()}</div>`,
				};
				const sections: Record<string, string[]> = { overview: ['me', 'mood', 'ach', 'daily', 'skills', 'derived'], assets: ['assets', 'life', 'bag', 'album'], people: ['rels'] };
				const seg = `<div class="seg" role="tablist">${ME_TABS.map(([id, label]) => `<button role="tab" data-metab="${id}" class="${meTab === id ? 'on' : ''}" aria-selected="${meTab === id}">${label}</button>`).join('')}</div>`;
				const bodyHtml = meTab === 'log' ? panelLog() : meTab === 'sync' ? panelSync() : (sections[meTab] ?? sections.overview).map((k) => card[k as keyof typeof card]).join('');
				return seg + bodyHtml;
			}

			function boardCard() {
				loadBoard();
				const row = (r: BoardRow) => `<div class="row"><span class="ico">${r.rank}</span><span class="body">${esc(r.avatar)} ${r.me ? `<b>${esc(r.name)}（你）</b>` : esc(r.name)}<small>净资产 $${r.worth.toLocaleString()} · 第 ${r.day + 1} 天</small></span></div>`;
				const body = board
					? `${board.top.map(row).join('') || '<p class="muted">还没有人上榜。</p>'}${board.me && !board.top.some((r) => r.me) ? `<p class="muted" style="margin:6px 0">……</p>${row(board.me)}` : ''}`
					: `<p class="muted">${boardLoading ? '正在加载…' : esc(boardError || '正在加载…')}</p>`;
				return `<div class="card"><h3>🏆 净资产排行</h3><p>全服按净资产排名（现金 + 车 + 家具 + 房产 − 贷款），结果由服务端计算。${board ? `共 ${board.total} 人上榜。` : ''}</p>
					<div class="list" style="margin-top:8px">${body}</div>
					<div class="inline" style="margin-top:8px"><button data-board ${boardLoading ? 'disabled' : ''}>刷新</button></div></div>`;
			}

			function panelSocial() {
				const s = state!;
				const online = ws?.readyState === WebSocket.OPEN;
				const here = [...peers.values()].filter((p) => p.loc === s.loc && p.id !== myPeerId);
				const people = here.length ? here.map((p) => `<div class="row"><span class="ico">${esc(p.avatar)}</span><span class="body">${esc(p.name)}</span>
					<span class="emotes">${emotes.map((e) => `<button data-emote="${e}" data-to="${esc(p.id)}">${e}</button>`).join(' ')}</span></div>`).join('') : '<p class="muted">这里暂时只有你一个人。</p>';
				return `<div class="card"><h3>${esc(getLocation(region, s.loc)!.name)}的人</h3><p>${online ? `全区在线 ${peers.size} 人` : '未连接，稍后自动重连…'}</p><div class="list" style="margin-top:8px">${people}</div></div>
					<div class="card"><h3>本地频道</h3><p>只有同一地点的玩家能看到。</p>
						<div class="chat" id="chat">${chats.map((c) => `<div>${esc(c.avatar)} <b>${esc(c.name)}</b> ${esc(c.text)}</div>`).join('')}</div>
						<form class="inline" id="chat-form"><input id="chat-input" maxlength="120" placeholder="说点什么…" autocomplete="off" ${online ? '' : 'disabled'} /><button class="primary" ${online ? '' : 'disabled'}>发送</button></form></div>
					${boardCard()}`;
			}

			function panelLog() {
				const rows = [...state!.journal].reverse().map((j) => `<div class="row"><span class="body">${esc(j.text)}<small>${formatClock(j.t)}</small></span></div>`).join('');
				return `<div class="card"><h3>人生日志</h3><div class="list" style="margin-top:8px">${rows}</div></div>`;
			}

			function panelNear() {
				const s = state!;
				const intro = `<div class="card"><h3>附近能做的事</h3><p>人在真实的餐馆、健身房、公园、图书馆、超市……打开定位，就能在游戏里吃饭、训练、打卡上班。服务端会检查定位精度、距离和移动速度。</p>
					<div class="inline" style="margin-top:8px"><button data-locate>📍 ${nearFix ? '重新定位' : '定位'}</button></div>
					${nearFix ? `<p style="margin-top:6px" class="muted">定位误差约 ${Math.round(nearFix.acc)} 米 · ${Math.max(0, Math.round((Date.now() - nearFix.at) / 60000))} 分钟前</p>` : ''}</div>`;
				const ci = s.clockIn;
				const ciVenue = ci ? region.venues.find((v) => v.id === ci.venue) : undefined;
				// 上班中：深色卡，大字计时、离 8 小时上限的进度；人在这家店范围内时直接给「打下班卡」大按钮
				const clockCard = (clockOutBtn: string) => {
					if (!ci) return '';
					const mins = Math.max(0, Math.round((srvNow() - ci.at) / 60000));
					const stale = clockStale(s, srvNow());
					const pct = Math.min(100, Math.round(mins / FIX_RULES.shiftMaxMin * 100));
					const note = stale ? '这张卡太久没打下班卡，已经过期，不计薪：在任何带上班按钮的地点点一下就会作废；那里还能上班的话，会顺便打一张新卡。'
						: mins < FIX_RULES.clockInMinMin ? `至少上满 ${FIX_RULES.clockInMinMin} 分钟才能打下班卡。`
						: `离开前在这家店打下班卡（一次最多计 ${FIX_RULES.shiftMaxMin / 60} 小时）。`;
					return `<div class="next clock"><span class="lbl">${stale ? '上班卡已过期' : '上班中'}${ci.career ? ` · ${esc(getCareer(ci.career)?.name ?? '')}` : ' · 零工'}</span>
						<div class="clock-time"><b>${Math.floor(mins / 60)}:${String(mins % 60).padStart(2, '0')}</b><span>${esc(ciVenue?.name ?? ci.venue)}</span></div>
						<div class="bar dark"><i style="width:${pct}%"></i></div><p>${note}</p>${clockOutBtn}</div>`;
				};
				const clockHtml = clockCard('');
				if (!region.venues.length) return intro + clockHtml + '<div class="card"><p>这个区域的真实地点数据还在采集中（来自 OpenStreetMap）。</p></div>';
				if (!nearFix) return intro + clockHtml;
				const list = venuesNear(s, region, nearFix.lat, nearFix.lon, nearFix.acc, srvNow());
				if (!list.length) return intro + clockHtml + '<div class="card"><p>1.5 公里内没有收录的地点。</p></div>';
				const cards = list.slice(0, 20).map(({ venue, type, distM, inRange, ops }) => `<div class="card"><h3>${type.icon} ${esc(venue.name)} <span class="muted">${esc(type.name)} · ${distM} 米</span></h3>
					${inRange ? ops.map(({ op, outcome, blocked, voids, renews }) => {
						const clockOut = op.id === 'work' && s.clockIn?.venue === venue.id;
						const label = op.id === 'work' ? (voids ? '作废上班卡' : renews ? '作废旧卡并重新打卡' : clockOut ? '打下班卡' : '打上班卡') : op.name;
						const detail = blocked ?? (voids ? voids : renews ? renews : outcome ? outcome.notes.join(' · ') : op.desc);
						return `<button class="row" data-venue="${esc(venue.id)}" data-venue-op="${op.id}" ${blocked ? 'disabled' : ''}><span class="ico">${op.icon}</span><span class="body">${label}<small>${esc(detail)}</small></span></button>`;
					}).join('') : `<p>再走近 ${Math.max(0, distM - type.radiusM)} 米就能${ops.map((o) => o.op.name).join('、')}。</p>`}</div>`).join('');
				const here = ci ? list.find((x) => x.venue.id === ci.venue && x.inRange) : undefined;
				const outOp = here?.ops.find((o) => o.op.id === 'work');
				const outBtn = here && outOp && !outOp.blocked && !outOp.voids && !outOp.renews ? `<button data-venue="${esc(here.venue.id)}" data-venue-op="work">打下班卡</button>` : '';
				return intro + clockCard(outBtn) + cards;
			}

			function panelSync() {
				return `<div class="card"><h3>多设备同步</h3><p>${esc(syncStatus)}</p>
						<p style="margin-top:8px">在另一台手机或电脑打开本页，选择“用同步码恢复”，粘贴下面这串码即可接着玩。</p>
						<div class="code">${esc(cred!.id)}.${esc(cred!.key)}</div>
						<div class="inline"><button data-copy>复制同步码</button><button data-pull>立即同步</button></div>
						<p style="margin-top:8px">同步码等同于密码，不要发给别人。</p></div>
					<div class="card"><h3>重新开始</h3><p>清除本机存档并创建新角色（云端旧档仍可用同步码找回）。</p><button data-reset style="margin-top:8px">删除本机存档</button></div>`;
			}

			function renderPanel() {
				$('tabs').innerHTML = `<div class="tabs-in">${TABS.map(([id, label, icon]) => `<button data-tab="${id}" class="${tab === id ? 'on' : ''}" ${tab === id ? 'aria-current="page"' : ''}><svg viewBox="0 0 24 24" aria-hidden="true">${icon}</svg>${label}</button>`).join('')}</div>`;
				// 地图只在「出行」页显示
				$('map-wrap').classList.toggle('hidden', tab !== 'go');
				renderHud();
				const html = { place: panelPlace, near: panelNear, go: panelGo, me: panelMe, social: panelSocial }[tab]!();
				$('panel').innerHTML = html;
				const chat = document.getElementById('chat');
				if (chat) chat.scrollTop = chat.scrollHeight;
			}

			function renderEvent() {
				const ev = state ? getPendingEvent(state) : null;
				const modal = $('modal');
				const game = $('game') as HTMLElement & { inert: boolean };
				if (!ev) { modal.classList.add('hidden'); game.inert = false; return; }
				const s = state!;
				const loc = getLocation(region, s.loc);
				// 成功率：检定分 + 随机 0–60 ≥ 难度（和引擎同一个公式，只用于显示）
				const odds = (skill: Parameters<typeof checkScore>[1], dc: number) => Math.round(Math.max(0, Math.min(1, (checkScore(s, skill).total + 60 - dc) / 60)) * 100);
				const img = cgi['event:' + ev.id];
				modal.innerHTML = `<div class="sheet" role="dialog" aria-modal="true" aria-labelledby="ev-title">
					<div class="ev-hero">${img ? `<img src="${esc(img)}" alt="" loading="lazy" />` : ''}<span class="kicker">${loc ? `到达 ${esc(loc.name)}` : '事件'}</span><h2 id="ev-title">${ev.icon} ${esc(ev.title)}</h2></div>
					<div class="ev-body"><p>${esc(ev.text)}</p>
					<div class="list">${ev.choices.map((c, i) => {
						const poor = !!c.cost && c.cost > s.cash;
						const pills = [
							c.cost ? `<span class="pill ${poor ? 'bad' : 'cost'}">${poor ? `需要 $${c.cost}，钱不够` : `$${c.cost}`}</span>` : '',
							c.check ? `<span class="pill" title="你 ${checkScore(s, c.check.skill).total} + 随机 0–60，难度 ${c.check.dc}">${SKILL_META[c.check.skill].icon} ${SKILL_META[c.check.skill].name}检定 · 成功率约 ${odds(c.check.skill, c.check.dc)}%</span>` : '',
						].join('');
						return `<button class="row choice" data-choice="${i}"${poor ? ' disabled' : ''}><span class="label">${esc(choiceLabel(c))}</span>${pills ? `<span class="pills">${pills}</span>` : ''}</button>`;
					}).join('')}</div></div></div>`;
				const wasOpen = !modal.classList.contains('hidden');
				modal.classList.remove('hidden');
				// 弹窗打开期间背后的页面不可点、不可聚焦；刚打开时把焦点移到第一个能选的选项
				game.inert = true;
				if (!wasOpen) modal.querySelector<HTMLElement>('button:not([disabled])')?.focus();
			}

			function render() {
				if (!state) { $('game').classList.add('hidden'); $('create').classList.remove('hidden'); return; }
				$('create').classList.add('hidden');
				$('game').classList.remove('hidden');
				renderHud();
				renderMap();
				renderPanel();
				renderEvent();
				if (dailyNote) {
					const note = dailyNote;
					dailyNote = '';
					setTimeout(() => toast('🎁 ' + note), 400);
				}
			}

			// ---------- 输入 ----------
			document.addEventListener('click', (e) => {
				const t = (e.target as Element).closest<HTMLElement>('[data-tab],[data-metab],[data-guide-close],[data-act],[data-go],[data-loc],[data-choice],[data-gps],[data-locate],[data-venue],[data-emote],[data-copy],[data-pull],[data-board],[data-reset],[data-buy],[data-use],[data-npc],[data-job],[data-home],[data-veh],[data-course],[data-exp],[data-furn],[data-prop]');
				if (!t || !state || (t as HTMLButtonElement).disabled) return;
				const d = t.dataset;
				if (d.tab) { tab = d.tab; if (t.classList.contains('moodchip')) meTab = 'overview'; renderPanel(); window.scrollTo({ top: 0 }); }
				else if (d.metab) { meTab = d.metab; renderPanel(); }
				else if ('guideClose' in d) { store.set(GUIDE_KEY, 'done'); renderPanel(); }
				else if (d.npc && d.npcAct) act(d.npcItem ? { t: 'npc', npc: d.npc, act: 'gift', item: d.npcItem } : { t: 'npc', npc: d.npc, act: d.npcAct as NpcAction }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.veh) {
					if (d.veh === 'sell' && !confirm('确定把车卖掉？')) return;
					const a: GameAction = d.veh === 'buy' ? { t: 'vehicle', op: 'buy', id: d.vehId! } : { t: 'vehicle', op: d.veh as 'sell' | 'sleep' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.course) act({ t: 'course', id: d.course }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.exp) act({ t: 'experience', id: d.exp }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.job) {
					if (d.job === 'quit' && !confirm('确定辞职？当前等级的进度会清零。')) return;
					const a: GameAction = d.job === 'apply' ? { t: 'job', op: 'apply', career: d.career! } : { t: 'job', op: d.job as 'work' | 'quit' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.prop) {
					const id = d.propId!;
					const pr = getProperty(id);
					if (!pr) return;
					let a: GameAction;
					if (d.prop === 'buy' || d.prop === 'buyloan') {
						if (!confirm(`确定${d.prop === 'buy' ? '全款' : '贷款'}买下${pr.name}？以后卖出只能拿回房价的 95%。`)) return;
						a = { t: 'property', op: 'buy', id, loan: d.prop === 'buyloan' };
					} else if (d.prop === 'repay') {
						const amount = Number(prompt('提前还多少？', String(Math.min(state.cash, state.properties.find((x) => x.id === id)?.loan ?? 0))));
						if (!(amount > 0)) return;
						a = { t: 'property', op: 'repay', id, amount };
					} else {
						if (d.prop === 'sell' && !confirm(`确定卖掉${pr.name}？`)) return;
						if (d.prop === 'movein' && state.home && !confirm('搬进去会退掉现在的住处，家具半价折现。确定？')) return;
						a = { t: 'property', op: d.prop as 'sell' | 'movein' | 'rentout', id };
					}
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.furn) {
					const a: GameAction = d.furn === 'buy' ? { t: 'furniture', op: 'buy', id: d.furnId! } : { t: 'furniture', op: 'sell', slot: d.slot! };
					act(a).then((r) => { if (r) { toast(r.msg); render(); } });
				}
				else if (d.home) {
					if (d.home === 'leave' && !confirm('确定退租？已付的房租不退，家具半价折现。')) return;
					if (d.home === 'rent' && state.home && !confirm('搬家会退掉现在的住处，家具半价折现。确定？')) return;
					const a: GameAction = d.home === 'rent' ? { t: 'home', op: 'rent', home: d.homeId! } : { t: 'home', op: d.home as 'sleep' | 'leave' | 'cook' | 'relax' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.buy) act({ t: 'buy', item: d.buy }).then((r) => { if (r) { toast(r.msg); render(); } });
				else if (d.use) act({ t: 'use', item: d.use }).then((r) => { if (r) { toast(r.msg); render(); } });
				else if (d.act) act({ t: 'activity', id: d.act }).then((r) => { if (r) { lastOutcome = null; toast(r.msg); render(); } });
				else if (d.go) {
					act({ t: 'travel', to: d.go, mode: d.mode as TravelMode }).then((r) => { if (r) { selected = null; lastOutcome = null; tab = 'place'; if (!state!.pending) toast(r.msg); render(); window.scrollTo({ top: 0 }); } });
				}
				else if (d.loc) { selected = d.loc === state.loc ? null : d.loc; tab = selected ? 'go' : 'place'; renderMap(); renderPanel(); }
				else if (d.choice) act({ t: 'event', choice: +d.choice }).then((r) => { if (r) { lastOutcome = r.msg; tab = 'place'; render(); } });
				else if ('gps' in d) checkIn();
				else if ('locate' in d) locate().then((f) => { if (f) renderPanel(); });
				else if (d.venue && d.venueOp) venueDo(d.venue, d.venueOp as VenueOp);
				else if (d.emote && d.to) { ws?.send(JSON.stringify({ t: 'emote', to: d.to, kind: d.emote })); toast(`你向对方 ${d.emote}`); }
				else if ('copy' in d) navigator.clipboard?.writeText(`${cred!.id}.${cred!.key}`).then(() => toast('已复制'), () => toast('复制失败，请长按手动复制'));
				else if ('pull' in d) pullCloud();
				else if ('board' in d) loadBoard(true);
				else if ('reset' in d) {
					if (!confirm('确定删除本机存档？请先记下同步码。')) return;
					try { localStorage.removeItem(SAVE_KEY); localStorage.removeItem(CRED_KEY); } catch {}
					location.reload();
				}
			});
			document.addEventListener('submit', (e) => {
				if ((e.target as Element).id !== 'chat-form') return;
				e.preventDefault();
				const input = $('chat-input') as HTMLInputElement;
				const text = input.value.trim();
				if (text && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'chat', text }));
				input.value = '';
			});

			/** 取一次高精度定位，存在本机内存里（不写 localStorage） */
			function locate(): Promise<typeof nearFix> {
				if (!navigator.geolocation) { toast('这台设备不支持定位'); return Promise.resolve(null); }
				toast('正在定位…');
				return new Promise((done) => navigator.geolocation.getCurrentPosition(
					(pos) => { nearFix = { lat: pos.coords.latitude, lon: pos.coords.longitude, acc: pos.coords.accuracy, at: Date.now() }; done(nearFix); },
					() => { toast('无法获取定位，请检查定位权限'); done(null); },
					{ enableHighAccuracy: true, timeout: 10000, maximumAge: 0 },
				));
			}

			/** 真实地点动作：先重新定位；游戏里不在那个地点时先用真实定位抵达 */
			async function venueDo(venueId: string, op: VenueOp) {
				const v = region.venues.find((x) => x.id === venueId);
				if (!v || !getVenueType(v.type)) return;
				const f = await locate();
				if (!f || !state) return;
				if (state.loc !== v.loc) {
					const g = await act({ t: 'gps', lat: f.lat, lon: f.lon });
					if (!g || state.pending) { render(); return; }
				}
				const r = await act({ t: 'venue', venue: venueId, op, lat: f.lat, lon: f.lon, acc: f.acc });
				if (r) { lastOutcome = r.msg; toast(r.msg); }
				render();
			}

			function checkIn() {
				if (!navigator.geolocation) return toast('这台设备不支持定位');
				toast('正在定位…');
				navigator.geolocation.getCurrentPosition(
					(pos) => {
						if (!state) return;
						act({ t: 'gps', lat: pos.coords.latitude, lon: pos.coords.longitude }).then((r) => { if (r) { if (!state!.pending) toast(r.msg); render(); } });
					},
					() => toast('无法获取定位，请检查定位权限'),
					{ enableHighAccuracy: true, timeout: 10000 },
				);
			}

			// ---------- 创建角色 ----------
			let pickAvatar = AVATARS[0];
			let pickOrigin = ORIGINS[0].id;
			let pickTraits: string[] = [];
			function renderCreate() {
				$('c-avatars').innerHTML = AVATARS.map((a) => `<button class="chip${a === pickAvatar ? ' on' : ''}" data-avatar="${a}">${a}</button>`).join('');
				$('c-origins').innerHTML = ORIGINS.map((o) => `<button class="origin${o.id === pickOrigin ? ' on' : ''}" data-origin="${o.id}">${o.icon} ${o.name} · 起始 $${o.cash}${o.vehicle !== 'none' ? ' · 有车' : ''}<small>${o.desc}</small></button>`).join('');
				$('c-traits').innerHTML = TRAITS.map((t) => {
					const on = pickTraits.includes(t.id);
					const ok = on || validTraits([...pickTraits, t.id], MAX_TRAITS);
					return `<button class="trait${on ? ' on' : ''}" data-trait="${t.id}" ${ok ? '' : 'disabled'}>${esc(t.name)}<small>${esc(t.desc)}</small></button>`;
				}).join('');
				($('c-start') as HTMLButtonElement).disabled = pickTraits.length !== MAX_TRAITS;
				$('c-start').textContent = pickTraits.length === MAX_TRAITS ? '开始生活' : `再选 ${MAX_TRAITS - pickTraits.length} 个性格特质`;
			}
			$('create').addEventListener('click', (e) => {
				const t = (e.target as Element).closest<HTMLElement>('[data-avatar],[data-origin],[data-trait]');
				if (!t || (t as HTMLButtonElement).disabled) return;
				if (t.dataset.avatar) pickAvatar = t.dataset.avatar;
				if (t.dataset.origin) pickOrigin = t.dataset.origin;
				const tr = t.dataset.trait;
				if (tr) pickTraits = pickTraits.includes(tr) ? pickTraits.filter((x) => x !== tr) : [...pickTraits, tr];
				renderCreate();
			});
			function begin() { render(); connect(); }
			$('c-start').addEventListener('click', async () => {
				const btn = $('c-start') as HTMLButtonElement;
				const c = { id: 'p' + randId(15), key: randId(24) };
				const profile = { name: ($('c-name') as HTMLInputElement).value, avatar: pickAvatar, origin: pickOrigin, traits: pickTraits };
				btn.disabled = true;
				try {
					const { data } = await api({ action: 'create', id: c.id, key: c.key, profile });
					if (!data.ok) return toast(data.msg || '创建失败');
					cred = c;
					store.set(CRED_KEY, JSON.stringify(cred));
					if (adopt(data.state)) begin();
				} catch {
					toast('需要联网才能创建角色');
				} finally {
					btn.disabled = false;
				}
			});
			$('c-import').addEventListener('click', async () => {
				const m = /^([a-zA-Z0-9_-]{6,40})\.([a-zA-Z0-9]{16,64})$/.exec(($('c-code') as HTMLInputElement).value.trim());
				if (!m) return toast('同步码格式不对');
				try {
					const { data } = await api({ action: 'get', id: m[1], key: m[2] });
					if (!data.ok) return toast(data.msg || '恢复失败');
					cred = { id: m[1], key: m[2] };
					store.set(CRED_KEY, JSON.stringify(cred));
					if (adopt(data.state, '已恢复云端存档')) { render(); begin(); }
					else toast('云端存档已损坏');
				} catch { toast('网络错误，请稍后再试'); }
			});

			// ---------- 启动 ----------
			try { cred = JSON.parse(store.get(CRED_KEY) || 'null'); } catch {}
			// 本地缓存里的所在地如果已经不存在，先挪到出生点而不是判损坏：不然凭证会被清掉，连云端完好的存档都拉不回来
			try { state = sanitizeState(JSON.parse(store.get(SAVE_KEY) || 'null'), LOC_IDS, { fallbackLoc: region.spawn }); } catch {}
			if (!cred || !state || state.id !== cred.id) { state = null; cred = null; }
			renderCreate();
			render();
			fetch('/earth/cgi/manifest.json').then((r) => (r.ok ? r.json() : {})).then((m: any) => { cgi = m.images || {}; if (state) { renderPanel(); renderEvent(); } }).catch(() => {});
			if (state) { connect(); pullCloud(); }
			document.addEventListener('visibilitychange', () => { if (!document.hidden && state) { connect(); pullCloud(); } });
			// 离线外壳：能「添加到主屏幕」、断网时也能打开查看。注册失败不影响游戏
			if ('serviceWorker' in navigator && location.protocol === 'https:') navigator.serviceWorker.register('/earth/sw.js', { scope: '/earth/' }).catch(() => {});
		</script>
	</body>
</html>
