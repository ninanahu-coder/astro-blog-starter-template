				// 声音（v37）：三条分轨各自开关，加一个总音量；默认都关。声音只是点缀，所有信息都有文字和画面
				const sound = `${toggle('sound', 'pref.sound', 'pref.sound.hint')}${toggle('ambience', 'pref.ambience', 'pref.ambience.hint')}${toggle('music', 'pref.music', 'pref.music.hint')}${seg('volume', 'pref.volume', VOLUME_OPTIONS)}${toggle('haptic', 'pref.haptic', 'pref.haptic.hint')}<p class="muted" style="margin-top:4px">${tx('pref.sound.note')}</p>`;
				const real = `<div class="row" style="margin-top:8px"><span class="body">${tx('pref.basemap')}<small>${tx('pref.basemap.hint')}${prefs.basemap ? held(fx.basemap) : ''}${basemapFailed ? tx('pref.basemap.failed') : ''}</small></span><button data-pref="basemap" aria-pressed="${prefs.basemap}">${onOff(prefs.basemap)}</button></div>`;
				// 画面档：四个按钮，下面一行说明这一档开了什么；跟随系统时先说现在按哪一档、为什么
				const why = prefs.visual !== 'auto' ? '' : preset === 'data' ? tx('pref.visual.why.data') : preset === 'battery' ? tx('pref.visual.why.motion') : '';
				const visual = `${seg('visual', 'pref.visual', VISUAL_OPTIONS)}<p class="muted" style="margin-top:4px">${why}${tx(hint)}</p>`;
				// 语言名用各自的语言写，按钮带 lang，读屏和字体回退都按那门语言处理
				const lang = `<div class="pref-row" role="group" aria-label="${tx('pref.lang')}"><span>${tx('pref.lang')}</span><div class="seg">${LOCALE_ORDER.map((l) => `<button data-pref="lang" data-val="${l}" lang="${LOCALES[l].tag}" class="${prefs.lang === l ? 'on' : ''}" aria-pressed="${prefs.lang === l}">${esc(LOCALES[l].label)}</button>`).join('')}</div></div>${prefs.lang === 'zh-Hans' ? '' : `<p class="muted">${tx('pref.lang.partial')}</p>`}`;
				return `<div class="card"><h3>${tx('pref.display')}</h3><p class="muted">${tx('pref.display.hint')}</p>${lang}${visual}${seg('font', 'pref.font', FONT_OPTIONS)}${seg('motion', 'pref.motion', MOTION_OPTIONS)}${sound}${real}</div>
					<div class="card"><h3>提示</h3>${tips}
						<div class="row" style="margin-top:8px"><span class="body">引导提示和渐进出现<small>第一次进入各页的提示、新卡片出现的提醒；关掉后所有卡片直接显示。跟着存档走，换设备也一样</small></span><button data-ob-guide aria-pressed="${!state!.onboard.off}">${state!.onboard.off ? '已关闭' : '已开启'}</button></div></div>
					${blockedCard(state!)}
					<div class="card"><h3>隐私</h3><div class="row"><span class="body">匿名统计<small>${STATS_NOTE}只存按天汇总的次数，数据存放在 Cloudflare（服务器可能在澳洲境外）。默认开启；浏览器开了「全局隐私控制」或「请勿跟踪」时默认关闭。关掉后立即停止发送。</small></span><button data-pref="stats" aria-pressed="${statsOn}">${statsOn ? '已开启' : '已关闭'}</button></div></div>
					<div class="card"><h3>玩法说明</h3><dl class="help">${HELP.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('')}</dl></div>
					${credBad ? `<div class="card"><h3>同步码已失效</h3><p>服务器不认这台设备上的同步码了：可能在另一台设备上更换过，或者账号已删除。输入新的同步码就能接着玩，排队的动作会在那之后补交。</p>
						<input id="s-code" placeholder="粘贴新的同步码" aria-label="新的同步码" autocomplete="off" style="margin-top:8px" />
						<div class="inline"><button data-recode>用新同步码继续</button></div></div>` : ''}
					<div class="card"><h3>多设备同步</h3><p>${esc(syncStatus)}</p>
						<p style="margin-top:8px">在另一台手机或电脑打开本页，选择“用同步码恢复”，粘贴下面这串码即可接着玩。</p>
						<div class="code">${esc(cred!.id)}.${esc(cred!.key)}</div>
						<div class="inline"><button data-copy>复制同步码</button><button data-qr aria-expanded="${!!qrHtml}">${qrHtml ? '收起二维码' : '显示二维码'}</button><button data-pull>立即同步</button></div>
						${qrHtml ? `<div class="qr-box">${qrHtml}<p class="muted">用另一台手机的相机扫一扫，打开链接就能接着玩。二维码和同步码一样等同于密码，别拍给别人。</p></div>` : ''}
						<p style="margin-top:8px">同步码等同于密码，不要发给别人。怀疑被别人看到了，就更换：旧码和旧二维码立即失效。</p>
						<div class="inline"><button data-rekey>更换同步码</button></div></div>
					<div class="card"><h3>我的数据</h3><p>服务器上存着：角色存档、排行榜上的名字和净资产、你贴的留言。导出的文件里没有同步码，不能用来恢复角色。</p>
						<div class="inline"><button data-export>导出存档</button><button data-delacct>删除账号</button></div></div>
					<div class="card"><h3>重新开始</h3><p>清除本机存档并创建新角色（云端旧档仍可用同步码找回）。</p><button data-reset style="margin-top:8px">删除本机存档</button></div>`;
			}

			/** 底部标签栏；社交标签上显示同地点在线的其他玩家数 */
			function renderTabs() {
				const hereCount = state ? [...peers.values()].filter((p) => p.loc === state!.loc && p.id !== myPeerId).length : 0;
				// 附近是出行的分页：在附近时出行标签也亮
				const on = (id: string) => id === tab || (id === 'go' && tab === 'near');
				setHtml($('tabs'), `<div class="tabs-in">${TABS.map(([id, label, icon]) => `<button data-tab="${id}" class="${on(id) ? 'on' : ''}" ${on(id) ? 'aria-current="page"' : ''}><svg viewBox="0 0 24 24" aria-hidden="true">${icon}</svg>${tx(label)}${id === 'social' && hereCount ? `<span class="badge" aria-label="${tx('tab.social.online', { n: hereCount })}">${hereCount}</span>` : ''}</button>`).join('')}</div>`);
			}

			// 地点短片：进入视口、页面可见、没开「减少动画」时才开始下载和播放（preload=none），离开视口就暂停。
			// 重绘面板时沿用正在播的同一段短片（不从头开始）；once 的短片（到达时的推镜）每次到达只播一次，播完停在末帧
			let clipObs: IntersectionObserver | null = null;
			const onceDone = new Set<string>();
			let clipLoc = '';
			const onceOver = (v: HTMLVideoElement) => !!v.dataset.once && (v.ended || onceDone.has(v.getAttribute('src') ?? ''));
			function wireClips(prev: HTMLVideoElement | null) {
				if (typeof IntersectionObserver !== 'function' || typeof document.querySelectorAll !== 'function') return;
				const loc = state?.loc ?? '';
				if (loc !== clipLoc) { onceDone.clear(); clipLoc = loc; }
				let vids = [...document.querySelectorAll<HTMLVideoElement>('#panel video.loc-clip, #modal .drawer video.loc-clip')];
				const same = prev && vids.find((v) => v.getAttribute('src') === prev.getAttribute('src'));
				if (prev && same) { same.replaceWith(prev); vids = vids.map((v) => (v === same ? prev : v)); }
				if (!vids.length || document.documentElement?.classList?.contains('calm')) return;
				for (const v of vids) {
					if (!v.dataset.once || v.dataset.wired) continue;
					v.dataset.wired = '1';
					const src = v.getAttribute('src') ?? '';
					v.addEventListener('ended', () => onceDone.add(src));
					// 这次到达已经播过（面板重绘出了新元素）：直接停在末帧，不再播
					if (onceDone.has(src)) {
						v.addEventListener('loadedmetadata', () => { v.currentTime = Math.max(0, v.duration - 0.05); }, { once: true });
						v.preload = 'auto';
						v.load();
					}
				}
				clipObs ??= new IntersectionObserver((list) => {
					for (const en of list) {
						const v = en.target as HTMLVideoElement;
						if (en.isIntersecting && !document.hidden && !onceOver(v)) v.play().catch(() => {});
						else v.pause();
					}
				}, { threshold: 0.4 });
				clipObs.disconnect();
				vids.forEach((v) => clipObs!.observe(v));
			}

			function renderPanel() {
				renderTabs();
				// 地图只在「出行」页显示
				$('map-wrap').classList.toggle('hidden', tab !== 'go');
				renderMap();
				renderHud();
				const page = (tab === 'me' && meTab === 'sync' ? 'sync' : tab) as OnboardPage;
				// 这一页有新手便签时不放装饰横幅：第一屏留给便签和真正的内容（体验改造 P1）
				slipOnPage = tab !== 'place' && !!tipSlip(page);
				// 需求环只在今天页：在别的页做的事不留到以后回今天页时再飘
				if (tab !== 'place') ringFx = {};
				const html = { place: panelPlace, near: () => goSeg() + tipSlip('near') + banner('banner:near') + panelNear(), go: () => goSeg() + tipSlip('go') + panelGo(), grow: () => tipSlip('grow') + panelMe('grow'), me: () => tipSlip(page) + panelMe(), social: () => tipSlip('social') + panelSocial() }[tab]!();
				const prevClip = typeof document.querySelector === 'function' ? document.querySelector<HTMLVideoElement>('#panel video.loc-clip') : null;
				paint($('panel'), html);
				wireClips(prevClip);
				tickNumbers();
				// 抽屉开着时跟着今天页一起重画（留言后到、后台同步换了存档……）；不抢焦点
				if (drawer) renderEvent();
				const chat = document.getElementById('chat');
				if (chat) chat.scrollTop = chat.scrollHeight;
			}

			// 事件选完后的结果页（在弹窗里），点「继续」关闭；只在本机内存里
			let eventResult: { title: string; icon: string; text: string; delta: { text: string; up: boolean }[]; ach: string[] } | null = null;
			// 弹窗里现在显示的是哪一页（结果对象，或「事件 id@时刻」）：内容换了才移焦点，同一页重画（后台同步）不抢焦点
			let modalShown: unknown = null;
			function renderEvent() {
				const ev = state ? getPendingEvent(state) : null;
				const modal = $('modal');
				const game = $('game') as HTMLElement & { inert: boolean };
				if (!ev && eventResult) {
					// 没有下一个待处理事件时，显示刚才那个事件的结果
					const r = eventResult;
					paint(modal, `<div class="sheet" role="dialog" aria-modal="true" aria-labelledby="ev-title">
						<div class="ev-hero"><span class="ev-stamp${modalShown !== r ? ' fresh' : ''}">结果</span><h2 id="ev-title">${r.icon} ${esc(r.title)}</h2></div>
						<div class="ev-body"><p>${esc(r.text)}</p>
						${r.delta.length ? `<div class="pills">${r.delta.map((x) => `<span class="pill ${x.text.startsWith('用时') ? '' : x.up ? 'up' : 'bad'}">${esc(x.text)}</span>`).join('')}</div>` : ''}
						${r.ach.length ? `<p class="ach-line">🏅 达成成就：${r.ach.map(esc).join('、')}</p>` : ''}
						<button class="primary" data-result-close>继续</button></div></div>`);
					modal.classList.remove('hidden');
					game.inert = true;
					// 选完选项后原来聚焦的按钮被结果页替换掉了：焦点移到「继续」
					if (modalShown !== r) modal.querySelector<HTMLElement>('button')?.focus();
					modalShown = r;
					return;
				}
				if (!ev && lbAsk) {
					// 旧玩家的一次性上榜提示：只在没有事件、没有事件结果时弹，不打断事件
					paint(modal, lbAskHtml());
					modal.classList.remove('hidden');
					game.inert = true;
					if (modalShown !== 'lbask') modal.querySelector<HTMLElement>('button')?.focus();
					modalShown = 'lbask';
					return;
				}
				const g = !ev && drawer && tab === 'place' ? placeGroups[drawer] : undefined;
				if (!ev && drawer && !g) drawer = null;
				if (g) {
					const key = 'drawer:' + drawer;
					// 同一个抽屉重画（买完东西、后台同步）：记下滚到哪、焦点在哪个按钮，重画后放回去，不跳回顶部
					const same = modalShown === key;
					const q = (sel: string) => (typeof modal.querySelector === 'function' ? modal.querySelector<HTMLElement>(sel) : null);
					const prevTop = same ? q('.sheet.drawer')?.scrollTop ?? 0 : 0;
					const ae = typeof document.activeElement === 'object' ? (document.activeElement as HTMLElement | null) : null;
					const focusKey = same && ae && typeof modal.contains === 'function' && modal.contains(ae) ? Object.entries(ae.dataset ?? {}).map(([k, v]) => `[data-${k.replace(/[A-Z]/g, (c) => '-' + c.toLowerCase())}="${CSS.escape(String(v))}"]`).join('') : '';
					const prevClip = q('video.loc-clip') as HTMLVideoElement | null;
					// 展开的折叠卡（运动和比赛、步行路线……）按顺序记下，重画后放回去；只补「展开」，模板里本来展开的照旧（合并运动分支后复核）
					const haggleOn = same && !!(q('#swap-haggle') as HTMLInputElement | null)?.checked; // 换手墙的砍价勾选框：重画后照旧勾着（合并 main 后复核）
					const openDetails = same && typeof modal.querySelectorAll === 'function' ? [...modal.querySelectorAll<HTMLDetailsElement>('.drawer-body details')].map((d) => d.open) : [];
					paint(modal, `<div class="sheet drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
						<div class="drawer-head"><h2 id="drawer-title">${lu(g.icon as LucideName, 'drawer-ico')} ${g.title}</h2><button class="drawer-x" data-drawer-close aria-label="关闭${g.title}">关闭</button></div>
						<div class="drawer-body">${g.html}</div></div>`);
					modal.classList.remove('hidden');
					game.inert = true;
					if (!same) q('.drawer-x')?.focus();
					else {
						if (openDetails.length) modal.querySelectorAll<HTMLDetailsElement>('.drawer-body details').forEach((d, i) => { if (openDetails[i]) d.open = true; });
						if (haggleOn) { const h = q('#swap-haggle') as HTMLInputElement | null; if (h) h.checked = true; }
						const sh = q('.sheet.drawer');
						if (sh) sh.scrollTop = prevTop;
						const f = focusKey ? q(focusKey) : null;
						if (f && !f.hasAttribute('disabled') && !f.closest('details:not([open])')) f.focus({ preventScroll: true });
						else if (ae && !modal.contains?.(ae)) q('.drawer-x')?.focus({ preventScroll: true });
					}
					modalShown = key;
					wireClips(prevClip);
					return;
				}
				if (!ev) {
					const wasOpen = !modal.classList.contains('hidden');
					modal.classList.add('hidden');
					game.inert = false;
					// 弹窗关掉后焦点不能留在已经隐藏的按钮上：移回页面内容，键盘和读屏用户接着往下读
					if (wasOpen) ($('panel') as HTMLElement).focus?.({ preventScroll: true });
					modalShown = null;
					return;
				}
				const s = state!;
				const loc = getLocation(region, s.loc);
				// 成功率：检定分 + 随机 0–60 ≥ 难度（和引擎同一个公式，只用于显示）
				const odds = (skill: Parameters<typeof checkScore>[1], dc: number) => Math.round(Math.max(0, Math.min(1, (checkScore(s, skill).total + 60 - dc) / 60)) * 100);
				const img = cgi['event:' + ev.id];
				const key = `${ev.id}@${s.clock}`;
				paint(modal, `<div class="sheet" role="dialog" aria-modal="true" aria-labelledby="ev-title">
					<div class="ev-hero">${img ? `<img src="${esc(img)}" alt="" loading="lazy" /><span class="ai-tag">AI 生成示意</span>` : loc ? `${sceneSvg({ phase: skyPhase(loc, s.clock), weather: weatherAt(s).id, kind: loc.kind, tags: loc.tags, noFigure: true })}<i class="ev-shade"></i>` : ''}<span class="ev-stamp${modalShown !== key ? ' fresh' : ''}">${loc ? `到达 ${esc(loc.name)} · ${formatClock(s.clock).split(' ')[1]}` : '事件'}${weatherAt(s).closesSea ? ' · 风暴天' : ''}</span><h2 id="ev-title">${ev.icon} ${esc(ev.title)}</h2></div>
					<div class="ev-body"><p>${esc(ev.text)}</p>
					<div class="list">${(() => { let lit = false; return ev.choices.map((c, i) => {
						const poor = !!c.cost && c.cost > s.cash;
						const stormBlocked = c.exposed === 'sea' && !!weatherAt(s).closesSea;
						const pills = [
							stormBlocked ? '<span class="pill bad">今天有风暴，下不了海</span>' : '',
							c.cost ? `<span class="pill ${poor ? 'bad' : 'cost'}">${poor ? `需要 $${c.cost}，钱不够` : `$${c.cost}`}</span>` : '',
							!poor && c.cost && spendWarn(s, c.cost) ? `<span class="pill bad">${esc(spendWarn(s, c.cost))}</span>` : '',
							c.check ? `<span class="pill" title="你 ${checkScore(s, c.check.skill).total} + 随机 0–60，难度 ${c.check.dc}">${SKILL_META[c.check.skill].icon} ${SKILL_META[c.check.skill].name}检定 · 成功率约 ${odds(c.check.skill, c.check.dc)}%</span>` : '',
						].join('');
						// 第一个能选的选项高亮（第一项钱不够或风暴下不了海时，顺延到下一个能选的）
						const first = !poor && !stormBlocked && !lit;
						if (first) lit = true;
						return `<button class="row choice${first ? ' first' : ''}" data-choice="${i}"${poor || stormBlocked ? ' disabled' : ''}><span class="label">${esc(choiceLabel(c))}</span>${pills ? `<span class="pills">${pills}</span>` : ''}</button>`;
					}).join(''); })()}</div></div></div>`);
				modal.classList.remove('hidden');
				// 弹窗打开期间背后的页面不可点、不可聚焦；换成一个新事件时（刚打开或接着下一个）把焦点移到第一个能选的选项
				game.inert = true;
				if (modalShown !== key) { modal.querySelector<HTMLElement>('button:not([disabled])')?.focus(); sfx('event'); }
				modalShown = key;
			}

			function render() {
				// 开场是护照封皮的深蓝：手机状态栏跟着换色，进游戏后还原成浅色/深色主题色
				for (const m of document.querySelectorAll?.<HTMLMetaElement>('meta[name="theme-color"]') ?? []) {
					m.dataset.base ??= m.content;
					m.content = state ? m.dataset.base! : '#15284d';
				}
				if (!state) { $('game').classList.add('hidden'); $('create').classList.remove('hidden'); return; }
				$('create').classList.add('hidden');
				$('game').classList.remove('hidden');
				// 画面天色跟着当地真实的日出日落走（第 37 轮）：夏天傍晚 7 点天还亮、冬天 6 点就黑了。玩法上的时段（活动、事件、NPC 日程）照旧按钟点
				const pid = skyPhase(getLocation(region, state.loc)!, state.clock);
				for (const p of PERIOD_IDS) document.documentElement?.classList?.toggle('p-' + p, p === pid);
				renderPanel(); // 里面会画顶栏和（出行页的）地图
				renderEvent();
				syncScene();
				if (obPending.length) void flushOnboard();
				maybeFireWarn();
				if (dailyNote) {
					const note = dailyNote;
					dailyNote = '';
					setTimeout(() => toast('🎁 ' + note), 400);
				}
			}

			// ---------- 输入 ----------
			// 键盘：事件结果页按 Esc 等于点「继续」（还没选的事件必须选一个，Esc 不关）
			document.addEventListener('keydown', (e) => {
				gestured = true;
				if ((e as KeyboardEvent).key !== 'Escape') return;
				if (drawer && !lbAsk && !eventResult && !(state && getPendingEvent(state))) { closeDrawer(); return; }
				if (!eventResult || (state && getPendingEvent(state))) return;
				eventResult = null;
				renderEvent();
			});
			/** 关抽屉，焦点回到打开它的那一行（找不到就回到页面内容） */
			function closeDrawer() {
				const id = drawer;
				drawer = null;
				renderEvent();
				const back = id && typeof document.querySelector === 'function' ? document.querySelector<HTMLElement>(`[data-drawer="${id}"]`) : null;
				if (back) back.focus?.(); else ($('panel') as HTMLElement).focus?.({ preventScroll: true });
			}
			// 点抽屉外面的遮罩：关掉（事件弹窗不受影响，事件必须选一个选项）
			$('modal').addEventListener('click', (e) => {
				if (drawer && !lbAsk && !eventResult && e.target === $('modal') && !(state && getPendingEvent(state))) closeDrawer(); // 上榜提示盖着抽屉时不关
			});
			// NPC 打招呼语音：只在玩家点「听」时播放；再点一次同一条就停
			document.addEventListener('click', (e) => {
				const b = (e.target as Element).closest<HTMLElement>('[data-voice]');
				const line = b ? media.voice[b.dataset.voice ?? ''] : undefined;
				if (!line) return;
				try {
					const same = voicePlayer && !voicePlayer.paused && voicePlayer.dataset.npc === b!.dataset.voice;
					voicePlayer?.pause();
					if (same) return;
					voicePlayer = new Audio(line.src);
					voicePlayer.dataset.npc = b!.dataset.voice;
					voicePlayer.play().catch(() => {});
				} catch {}
			});
			document.addEventListener('click', (e) => {
				gestured = true;
				const t = (e.target as Element).closest<HTMLElement>('[data-tab],[data-metab],[data-career],[data-guide-close],[data-recap-close],[data-share],[data-pref],[data-result-close],[data-quick],[data-act],[data-care],[data-go],[data-loc],[data-choice],[data-gps],[data-locate],[data-venue],[data-emote],[data-copy],[data-qr],[data-queue-clear],[data-venues-retry],[data-pull],[data-board],[data-lbq],[data-lbpref],[data-lbask],[data-reset],[data-rekey],[data-export],[data-delacct],[data-recode],[data-buy],[data-use],[data-sell],[data-npc],[data-job],[data-home],[data-veh],[data-course],[data-cert],[data-study],[data-fish],[data-photo],[data-exp],[data-furn],[data-cook],[data-host],[data-grocery],[data-insure],[data-sport],[data-hobby],[data-mind],[data-rental],[data-wall],[data-biz],[data-tax],[data-paper],[data-trip],[data-flat],[data-bank],[data-vol],[data-prop],[data-dmode],[data-coop],[data-giftpick],[data-trade],[data-week],[data-note],[data-asset],[data-pet],[data-safety],[data-report-pick],[data-report],[data-live],[data-trail],[data-claim],[data-wear],[data-ob-tip],[data-ob-back],[data-ob-all],[data-ob-guide],[data-redeem],[data-redeem-confirm],[data-drawer],[data-drawer-close],[data-swappick],[data-swap],[data-mkt],[data-visa],[data-visa-ielts],[data-cash-cost]');
				// 打开了环境音或音乐、但还没出过声：第一次点页面任何地方时解锁音频（浏览器的自动播放限制）
				if (!audio && (prefs.ambience || prefs.music)) { try { ensureAudio(); } catch {} syncScene(); }
				if (!t || !state || (t as HTMLButtonElement).disabled) return;
				const d = t.dataset;
				if (d.cashCost !== undefined && !confirmLowCash(d.cashLabel || '这项操作', Number(d.cashCost))) return;
				if (d.drawer) {
					const g = d.drawer;
					if (Object.hasOwn(placeGroups, g)) { drawer = g; tm.track('drawer', drawer); }
					sfx('tap');
					// 「地点」抽屉里有留言板：打开时重画一遍今天页，顺带去拉最新留言
					if (drawer === 'place') renderPanel(); else renderEvent();
					return;
				}
				if ('drawerClose' in d) { closeDrawer(); return; }
				if (d.tab) {
					if (d.tab !== tab) sfx('tap');
					tab = d.tab;
					if (drawer) { drawer = null; renderEvent(); }
					tm.track('tab', tab);
					if (tab === 'near') retryVenues();
					if (tab === 'place') maybeFireWarn();
					if (t.classList.contains('moodchip')) meTab = 'overview';
					if (d.metabGo) meTab = d.metabGo;
					renderPanel();
					window.scrollTo({ top: 0 });
					// 键盘和读屏用户：焦点移到新页面的内容上
					($('panel') as HTMLElement).focus?.({ preventScroll: true });
				}
				else if (d.metab) { meTab = d.metab; tm.track('metab', meTab); renderPanel(); }
				else if (d.obTip) { obSend({ op: 'tip', id: d.obTip }, d.obTip); renderPanel(); ($('panel') as HTMLElement).focus?.({ preventScroll: true }); }
				else if ('obBack' in d) { obSend({ op: 'back' }, 'back'); renderPanel(); ($('panel') as HTMLElement).focus?.({ preventScroll: true }); }
				else if ('obAll' in d) { obSend({ op: 'all' }, 'all'); toast('钓鱼、课程、车行、房产等卡片都显示出来了'); renderPanel(); }
				else if ('obGuide' in d) { const off = !state.onboard.off; if (!off) obHidden.clear(); obSend({ op: off ? 'off' : 'on' }); toast(off ? '引导提示已关闭，所有卡片都会显示' : '引导提示已重新打开，各页的提示会再出现一次'); }
				else if ('guideClose' in d) { setPrefs({ guide: false }); toast('新手指南已关闭，可以在「我 · 设置」里重新打开'); renderPanel(); }
				else if ('venuesRetry' in d) { retryVenues(); renderPanel(); }
				else if ('queueClear' in d) { queue = []; saveQueue(); toast('排队的动作已全部取消'); render(); }
				else if ('recapClose' in d) { store.set(RECAP_KEY, d.recapClose ?? ''); renderPanel(); }
				else if ('share' in d) shareProgress();
				else if (d.career) void shareCareer(d.career);
				else if (d.pref) {
					const k = d.pref;
					if (k === 'font' && FONT_OPTIONS.some(([v]) => v === d.val)) setPrefs({ font: d.val as Prefs['font'] });
					else if (k === 'motion' && MOTION_OPTIONS.some(([v]) => v === d.val)) setPrefs({ motion: d.val as Prefs['motion'] });
					else if (TIP_OPTIONS.some(([t]) => t === k)) setPrefs({ [k]: !prefs[k as 'guide' | 'recap' | 'achToast'] });
					else if (k === 'sound') { setPrefs({ sound: !prefs.sound }); sfx('ok'); }
					else if (k === 'ambience' || k === 'music') { setPrefs({ [k]: !prefs[k] }); try { ensureAudio(); } catch {} syncScene(); }
					else if (k === 'volume' && VOLUME_OPTIONS.some(([v]) => v === d.val)) { setPrefs({ volume: d.val as Prefs['volume'] }); syncScene(); sfx('ok'); }
					// 重新打开时再试一次（上次失败的标记清掉）；关掉就把地图拆了，不再向图块服务发请求
					else if (k === 'stats') { setStats(!statsOn); toast(statsOn ? '匿名统计已开启' : '匿名统计已关闭，不会再发送'); }
					else if (k === 'haptic') { setPrefs({ haptic: !prefs.haptic }); buzz(10); }
					else if (k === 'basemap') { setPrefs({ basemap: !prefs.basemap }); basemapFailed = false; if (!prefs.basemap) dropBasemap(); }
					else if (k === 'lang' && isLocale(d.val)) setPrefs({ lang: d.val });
					else if (k === 'visual' && VISUAL_OPTIONS.some(([v]) => v === d.val)) { setPrefs({ visual: d.val as Prefs['visual'] }); visualChanged(); }
					renderPanel();
				}
				else if (d.quick !== undefined) {
					const text = QUICK_CHAT[+d.quick];
					if (text && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'chat', text }));
				}
				else if (d.npc && d.npcAct && d.npcAct === 'unbond' && !confirm('确定不再算知己？关系分数不变，但会重新开始变淡，7 天内不能再结。')) return;
				else if (d.npc && d.npcAct) act(d.npcItem ? { t: 'npc', npc: d.npc, act: 'gift', item: d.npcItem } : { t: 'npc', npc: d.npc, act: d.npcAct as NpcAction }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.veh) {
					if (d.veh === 'sell' && !confirm('确定把车卖掉？')) return;
					if (d.veh === 'buy') {
						const offer = dealerAt(state, region).find((x) => x.vehicle.id === d.vehId);
						if (offer && !confirmLowCash(`买${offer.vehicle.name}`, offer.net)) return;
					}
					if (d.veh === 'service') {
						const offer = garageAt(state, region);
						if (offer && !confirmLowCash('车辆保养', offer.price)) return;
					}
					const a: GameAction = d.veh === 'buy' ? { t: 'vehicle', op: 'buy', id: d.vehId! } : { t: 'vehicle', op: d.veh as 'sell' | 'sleep' | 'service' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.paper) {
					const row = paperChecklist(state, region).find((x) => x.paper.id === d.paper);
					if (row && !confirmLowCash(`办理${row.paper.name}`, row.paper.fee)) return;
					act({ t: 'paper', id: d.paper }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.biz) {
					// 副业与生意（ui/business.ts 的按钮）：只转发形状，合不合规则由服务端 parseAction + 引擎判断
					if (d.biz === 'close' && !confirm('确定关店？装修费不退，押金扣掉欠款后退回，库存半价清货。')) return;
					const a = (d.biz === 'gig' || d.biz === 'license' ? { t: 'biz', op: d.biz, id: d.bizId ?? '' }
						: d.biz === 'open' ? { t: 'biz', op: 'open', shop: d.bizShop ?? '', site: d.bizSite ?? '' }
						: d.biz === 'restock' ? { t: 'biz', op: 'restock', qty: Number(d.bizQty) }
						: { t: 'biz', op: d.biz }) as GameAction;
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.sport) {
					if (d.sport === 'quit' && !confirm('确定退出俱乐部？会费不退。')) return;
					const a: GameAction = d.sport === 'club' || d.sport === 'quit' ? { t: 'sport', op: d.sport } : { t: 'sport', op: d.sport as 'enter' | 'race' | 'join', id: d.sportId! };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.insure) {
					if (!confirmLowCash('购买保险', premiumFor(state.cover, d.insure, dayOf(state.clock)))) return;
					act({ t: 'insure', id: d.insure }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.course) {
					const offer = coursesAt(state, region).find((x) => x.course.id === d.course);
					if (offer && !confirmLowCash(`上${offer.course.name}`, offer.price)) return;
					act({ t: 'course', id: d.course }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.claim) act({ t: 'claim', id: d.claim }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.wear !== undefined) act({ t: 'title', id: d.wear }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if ('photo' in d) act({ t: 'photo' }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if ('hobby' in d) {
					const garden = d.hobby === 'garden' ? gardenStatus(state) : null;
					const cost = garden?.op === 'plant' ? garden.plant.seed : d.hobby === 'craft' ? nextCraft(state).cost : 0;
					if (cost && !confirmLowCash('爱好材料', cost)) return;
					act({ t: 'hobby', id: d.hobby as never }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.pet) {
					let a: GameAction;
					if (d.pet === 'adopt') {
						const name = prompt('给它起个名字（可以不填）', '');
						if (name === null) return;
						a = { t: 'pet', op: 'adopt', kind: d.petKind!, from: d.petFrom === 'breeder' ? 'breeder' : 'shelter', ...(name.trim() ? { name: name.trim().slice(0, PET.nameMax) } : {}) };
					} else if (d.pet === 'board') {
						const days = Number(prompt(`寄养几天？（1–${PET.boardMaxDays}）`, '3'));
						if (!Number.isInteger(days) || days < 1 || days > PET.boardMaxDays) return;
						a = { t: 'pet', op: 'board', days };
					} else {
						if (d.pet === 'rehome' && !confirm('确定把它送回救助站？工作人员会给它找新家。')) return;
						a = { t: 'pet', op: d.pet as 'feed' | 'play' | 'walk' | 'vet' | 'pickup' | 'rehome' };
					}
					const petDef = d.pet === 'adopt' ? getPetKind(d.petKind!) : state.pet ? getPetKind(state.pet.kind) : undefined;
					const petCost = d.pet === 'adopt' && petDef ? (d.petFrom === 'breeder' ? petDef.buy ?? 0 : petDef.adopt) + petDef.register
						: d.pet === 'board' && petDef ? petDef.board * a.days
							: d.pet === 'feed' && petDef ? petDef.food : d.pet === 'vet' && petDef ? petDef.vet : 0;
					if (petCost && !confirmLowCash(d.pet === 'adopt' ? '领养宠物' : d.pet === 'board' ? '寄养宠物' : d.pet === 'vet' ? '宠物体检' : '购买宠物口粮', petCost)) return;
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if ('fish' in d) act({ t: 'fish' }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.visa) {
					const route = VISA_ROUTES.find((x) => x.id === d.visa);
					if (route && (!confirmLowCash(`申请${route.name}`, route.fee) || !confirm('确定申请？申请费不退。'))) return;
					act({ t: 'visa', op: 'apply', route: d.visa }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if ('visaIelts' in d) {
					const offer = ieltsAt(state, region);
					if (offer && !confirmLowCash('报名雅思', offer.fee)) return;
					act({ t: 'visa', op: 'ielts' }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.cert) {
					const offer = certsAt(state, region).find((x) => x.cert.id === d.cert);
					if (offer && !confirmLowCash(`报名${offer.cert.name}`, offer.cert.price)) return;
					act({ t: 'cert', id: d.cert }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.vol) act({ t: 'volunteer', id: d.vol }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.study) {
					const offer = programsAt(state, region).find((x) => x.program.id === d.study);
					if (offer && !confirmLowCash(`上${offer.program.name}`, offer.program.fee)) return;
					act({ t: 'study', id: d.study }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.exp) {
					const offer = experiencesAt(state, region).find((x) => x.exp.id === d.exp);
					if (offer && !confirmLowCash(`参加${offer.exp.name}`, offer.exp.price)) return;
					act({ t: 'experience', id: d.exp }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.trip) {
					const offer = tripOptions(state).find((x) => x.dest.id === d.trip);
					if (offer && !confirmLowCash(`前往${offer.dest.name}`, offer.price + offer.packing)) return;
					act({ t: 'trip', dest: d.trip, days: Number(d.days) }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.job) {
					if (d.job === 'quit' && !confirm('确定辞职？当前等级的进度会清零。')) return;
					const a: GameAction = d.job === 'apply' ? { t: 'job', op: 'apply', career: d.career! } : { t: 'job', op: d.job as 'work' | 'quit' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.prop) {
					const id = d.propId!;
					const pr = getProperty(id);
					if (!pr) return;
					let a: GameAction;
					if (d.prop === 'buy' || d.prop === 'buyloan') {
						if (!confirm(`确定${d.prop === 'buy' ? '全款' : '贷款'}买下${pr.name}？以后卖出只能拿回房价的 95%。`)) return;
						const offer = propertiesAt(state, region).find((x) => x.property.id === id);
						if (offer && !confirmLowCash(`买下${pr.name}`, d.prop === 'buy' ? pr.price : offer.down)) return;
						a = { t: 'property', op: 'buy', id, loan: d.prop === 'buyloan' };
					} else if (d.prop === 'repay') {
						const amount = Number(prompt('提前还多少？', String(Math.min(state.cash, state.properties.find((x) => x.id === id)?.loan ?? 0))));
						if (!(amount > 0)) return;
						const paid = Math.floor(Math.min(amount, state.cash, state.properties.find((x) => x.id === id)?.loan ?? 0));
						if (!confirmLowCash('提前还房贷', paid)) return;
						a = { t: 'property', op: 'repay', id, amount };
					} else {
