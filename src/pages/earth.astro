			// 上一个成功动作带来的数值变化，显示在今天页（只在本机内存里）
			let lastDelta: { text: string; up: boolean }[] = [];
			// 上一个成功动作新达成的成就（事件结果页显示）
			let lastAch: string[] = [];
			/** 对比动作前后的存档，列出看得见的变化：现金、健康、声望、需求、能力、用掉的时间 */
			function stateDelta(a: PlayerState, b: PlayerState) {
				const out: { text: string; up: boolean }[] = [];
				const push = (name: string, d: number, min: number, digits = 0, money = false) => {
					if (Math.abs(d) < min) return;
					const v = digits ? Math.abs(d).toFixed(digits) : String(Math.round(Math.abs(d)));
					out.push({ text: `${name} ${d > 0 ? '+' : '−'}${money ? '$' : ''}${money ? Math.round(Math.abs(d)).toLocaleString() : v}`, up: d > 0 });
				};
				push('现金', b.cash - a.cash, 1, 0, true);
				push('健康', b.health - a.health, 1);
				push('声望', b.respect - a.respect, 0.5, 1);
				for (const k of NEED_KEYS) push(NEED_META[k].name, b.needs[k] - a.needs[k], 1);
				for (const k of SKILL_KEYS) push(SKILL_META[k].name, b.skills[k] - a.skills[k], 0.1, 1);
				const mins = b.clock - a.clock;
				if (mins > 0) out.push({ text: `用时 ${mins >= 60 ? Math.floor(mins / 60) + ' 小时' + (mins % 60 ? ' ' + (mins % 60) + ' 分' : '') : mins + ' 分钟'}`, up: true });
				return out;
			}
			let cgi: Record<string, string> = {};
			let ws: WebSocket | null = null;
			let myPeerId = '';
			let peers = new Map<string, Peer>();
			let chats: Chat[] = [];
			let emotes: string[] = [];
