				catch (e) { tm.track('err', 'net'); throw e; }
				tm.track('perf', 'api', performance.now() - t0);
				if (res.status >= 500) tm.track('err', 'api5xx');
				const data = (await res.json()) as any;
				// 冷却和上班卡都按服务器时间算：用服务器返回的时间校准，手机时钟不准也不影响
				if (typeof data?.at === 'number' && Number.isFinite(data.at)) clockSkew = data.at - Date.now();
				if (typeof data?.daily === 'string') dailyNote = data.daily;
				// 旧玩家还没回答过要不要上榜：读档时服务端带 lbAsk，弹一次（见 renderEvent）
				if (data?.lbAsk === true && !lbAskDone) lbAsk = true;
				return { status: res.status, data };
			}
			/** 采用服务器返回的存档；位置变了就通知在线频道 */
			function adopt(remote: unknown, why?: string) {
				const clean = sanitizeState(remote, LOC_IDS, { fallbackLoc: region.spawn });
				if (!clean) return false;
				const moved = !state || state.loc !== clean.loc;
				if (state && clean.rev !== state.rev && !busy) { lastDelta = []; ringFx = {}; cashFx = 0; }
				state = clean;
				syncStatus = `已同步 · 版本 ${clean.rev}`;
				cache();
				if (moved && ws && wsArea && wsArea !== curArea().id) {
					// 到了别的区域：换到那个区域的在线频道
					// 旧区域的聊天记录也清掉：社交页只显示所在区域的频道（第 9 批审查问题 1）
					const old = ws;
					ws = null;
					peers.clear();
					chats = [];
					old.close();
					connect();
				} else if (moved && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'move', loc: state.loc }));
				if (why) toast(why);
				return true;
			}
			/** 每发一次同步请求加一：只有最后发出的那次能采用结果 */
			let pullSeq = 0;
			async function pullCloud() {
				if (!cred || syncing || credBad) return;
				// 上次换码的回复没收到：先把换码补完，不然拿旧码去读会被拒
				const pend = parsePendingKey(readJson(NEXT_KEY), cred);
				if (pend && !(await finishRekey(pend, true))) return;
				const gen = actGen;
				const seq = ++pullSeq;
				try {
					const { status, data } = await api({ action: 'get', id: cred.id, key: cred.key });
					if (status === 403) { await onBadKey(); return; }
					// 同步请求在路上时玩家做了动作：这份存档可能比动作的结果旧，采用了会把进度倒回去、下一个动作版本冲突被丢掉
					// 后面又发了同步：先发的可能后到，带回的是更旧的存档，只认最后一次
					if (seq !== pullSeq || gen !== actGen || busy) return;
					// 本机缓存只用于离线显示，联网时一律以服务器为准（即使版本号相同，缓存也可能被改过）
					if (data.ok) {
						const newer = !!state && data.state.rev !== state.rev;
						adopt(data.state, newer ? '已载入最新进度' : undefined);
						render();
						void flushQueue();
						return; // render() 已经把顶栏和面板都画过了，不用再画一次
					} else syncStatus = '同步失败：' + (data.msg || '');
				} catch {
					syncStatus = '离线：可以查看，联网后才能行动';
				}
				if (tab === 'me') renderPanel();
				else renderHud();
			}

			// ---------- 同步码管理（第 50 批）：换码、失效、导出、删除账号 ----------
			/** 同步码被服务器拒绝（在别的设备换过、或账号已删除）：不再发动作，等玩家输入新码 */
			let credBad = false;
			function readJson(k: string): unknown { try { return JSON.parse(store.get(k) || 'null'); } catch { return null; } }
			/** 把换码做完：成功后本机改用新码，旧码、旧二维码作废。quiet：后台补完时不弹失败提示 */
			async function finishRekey(next: Cred, quiet = false): Promise<boolean> {
				if (!cred || next.id !== cred.id) { store.del(NEXT_KEY); return false; }
				try {
					const { status, data } = await api({ action: 'rekey', id: cred.id, key: cred.key, newKey: next.key });
					if (data?.ok) {
						cred = next;
						store.set(CRED_KEY, JSON.stringify(next));
						store.del(NEXT_KEY);
						credBad = false;
						qrHtml = '';
						if (data.state) adopt(data.state);
						toast('同步码已更换：旧的同步码和二维码已失效，其他设备要输入新码');
						render();
						return true;
					}
					// 旧码、新码服务器都不认：别的设备又换过了。这次的新码作废
					if (status === 403) { store.del(NEXT_KEY); credBad = true; syncStatus = '同步码已失效：在「我 · 设置」输入新的同步码'; render(); return false; }
					if (!quiet) toast(data?.msg || '更换失败');
				} catch {
					if (!quiet) toast('网络断开了：联网后会自动把更换做完');
				}
				return false;
			}
			async function rekey() {
				if (!cred || !state || busy || flushing || syncing || credBad) return;
				if (!confirm('更换同步码后，旧的同步码和二维码立即失效；你的其他设备要输入新码才能继续玩。确定更换？')) return;
				const next = { id: cred.id, key: randId(24) };
				store.set(NEXT_KEY, JSON.stringify(next));
				await finishRekey(next);
			}
			async function onBadKey() {
				const pend = parsePendingKey(readJson(NEXT_KEY), cred);
				if (pend && (await finishRekey(pend, true))) return;
				credBad = true;
				syncStatus = '同步码已失效：在「我 · 设置」输入新的同步码';
				toast('这台设备的同步码已失效（可能在另一台设备更换过）：到「我 · 设置」输入新的同步码');
				render();
			}
			/** 同步码失效后输入新码：必须是同一个角色，服务器认了才换 */
			async function recode() {
				const c = parseSyncCode(($('s-code') as HTMLInputElement).value);
				if (!c) return toast('同步码格式不对');
				if (!cred || c.id !== cred.id) return toast('这是另一个角色的同步码：先「删除本机存档」，再用它恢复');
				try {
					const { data } = await api({ action: 'get', id: c.id, key: c.key });
					if (!data?.ok) return toast(data?.msg || '同步码不对');
					const clean = cloudSave(data.state, c.id);
					if (!clean) return toast('云端存档已损坏');
					cred = c;
					store.set(CRED_KEY, JSON.stringify(c));
					store.del(NEXT_KEY);
					credBad = false;
					adopt(clean, '同步码已更新');
					render();
					void flushQueue();
				} catch { toast('网络错误，请稍后再试'); }
			}
			/** 导出服务器上我的全部数据（JSON 文件，不含同步码） */
			async function exportSave() {
				if (!cred || credBad) return;
				try {
					const { data } = await api({ action: 'export', id: cred.id, key: cred.key });
					if (!data?.ok || !data.export) return toast(data?.msg || '导出失败');
					const d = document as unknown as { createElement?: (t: string) => any; body: { appendChild?: (e: unknown) => void } };
					const U = (globalThis as { URL?: { createObjectURL?: (b: Blob) => string; revokeObjectURL?: (u: string) => void } }).URL;
					if (typeof d.createElement !== 'function' || typeof U?.createObjectURL !== 'function') return toast('这个浏览器不支持下载文件');
					const url = U.createObjectURL(new Blob([JSON.stringify(data.export, null, 2)], { type: 'application/json' }));
					const a = d.createElement('a');
					a.href = url;
					a.download = exportName(data.export.exportedAt);
					d.body.appendChild?.(a);
					a.click();
					a.remove?.();
					setTimeout(() => U.revokeObjectURL?.(url), 1000);
					toast('已导出存档（文件里没有同步码）');
				} catch { toast('导出需要联网'); }
			}
			/** 本机保存的这个角色的一切：存档缓存、凭证、排队、换码中的新码 */
			function wipeLocal() { for (const k of [SAVE_KEY, CRED_KEY, QUEUE_KEY, NEXT_KEY]) store.del(k); }
			async function deleteAccount() {
				if (!cred || !state || busy || flushing || syncing || credBad) return;
				if (!confirm(`删除账号「${state.name}」？云端存档、排行榜记录和你贴的留言会全部删除，所有设备都找不回来。建议先「导出存档」。`)) return;
				if (!confirm('再确认一次：删除后不能恢复。')) return;
				try {
					const { data } = await api({ action: 'delete', id: cred.id, key: cred.key, confirm: 'delete' });
					if (!data?.ok) return toast(data?.msg || '删除失败');
					wipeLocal();
					location.reload();
				} catch { toast('删除账号需要联网'); }
			}

			// ---------- 在线状态 ----------
			// 在线频道的消息（有人进出、移动、聊天）一波波来：攒 150 毫秒合成一次重画，人多时不会每条消息都重画整页（第 35 轮）
			let liveTimer: ReturnType<typeof setTimeout> | null = null;
			function liveRender() {
				if (liveTimer) return;
				liveTimer = setTimeout(() => {
					liveTimer = null;
					if (!state) return;
					renderMap();
					renderTabs();
					if (tab === 'social') renderPanel();
				}, 150);
			}
			function connect() {
				if (!state || !cred || syncing || (ws && ws.readyState <= WebSocket.OPEN)) return;
				if (wsRetry) { clearTimeout(wsRetry); wsRetry = null; }
				// 在线频道按区域分：连的是所在地点的区域，记下来，跨区域后重连
				wsArea = curArea().id;
				const q = new URLSearchParams({ region: wsArea, id: cred.id, name: state.name, avatar: state.avatar, loc: state.loc });
				const sock = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/api/earth/ws?${q}`);
				ws = sock;
				sock.onmessage = (e) => {
					// 已经换掉的旧连接（跨区域后）还在路上的消息一律不处理，不然旧区域的玩家和聊天会混进新区域（第 9 批审查问题 1）
					if (ws !== sock) return;
					let m: any;
					try { m = JSON.parse(e.data); } catch { return; }
					if (m.t === 'hello') {
						wsDelay = 5000;
						myPeerId = m.you;
						emotes = m.emotes || [];
						peers = new Map((m.players as Peer[]).map((p) => [p.id, p]));
						sendMute();
					} else if (m.t === 'join') peers.set(m.p.id, m.p);
					else if (m.t === 'leave') peers.delete(m.id);
					else if (m.t === 'move') { const p = peers.get(m.id); if (p) p.loc = m.loc; }
					else if (m.t === 'notice') { if (typeof m.msg === 'string') toast(m.msg); return; }
					else if ((m.t === 'chat' && state && isBlocked(state, m.id)) || (m.t === 'emote' && state && isBlocked(state, m.from))) return;
					else if (m.t === 'chat') { chats.push(m); chats = chats.slice(-50); if (tab !== 'social') toast(`${m.name}: ${m.text}`); }
					else if (m.t === 'emote') toast(`${m.name} 向你 ${m.kind}`);
					else if (m.t === 'coop') { coopHint(); return; }
					else if (m.t === 'trade') { tradeHint(); return; }
					else return;
					liveRender();
				};
				sock.onerror = () => tm.track('err', 'ws');
				sock.onclose = () => {
					if (ws !== sock) return;
					ws = null;
					peers.clear();
					// 断开后在线人数清零：标签角标、地图和社交页跟着更新
					renderTabs();
					renderMap();
					if (tab === 'social') renderPanel();
					if (wsRetry) clearTimeout(wsRetry);
					wsRetry = setTimeout(() => { wsRetry = null; connect(); }, wsDelay);
					wsDelay = Math.min(wsDelay * 2, 60000);
				};
			}
			setInterval(() => { if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'ping' })); }, 20000);
			// 「附近」页的按钮状态随现实时间变化（上班满 15 分钟才能打下班卡、各动作的冷却）：有这类倒计时的时候每半分钟刷新一次
			setInterval(() => {
				if (tab !== 'near' || document.hidden || !state || state.pending) return;
				if (state.clockIn || Object.keys(state.venueCd).length) renderPanel();
			}, 30000);

			// ---------- 动作（发给服务器结算） ----------
			let busy = false;
			/** 正在处理扫码换角色（启动时）：原角色不连在线频道、不同步、不补交、不能操作 */
			let syncing = false;
			/** 每发起一次会改存档的请求就加一（留言不改存档，不算）：后台同步用它判断回来的存档是不是已经过时 */
			let actGen = 0;
			// ---------- 离线排队（第 33 轮）----------
			// 断网时点的动作先记在本机（只排白名单里的），联网后按顺序补交；服务器照常一个个结算，哪个没通过就停下、后面全取消
			let queue: Queued[] = [];
			let flushing = false;
			const NAMES = {
				activity: (id: string) => ACTIVITIES.find((x) => x.id === id)?.name,
				loc: (id: string) => getLocation(region, id)?.name,
				item: (id: string) => getItem(id)?.name,
				npc: (id: string) => NPCS.find((x) => x.id === id)?.name,
			};
			function saveQueue() { if (cred) store.set(QUEUE_KEY, queueJson(cred.id, queue)); }
			/** 从本机读出这个角色的排队（换了角色、坏数据、过期的都丢掉） */
			function loadQueue() {
				if (!cred) { queue = []; return; }
				const r = parseQueue(store.get(QUEUE_KEY), cred.id, Date.now());
				queue = r.items;
				saveQueue();
				if (r.expired) toast(flushSummary({ done: 0, cancelled: 0, expired: r.expired }));
			}
			function newOp() { return opId(crypto.getRandomValues(new Uint8Array(8))); }
			function queueUp(a: GameAction, op: string): null {
				const next = enqueue(queue, a, actLabel(a, NAMES), Date.now(), op);
				if (!next) {
					toast(queueable(a) ? `离线：最多排 ${QUEUE_MAX} 个动作，联网后再来` : '网络断开了，这件事要联网才能做');
					return null;
				}
				queue = next;
				saveQueue();
				toast(`离线：「${queue[queue.length - 1].label}」已排队（${queue.length}/${QUEUE_MAX}），联网后自动补交`);
				render();
				return null;
			}
			/** 联网后按顺序补交；第一个没通过的停下，后面的取消 */
			async function flushQueue() {
				if (flushing || syncing || !queue.length || !state || !cred || busy) return;
				flushing = true;
				const pruned = parseQueue(queueJson(cred.id, queue), cred.id, Date.now());
				queue = pruned.items;
				let done = 0, cancelled = 0, retried = 0;
				let failed: { label: string; msg: string } | undefined;
				let retriedOp = '';
				try {
					while (queue.length) {
						const it = queue[0];
						const r = await actOnce(it.act, it.op, true);
						if (r.kind === 'offline' || r.kind === 'skip') break; // 又断网了：留着下次再交
						// 版本冲突：补交途中另一台设备动过存档。冲突的回复已经带回最新存档，用同一个动作编号按新版本重交一次
						// （服务器按编号去重，不会做两遍）；同一个动作再冲突才算没通过
						if (r.kind === 'conflict' && retriedOp !== it.op) { retriedOp = it.op; retried++; continue; }
						queue = queue.slice(1);
						if (r.kind === 'ok') { done++; continue; }
						failed = { label: it.label, msg: r.msg };
						cancelled = queue.length;
						queue = [];
					}
				} finally {
					flushing = false;
					saveQueue();
				}
				const msg = flushSummary({ done, failed, cancelled, expired: pruned.expired, retried });
				if (msg) toast(msg);
				render();
			}
			function queueCard() {
				if (!queue.length) return '';
				return `<div class="card"><h3>排队中 · 联网后自动补交</h3><p class="muted">服务器按顺序结算；有一个没通过，后面的就取消。</p>
					<ol class="queue">${queue.map((q) => `<li>${esc(q.label)}</li>`).join('')}</ol>
					<div class="inline"><button data-queue-clear>全部取消</button></div></div>`;
			}

			async function act(a: GameAction): Promise<{ ok: boolean; msg: string } | null> {
				if (!state || !cred || busy || flushing || syncing) return null;
				if (credBad) { toast('这台设备的同步码已失效：到「我 · 设置」输入新的同步码'); return null; }
				// 这个动作的编号：断网后排队、补交都沿用它，服务器已经结算过的不会再做一次
				const op = newOp();
				// 还有排队的：先补交，保证顺序；补交不了（还离线）就接着排
				if (queue.length) {
					await flushQueue();
					if (queue.length) return queueable(a) ? queueUp(a, op) : (toast('网络断开了，这件事要联网才能做'), null);
					if (!state) return null;
				}
				const r = await actOnce(a, op);
				if (r.kind === 'ok') return { ok: true, msg: r.msg };
				if (r.kind === 'offline') return queueUp(a, op);
				return null;
			}
			type Sent = { kind: 'ok'; msg: string } | { kind: 'fail'; msg: string } | { kind: 'conflict'; msg: string } | { kind: 'offline' } | { kind: 'skip' };
			/** 发一个动作给服务器结算。quiet：补交时不逐个弹失败提示（最后汇总） */
			async function actOnce(a: GameAction, op: string, quiet = false): Promise<Sent> {
				if (!state || !cred || busy || syncing || credBad) return { kind: 'skip' };
				busy = true;
				actGen++;
				document.body.classList.add('busy');
				// 动作前的存档：请求期间后台同步可能替换 state，所以在发请求前记下
				const before = state;
				try {
					const { status, data } = await api({ action: 'act', id: cred.id, key: cred.key, rev: before.rev, act: a, op });
					// 同步码在别的设备换过了：这台设备的动作一个都交不上，排队的留着，等输入新码后再补交
					if (status === 403) { await onBadKey(); return { kind: 'skip' }; }
					if (status === 409 && data.state) { lastDelta = []; adopt(data.state, quiet ? undefined : data.msg); render(); return { kind: 'conflict', msg: data.msg || '存档版本变了' }; }
					if (data.state) adopt(data.state);
					// 只有返回的正好是动作前那一版的下一版，变化才是这个动作带来的
					if (data.ok && state && state.rev === nextRev(before.rev)) {
						lastDelta = stateDelta(before, state);
						ringFx = ringChanges(before, state);
						cashFx = state.cash - before.cash;
						buzz(10);
						if (drawer && drawer !== 'shop') drawer = null;
						const got = newAchievements(before, state, region);
						lastAch = got.map((d) => `${d.icon} ${d.name}`);
						if (got.length && prefs.achToast) setTimeout(() => toast(`🏅 达成成就：${got.map((d) => d.name).join('、')}（去成长页领奖）`), 1200);
						const cue = cueAfter({ ok: true, ach: got.length > 0, levelUp: level(state.respect).lv > level(before.respect).lv, travel: a.t === 'travel', pending: !!state.pending, weather: weatherAt(state).id, coin: state.cash > before.cash });
						if (cue) sfx(cue);
					}
					else { lastDelta = []; lastAch = []; }
					if (!data.ok) { sfx('fail'); buzz([12, 50, 12]); if (!quiet) toast(data.msg || '操作失败', true); render(); return { kind: 'fail', msg: data.msg || '操作失败' }; }
					return { kind: 'ok', msg: data.msg };
				} catch {
					syncStatus = '离线：可以查看，联网后才能行动';
					renderHud();
					return { kind: 'offline' };
				} finally {
					busy = false;
					document.body.classList.remove('busy');
				}
			}

			/** 动作前后各个需求环的变化（只记看得出的整数变化） */
			function ringChanges(a: PlayerState, b: PlayerState) {
				const out: Record<string, number> = {};
				const dh = Math.round(b.health) - Math.round(a.health);
				if (dh) out.health = dh;
				for (const k of NEED_KEYS) { const d = Math.round(b.needs[k]) - Math.round(a.needs[k]); if (d) out[k] = d; }
				return out;
			}
			/** 震动反馈：只有安卓浏览器支持，iPhone Safari 没有这个接口；设置里关掉或「减少动态效果」时不震。
			 * 只看玩家的动画设置和系统的减少动态效果，不跟画面档（P3 复核：省电、省流量档不该悄悄关掉震动） */
			function buzz(p: number | number[]) {
				if (!prefs.haptic || calmMotion(prefs, sysReduce)) return;
				try { (navigator as Navigator & { vibrate?: (p: number | number[]) => boolean }).vibrate?.(p); } catch {}
			}

			// ---------- 渲染 ----------
			function barCls(v: number) { return v < 25 ? 'low' : v < 50 ? 'mid' : ''; }
			/** 健康 + 5 项需求，今天页和顶栏共用 */
			function needList(s: PlayerState) {
				return [{ key: 'health', name: '健康', icon: '❤️', v: Math.round(s.health) }, ...NEED_KEYS.map((k) => ({ key: k as string, name: NEED_META[k].name, icon: NEED_META[k].icon, v: Math.round(s.needs[k]) }))];
			}
			function moodCls(m: number) { return m < 25 ? ' low' : m < 50 ? ' mid' : ''; }
			const PERIOD_ICON: Record<string, string> = { dawn: '🌅', day: '🌤️', dusk: '🌇', night: '🌙' };
			/** 紫外线现在「很高」及以上（≥ 8）时顶栏提醒（第 40 轮，只做提示） */
			function uvChip(s: PlayerState) {
				const uv = uvDay(getLocation(region, s.loc)!, s.clock, weatherAt(s).id).now;
				return uv >= 8 ? `<span class="chip fire-chip" title="紫外线指数（示意）">🕶️ 紫外线 ${uv}</span>` : '';
			}
			/** 火险「高」及以上时顶栏提醒（第 39 轮，只做提示；画顶栏不带副作用） */
			function fireChip(s: PlayerState) {
				const f = fireDanger(getLocation(region, s.loc)!, s.clock, weatherAt(s).id);
				if (f.id !== 'high' && f.id !== 'extreme' && f.id !== 'catastrophic') return '';
				return `<span class="chip fire-chip" title="火险等级（游戏估算，不是真实预警）">🔥 火险${f.name} · 示意</span>`;
			}
			/**
			 * 「极端」「灾难性」火险的提示：每个地点每个游戏日只弹一次（记在本机，重新载入也不重复）；
			 * 只在今天页、页面可见时弹；等 0.6 秒（让每日奖励等提示先过去）后再核对一次还在同一页、同一地点、同一天，不在就不弹也不记
			 */
			function maybeFireWarn() {
				const s = state;
				if (!s || tab !== 'place' || document.hidden || s.pending) return;
				const f = fireDanger(getLocation(region, s.loc)!, s.clock, weatherAt(s).id);
				if (f.id !== 'extreme' && f.id !== 'catastrophic') return;
				const key = fireKey(s.loc, dayOf(s.clock));
				if (parseFireSeen(store.get(FIRE_SEEN_KEY)).includes(key)) return;
				setTimeout(() => {
					const now = state;
					if (!now || tab !== 'place' || document.hidden || fireKey(now.loc, dayOf(now.clock)) !== key) return;
					const seen = parseFireSeen(store.get(FIRE_SEEN_KEY));
					if (seen.includes(key)) return;
					store.set(FIRE_SEEN_KEY, JSON.stringify(addFireSeen(seen, key)));
					toast(fireToastText(f.name, f.advice, curArea().id));
				}, 600);
			}
			function renderHud() {
				const s = state!;
				const m = mood(s);
				const stars = wantedStars(s.heat);
				const online = !/失败|离线|未同步/.test(syncStatus);
				const loc = getLocation(region, s.loc)!;
				const w = weatherAt(s);
				const p = period(s.clock);
				// 时段名是玩法时段（按钟点，活动、事件、NPC 日程看它）；画面天色按真实日出日落，两者不一致时补一句实际天色（第 8 批审查问题 4）
				const note = phaseNote(p.id, skyPhase(loc, s.clock));
				const time = `${PERIOD_ICON[p.id]} ${dateLabel(s.clock)} · ${WEEKDAYS[weekdayOf(s.clock)]} ${formatClock(s.clock).split(' ')[1]} ${p.name}${note ? `（${note}）` : ''}`;
				const sync = `<span class="sync-dot${online ? '' : ' off'}">${online ? '已同步' : '离线'}</span>`;
				const cf = Math.round(cashFx);
				cashFx = 0;
				const cash = `<span class="chip cash${cf ? ' bump' : ''}">$${s.cash.toLocaleString()}${cf ? `<i class="cash-delta ${cf > 0 ? 'up' : 'down'}" aria-hidden="true">${cf > 0 ? '+' : '−'}$${Math.abs(cf).toLocaleString()}</i>` : ''}</span>`;
				const moodBtn = `<button class="moodchip${moodCls(m)}" data-tab="me" title="看心情的来源"><span>心情 ${moodTier(m).name} ${m}</span></button>`;
				const starHtml = stars ? `<span class="chip" title="通缉星级（麻烦值 ${Math.round(s.heat)}）">${'★'.repeat(stars)}</span>` : '';
				let top: string;
				if (tab === 'place') {
					// 今天页：时间 + 地点大标题 + 天气；下面一排现金、工作/等级、心情（需求条在页面里）
					const career = s.job ? getCareer(s.job.career) : undefined;
					const lv = level(s.respect);
					const role = career ? `${career.name} · ${career.levels[s.job!.level]?.title ?? ''}` : `Lv${lv.lv} ${lv.title}`;
					// 场景顶栏（虚拟人生风格）：当地小场景当背景，时间、天气浮在上面，地点做名牌；最缺的需求变成人物头上的想法气泡
					const needs = needList(s);
					const worst = needs.reduce((a, b) => (b.v < a.v ? b : a));
					const worstKey = worst.name === '健康' ? 'health' : NEED_KEYS.find((k) => NEED_META[k].name === worst.name) ?? '';
					const thought = worst.v < 60 && NEED_LOW[worstKey] ? `<span class="thought">${esc(NEED_LOW[worstKey])}</span>` : '';
					// 主界面定稿（第 15 批）：左上是人物名牌（头像外圈是升级进度环，点了去成长页），右上是现金和天气，时间写在地点名牌里
					const lvPct = lv.next !== null ? Math.min(100, Math.round((s.respect / lv.next) * 100)) : 100;
					const lvPlate = `<button class="lv-plate" data-tab="grow" aria-label="Lv${lv.lv} ${esc(lv.title)}，升级进度 ${lvPct}%，去成长页"><span class="lv-ring"><svg viewBox="0 0 46 46" aria-hidden="true" focusable="false"><circle cx="23" cy="23" r="20" class="track"/><circle cx="23" cy="23" r="20" class="arc" stroke-dasharray="${ringDash(lvPct, 20)}" transform="rotate(-90 23 23)"/></svg><span class="lv-ava" aria-hidden="true">${s.avatar}</span><b class="lv-num" aria-hidden="true">${lv.lv}</b></span><span class="lv-txt"><b>${esc(s.name)}</b><small>${wornTitle(s) ? `「${esc(wornTitle(s))}」` : esc(lv.title)}${lv.next !== null ? ` · 离下一级 ${fmtHalf(Math.max(0, lv.next - s.respect))}` : ''}</small></span></button>`;
					top = `<div class="scene">${sceneSvg({ phase: skyPhase(loc, s.clock), weather: w.id, kind: loc.kind, tags: loc.tags })}
						<div class="scene-top">${lvPlate}<div class="scene-right">${cash}
						<span class="wx-pill${w.closesSea ? ' storm' : ''}">${w.icon} ${esc(w.name)} ${temps(loc, s.clock, w.id).max}°${w.closesSea ? ' · 海上关闭' : ''}</span></div></div>
						<div class="plate"><h1>${esc(loc.name)}</h1><span class="en" lang="en" aria-hidden="true">${esc(loc.en)}</span><small title="${formatClock(s.clock)}">${time}</small></div>${thought}</div>
						<div class="hud-chips"><span class="chip">${esc(role)}</span>${starHtml}${warningChip(warningsAt(s, region), esc)}${fireChip(s)}${uvChip(s)}${moodBtn}${sync}</div>`;
				} else {
					// 其他页：副标题 + 页名；右边现金和心情，下面一条迷你需求条
					const here = [...peers.values()].filter((p) => p.loc === s.loc && p.id !== myPeerId).length;
					const sub: Record<string, string> = {
						go: `从${loc.name}出发 · ${time}`,
						near: '真实地点 · 本人到场才能用',
						grow: `${level(s.respect).title} · 收集与成就`,
						social: `${loc.name} · ${here ? `${here} 位玩家在线` : '没有其他玩家在线'}`,
						me: `${dateLabel(s.clock)} · 已过 ${dayOf(s.clock) + 1} 天`,
					};
					const tabKey = TABS.find(([id]) => id === tab)?.[1]; const title = tab === 'near' ? '附近' : tabKey ? tx(tabKey) : '';
					top = `<div class="hud-top"><div class="hud-title"><span class="hud-sub">${esc(sub[tab] ?? time)}</span><h1>${title}</h1></div>
						<div class="hud-right">${cash}${starHtml}</div></div>
						<div class="hud-chips">${moodBtn}${sync}</div>
						<div class="mini-needs">${needList(s).map((n) => `<div class="need" title="${n.name} ${n.v}">${n.icon}<div class="bar"><i class="${barCls(n.v)}" style="width:${n.v}%"></i></div></div>`).join('')}</div>`;
				}
				const offline = syncStatus.startsWith('离线') ? `现在离线：可以查看；做事、出行等可以先排队，联网后自动补交${queue.length ? `（已排 ${queue.length} 个）` : ''}` : queue.length ? `有 ${queue.length} 个排队的动作等着补交` : '';
				$('hud').classList.toggle('scened', tab === 'place');
				paint($('hud'), `${top}${offline ? `<div class="offline" role="status">${offline}</div>` : ''}`);
			}

			/** 玩家所在的区域（地图按它画）；还没有角色时用第一个区域 */
			function curArea(): Region { return (state && areaOf(state.loc)) || MAP_AREAS[0]; }
			/** 每个区域一套投影（按它自己的范围），算一次就缓存 */
			const projCache = new Map<string, ReturnType<typeof makeProjection>>();
			function projOf(a: Region) {
				let p = projCache.get(a.id);
				if (!p) projCache.set(a.id, (p = makeProjection(a)));
				return p;
			}
			/** 夜里地图上的星星：固定的伪随机位置，每次画都一样 */
			function starField(w: number, h: number) {
				let x = 2463534242;
				const next = () => { x ^= x << 13; x ^= x >>> 17; x ^= x << 5; return (x >>> 0) / 4294967296; };
				return Array.from({ length: 36 }, () => `<circle class="star" cx="${(next() * w).toFixed(1)}" cy="${(next() * h).toFixed(1)}" r="${(0.4 + next() * 0.8).toFixed(2)}"/>`).join('');
			}
			function renderMap() {
				// 地图只在「出行」页显示：其他页不画，切到出行页时 renderPanel 会补画
				if (tab !== 'go' || !state) return;
				const s = state!;
				const area = curArea();
				const proj = projOf(area);
				const pt = (id: string) => { const l = getLocation(region, id)!; return proj.project(l.lon, l.lat); };
				const outline = area.outline.map(([lon, lat]) => proj.project(lon, lat).join(',')).join(' ');
				const routes = area.routes.map((r) => {
					const [x1, y1] = pt(r.a), [x2, y2] = pt(r.b);
					const live = r.a === s.loc || r.b === s.loc ? ' live' : '';
					return `<line class="route ${r.mode}${live}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`;
				}).join('');
				// 跨区域出口（第 43 轮）：从本区域的那一头朝另一个区域的方向画一小段，标上去哪；点它和点地点一样，出目的地卡片
				const exits = exitsOf(area).map((r) => {
					const mine = area.locations.find((l) => l.id === r.a || l.id === r.b)!;
					const far = getLocation(region, mine.id === r.a ? r.b : r.a)!;
					const [x, y] = proj.project(mine.lon, mine.lat);
					const ang = Math.atan2(mine.lat - far.lat, far.lon - mine.lon);
					const ex = Math.min(proj.width - 6, Math.max(6, x + Math.cos(ang) * 38)), ey = Math.min(proj.height - 6, Math.max(6, y + Math.sin(ang) * 38));
					const live = mine.id === s.loc ? ' live' : '';
					const anchor = ex >= x ? 'start' : 'end';
					const farArea = areaOf(far.id);
					return `<line class="route exit ${r.mode}${live}" x1="${x}" y1="${y}" x2="${ex.toFixed(1)}" y2="${ey.toFixed(1)}"/>
						<text class="exit-label" x="${(ex + (anchor === 'start' ? 4 : -4)).toFixed(1)}" y="${(ey + 3).toFixed(1)}" text-anchor="${anchor}">${r.mode === 'air' ? '✈️' : '🛣️'} ${esc(far.name)}${farArea ? `（${esc(farArea.name)}）` : ''}</text>
						<circle class="hit" data-loc="${far.id}" cx="${ex.toFixed(1)}" cy="${ey.toFixed(1)}" r="15"/>`;
				}).join('');
				const counts = new Map<string, number>();
				for (const p of peers.values()) if (p.id !== myPeerId) counts.set(p.loc, (counts.get(p.loc) || 0) + 1);
				const dots = area.locations.map((l) => {
					const [x, y] = proj.project(l.lon, l.lat);
					const here = l.id === s.loc;
					const cls = here ? 'here' : `dot${s.visited[l.id] ? '' : ' new'}${selected === l.id ? ' sel' : ''}`;
					const [dx, dy, anchor] = LABEL[l.id] ?? (x > proj.width * 0.7 ? [-8, 3, 'end'] : [8, 3, 'start']);
					const n = counts.get(l.id);
					return `${here ? `<circle class="pulse" cx="${x}" cy="${y}" r="7"/>` : ''}
						<circle class="${cls}" cx="${x}" cy="${y}" r="${here ? 6 : 4.5}"/>
						<text x="${x + dx}" y="${y + dy}" text-anchor="${anchor}">${esc(l.name)}<tspan class="wx">${weatherOn(l.id, dayOf(s.clock)).icon}</tspan>${n ? ` <tspan class="cnt">👥${n}</tspan>` : ''}</text>
						<circle class="hit" data-loc="${l.id}" cx="${x}" cy="${y}" r="15"/>`;
				}).join('');
				const map = $('map');
				map.setAttribute('aria-label', mapLabel(area.name, false));
				map.setAttribute('viewBox', `0 0 ${proj.width} ${proj.height}`);
				const stars = skyPhase(getLocation(region, s.loc)!, s.clock) === 'night' ? starField(proj.width, proj.height) : '';
				setHtml(map, `${stars}<polygon class="land" points="${outline}"/>${routes}${exits}${dots}`);
				renderBasemap(s, counts);
			}

			// ---------- 真实底图（第 31 轮）----------
			// 手绘地图照常画（离线、加载中、失败时看它）；真实地图加载好、又联网时盖在上面
			let basemap: Basemap | null = null;
			/** 底图是按哪个区域建的 */
			let basemapArea = '';
			/** 同步页里显示的二维码（SVG），点「收起」清掉 */
			let qrHtml = '';
			let basemapFailed = false;
			let webglOk: boolean | null = null;
			function renderBasemap(s: PlayerState, counts: Map<string, number>) {
				const wrap = $('map-wrap');
				webglOk ??= webglSupported(document as unknown as { createElement?: (t: string) => unknown });
				const online = (navigator as { onLine?: boolean }).onLine !== false;
				if (!canUseBasemap({ pref: prefs.basemap && fx.basemap, online, webgl: webglOk, failed: basemapFailed })) {
					wrap.classList.remove('real');
					return;
				}
				const area = curArea();
				// 换了区域：底图按新区域的范围重建
				if (basemap && basemapArea !== area.id) dropBasemap();
				const bounds = basemapBounds(area.locations);
				if (!basemap) {
					basemapArea = area.id;
					$('basemap').setAttribute('aria-label', mapLabel(area.name, true));
					const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#1d5fd1';
					basemap = createBasemap({
						container: $('basemap'),
						bounds,
						doc: document,
						routeColor: accent,
						onState: (st) => {
							if (st === 'failed') { basemapFailed = true; basemap = null; }
							if (tab === 'go') renderMap();
						},
					});
				}
				basemap.resize();
				// 跨区域出口（v42）：手绘地图上有，真实地图以前只画了一条伸出去的线、没地方点；现在在地图边上放一个出口标记
				const exitPins: Pin[] = exitsOf(area).map((r) => {
					const mine = area.locations.find((l) => l.id === r.a || l.id === r.b)!;
					const far = getLocation(region, mine.id === r.a ? r.b : r.a)!;
					const [lon, lat] = exitPoint([mine.lon, mine.lat], [far.lon, far.lat], bounds);
					return { id: far.id, name: far.name, lon, lat, here: false, visited: true, selected: selected === far.id, wx: '', count: 0, exit: { mode: r.mode, area: areaOf(far.id)?.name ?? '', end: far.lon > mine.lon } };
				});
				basemap.update({
					pins: [...area.locations.map((l) => ({ id: l.id, name: l.name, lon: l.lon, lat: l.lat, here: l.id === s.loc, visited: !!s.visited[l.id], selected: selected === l.id, wx: weatherOn(l.id, dayOf(s.clock)).icon, count: counts.get(l.id) ?? 0 })), ...exitPins],
					routes: [...area.routes, ...exitsOf(area)].map((r) => {
						const a = getLocation(region, r.a)!, b = getLocation(region, r.b)!;
						return { a: [a.lon, a.lat] as [number, number], b: [b.lon, b.lat] as [number, number], live: r.a === s.loc || r.b === s.loc };
					}),
				});
				wrap.classList.toggle('real', basemap.ready);
			}
			function dropBasemap() {
				basemap?.destroy();
				basemap = null;
				$('map-wrap').classList.remove('real');
			}

			function hero(key: string, fallback: string) {
				return heroHtml(esc, fx.clips ? media.loc[key] : undefined, cgi[key], fallback);
			}
			/** NPC 头像：有 CGI 用图，没有就用按 id 画的 SVG 立绘 */
			function portrait(id: string) {
				const img = cgi['npc:' + id];
				return img ? `<img class="portrait" src="${esc(img)}" alt="" loading="lazy" width="56" height="56" />` : portraitSvg(id);
			}
			/** 行内缩略图（48px）：有 CGI 用图，没有就用原来的样式（fallback，通常是 emoji 方块；空串表示什么都不放） */
			function thumb(key: string, fallback = '') {
				return cgi[key] ? `<img class="thumb" src="${esc(cgi[key])}" alt="" loading="lazy" width="48" height="48" />` : fallback;
			}
			/** 卡片封面：有图才出，没图不占位 */
			function cover(key: string) {
				return cgi[key] ? hero(key, '') : '';
			}
			/** 页头横幅和空状态小插图：有图才出 */
			/** 这一页正显示新手便签（renderPanel 里每次重算） */
			let slipOnPage = false;
			/** 需求环上变了的数字从旧值滚到新值（500ms 缓出）；减少动态效果时直接显示新值 */
			function tickNumbers() {
				if (typeof document.querySelectorAll !== 'function' || typeof requestAnimationFrame !== 'function' || document.documentElement?.classList?.contains('calm')) return;
				for (const b of document.querySelectorAll<HTMLElement>('#panel .ring b[data-from]')) {
					const from = Number(b.dataset.from), to = Number(b.textContent);
					b.removeAttribute('data-from');
					if (!Number.isFinite(from) || !Number.isFinite(to) || from === to) continue;
					const t0 = performance.now();
					const step = (t: number) => {
						const k = Math.min(1, (t - t0) / 500);
						b.textContent = String(Math.round(from + (to - from) * (1 - Math.pow(1 - k, 3))));
						if (k < 1) requestAnimationFrame(step);
					};
					b.textContent = String(from);
					requestAnimationFrame(step);
				}
			}
			function banner(key: string) {
				if (slipOnPage) return '';
				return cgi[key] ? `<div class="banner"><img src="${esc(cgi[key])}" alt="" loading="lazy" /></div>` : '';
			}
			function emptyArt(key: string) {
				return cgi[key] ? `<div class="empty-art"><img src="${esc(cgi[key])}" alt="" loading="lazy" /></div>` : '';
			}

			const minutesLabel = (m: number) => (m >= 60 ? (m / 60).toFixed(m % 60 ? 1 : 0) + ' 小时' : m + ' 分钟');
			const NEED_LOW: Record<string, string> = { health: '身体不太舒服', hunger: '肚子有点饿了', energy: '有点累了', hygiene: '该洗个澡了', fun: '有点无聊', social: '想找人说说话' };
			/** 今天页的状态卡：健康 + 5 项需求；低于 60 的最低一项标「最缺」（名字、现金、心情在顶栏） */
			function needsCard(s: PlayerState) {
				const list = needList(s);
				const min = Math.min(...list.map((n) => n.v));
				// 需求环（虚拟人生风格）：六个圆环一排，数字在环中间；最低一项低于 60 时名字下标「最缺」
				const fx = ringFx;
				ringFx = {};
				return `<div class="card"><h3>状态</h3><div class="rings">${list.map((n) => { const d = Math.round(fx[n.key] ?? 0); return `<div class="ring ${barCls(n.v)}${d ? ' bump' : ''}" role="img" aria-label="${n.name} ${n.v}${d ? `，刚才${d > 0 ? '加' : '减'}了 ${Math.abs(d)}` : ''}${n.v === min && min < 60 ? '，最缺' : ''}">
					<svg viewBox="0 0 50 50" aria-hidden="true" focusable="false"><circle cx="25" cy="25" r="21" class="track"/><circle cx="25" cy="25" r="21" class="arc" stroke-dasharray="${ringDash(n.v)}" transform="rotate(-90 25 25)"/></svg>
					${d ? `<i class="ring-delta ${d > 0 ? 'up' : 'down'}" aria-hidden="true">${d > 0 ? '+' : '−'}${Math.abs(d)}</i>` : ''}<b${d ? ` data-from="${n.v - d}"` : ''}>${n.v}</b><span><span aria-hidden="true">${n.icon}</span> ${n.name}</span>${n.v === min && min < 60 ? '<em class="lack">最缺</em>' : ''}</div>`; }).join('')}</div></div>`;
			}
			/** 健康卡（健康系统第 1 版）：生病时写病名、还要多久、不能做什么；生病或健康低于 70 时列出这里能做的就医（GP、药房、急诊）和自付金额 */
			function healthCard(s: PlayerState) {
				const cur = currentIllness(s);
				if (!cur && s.health >= 70) return '';
				const cover = coverOf(s);
				const LOAD: Record<string, string> = { heavy: '剧烈运动', sea: '下海', work: '上班' };
				const head = cur ? `<p>${cur.def.icon} <b>${esc(cur.def.name)}</b> · 还要约 ${hoursLeft(s)} 小时${cur.def.blocks.length ? ` · 期间不能${cur.def.blocks.map((b) => LOAD[b]).join('、')}` : ''}</p><p class="muted">${esc(cur.def.desc)}${cur.ill.rx && !cur.ill.care.includes('rx') ? ' 医生开了处方，去药房取药。' : ''}</p>` : `<p>健康 ${Math.round(s.health)}，可以看看医生。</p>`;
				const rows = careAt(s, region).map(({ care, out, blocked }) => `
					<button class="row" data-care="${care.id}" ${blocked ? 'disabled' : ''}><span class="ico" aria-hidden="true">${care.icon}</span>
					<span class="body">${esc(care.name)}<small>${esc(blocked ?? out.notes.join('，'))}</small></span><span class="meta"><b>${out.cost ? '$' + out.cost : '免费'}</b>${minutesLabel(out.minutes)}</span></button>`).join('');
				return `<div class="card"><h3>${cur ? '生病了' : '身体'} <span class="chip">${esc(cover.name)}</span></h3>${head}${rows ? `<div class="list" style="margin-top:8px">${rows}</div>` : '<p class="muted" style="margin-top:6px">这里没有诊所和药房，去城镇或有医院的地方。</p>'}<p class="muted" style="margin-top:6px">${esc(cover.note)} 游戏里的简化，不是医疗建议。</p></div>`;
			}
			/** 四个快捷动作：从最缺的需求起，每项挑这里能补它最多、还没选过的事；有待处理事件或凑不够两个时不显示。只是快捷入口，下面的完整列表照旧 */
			function quickActs(s: PlayerState) {
				if (s.pending) return [];
				const open = activitiesAt(s, region).filter((x) => !x.blocked).map((x) => x.act);
				const order = [...NEED_KEYS].sort((a, b) => s.needs[a] - s.needs[b]);
				const pick: (typeof open)[number][] = [];
				for (const k of order) {
					const best = open.filter((a) => !pick.includes(a) && (a.fx.needs?.[k] ?? 0) > 0).sort((a, b) => (b.fx.needs![k] ?? 0) - (a.fx.needs![k] ?? 0))[0];
					if (best) pick.push(best);
					if (pick.length === 4) break;
				}
				return pick.length >= 2 ? pick : [];
			}
			function quickHtml(s: PlayerState) {
				const acts = quickActs(s);
				if (!acts.length) return '';
				const cost = (c?: number) => (c ? (c > 0 ? '+' : '−') + '$' + Math.abs(c) : '免费');
				return `<div class="quick" role="group" aria-label="常用的事">${acts.map((a) => `<button data-act="${a.id}" aria-label="${esc(a.name)}，${cost(a.fx.cash)}，${minutesLabel(a.minutes)}"><span class="qico" aria-hidden="true">${a.icon}</span><b>${esc(a.name)}</b><small>${cost(a.fx.cash)}</small></button>`).join('')}</div>`;
			}
			/** 「下一步」：最缺的那项需求 → 这里能补它最多的事；需求都还行时提示上班或出门。只是建议，结算仍由服务器做 */
			function nextCard(s: PlayerState, homeHere: boolean, canWork: boolean) {
				// 有没处理的事件时什么都做不了（引擎会拒绝），不给按钮
				if (s.pending) return '';
				const loc = getLocation(region, s.loc)!;
				const vals: [string, string, number][] = [['health', '健康', s.health], ...NEED_KEYS.map((k) => [k, NEED_META[k].name, s.needs[k]] as [string, string, number])];
				const [key, name, v] = vals.reduce((a, b) => (b[2] < a[2] ? b : a));
				let title = '', text = '', btn = '', attr = '';
				const open = activitiesAt(s, region).filter((x) => !x.blocked).map((x) => x.act);
				const costLabel = (c?: number) => (c ? (c > 0 ? '+' : '') + '$' + Math.abs(c) : '免费');
				const suggestAct = (act: (typeof open)[number]) => { btn = `${esc(act.name)} · ${costLabel(act.fx.cash)} · ${minutesLabel(act.minutes)}`; attr = `data-act="${act.id}"`; };
				/** 最缺的那项需求：推荐补它最多的事（精力在家就回家睡） */
				const fixNeed = () => {
					title = NEED_LOW[key];
					const best = open
						.map((act) => ({ act, gain: key === 'health' ? act.fx.health ?? 0 : act.fx.needs?.[key as keyof typeof s.needs] ?? 0 }))
						.filter((x) => x.gain > 0)
						.sort((x, y) => y.gain - x.gain)[0];
					if (key === 'energy' && homeHere) {
						text = `精力只剩 ${Math.round(v)}，回家睡一觉能回满`; btn = '回家睡觉'; attr = 'data-home="sleep"';
					} else if (best) {
						text = `${name}只剩 ${Math.round(v)}，在${esc(loc.name)}${esc(best.act.name)}能补回来`; suggestAct(best.act);
					} else {
						text = `${name}只剩 ${Math.round(v)}，这里没有能补的事，换个地方看看`; btn = '去出行'; attr = 'data-tab="go"';
					}
				};
				// 周结算钱不够：能上班就上班，否则推荐这里最赚钱的事
				const wc = weeklyCosts(s);
				const short = wc.total > 0 && s.nextWeek - dayOf(s.clock) <= 2 && s.cash < wc.total ? wc.total - s.cash : 0;
				const earner = open.filter((act) => (act.fx.cash ?? 0) > 0).sort((x, y) => (y.fx.cash ?? 0) - (x.fx.cash ?? 0))[0];
				// 今天的心愿里有在这里就能完成的
				const hr = Math.floor((s.clock % 1440) / 60);
				const night = hr >= 22 || hr < 6;
				const wishAct = s.wishes.map((id) => getWish(id)).flatMap((w) => (w && w.done.t === 'activity' ? w.done.ids.map((aid) => ({ w, act: open.find((x) => x.id === aid) })) : [])).find((x) => x.act);
				if (v < 40) fixNeed();
				else if (short && canWork) { title = '周结算钱不够'; text = `还差 $${short.toLocaleString()}，正好在工作的地方，先上个班`; btn = '上班'; attr = 'data-job="work"'; }
				else if (short && earner) { title = '周结算钱不够'; text = `还差 $${short.toLocaleString()}，在${esc(loc.name)}${esc(earner.name)}能挣一点`; suggestAct(earner); }
				else if (v < 60) fixNeed();
				else if (night && s.needs.energy < 80) {
					// 夜深了：有家回家睡，有露营车睡车里，否则找这里能补精力最多的（旅馆、露营）
					title = '夜深了';
					const van = getVehicle(s.vehicle)?.sleep;
					const bed = open.filter((act) => (act.fx.needs?.energy ?? 0) > 0).sort((x, y) => (y.fx.needs?.energy ?? 0) - (x.fx.needs?.energy ?? 0))[0];
					if (homeHere) { text = '回家睡一觉，明天精神满满'; btn = '回家睡觉'; attr = 'data-home="sleep"'; }
					else if (van) { text = '在车里睡一晚，不花钱'; btn = '在车里睡'; attr = 'data-veh="sleep"'; }
					else if (bed) { text = `在${esc(loc.name)}找个地方过夜`; suggestAct(bed); }
					else { text = '这里没地方过夜，换个地方看看'; btn = '去出行'; attr = 'data-tab="go"'; }
				}
				else if (canWork) { title = '该上班了'; text = '状态不错，正好在工作的地方'; btn = '上班'; attr = 'data-job="work"'; }
				else if (wishAct) { title = '完成一个心愿'; text = `「${esc(wishAct.w!.text)}」在这里就能做到`; suggestAct(wishAct.act!); }
				else { title = '状态不错'; text = s.wishes.length ? `今天还有 ${s.wishes.length} 个心愿没完成` : '出去走走，看看会遇到什么'; btn = '去出行'; attr = 'data-tab="go"'; }
				return `<div class="next"><span class="lbl">下一步<i lang="en" aria-hidden="true">NEXT</i></span><h2>${title}</h2><p>${text}</p><button ${attr}>${btn}</button></div>`;
			}

			// 新手指南（第 26 轮）：前三天分步解开，做到了自动打勾；点「知道了」或在设置里关掉后不再显示（只记在本机）
			// ---------- 新手引导（v36）：上下文提示、新出现的功能、回流卡片 ----------
			// 进度在存档的 onboard 字段里（跟着存档同步）；点关掉时先在本机藏起来，再把动作发给服务器记下
			const obHidden = new Set<string>();
			let obPending: OnboardOp[] = [];
			let obSending = false;
			let obRetryAt = 0;
			function obSend(o: OnboardOp, hide?: string) {
				if (hide) obHidden.add(hide);
				obPending = [...obPending, o];
				void flushOnboard();
			}
			/** 依次补交引导动作：不弹提示、不记「刚才的变化」；离线时留着，下次画界面时再试 */
			async function flushOnboard() {
				if (obSending || !obPending.length || !state || !cred || busy || syncing || flushing || Date.now() < obRetryAt) return;
				obSending = true;
				busy = true;
				let tries = 0;
				let got = false;
				try {
					while (obPending.length && state && cred && tries < 4) {
						tries++;
						const { status, data } = await api({ action: 'act', id: cred.id, key: cred.key, rev: state.rev, act: { t: 'onboard', ...obPending[0] }, op: newOp() });
						if (data?.state && adopt(data.state)) got = true;
						if (status === 409) continue; // 另一台设备刚改过：拿到最新版本后重发
						obPending = obPending.slice(1);
					}
				} catch {
					// 离线：留在本机，30 秒后下次画界面时再交
					obRetryAt = Date.now() + 30_000;
				} finally {
					obSending = false;
					busy = false;
				}
				if (got) renderPanel();
			}
			/** 便签左侧的图形：和底部标签同一套线条图标 */
			const SLIP_ICON: Record<string, string> = {
				...Object.fromEntries(TABS.map(([id, , icon]) => [id, icon])),
				near: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
				sync: '<circle cx="8" cy="15" r="4"/><path d="M11 12l8-8M16 7l2.5 2.5M14 9l2 2"/>',
				feat: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8.5 11V7.5a3.5 3.5 0 0 1 6.8-1.2"/>',
			};
			function slip(id: string, icon: string, title: string, text: string, close: string, extra = '') {
				return `<section class="slip" aria-labelledby="slip-${id}"><span class="slip-stub" aria-hidden="true"><svg viewBox="0 0 24 24">${SLIP_ICON[icon] ?? ''}</svg></span>
					<div class="slip-body"><h3 id="slip-${id}">${esc(title)}</h3><p>${esc(text)}</p>
					<div class="slip-acts">${extra}${close}</div></div></section>`;
			}
			/** 第一次进入某页的提示：关掉后不再出现（记进存档，换设备也一样） */
			function tipSlip(page: OnboardPage) {
				const t = state && tipFor(state, page);
				if (!t || obHidden.has(t.id)) return '';
				const go = t.go ? `<button class="slip-go" data-tab="${t.go.page === 'sync' ? 'me' : t.go.page}"${t.go.page === 'sync' ? ' data-metab-go="sync"' : ''}>${esc(t.go.label)}</button>` : '';
				return slip(t.id, page, t.title, t.text, `<button class="slip-x" data-ob-tip="${t.id}" aria-label="关掉提示「${esc(t.title)}」，以后不再出现">知道了</button>`, go);
			}
			/** 今天页：刚出现的功能，一次一条 */
			function featSlip(s: PlayerState) {
				const f = newFeature(s);
				if (!f || obHidden.has('feat:' + f.id)) return '';
				return slip('feat-' + f.id, 'feat', `新出现：${f.name}`, `在${f.where}。`, `<button class="slip-x" data-ob-tip="feat:${f.id}" aria-label="关掉「新出现：${esc(f.name)}」">知道了</button>`);
			}
			/** 今天页最下面：还没出现的卡片和怎么让它出现；老手可以一次全部显示 */
			function laterNote(s: PlayerState) {
				const l = lockedFeatures(s);
				if (!l.length || obHidden.has('all')) return '';
				return `<div class="later"><p><b>之后会出现</b>${l.map((f) => `${esc(f.name)}（${esc(f.hint)}）`).join('；')}。</p><button data-ob-all>现在全部显示</button></div>`;
			}
			/** 离开几天后回来：再次入境章、离开了几天、主线停在哪、离开期间的更新 */
			function returnCard(s: PlayerState) {
				const r = returnView(s, s.daily.day, news?.CHANGELOG ?? []);
				if (!r || obHidden.has('back')) return '';
				// 更新日志按需加载（第 41 批）：回流卡片要列离开期间的更新时才去下，下完重画今天页
				if (!news) void loadNews();
				const lines = [
					r.story ? `<li><b>主线停在</b>${esc(r.story.title)}：${esc(r.story.step)}</li>` : '',
					r.low ? '<li><b>先补一补</b>有需求低于 30，「下一步」会告诉你去哪补</li>' : '',
					r.news.length ? `<li><b>离开期间更新了 ${r.news.length} 次</b>${r.news.map((n) => esc(n.title)).join('、')}（「我 · 更新」里看详情）</li>` : '',
				].join('');
				return `<section class="back-card" aria-labelledby="back-title">
					<svg class="back-stamp" viewBox="0 0 120 120" aria-hidden="true" focusable="false"><circle cx="60" cy="60" r="55"/><circle cx="60" cy="60" r="47" class="thin"/><text x="60" y="54" class="big">入境</text><text x="60" y="72">RE-ENTRY</text><text x="60" y="88" class="small">${r.gap} DAY${r.gap === 1 ? '' : 'S'}</text></svg>
					<h3 id="back-title">欢迎回来，离开了 ${r.gap} 天</h3>
					<p>游戏里的时间没有走，需求和钱都停在你离开时的样子。</p>
					${lines ? `<ul>${lines}</ul>` : ''}
					<button class="back-ok" data-ob-back>知道了，接着玩</button></section>`;
			}
			function guideCard(s: PlayerState) {
				if (!prefs.guide) return '';
				const g = guideView(s);
				if (!g) return '';
				const item = (st: GuideView['steps'][number]) => {
					const now = st.id === g.current;
					const go = now && st.tab && st.tab !== tab ? `<button class="guide-go" data-tab="${st.tab}"${st.tab === 'me' ? ' data-metab-go="sync"' : ''}>去看看</button>` : '';
					return `<li class="${st.done ? 'done' : now ? 'now' : ''}"${now ? ' aria-current="step"' : ''}><span class="tick" aria-hidden="true">${st.done ? '✓' : ''}</span><span>${esc(st.title)}${now ? '<em class="now-tag">现在</em>' : ''}<small>${esc(st.hint)}</small>${go}</span><span class="sr">${st.done ? '（已完成）' : now ? '（下一步）' : ''}</span></li>`;
				};
				return `<div class="card guide"><div class="guide-head"><h3>新手指南 · 第 ${g.day} 天 <span class="muted">${g.done}/${g.total}</span></h3><button data-guide-close>知道了</button></div>
					<ol>${g.steps.map(item).join('')}</ol>${g.next ? `<p class="guide-next">做完这些或到第 ${g.day + 1} 天解开：${esc(g.next)}</p>` : ''}</div>`;
			}

			// 每日摘要（第 27 轮）：跨过午夜后的那一天，今天页顶上显示上一天的变化和日志；点「知道了」后这一天不再显示（只记在本机）
			const RECAP_KEY = 'earth.recap.v1';
			function recapCard(s: PlayerState) {
				const y = recapFor(s);
				if (!prefs.recap || !y || store.get(RECAP_KEY) === String(y.day)) return '';
				const title = y.days > 1 ? `过去 ${y.days} 天回顾（第 ${y.day + 1}–${y.day + y.days} 天）` : `昨天回顾（第 ${y.day + 1} 天）`;
				const money = y.cash === 0 ? '现金没变' : `现金 ${y.cash > 0 ? '+' : '−'}$${Math.abs(y.cash).toLocaleString()}`;
				const rep = Math.round(y.respect * 10) / 10;
				const parts = [money, rep ? `声望 ${rep > 0 ? '+' : '−'}${Math.abs(rep)}` : '', y.places ? `新去了 ${y.places} 个地方` : ''].filter(Boolean);
				const lines = recapLog(s, y).map((j) => `<li><span class="muted">${formatClock(j.t).split(' ')[1]}</span> ${esc(j.text)}</li>`).join('');
				return `<div class="card recap"><div class="guide-head"><h3>${title}</h3><button data-recap-close="${y.day}">知道了</button></div>
					<p>${parts.join(' · ')}</p>${lines ? `<ul class="recap-log">${lines}</ul>` : '<p class="muted">那天没有记下什么特别的事。</p>'}</div>`;
			}

			/** 周结算预警：两天内要结算、现金不够付这周的固定开销时提醒（出租收入不计入，按最坏情况算） */
			function settleCard(s: PlayerState) {
				const wc = weeklyCosts(s);
				const days = Math.max(0, s.nextWeek - dayOf(s.clock));
				if (!wc.total || days > 2 || s.cash >= wc.total) return '';
				const parts = [wc.rent ? `房租 $${wc.rent}` : '', wc.property ? `房产 $${wc.property}` : '', wc.vehicle ? `车辆 $${wc.vehicle}` : ''].filter(Boolean).join(' + ');
				const risks = [wc.rent ? '付不起房租会被收回住处（家具半价折现）' : '', wc.property ? `房产连续欠款超过 ${FINANCE.graceWeeks} 次会被强制卖掉` : '', wc.vehicle ? '付不起车辆保险麻烦值 +8' : ''].filter(Boolean).join('；');
				return `<div class="card warn" role="status"><h3>${days ? `${days} 天后` : '今天'}周结算，钱不够</h3><p>要付 $${wc.total.toLocaleString()}（${parts}），现在只有 $${s.cash.toLocaleString()}，还差 $${(wc.total - s.cash).toLocaleString()}。</p><p style="margin-top:4px">${risks}。</p></div>`;
			}

			/** 分享用的一段文字：只放展示信息，不含存档 id 和同步码 */
			function shareText(s: PlayerState) {
				const lv = level(s.respect);
				const places = region.locations.filter((l) => s.visited[l.id]).length;
				const ach = achievements(s, region);
				return `我在「地球人生 · ${curArea().name}」里是 ${s.name}（Lv${lv.lv} ${lv.title}），过了 ${dayOf(s.clock) + 1} 天，去过 ${places}/${region.locations.length} 个地方，净资产 $${Math.round(netWorth(s)).toLocaleString()}，成就 ${ach.filter((a) => a.done).length}/${ach.length}。`;
			}
			async function shareProgress() {
				const s = state!;
				const text = shareText(s);
				const url = `${location.protocol}//${location.host}/earth/`;
				const nav = navigator as Navigator & { share?: (d: { title: string; text: string; url: string }) => Promise<void> };
				try {
					if (nav.share) { await nav.share({ title: '地球人生', text, url }); return; }
					await navigator.clipboard.writeText(`${text} ${url}`);
					toast('已复制，可以粘贴给朋友');
				} catch (e) {
					// 用户取消分享不提示；其他失败（不支持剪贴板）给出文字让人手动复制
					if ((e as Error)?.name !== 'AbortError') toast('分享失败，可以在「设置」里手动复制');
				}
			}

			/** 留言板：这个地点最近的留言，和留一句的输入框 */
			function notesCard(s: PlayerState) {
				if (drawer === 'place') loadNotes();
				const list = notesLoc === s.loc ? notesList : [];
				const ago = (at: number) => { const m = Math.max(0, Math.round((srvNow() - at) / 60_000)); return m < 60 ? `${m} 分钟前` : m < 1440 ? `${Math.round(m / 60)} 小时前` : `${Math.round(m / 1440)} 天前`; };
				const rows = list.map((n) => `<div class="note"><span class="ico">${esc(n.avatar)}</span><span class="body"><b>${esc(n.name)}</b> <small class="muted">${ago(n.at)}</small><br />${esc(n.text)}</span>${n.mine ? `<button data-note="delete" data-note-id="${esc(n.id)}" aria-label="删掉这条留言">删</button>` : `<span class="meta"><button data-safety="block" data-note-id="${esc(n.id)}" aria-label="屏蔽${esc(n.name)}">屏蔽</button> <button data-report-pick="note" data-note-id="${esc(n.id)}" data-name="${esc(n.name)}" data-quote="${esc(n.text)}" aria-label="举报这条留言">举报</button></span>`}</div>`).join('');
				return `${reportPick?.note ? reportCard() : ''}<div class="card"><h3>📝 留言板</h3><p class="muted">给后来到${esc(getLocation(region, s.loc)!.name)}的人留一句话。不能带网址和联系方式；每人每天最多 3 条，同一个地方一天一条。</p>
					${rows || '<p class="muted">还没有人在这里留言。</p>'}
					<form class="inline" id="note-form" style="margin-top:8px"><input id="note-input" maxlength="${NOTE_MAX}" placeholder="写一句给后来的人…" aria-label="留言内容" autocomplete="off" /><button class="primary">贴上</button></form></div>`;
			}

			/** 落地清单（第 43 批，core/paperwork.ts）：证件和办事。办完以后收起来，不再占地方 */
			function paperCard(s: PlayerState) {
				const rows = paperChecklist(s, region);
				if (!rows.length) return '';
				const { done, total } = paperProgress(s);
				const mark = { todo: '⬜', waiting: '⏳', done: '✅', stale: '⚠️', retry: '🔁', na: 'ℹ️' } as const;
				const LINKED_WHERE = { bank: '「我 · 资产」的银行', tfn: '「我 · 资产」的税务', cover: '你的签证' } as const;
				// 合并 main 后：银行户、TFN、医保看 main 各自的系统，说明里写在哪看、在哪办
				const state = (r: (typeof rows)[number]) => r.paper.linked ? (r.status === 'done' ? `已办好（${LINKED_WHERE[r.paper.linked]}）` : r.blocked ?? `点「办理」就在${LINKED_WHERE[r.paper.linked]}办，不花时间`) : r.status === 'done' ? '已办好' : r.status === 'waiting' ? `办理中，第 ${s.papers[r.paper.id].ready + 1} 天办好` : r.status === 'stale' ? '搬家了，地址要更新' : r.blocked ?? `${r.paper.fee ? `$${r.paper.fee} · ` : ''}${r.paper.minutes} 分钟${r.paper.where === 'online' ? ' · 网上办' : ''}`;
				const name = (id: string) => rows.find((x) => x.paper.id === id)?.paper.name ?? id;
				const item = (r: (typeof rows)[number]) => {
					const p = r.paper;
					const wait = p.waitDays ? `游戏里递交后等 ${p.waitDays} 天` : '游戏里当场办好';
					const pre = [...p.needs.map((id) => `先「${name(id)}」`), ...(p.needsHome ? ['先有住处'] : [])];
					return `<div style="margin-top:10px"><div class="row"><span class="body">${mark[r.status]} ${esc(p.icon)} ${esc(p.name)}<small>${esc(state(r))}</small></span>${r.status === 'done' || r.status === 'na' ? '' : `<button data-paper="${esc(p.id)}" ${r.blocked ? 'disabled' : ''}>${r.status === 'retry' ? '再考' : r.status === 'stale' ? '更新' : '办理'}</button>`}</div>
					<details style="margin-top:4px"><summary class="muted">怎么办、办完有什么用</summary>
					<p style="margin-top:6px">${esc(p.desc)}</p>
					${p.linked ? `<p style="margin-top:6px"><b>在哪办：</b>${esc(LINKED_WHERE[p.linked])}${p.linked === 'cover' ? '（按签证自动有，不用另外办）' : '（点「办理」就在那边办，不花时间）'}。</p>` : `<p style="margin-top:6px"><b>在哪办：</b>${esc(p.place)}${p.hours ? `，${hoursLabel(p.hours)}` : ''}。<b>前置：</b>${esc(pre.length ? pre.join('，') : '无')}。<b>材料：</b>${esc(p.docs.join('、'))}。<b>等待：</b>${esc(wait)}。</p>`}
					<p style="margin-top:6px"><b>办完解锁：</b>${esc([...p.unlocks.now, ...p.unlocks.later.map((x) => `${x}（之后版本）`)].join('；'))}。</p>
					<p style="margin-top:6px" class="muted"><b>现实中：</b>${esc(p.real.who)}${esc(p.real.steps)}${esc(p.real.wait)}以官方为准：${p.real.sources.map((x) => `<a href="${esc(x.url)}" target="_blank" rel="noopener">${esc(x.title)}</a>`).join('、')}。</p></details></div>`;
				};
				return `<details class="card"${done < total ? ' open' : ''}><summary><h3 style="display:inline">🛂 落地清单</h3> <span class="muted">${done}/${total}</span></summary>
					<p>刚到要办的手续。游戏里的花费、等待天数都是简化过的，现实流程看每项的「现实中」，以官方为准。</p>
					${rows.map(item).join('')}</details>`;
			}
			/** 现实活动（第 24 批）：按服务器时间和当地时区自动上线、下线；能不能领以服务器结算为准 */
			function liveSection(s: PlayerState) {
				const now = srvNow();
				const cal = liveCalendar(now, 30);
				if (!cal.length) return '';
				const myArea = areaOf(s.loc)?.id;
				const rows = cal.filter((c) => c.active || c.event.area === myArea).slice(0, 6).map((c) => {
					const ev = c.event;
					const where = ev.loc ? getLocation(region, ev.loc)?.name ?? '' : ev.area === 'wa' ? '西澳全境' : '南澳全境';
					const days = Math.ceil(c.startsInMs / 86_400_000);
					const when = c.active ? '进行中' : days <= 1 ? '明天前开始' : `${days} 天后开始`;
					const why = c.active ? liveBlocked(s, region, ev, now) : undefined;
					const btn = c.active ? `<button class="${why ? '' : 'primary'}" data-live="${esc(ev.id)}" ${why ? 'disabled' : ''}>${(s.live ?? []).includes(ev.id) ? '已领' : '到场'}</button>` : '';
					return `<div class="row"><span class="ico">${ev.kind === 'festival' ? '🎪' : '🎉'}</span><span class="body">${esc(ev.name)} · ${esc(where)}<small>${when} · ${esc(liveDateLabel(ev))}${why && !(s.live ?? []).includes(ev.id) ? ` · ${esc(why)}` : ''} · <a href="${esc(ev.source)}" target="_blank" rel="noopener noreferrer">来源</a></small></span><span class="meta">${btn}</span></div>`;
				}).join('');
				if (!rows) return '';
				// 并进「节日」卡当一节（不单独成卡）：真实日历一进 30 天窗口就多一张卡，第 1 天今天页会超过 6 张
				return `<div class="live-sec" style="margin-top:12px"><h4>现实里的节日和假期</h4><p class="muted">跟真实日历走，和游戏里的季节无关。在活动地点（假期是同一个州）可以领一次到场纪念。</p><div class="list" style="margin-top:8px">${rows}</div></div>`;
			}

			/** 天象卡（第 8 批）：按地点和游戏日期用公式估算，只做显示，不影响玩法 */
			function skyCard(s: PlayerState) {
				const loc = getLocation(region, s.loc)!;
				const w = weatherAt(s);
				const t = temps(loc, s.clock, w.id);
				const sun = sunTimes(loc, s.clock);
				const rows = [
					...warningRows(warningsAt(s, region), region, loc, dayOf(s.clock), curArea().id, esc, new Set(travelOptions(s, region).filter((o) => o.available).map((o) => o.to))),
					`<div class="row"><span class="ico" aria-hidden="true">🌡️</span><span class="body">气温 ${t.min}–${t.max}°C<small>${esc(w.name)}</small></span></div>`,
					`<div class="row"><span class="ico" aria-hidden="true">🌅</span><span class="body">日出 ${hhmm(sun.rise)} · 日落 ${hhmm(sun.set)}<small>白天 ${Math.floor((sun.set - sun.rise) / 60)} 小时 ${(sun.set - sun.rise) % 60} 分；画面明暗跟着日出日落走</small></span></div>`,
				];
				const uv = uvDay(loc, s.clock, w.id);
				rows.push(`<div class="row"><span class="ico" aria-hidden="true">🕶️</span><span class="body">紫外线：现在 ${uv.now}（${uvLevel(uv.now).name}）· 今天最高 ${uv.peak}（${uvLevel(uv.peak).name}）<small>${uv.protect ? `${hhmm(uv.protect[0])}–${hhmm(uv.protect[1])} 指数在 3 以上，出门要防晒：衣服、帽子、防晒霜、墨镜、找阴凉` : '今天紫外线都不到 3，不用特别防晒'}</small></span></div>`);
				const fire = fireDanger(loc, s.clock, w.id);
				if (fire.id !== 'none') rows.push(`<div class="row fire fire-${fire.id}"><span class="ico" aria-hidden="true">🔥</span><span class="body">火险等级：${fire.name}<small>${esc(fire.advice)}火险是游戏里的估算，不是真实预警；真实火情看 <a href="${fireAgency(curArea().id).url}" target="_blank" rel="noopener">${esc(fireAgency(curArea().id).name)}</a></small></span></div>`);
				else if (fireSeason(loc, s.clock)) rows.push(`<div class="row"><span class="ico" aria-hidden="true">🔥</span><span class="body">山火季<small>今天天气潮湿，没有火险评级</small></span></div>`);
				if (hasTide(loc)) {
					const td = tideNow(loc, s.clock);
					const m = (x: number) => `${x >= 0 ? '+' : '−'}${Math.abs(x).toFixed(1)} 米`;
					const when = (at: number) => `${dayOf(at) > dayOf(s.clock) ? '明天 ' : ''}${hhmm(at)}`;
					const turns = td.next.map((x) => `${x.kind === 'high' ? '满潮' : '干潮'} ${when(x.at)}（${m(x.h)}）`).join('、');
					rows.push(`<div class="row"><span class="ico" aria-hidden="true">🌊</span><span class="body">${td.rising ? '涨潮中' : '退潮中'} · 现在 ${m(td.h)}<small>接下来：${turns}；今天潮差约 ${td.range.toFixed(1)} 米。潮汐是示意，真下海请看官方潮汐预报</small></span></div>`);
				}
				return `<div class="card sky"><h3>今天的天${fireSeason(loc, s.clock) ? ' <span class="chip">山火季</span>' : ''}</h3><p class="muted">游戏里的今天大约是现实中的 ${realDateLabel(realDayOfYear(s.clock))}。下面按纬度、季节和天气估算，不是真实预报。</p><div class="list" style="margin-top:8px">${rows.join('')}</div></div>`;
			}

			// 今日日程（第 43 批）：上班窗口、作息；只提示不拦
			const AGENDA_MARK: Record<AgendaStatus, string> = { done: '✅ 已完成', now: '🟢 现在', later: '⏳ 稍后', missed: '⛔ 已错过', blocked: '⛔ 今天上不了' };
			/** 睡这一觉的说明：睡眠质量，加上会不会赶不上今天的班（合并 main 时复核）。
			 * 整觉加一句精力上限（第十轮平衡定：回家、住旅馆的整觉精力常直接回到上限，睡眠质量主要体现在健康、心情和睡眠债；露营、睡车恢复本来就少） */
			function sleepHint(s: PlayerState, spot: SleepSpot, minutes: number) {
				const w = timeConflict(s, minutes, true);
				const cap = minutes >= SLEEP.fullMinutes ? `，精力最多回到上限 ${Math.round(energyCap(s))}` : '';
				return `${sleepNote(sleepQuality(s, region, spot))}${cap}${w ? `；⚠ ${w}` : ''}`;
			}
			function agendaCard(s: PlayerState) {
				// 合并 main 后：没工作、还没到熬夜、也不欠觉时不显示（今天页第 1 天不超过 6 张卡，体验改造 P1）
				if (!s.job && minutesToLate(s) > 0 && debtNow(s) === 0) return '';
				const rows = agenda(s, region).map((it) => `<div class="row" style="margin-top:6px"><span class="ico">${esc(it.icon)}</span><span class="body">${esc(it.title)}<small>${esc(it.when)}${it.note ? ` · ${esc(it.note)}` : ''}</small></span><span class="meta">${AGENDA_MARK[it.status]}</span></div>`).join('');
				return `<details class="card"><summary><b>🗓️ 今日日程</b></summary>${rows}</details>`;
			}
			/** 志愿者卡：这里能做的志愿 + 社区信誉、今天次数、推荐信、签证提示（docs/earth-game/volunteer.md） */
			function volCard(s: PlayerState, vols: ReturnType<typeof volunteerAt>) {
				const tier = volTier(s);
				const used = s.volunteer.day === dayOf(s.clock) ? s.volunteer.today.length : 0;
				const refs = s.volunteer.refs.length;
				const head = `社区信誉「${esc(tier.name)}」· 做过 ${tier.shifts} 次${tier.next !== null ? `（${tier.next} 次升下一档）` : ''} · 今天 ${used}/${VOL_RULES.dailyMax}${refs ? ` · 推荐信 ${refs} 封（职位声望门槛抵 ${refRespect(s)}）` : ''}`;
				const rows = vols.map(({ gig, org, count, letter, blocked }) => `
					<div class="row" style="margin-top:8px"><span class="ico" aria-hidden="true">${esc(gig.icon)}</span><span class="body">${letter ? '✉️ ' : ''}${esc(gig.name)} · 声望 +${esc(String(gig.respect))}<small>${esc(blocked ?? `${gig.desc} ${minutesLabel(gig.minutes)}${count ? `，做过 ${count} 次` : ''}${!letter ? `，满 ${VOL_RULES.refShifts} 次给推荐信` : ''}`)}</small>${org ? `<small>现实里：<a href="${esc(org.source)}" target="_blank" rel="noopener">${esc(org.name)} ${esc(org.en)}</a></small>` : ''}</span><button data-vol="${esc(gig.id)}" ${blocked ? 'disabled' : ''}>去帮忙</button></div>`).join('');
				return `<div class="card"><h3>志愿者</h3><p>${head}</p>${rows}<details style="margin-top:8px"><summary class="muted">做志愿对签证有用吗？</summary><p style="margin-top:6px">${esc(VISA_HINT.text)} <a class="muted" href="${esc(VISA_HINT.source)}" target="_blank" rel="noopener">来源</a></p></details></div>`;
			}

			function panelPlace() {
				const s = state!;
				const loc = getLocation(region, s.loc)!;
				const actRow = ({ act, blocked }: ReturnType<typeof activitiesAt>[number]) => `
					<button class="row" data-act="${act.id}" ${blocked ? 'disabled' : ''}>
						<span class="ico">${act.icon}</span>
						<span class="body">${esc(act.name)}<small>${esc(blocked ?? act.desc)}${blocked ? '' : act.bed ? ` · ${esc(sleepHint(s, { bed: act.bed }, act.minutes))}` : (() => { const w = timeConflict(s, act.minutes); return w ? ` · ⚠ ${esc(w)}` : ''; })()}</small></span>
						<span class="meta"><b>${act.fx.cash ? (act.fx.cash > 0 ? '+' : '−') + '$' + Math.abs(act.fx.cash) : '免费'}</b>${minutesLabel(act.minutes)}</span>
					</button>`;
				// 现在能做的和做不了的（没开门、钱不够……）分开：做不了的收进「稍后」，不和能做的混在一起
				const allActs = activitiesAt(s, region);
				const openActs = allActs.filter((x) => !x.blocked);
				const laterActs = allActs.filter((x) => x.blocked);
				const pois = region.pois.filter((p) => p.loc === loc.id);
				const poiHtml = pois.length ? `<div class="card"><h3>打卡点</h3><p>人到现场、打开定位即可打卡（${pois.filter((p) => s.checkins.includes(p.id)).length}/${pois.length}）</p>
					<div class="list" style="margin-top:8px">${pois.map((p) => `<div class="row"><span class="ico">${s.checkins.includes(p.id) ? '✅' : '📌'}</span><span class="body">${esc(p.name)}<small>${esc(p.category)}</small></span></div>`).join('')}</div></div>` : '';
				const people = npcsAt(s, region);
				const absent = NPCS.filter((n) => !people.some((a) => a.npc.id === n.id)).map((n) => ({ n, plan: npcStatus(n, s.clock).plan }))
					.filter(({ n, plan }) => plan.loc === loc.id || n.loc === loc.id);
				// 在路上的 NPC 多说一句（第 43 批）
				const awayHint = (n: (typeof NPCS)[number]) => {
					const w = npcWhere(n, s.clock, region);
					return w.kind === 'travel' && w.to ? `正在去${esc(getLocation(region, w.to)?.name ?? '')}的路上。` : '';
				};
				const bagIds = Object.keys(s.inventory).filter((id) => s.inventory[id] > 0 && getItem(id));
				const giftLabel = (npcId: string, itemId: string) => {
					const n = NPCS.find((x) => x.id === npcId)!;
					return getRelation(s, npcId).known.includes(itemId) ? `（${GIFT_LABEL[giftReaction(n, itemId)]}）` : '';
				};
				const peopleHtml = people.length || absent.length ? `<div class="card"><h3>这里的人</h3>${people.map(({ npc, rel, tier, blocked, nextStory, favor, fading, confidant, mood }) => `
					<div class="npc-talk"><div class="npc-head">${portrait(npc.id)}<div class="npc-name"><b>${esc(npc.name)}</b><small>${esc(npc.role)}</small></div>
					<div class="npc-rel"><small>${confidant ? '🫶 知己' : tier} · ${Math.round(rel.score)}/100</small><div class="bar" role="progressbar" aria-label="和${esc(npc.name)}的关系" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${Math.round(rel.score)}"><i style="width:${Math.round(Math.max(0, Math.min(100, rel.score)))}%"></i></div></div></div>
					<p class="bubble"><span title="${esc(NPC_MOOD_NAME[mood.level])}">${NPC_MOOD_ICON[mood.level]}</span> ${esc(mood.line)}</p><p class="muted" style="margin-top:4px">${esc(npc.bio)}</p>${greetHtml(esc, npc.id, npc.name, media.voice[npc.id])}
					${favor ? `<p class="bubble">🙋 ${esc(favor.ask)}</p>` : ''}
					${fading ? `<p class="muted" style="margin-top:4px">好久没来往了，关系在慢慢变淡。</p>` : ''}
					<div class="inline talk-choices">${(['chat', 'help'] as const).map((a) => `<button data-npc="${npc.id}" data-npc-act="${a}" ${blocked[a] ? `disabled title="${esc(blocked[a])}"` : ''}>${{ chat: '聊天', help: '帮忙' }[a]}</button>`).join('')}${npc.perk ? `<button data-npc="${npc.id}" data-npc-act="perk" ${blocked.perk ? `disabled title="${esc(blocked.perk)}"` : ''}>✨ ${esc(npc.perk.name)}</button>` : ''}${favor ? `<button data-npc="${npc.id}" data-npc-act="favor" ${blocked.favor ? `disabled title="${esc(blocked.favor)}"` : ''}>🙋 帮忙带 ${getItem(favor.item)?.icon ?? ''} ${esc(getItem(favor.item)?.name ?? '')} ×${favor.qty}</button>` : ''}${'bond' in blocked ? `<button data-npc="${npc.id}" data-npc-act="bond" ${blocked.bond ? `disabled title="${esc(blocked.bond)}"` : ''}>🫶 结为知己</button>` : ''}${confidant ? `<button data-npc="${npc.id}" data-npc-act="unbond">解除知己</button>` : ''}</div>
					${bagIds.length ? `<div class="inline" style="margin-top:6px"><span class="muted">送礼：</span>${bagIds.map((id) => `<button data-npc="${npc.id}" data-npc-act="gift" data-npc-item="${id}" ${blocked.gift ? `disabled title="${esc(blocked.gift)}"` : ''}>${getItem(id)!.icon} ${esc(getItem(id)!.name)}${giftLabel(npc.id, id)}</button>`).join('')}</div>` : ''}
					${Object.values(blocked).some(Boolean) ? `<p style="margin-top:4px">${esc([...new Set(Object.values(blocked).filter(Boolean))].join('；'))}</p>` : ''}
					${nextStory !== undefined ? `<p style="margin-top:4px" class="muted">关系到 ${nextStory}（${relationTier(nextStory)}）会有新故事。</p>` : ''}</div>`).join('')}
					${absent.map(({ n, plan }) => `<p style="margin-top:8px">${esc(n.name)}（${esc(n.role)}）${plan.away ? `今天${esc(plan.note ?? '')}，不在。平时 ${hoursLabel(n.hours)} 在这里。</p>` : `现在不在。${awayHint(n)}${plan.loc === loc.id ? `今天 ${hoursLabel(plan.hours)} 在这里${plan.note ? `：${esc(plan.note)}` : ''}。` : `今天去了${esc(getLocation(region, plan.loc)?.name ?? '')}${plan.note ? `（${esc(plan.note)}）` : ''}，平时 ${hoursLabel(n.hours)} 在这里。`}</p>`}`).join('')}</div>` : '';
				const job = s.job;
				const career = job ? getCareer(job.career) : undefined;
				const workHere = job && job.loc === loc.id && career;
				const offers = careersAt(s, region).filter((o) => !(workHere && o.career.id === job!.career));
				const shiftWhy = shiftBlocked(s, region);
				const visaLeft = workMinutesLeft(s);
