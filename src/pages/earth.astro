				const garageHtml = garage ? `<div class="card"><h3>修车厂</h3><div class="row" style="margin-top:8px">${thumb('veh:' + myVeh!.id)}<span class="body">给${esc(myVeh!.name)}做保养 · $${garage.price}<small>${esc(garage.blocked ?? `离上次保养 ${s.car.since.toLocaleString()} 公里；超过 ${SERVICE_KM.toLocaleString()} 公里后路上可能抛锚`)}</small></span><button data-veh="service" ${garage.blocked ? 'disabled' : ''}>保养</button></div></div>` : '';
				const vanHtml = myVeh?.sleep ? `<button class="row" data-veh="sleep">${thumb('veh:' + myVeh.id, `<span class="ico">${myVeh.icon}</span>`)}<span class="body">在${esc(myVeh.name)}里睡一觉<small>免费，开到哪睡到哪 · ${esc(sleepHint(s, { bed: 'vehicle' }, SLEEP.fullMinutes))}</small></span></button>` : '';
				const shop = shopAt(s, region);
				const shopHtml = shop.length ? `<div class="card"><h3>商店</h3><div class="list" style="margin-top:8px">${shop.map(({ item, price, markdown, blocked }) => `
					<button class="row" data-buy="${item.id}" ${blocked ? 'disabled' : ''}><span class="ico">${item.icon}</span>
					<span class="body">${esc(item.name)}${s.inventory[item.id] ? ` ×${s.inventory[item.id]}` : ''}<small>${esc(ITEM_CATS[itemCat(item)])}${storesOf(item).length ? ` · ${esc(storesOf(item).map((x) => x.name).join('、'))}有卖` : ''} · ${esc(blocked ?? item.desc)}</small></span><span class="meta">${markdown ? `🏷️ <s>$${Math.round(item.price)}</s> ` : ''}$${price}</span></button>`).join('')}</div></div>` : '';
				// 风暴天这里的海上活动做不了：和海上活动有关的心愿给个提示（去别处海边还能完成）
				const seaClosed = weatherAt(s).closesSea;
				const seaWish = (id: string) => { const w = getWish(id); return !!w && w.done.t === 'activity' && w.done.ids.some((a) => ACTIVITIES.find((x) => x.id === a)?.exposed === 'sea'); };
				const wishHtml = s.wishes.length ? `<div class="card"><h3>今天的心愿 · 还剩 ${s.wishes.length} 个</h3><div class="wishes">${s.wishes.map((id) => `<div class="wish"><span class="dot" aria-hidden="true"></span><span>${esc(getWish(id)?.text ?? '')}${seaClosed && seaWish(id) ? '（这里今天有风暴，换个海边）' : ''}</span></div>`).join('')}</div><p style="margin-top:6px" class="muted">做到了加心情和声望，过了今天会换一批。</p></div>` : '';
				const { here: festHere, soon: festSoon } = festivalsSoon(s.clock, loc.id);
				const festHtml = `<div class="card">${festHere ? cover('fest:' + festHere.festival.id) : ''}<h3>${festHere ? `🎉 ${esc(festHere.festival.name)}进行中` : '节日'}</h3>${festHere ? `<p>${esc(festHere.festival.desc)} 节日专属体验在「在这里 · 体验和爱好」里。</p>` : ''}
					${festSoon.map((c) => cgi['fest:' + c.festival.id]
						? `<div class="row" style="margin-top:8px">${thumb('fest:' + c.festival.id)}<span class="body">${esc(c.festival.name)}<small>${c.active ? '正在举行' : `${c.startsIn} 天后`} · ${esc(getLocation(region, c.festival.loc)!.name)}</small></span></div>`
						: `<p style="margin-top:4px">${c.active ? '正在举行' : `${c.startsIn} 天后`} · ${esc(c.festival.name)} · ${esc(getLocation(region, c.festival.loc)!.name)}</p>`).join('')}${liveSection(s)}</div>`;
				// 渐进出现（v36）：新角色头一两天先不摆钓鱼、课程、车行、房产这些卡，条件到了自动出现
				const on = (id: string) => featureShown(s, id);
				// 体验改造 P1（docs/earth-game/ux-p1.md）：今天页分三层。
				// 现在：状态、刚才的变化、下一步、心愿、快捷动作，一直展开；
				// 在这里：每组一行摘要，点开从底部弹出抽屉（商店也在抽屉里）；
				// 以后：主线、现实活动、节日、之后会出现，收着。
				const placeInfo = `<div class="card">${hero(loc.id, KIND_ICON[loc.kind])}
						<h3>${esc(loc.name)} <span class="muted">${esc(loc.en)}</span></h3><p>${esc(loc.blurb)}</p>
						<p style="margin-top:6px">今天${weatherAt(s).icon} ${esc(weatherAt(s).name)}：${esc(weatherAt(s).desc)} 明后天${forecast(s.loc, dayOf(s.clock) + 1, 2).map((w) => `${w.icon} ${esc(w.name)}`).join('，')}。</p>
						${climateLine(s.loc)}
					</div>${poiHtml}${factHtml}${notesCard(s)}`;
				const doHtml = `${vanHtml ? `<div class="list">${vanHtml}</div>` : ''}<div class="list"${vanHtml ? ' style="margin-top:8px"' : ''}>${openActs.map(actRow).join('') || '<p class="muted">现在这里没有能做的事。</p>'}</div>
					${laterActs.length ? `<details class="later-acts"><summary>稍后开门或现在做不了 · ${laterActs.length} 项</summary><div class="list">${laterActs.map(actRow).join('')}</div></details>` : ''}`;
				const favorHere = people.some((p) => p.favor);
				const sportSoon = racesSoon(s, region).filter((o) => !o.done).length; // 运动和比赛（第 43 批）：抽屉摘要里写快到的比赛
				const groups: [string, LucideName, string, string, string][] = [
					['do', 'sparkles', '做事', doHtml, `现在能做 ${openActs.length + (vanHtml ? 1 : 0)} 项${laterActs.length ? ` · 稍后 ${laterActs.length} 项` : ''}`],
					['shop', 'shopping-bag', '买东西', groceryHtml(s, region, esc) + shopHtml + (on('garage') ? swapCard(s, region) : ''), [groceriesAt(s, region).length ? '食材' : '', on('garage') && swapBoard(s, region) ? '换手墙' : '', shop.length ? `${shop.length} 件${shop.some((x) => x.markdown) ? ' · 有打折' : ''}` : ''].filter(Boolean).join(' · ')],
					['work', 'briefcase-business', '工作', workHtml + careerRoutesHtml + bizCard(s, region, esc), [workHere ? `${esc(career!.name)} · ${shiftWhy ? '现在不能上班' : '可以上班'}` : offers.length ? `${offers.length} 个职位在招` : '', gigsAt(s, region).length ? `${gigsAt(s, region).length} 份副业` : '', s.biz.shop ? `你的店${s.biz.shop.debt ? ` · 欠款 $${s.biz.shop.debt}` : ''}` : ''].filter(Boolean).join(' · ')],
					['home', 'house', '住处', homeHtml + flatAwayHtml, [homeHere ? `你的${esc(homeHere.name)}` : rentals.length ? `${rentals.length} 处可租` : '', s.rental.claim ? `押金扣款待处理 $${s.rental.claim.amount}` : '', activeMates(s).length ? `${activeMates(s).length} 位室友` : '', s.flatshare.sublet ? '转租中' : '', s.flatshare.ev ? (homeHere ? '室友有事找你' : '室友有事找你（回家处理）') : ''].filter(Boolean).join(' · ')],
					['people', 'users', '这里的人', peopleHtml, people.length ? `${people.length} 位在这里${favorHere ? ' · 有人托你帮忙' : ''}` : '现在没人在'],
					['fun', 'ticket', '体验和爱好', expHtml + volHtml + sportsCard(s, region, esc) + (on('hobby') ? photoQuestHtml + fishHtml + hobbyHtml + skyCard(s) : ''), [exps.length ? `${exps.length} 项体验` : '', vols.length ? `${vols.length} 项志愿` : '', sportSoon ? `${sportSoon} 场比赛快到了` : '', on('hobby') && pq ? '摄影任务' : '', on('hobby') && spot ? '能钓鱼' : '', on('hobby') && hobbyOpts.length ? `${hobbyOpts.length} 个爱好` : ''].filter(Boolean).join(' · ') || '看看星空'],
					['study', 'graduation-cap', '学习', on('study') ? courseHtml + certHtml + studyHtml : '', [courses.length ? `${courses.length} 门课` : '', certs.length ? `${certs.length} 个证书` : '', programs.length ? `${programs.length} 个学历` : ''].filter(Boolean).join(' · ')],
					['garage', 'car', '车和房产', (on('garage') ? dealerHtml + garageHtml : '') + (on('estate') ? propHtml : ''), [on('garage') && dealer.length ? '车行' : '', on('garage') && garage ? '修车厂' : '', on('estate') && props.some((x) => !x.owned) ? `${props.filter((x) => !x.owned).length} 套房出售` : '', on('estate') && props.some((x) => x.owned) ? '你的房产' : ''].filter(Boolean).join(' · ')],
					['papers', 'circle-check', '落地清单', paperCard(s), (() => { const p = paperProgress(s); return p.total ? `${p.done}/${p.total} 办好` : ''; })()], // 证件和办事（合并 main 后放进「在这里」的抽屉，不占今天页的卡片）
					['pet', 'paw-print', '宠物', petHtml, ps ? `${ps.def.icon} ${esc(ps.pet.name)}${petNotes(ps) ? ' · ' + esc(petNotes(ps)) : ''}` : '领养或买一只'],
					['place', 'map-pin', esc(loc.name), placeInfo, '地点、天气、打卡点、小知识、留言板'],
				];
				const shown = groups.filter(([, , , html]) => html.trim());
				placeGroups = Object.fromEntries(shown.map(([id, icon, title, html]) => [id, { icon, title, html }]));
				const hereHtml = `<section class="card here" aria-labelledby="here-title"><h3 id="here-title">在${esc(loc.name)}</h3><div class="list">
						<button class="row" data-gps><span class="ico">${lu('locate-fixed')}</span><span class="body">真实定位打卡<small>你本人到了某个地点？直接抵达并触发事件</small></span></button>
						${shown.map(([id, icon, title, , sum]) => `<button class="row here-row" data-drawer="${id}" aria-haspopup="dialog"><span class="ico" aria-hidden="true">${lu(icon)}</span><span class="body">${title}<small>${sum}</small></span><span class="chev" aria-hidden="true">${lu('chevron-right')}</span></button>`).join('')}
					</div></section>`;
				return `
					${returnCard(s)}
					${needsCard(s)}
					${healthCard(s)}
					${resultStrip()}
					${nextCard(s, !!homeHere && !s.flatshare.sublet, !!workHere && !shiftWhy)}
					${wishHtml}
					${quickHtml(s)}
					${settleCard(s)}
					${queueCard()}
					${recapCard(s)}
					${guideCard(s)}
					${featSlip(s)}
					${agendaCard(s)}
					${hereHtml}
					<section class="later-zone" aria-label="以后">${storyCard}${festHtml}${laterNote(s)}</section>`;
			}

			/** 「刚才」：上一个成功动作的结果和数值变化，紧贴在状态环下面（以前在地点卡里，要往下翻才看得到） */
			function resultStrip() {
				if (!lastOutcome && !lastDelta.length) return '';
				return `<div class="result-strip">${lastOutcome ? `<p>${esc(lastOutcome)}</p>` : ''}${lastDelta.length ? `<div class="pills" aria-label="刚才的变化">${lastDelta.map((x) => `<span class="pill ${x.text.startsWith('用时') ? '' : x.up ? 'up' : 'bad'}">${esc(x.text)}</span>`).join('')}</div>` : ''}</div>`;
			}

			/** 地点卡里的一行气候说明：气候区 + 参照的气象站（第 30 批） */
			function climateLine(locId: string) {
				const c = climateOf(locId);
				return `<p class="muted" style="margin-top:4px">气候：${esc(c.zoneName)}。${esc(c.zoneDesc)}（概率参照澳洲气象局${esc(c.station)}站的多年平均）</p>`;
			}

			/** 档案卡里的法律记录（第 43 批）：只列有的项；全空不显示 */
			function lawHtml(s: PlayerState): string {
				const l = lawSummary(s);
				const parts: string[] = [];
				if (l.pts) parts.push(`驾照扣分 ${esc(l.pts)}/${esc(l.limit)}（3 年内）`);
				if (l.banDays) parts.push(`驾照暂停还剩 ${esc(l.banDays)} 天`);
				if (l.owed) parts.push(`欠罚款 $${esc(l.owed.toLocaleString())}`);
				if (l.cs) parts.push(`社区服务还差 ${esc(l.cs)} 小时（第 ${esc(l.csDue + 1)} 天前做完，城镇里能做）`);
				if (l.record) parts.push(`法庭定罪 ${esc(l.record)} 次`);
				if (!parts.length) return '';
				return `<p class="law-line">${parts.join(' · ')}</p>${l.visa ? `<p class="muted">${esc(l.visa)}</p>` : ''}`;
			}

			/** 目的地卡里的走法：并排方块选一种（默认最便宜能走的），下面写路费后剩多少，再一个「出发」大按钮 */
			function waysHtml(s: PlayerState, destId: string, ways: ReturnType<typeof travelOptions>) {
				const open = ways.filter((o) => o.available);
				const cheapest = [...open].sort((a, b) => a.cost - b.cost)[0];
				const chosen = (destMode?.dest === destId && open.find((o) => o.mode === destMode!.mode)) || cheapest;
				const tiles = ways.map((o) => {
					const on = o === chosen;
					return `<button class="tile${on ? ' on' : ''}" data-dmode="${o.mode}" data-dest="${destId}" aria-pressed="${on}" ${o.available ? '' : 'disabled'}><b>${esc(o.label)}</b><small>$${o.cost} · ${minutesLabel(o.minutes)}</small>${o.reason ? `<small>${esc(o.reason)}</small>` : o.note ? `<small>${esc(o.note)}</small>` : ''}</button>`;
				}).join('');
				if (!chosen) return `<div class="tiles">${tiles}</div>`;
				const left = s.cash - chosen.cost;
				const wc = weeklyCosts(s);
				const days = s.nextWeek - dayOf(s.clock);
				const settle = wc.total > 0 && days <= 2 ? `，${days ? `${days} 天后` : '今天'}周结算要付 $${wc.total.toLocaleString()}${left < wc.total ? '，会不够' : '，还够'}` : '';
				const name = getLocation(region, destId)!.name;
				// 第 43 批：刚喝过酒还选自己开车、驾照暂停中有车不能开，各提醒一句
				const law = lawSummary(s);
				// 路边呼气测试只在公路自驾、到达时做：按到达时刻判断还在不在喝酒窗口里（合并 main 后复核）
				const selfDrive = chosen.mode === 'road' && s.vehicle !== 'none' && !law.banDays;
				const lawNote = selfDrive && drankAt(s, s.clock + chosen.minutes) ? '<p class="budget tight">刚喝过酒：现在自己开车遇到路边呼气测试会超标。可以先歇几个小时再走。</p>'
					: law.banDays && s.vehicle !== 'none' ? `<p class="budget">驾照暂停中（还剩 ${esc(law.banDays)} 天），这段时间只能坐车。</p>` : '';
				return `<div class="tiles">${tiles}</div>${lawNote}
					<p class="budget${settle && left < wc.total ? ' tight' : ''}">${esc(chosen.label)}路费后剩 $${left.toLocaleString()}${settle}。</p>
					<button class="primary wide" data-go="${destId}" data-mode="${chosen.mode}">出发去${esc(name)} · ${esc(chosen.label)} $${chosen.cost}</button>`;
			}

			function panelGo() {
				const s = state!;
				// 带着宠物坐不了飞机、上不了保护区的岛：界面上和服务端一样标成不可用（v31）
				const opts = travelOptions(s, region).map((o) => {
					const why = o.available ? petTravelBlocked(s, o.to, o.mode) : undefined;
					return why ? { ...o, available: false, reason: why } : o;
				});
				// 点了地图上的某个地点：先给一张目的地卡片（介绍、今天的天气、谁在那里、签名事件、从这里怎么去）
				const dest = selected && selected !== s.loc ? getLocation(region, selected) : undefined;
				let note = '';
				if (dest) {
					const w = weatherOn(dest.id, dayOf(s.clock));
					const sig = EVENTS.some((e) => e.once && e.locs?.includes(dest.id) && !s.seen.includes(e.id));
					const people = NPCS.filter((n) => { const x = npcStatus(n, s.clock); return x.plan.loc === dest.id && x.state !== 'after' && x.state !== 'away'; }).map((n) => esc(n.name));
					const ways = opts.filter((o) => o.to === dest.id);
					note = `<div class="card dest"><div class="dest-head"><h3>${KIND_ICON[dest.kind]} ${esc(dest.name)} <span class="muted">${esc(dest.en)}</span></h3><button data-loc="${dest.id}" aria-label="关闭">✕</button></div>
						<p>${esc(dest.blurb)}</p>
						<div class="pills" style="margin-top:8px"><span class="pill">${w.icon} 今天${esc(w.name)}</span>${s.visited[dest.id] ? `<span class="pill up">去过 ${s.visited[dest.id]} 次</span>` : '<span class="pill cost">没去过</span>'}${sig ? '<span class="pill cost">首次到达有专属事件</span>' : ''}${people.length ? `<span class="pill">今天在那里：${people.join('、')}</span>` : ''}</div>
						${ways.length ? waysHtml(s, dest.id, ways)
							: `<p style="margin-top:8px">从${esc(getLocation(region, s.loc)!.name)}没有直达的路线，需要先到别处中转。</p>`}</div>`;
				}
				// 周结算两天内到：路费付完会不够付这周固定开销的，提醒一下
				const wcGo = weeklyCosts(s);
				const settleSoon = wcGo.total > 0 && s.nextWeek - dayOf(s.clock) <= 2;
				const rows = opts.map((o) => {
					const to = getLocation(region, o.to)!;
					const tight = settleSoon && o.available && s.cash - o.cost < wcGo.total;
					const h = Math.floor(o.minutes / 60), m = o.minutes % 60;
					const fresh = !s.visited[o.to];
					// 去别的区域的路线标出来（第 43 轮）
					const toArea = areaOf(o.to);
					const cross = toArea && toArea.id !== curArea().id ? `去${esc(toArea.name)} · ` : '';
					return `<button class="row${selected === o.to ? ' sel' : ''}${fresh && o.available ? ' new' : ''}" data-go="${o.to}" data-mode="${o.mode}" ${o.available ? '' : 'disabled'}>
						<span class="ico">${KIND_ICON[to.kind]}</span>
						<span class="body">${esc(to.name)} <span title="今天的天气">${weatherOn(o.to, dayOf(s.clock)).icon}</span><small>${cross}${fresh ? '没去过 · ' : ''}${esc(o.label)} · ${o.km} km${o.reason ? ' · ' + esc(o.reason) : o.note ? ' · ' + esc(o.note) : ''}${tight ? ` · <span class="warn-text">去了周结算会不够（要付 $${wcGo.total}）</span>` : ''}</small></span>
						<span class="meta"><b>$${o.cost}</b>${h ? h + ' 小时 ' : ''}${m} 分</span></button>`;
				}).join('');
				return `${note}<p class="section-title">从${esc(getLocation(region, s.loc)!.name)}出发</p><div class="list">${rows}</div><p class="muted">点地图上的地点可以高亮对应路线。虚线是航班，长虚线是越野土路（需四驱），橙色点是没去过的地方。公交、火车和步行不画在地图上，列在下面；票价照真实票价表，四舍五入到整元。</p>${roadTripHtml(s)}${tripsHtml(s)}`;
			}

			/** 州内自驾游建议（第 43 批）：3 天、不出州，只是建议，点第一站开始 */
			function roadTripHtml(s: PlayerState) {
				const plan = planRoadTrip(s, region, 3);
				if (plan.stops.length < 2) return ''; // 只能到一站的不算「三天自驾游」（合并 main 时复核）
				const names = plan.stops.map((st) => `${esc(getLocation(region, st.to)?.name ?? st.to)}${st.fresh ? '🆕' : ''}`).join(' → ');
				const first = plan.stops[0].to;
				return `<p class="section-title">🚗 三天自驾游建议</p><div class="card"><p>${esc(getLocation(region, s.loc)!.name)} → ${names}</p>
					<p class="muted">共 ${plan.km} km，开车约 ${Math.round(plan.minutes / 60)} 小时，路费约 $${plan.cost}。每天最多开 6 小时，不出本州；住宿、吃饭另算。</p>
					<button class="wide" data-loc="${esc(first)}">看第一站：${esc(getLocation(region, first)?.name ?? first)}</button></div>`;
			}

			/** 离开地图的旅行（第 43 批）：只在有这些航线的机场显示 */
			function tripsHtml(s: PlayerState) {
				const opts = tripOptions(s);
				if (!opts.length) return '';
				const seasons = fareSeasonsOn(s.clock).map((x) => esc(x.name)).join('、');
				const cards = opts.map((o) => {
					const pack = packingList(s, o.dest.kind).map((p) => `${p.packed ? '✅' : '⬜'}${esc(p.label)}${p.packed ? '' : `（当地补买 $${p.missCost}）`}`).join(' · ');
					const remind = packingReminders(o.dest.kind).map(esc).join('；');
					const fly = o.fare.flightMin ? `<span class="pill">飞行约 ${Math.floor(o.fare.flightMin / 60)} 小时 ${o.fare.flightMin % 60} 分</span>` : '';
					const btns = o.dest.days.map((d) => {
						const pv = awayPreview(s, d, o.price + o.packing);
						const why = o.blocked ?? tripDaysBlocked(s, o.dest.kind, d); // 宠物寄养、签证（合并 main 后）
						const bits = [
							pv.settlements ? `经过 ${pv.settlements} 次周结算，约 $${pv.weeklyDue}` : '期间没有周结算',
							pv.loseJob ? `<span class="warn-text">超过可保留工作的请假（今年还剩 ${pv.leaveLeft} 天），工作会丢</span>` : s.job ? `工作保留，不带薪（今年还剩 ${pv.leaveLeft} 天，这趟用 ${d} 天）` : '',
							pv.short ? '<span class="warn-text">现金可能不够周结算</span>' : '',
						].filter(Boolean).join(' · ');
						return `<button class="row" data-trip="${esc(o.dest.id)}" data-days="${d}" ${why ? 'disabled' : ''}>
							<span class="body">离开 ${d} 天<small>${bits}${why ? ' · ' + esc(why) : ''}</small></span>
							<span class="meta"><b>$${o.price + o.packing}</b></span></button>`;
					}).join('');
					return `<div class="card"><h3>${esc(o.dest.icon)} ${esc(o.dest.name)} <span class="muted">${esc(o.fare.carrier)}</span></h3>
						<p>${esc(o.dest.blurb)}</p>
						<div class="pills" style="margin-top:8px"><span class="pill">往返 $${o.price}</span>${fly}${o.fare.note === 'verify' ? '<span class="pill cost">票价待核对</span>' : ''}</div>
						<p class="muted">行李：${pack}</p><p class="muted">别忘了：${remind}</p>
						<div class="list">${btns}</div>
						<p class="muted"><small>票价出处：${esc(o.fare.source)}</small></p></div>`;
				}).join('');
				return `<p class="section-title">🧳 跨州旅行和回国探亲</p><p class="muted">离开期间房租、车险、贷款照常扣；${s.job ? `有工作的话，一年里可保留工作的请假共 ${JOB_LEAVE_DAYS} 天，离开期间不发工资；` : ''}旅途吃住不另收费，不掉需求。${seasons ? `现在是${seasons}，机票偏贵。` : ''}</p>${cards}`;
			}

			/** 出行页顶上的分页：路线（地图）和附近（真实地点）；附近原来是单独的底部标签 */
			function goSeg() {
				const seg: [string, string][] = [['go', '路线'], ['near', '附近']];
				return `<div class="seg" role="tablist" aria-label="出行">${seg.map(([id, label]) => `<button role="tab" data-tab="${id}" class="${tab === id ? 'on' : ''}" aria-selected="${tab === id}">${label}</button>`).join('')}</div>`;
			}

			/** 「我」和「成长」共用一套卡片：成长页放等级、每日奖励和各种收集，「我」页放档案、心情、能力和资产 */
			function panelMe(view: 'me' | 'grow' = 'me') {
				const s = state!;
				const origin = ORIGINS.find((o) => o.id === s.origin)!;
				// 每项能力在哪练：涨得最多的 3 个互动（只看数据，不管当前在哪）
				const trainers = (k: (typeof SKILL_KEYS)[number]) => ACTIVITIES.filter((a) => (a.fx.skills?.[k] ?? 0) > 0).sort((a, b) => (b.fx.skills![k] ?? 0) - (a.fx.skills![k] ?? 0)).slice(0, 3).map((a) => a.name).join('、');
				const skills = SKILL_KEYS.map((k) => `<div class="skill"><span>${SKILL_META[k].icon}</span><div>${SKILL_META[k].name} <span class="muted">${SKILL_META[k].hint}</span>${trainers(k) ? `<small class="train">怎么练：${esc(trainers(k))}</small>` : ''}<div class="bar"><i style="width:${s.skills[k]}%"></i></div></div><b title="含特质、装备、心情的检定分">${checkScore(s, k).total}</b></div>`).join('');
				const vdef = getVehicle(s.vehicle);
				const veh = vdef ? `${vdef.icon} ${vdef.name}（值 $${resaleValue(vdef.id, s.car.km).toLocaleString()}）· 开了 ${s.car.km.toLocaleString()} 公里，离上次保养 ${s.car.since.toLocaleString()} 公里${breakdownChance(s) > 0 ? `，该保养了（每趟抛锚几率 ${Math.round(breakdownChance(s) * 100)}%）` : ''}` : '无（坐巴士）';
				const titles = areaTitles(s);
				const album = Object.entries(AREAS).map(([id, a]) => {
					const all = EXPERIENCES.filter((e) => e.area === id);
					const got = all.filter((e) => s.collected.includes(e.id));
					const strip = all.filter((e) => cgi['exp:' + e.id]).map((e) => `<img src="${esc(cgi['exp:' + e.id])}" alt="" loading="lazy" width="40" height="40" class="${s.collected.includes(e.id) ? '' : 'off'}" />`).join('');
					return `<div class="row" style="margin-top:6px"><span class="body">${esc(a.name)} ${got.length}/${all.length}${strip ? `<span class="album-strip" aria-hidden="true">${strip}</span>` : ''}<small>${all.map((e) => (s.collected.includes(e.id) ? '✅' : '⬜') + esc(e.name)).join(' · ')}</small></span></div>`;
				}).join('');
				// 心事（第 43 批）：孤独、思乡、压力每天结算一次；低谷期展开恢复建议和现实求助渠道。所有插值经过 esc()
				const mindHtml = () => {
					const sig = mindSignals(s);
					const why = pressureSources(s).map((p) => p.label);
					const rows = sig.map((x) => {
						const md = mindMoodlet(x.key);
						const rel = x.relievedBy ? moodletName(x.relievedBy) : '';
						const state = x.active ? '现在有' : rel ? `被「${rel}」缓解着` : x.score >= x.trigger ? '明天可能会有' : '暂时没有';
						const extra = x.key === 'stressed' && why.length ? ` · ${why.join('、')}` : '';
						return `<div class="mood-row"><span>${md.icon} ${esc(md.name)} <span class="muted">${esc(state + extra)}</span>${x.active ? `<small style="display:block">${esc(MIND_TIPS[x.key])}</small>` : ''}</span><b class="${x.active ? 'down' : ''}">${x.active ? md.value : '—'}</b></div>`;
					}).join('');
					const spell = lowSpell(s);
					const help = HELP_LINES.map((h) => `<li><b>${esc(h.name)}</b> ${esc(h.contact)}<small style="display:block">${esc(h.desc)} 来源：<a href="${esc(h.url)}" target="_blank" rel="noopener noreferrer">${esc(new URL(h.url).hostname)}</a></small></li>`).join('');
					return `<h4 style="margin-top:12px">心事</h4><p class="muted" style="font-size:12px">每天过了午夜结算一次：社交太少会孤单，刚来的几周容易想家，钱、身体和麻烦会带来压力。</p>${rows}
						${spell ? `<p style="margin-top:8px">已经连续 ${s.mind.low} 天心情低落。慢慢来：先吃饱睡好，再做点运动、玩点喜欢的、和人说说话。</p>` : ''}
						<div class="inline" style="margin-top:8px;flex-wrap:wrap">${(Object.keys(MIND_ACTS) as (keyof typeof MIND_ACTS)[]).map((k) => `<button data-mind="${esc(k)}">${MIND_ACTS[k].icon} ${esc(MIND_ACTS[k].name)}（${MIND_ACTS[k].minutes} 分钟）</button>`).join('')}</div>
						<details style="margin-top:10px"${spell ? ' open' : ''}><summary>现实中也觉得撑不住？</summary><p style="font-size:13px;margin-top:6px">游戏里的心情只是数字。现实里如果持续低落、焦虑，可以联系下面的服务，也可以找学校的辅导服务（counselling）或家庭医生（GP）。</p><ul style="font-size:13px;padding-left:18px">${help}</ul></details>`;
				};
				const lv = level(s.respect);
				const m = mood(s);
				const tier = moodTier(m);
				const mb = moodBreakdown(s);
				const traits = s.traits.map((id) => getTrait(id)).filter(Boolean).map((t) => `<span class="tag" title="${esc(t!.desc)}">${esc(t!.name)}</span>`).join('');
				const jc = s.job ? getCareer(s.job.career) : undefined;
				const promo = promotionStatus(s);
				const hd = s.home ? getHome(s.home.type) : undefined;
				const wc = weeklyCosts(s);
				const estate = s.properties.map((op) => {
					const pr = getProperty(op.id);
					if (!pr) return '';
					const living = s.home?.owned === op.id;
					const status = living ? '自住' : op.rented ? (op.fresh ? `刚挂牌，下个结算日后起收租 $${rentOn(pr.rentIncome, settleDay(s))}/周` : `出租中 +$${rentOn(pr.rentIncome, settleDay(s))}/周`) : '空置';
					return `<div style="margin-top:10px"><div class="row">${thumb('prop:' + pr.id)}<span class="body">${esc(pr.name)} · ${esc(getLocation(region, pr.loc)!.name)}<small>${status} · 物业费 $${pr.weekly}/周${op.loan ? ` · 贷款 $${op.loan.toLocaleString()}，每周还 $${loanPayment(pr, op.loan, loanRateMult(settleDay(s)))}` : ' · 无贷款'}${op.missed ? ` · ⚠️ 已欠款 ${op.missed} 次（超过 ${FINANCE.graceWeeks} 次强制卖房）` : ''}</small></span><span class="meta">卖出到手<br/>$${saleProceeds(pr, op.loan).toLocaleString()}</span></div>
					<div class="inline" style="margin-top:6px;flex-wrap:wrap">${living ? '' : `<button data-prop="movein" data-prop-id="${op.id}">搬进去</button>`}<button data-prop="rentout" data-prop-id="${op.id}">${op.rented ? '停止出租' : '出租'}</button>${op.loan ? `<button data-prop="repay" data-prop-id="${op.id}">提前还贷</button>` : ''}<button data-prop="sell" data-prop-id="${op.id}">卖掉</button></div></div>`;
				}).join('');
				const life = `
					<p>${jc ? `${esc(jc.name)}（${esc(getLocation(region, s.job!.loc)!.name)}）· ${esc(jc.levels[s.job!.level].title)} · 每班 $${careerPay(s, s.job!.career, s.job!.level)}` : '无业。'}${s.certs.length ? ` 证书和学历：${s.certs.map((id) => esc(credentialName(id))).join('、')}。` : ''}${jc ? '' : '到城镇、海滩、矿区等地方找工作。'}</p>
					${promo ? `<p>升职到${esc(promo.next.title)}：已上 ${promo.shifts}/${PROMOTE_SHIFTS} 班，表现好 ${promo.good}/${PROMOTE_GOOD} 班${promo.blocked ? `，还需${esc(promo.blocked)}` : ''}</p>` : jc ? '<p>已是最高职位。</p>' : ''}
					<p>${hd ? `住在${esc(getLocation(region, s.home!.loc)!.name)}的${esc(hd.name)}，家具：${Object.values(s.home!.furniture).map((id) => esc(getFurniture(id)?.name ?? '')).join('、') || '无'}` : '没有住处。在城镇可以租房，回家睡觉免费且恢复更多。'}</p>
					<p>每周固定开销 $${wc.total}${wc.total ? `（房租 $${wc.rent} + 车辆 $${wc.vehicle} + 房产 $${wc.property}）· ${Math.max(0, s.nextWeek - dayOf(s.clock))} 天后结算` : ''}</p>
					<div class="inline" style="margin-top:8px">${jc ? '<button data-job="quit">辞职</button>' : ''}${hd ? '<button data-home="leave">退租</button>' : ''}</div>`;
				const npcName = (id: string) => NPCS.find((n) => n.id === id)?.name ?? id;
				const duoHtml = `<div class="card"><h3>朋友之间 ${s.duos.length}/${NPC_DUOS.length}</h3><p>两位朋友的好感都够了，和其中一位互动时会发生的事。</p><div class="ach-grid">${NPC_DUOS.map((d) => s.duos.includes(d.id)
					? `<div class="ach done"><span class="ach-ico" aria-hidden="true">🤝</span><span><b>${esc(d.title)}</b><small>${esc(d.text)}</small></span></div>`
					: `<div class="ach"><span class="ach-ico" aria-hidden="true">❔</span><span><b>${esc(npcName(d.a))} 和 ${esc(npcName(d.b))}</b><small>两人好感都到 ${d.at}</small></span></div>`).join('')}</div></div>`;
				const rels = Object.entries(s.relations).map(([id, r]) => {
					const npc = NPCS.find((n) => n.id === id);
					if (!npc) return '';
					const plan = npcStatus(npc, s.clock).plan;
					const where = plan.away ? `今天${plan.note ?? ''}` : `今天在${getLocation(region, plan.loc)?.name ?? ''} ${hoursLabel(plan.hours)}`;
					const known = r.known.map((i) => `${getItem(i)?.icon ?? ''}${GIFT_LABEL[giftReaction(npc, i)]}`).join(' ');
					return `<div class="skill"><span></span><div>${esc(npc.name)} <span class="muted">${esc(npc.role)} · ${esc(where)} · 故事 ${r.seen.length}/${npc.stories.length}${known ? ` · ${esc(known)}` : ''}</span><div class="bar"><i style="width:${Math.max(0, r.score)}%"></i></div></div><b title="${relationTier(r.score)}">${r.bond !== undefined ? '🫶 知己' : relationTier(r.score)}</b></div>`;
				}).join('');
				const bag = Object.entries(s.inventory).map(([id, n]) => {
					const it = getItem(id);
					if (!it) return '';
					const back = sellPrice(it);
					const sellWhy = sellItemBlocked(s, getLocation(region, s.loc), it);
					const sellBtn = back ? `<button data-sell="${it.id}" ${sellWhy ? `disabled title="${esc(sellWhy)}"` : ''}>卖 $${back}</button>` : '';
					const main = it.use ? `<button data-use="${it.id}">使用</button>` : itemCat(it) === 'gift' ? '<span class="meta">留着送人</span>' : '<span class="meta">装备中</span>';
					return `<div class="row" style="margin-top:8px"><span class="ico">${it.icon}</span><span class="body">${esc(it.name)} ×${n}<small>${esc(ITEM_CATS[itemCat(it)])} · ${esc(it.desc)}</small></span>${main}${sellBtn}</div>`;
				}).join('');
				const ach = achievements(s, region);
				const achDone = ach.filter((a) => a.done).length;
				// 成就奖励（第 28 批）：达成后点「领取」，服务端核对后发；领过的显示「已领」
				const achPrize = (a: (typeof ach)[number]) => {
					const r = achReward(a.def);
					return [r.cash ? `$${r.cash}` : '', r.respect ? `声望 +${r.respect}` : '', r.title ? `称号「${a.def.name}」` : ''].filter(Boolean).join('、');
				};
				const achHtml = `<div class="card"><h3>成就 ${achDone}/${ach.length}</h3><p>达成后点「领取」拿奖励，每个只能领一次。</p><div class="ach-grid">${ach.map((a) => `<div class="ach${a.done ? ' done' : ''}"><span class="ach-ico" aria-hidden="true">${a.def.icon}</span><span><b>${esc(a.def.name)}</b><small>${esc(a.def.desc)}${a.done ? '' : ` · ${a.cur.toLocaleString()}/${a.goal.toLocaleString()}`}</small><small>${a.claimed ? '已领' : `奖励：${esc(achPrize(a))}`}</small></span>${a.done && !a.claimed ? `<button class="claim" data-claim="${esc(a.def.id)}">领取</button>` : ''}<span class="sr">${a.done ? '（已达成）' : '（未达成）'}</span></div>`).join('')}</div></div>`;
				// 称号：拿到的可以戴一个，显示在名牌上；没拿到的告诉怎么拿
				const earned = earnedTitles(s);
				const earnedIds = new Set(earned.map((t) => t.id));
				const titleHtml = `<div class="card"><h3>称号 ${earned.length}/${allTitles().length}</h3><p>从片区收藏、成就和支线拿到，戴上一个会显示在名牌上，不影响数值。</p><div class="ach-grid">${allTitles().map((t) => earnedIds.has(t.id)
					? `<div class="ach done"><span class="ach-ico" aria-hidden="true">🏷️</span><span><b>${esc(t.name)}</b><small>${esc(t.from)}</small></span><button class="claim" data-wear="${esc(s.title === t.id ? '' : t.id)}">${s.title === t.id ? '摘下' : '戴上'}</button></div>`
					: `<div class="ach"><span class="ach-ico" aria-hidden="true">🏷️</span><span><b>${esc(t.name)}</b><small>${esc(t.from)}</small></span><span class="sr">（还没拿到）</span></div>`).join('')}</div></div>`;
				// 任务总览（第 28 批）：主线、支线、今天、收集、成就放在一张卡里，各自显示下一步和进度
				const KIND_LABEL: Record<string, string> = { main: '主线', side: '支线', daily: '每日', collect: '收集', ach: '成就' };
				const questHtml = `<div class="card"><h3>任务</h3><p>主线和支线做完自动发奖；成就要自己点领取。全服周目标在社交页。</p><div class="quest-list">${questBoard(s, region, (id) => NPCS.find((n) => n.id === id)?.name ?? id).map((q) => `<div class="quest${q.locked ? ' locked' : ''}"><span class="q-ico" aria-hidden="true">${q.locked ? '🔒' : esc(q.icon)}</span><span class="q-body"><span class="q-kind">${esc(KIND_LABEL[q.kind])}${q.locked ? ' · 未解锁' : ''}</span><b>${esc(q.title)}</b><small>${esc(q.sub)}</small>${q.reward ? `<small>奖励：${esc(q.reward)}</small>` : ''}</span><span class="q-n">${q.claimable ? '<b>可领</b>' : `${q.got}/${q.need}`}</span></div>`).join('')}</div></div>`;
				// 足迹：全部地点，去过的标出次数；点一下看去那里的走法（当前所在地回今天页）
				const placesVisited = region.locations.filter((l) => s.visited[l.id]).length;
				// 足迹按区域分组（第 42 轮）：每个区域一个小标题和去过几个
				const trailHtml = `<div class="card"><h3>足迹 ${placesVisited}/${region.locations.length}</h3>${MAP_AREAS.map((a) => `<p class="trail-area">${esc(a.name)} · ${a.locations.filter((l) => s.visited[l.id]).length}/${a.locations.length}</p><div class="trail">${a.locations.map((l) => `<button class="${s.visited[l.id] ? 'been' : ''}" data-loc="${l.id}">${KIND_ICON[l.kind]} ${esc(l.name)}${s.visited[l.id] ? `<small>${l.id === s.loc ? '在这里' : `${s.visited[l.id]} 次`}</small>` : '<small>没去过</small>'}</button>`).join('')}</div>`).join('')}</div>`;
				// 天气相册：每个地点一行，五种天气，拍到的点亮
				const photos = new Set(s.photos);
				const photoHtml = `<div class="card"><h3>天气相册 ${s.photos.length}/${region.locations.length * WEATHERS.length}</h3><p>抵达一个地方时，会按当天的天气收一张照片。同一个地方换个天气再来，能收到不一样的。</p>
					<div class="album">${region.locations.map((l) => `<div class="album-row"><span>${esc(l.name)}</span><span>${WEATHERS.map((w) => `<i class="${photos.has(`${l.id}|${w.id}`) ? 'got' : ''}" title="${esc(w.name)}">${w.icon}</i>`).join('')}</span><span class="sr">${WEATHERS.filter((w) => photos.has(`${l.id}|${w.id}`)).map((w) => w.name).join('、') || '还没有'}</span></div>`).join('')}</div></div>`;
				// 野生动物图鉴：见过的显示名字，没见过的只显示所属分组
				const dex = new Set(s.dex);
				const dexHtml = `<div class="card"><h3>野生动物图鉴 ${s.dex.length}/${ANIMALS.length}</h3><p>到了各地有机会看见动物，有的只在某个季节或清晨傍晚出现。一组集齐加声望。</p>
					<p>${dexProgress(s).map((g) => `${esc(g.name)} ${g.got}/${g.total}${g.done ? ' ✅' : ''}`).join(' · ')}</p>
					${(() => { const now = seasonAnimals(s.clock); return now.length ? `<p>本季限定：${now.map((a) => dex.has(a.id) ? `${a.icon}${esc(a.name)}` : '？？？').join('、')}</p>` : ''; })()}
					<div class="ach-grid">${ANIMALS.map((a) => dex.has(a.id)
						? `<div class="ach done"><span class="ach-ico" aria-hidden="true">${a.icon}</span><span><b>${esc(a.name)}</b><small>${esc(a.desc)}${animalHint(a) ? ` · ${esc(animalHint(a))}` : ''}</small></span></div>`
						: `<div class="ach"><span class="ach-ico" aria-hidden="true">❔</span><span><b>？？？</b><small>${esc([({ sea: '海洋', land: '陆地', bird: '飞鸟' } as Record<string, string>)[a.group], animalHint(a)].filter(Boolean).join(' · '))}</small></span><span class="sr">（还没见过）</span></div>`).join('')}</div>
					<details style="margin-top:8px"><summary><b>看动物的规矩</b></summary>${WILDLIFE_RULES.map((r) => `<p style="margin-top:6px">${esc(r.text)} <a class="muted" href="${esc(r.source)}" target="_blank" rel="noopener">来源</a></p>`).join('')}</details></div>`;
				const fishHtml2 = `<div class="card"><h3>鱼获 ${Object.keys(s.fish).length}/${FISH.length}</h3><div class="ach-grid">${FISH.map((f) => s.fish[f.id]
					? `<div class="ach done">${cgi['fish:' + f.id] ? `<img class="ach-img" src="${esc(cgi['fish:' + f.id])}" alt="" loading="lazy" width="40" height="40" />` : `<span class="ach-ico" aria-hidden="true">${f.icon}</span>`}<span><b>${esc(f.name)} ×${s.fish[f.id]}</b><small>${s.hobby.best[f.id] ? `最大 ${s.hobby.best[f.id]} cm · ` : ''}${esc(f.desc)}</small></span></div>`
					: `<div class="ach"><span class="ach-ico" aria-hidden="true">❔</span><span><b>？？？</b><small>还没钓到</small></span></div>`).join('')}</div></div>`;
				// 见闻录：一次性的专属事件，见过的显示标题，没见过的只提示在哪
				const onceEvents = EVENTS.filter((e) => e.once && !e.venueTypes);
				const seenOnce = onceEvents.filter((e) => s.seen.includes(e.id)).length;
				// 和事件触发相同的匹配规则（地点、标签、类型任一命中）
				const where = (e: (typeof onceEvents)[number]) => region.locations.filter((l) => e.locs?.includes(l.id) || e.tags?.some((t) => l.tags.includes(t)) || e.kinds?.includes(l.kind)).map((l) => l.name).join('、') || '某个地方';
				const storyHtml = `<div class="card"><h3>见闻录 ${seenOnce}/${onceEvents.length}</h3><p>只会遇到一次的事。没见过的只告诉你在哪。</p><div class="ach-grid">${onceEvents.map((e) => s.seen.includes(e.id)
					? `<div class="ach done"><span class="ach-ico" aria-hidden="true">${e.icon}</span><span><b>${esc(e.title)}</b><small>${esc(where(e))}</small></span></div>`
					: `<div class="ach"><span class="ach-ico" aria-hidden="true">❔</span><span><b>？？？</b><small>${esc(where(e))}</small></span><span class="sr">（还没遇到）</span></div>`).join('')}</div></div>`;
				// 爱好和收集册（docs/earth-game/hobbies.md）
				const hobbyLv = `<div class="card"><h3>爱好</h3>${HOBBIES.map((h) => { const st = hobbyStatus(s, h.id); return `<div class="mood-row"><span>${h.icon} ${esc(h.name)} · ${st.level} 级${esc(st.name)}</span><b>${st.next === null ? '满级' : `还差 ${st.next}`}</b></div>`; }).join('')}<p class="muted" style="margin-top:6px">同一天反复做同一件事，乐趣会递减；同好在场时一起做，加好感和社交。</p></div>`;
				const cols = collections(s, region);
				const colHtml = `<div class="card"><h3>收集册</h3><p class="muted">${COLLECTION_REWARD.half.respect > 0 ? `收到一半声望 +${COLLECTION_REWARD.half.respect}，收齐 +${COLLECTION_REWARD.full.respect}（野生动物和天气相册按原来的规则）。` : ''}</p>${cols.map((c) => {
					const rc = rarityCounts(c);
					const marks = c.reward ? ['half', 'full'].filter((k) => s.hobby.got.includes(`${c.id}:${k}`)).map((k) => (k === 'half' ? '½✅' : '🏆')).join(' ') : '';
					const grid = ['birds', 'works', 'plants', 'crafts', 'songs'].includes(c.id) ? `<div class="ach-grid">${c.entries.map((e) => e.got
						? `<div class="ach done"><span class="ach-ico" aria-hidden="true">${e.icon}</span><span><b>${esc(e.name)}</b><small>${esc([e.rarity ? RARITY_NAME[e.rarity] : '', e.detail ?? ''].filter(Boolean).join(' · '))}</small></span></div>`
						: `<div class="ach"><span class="ach-ico" aria-hidden="true">❔</span><span><b>${c.id === 'works' ? esc(e.name) : '？？？'}</b><small>${esc([e.rarity ? RARITY_NAME[e.rarity] : '', e.detail ?? (c.id === 'works' ? '还没有佳作' : '')].filter(Boolean).join(' · '))}</small></span><span class="sr">（还没收到）</span></div>`).join('')}</div>` : '';
					return `<details style="margin-top:8px"><summary><b>${c.icon} ${esc(c.name)} ${c.got}/${c.total}</b> ${marks}${rc.length ? ` <span class="muted">${rc.map((r) => `${r.icon}${r.got}/${r.total}`).join(' ')}</span>` : ''}</summary>${grid}</details>`;
				}).join('')}</div>`;
				const card = {
					hobby: hobbyLv,
					collect: colHtml,
					visa: visaCardHtml(s, region, esc), // 签证（第 43 批）：非留学生出身为空串
					story: storyHtml,
					dex: dexHtml,
					fish: fishHtml2,
					photo: photoHtml,
					trail: trailHtml,
					ach: achHtml,
					titles: titleHtml,
					quests: questHtml,
					me: `<div class="card"><h3>档案</h3><p>${origin.icon} ${origin.name} · 座驾：${veh}</p>
					<p>已探索 ${Object.keys(s.visited).length}/${region.locations.length} 个地点 · 麻烦值 ${Math.round(s.heat)}/100（${wantedStars(s.heat)} 星）</p>
					${lawHtml(s)}
						<p>Lv${lv.lv} ${lv.title} · 声望 ${fmtHalf(s.respect)}${lv.next !== null ? ` / ${lv.next}` : ''} · 心情 ${m}（${tier.name}，检定 ${tier.check >= 0 ? '+' : ''}${tier.check}）</p>
						<div class="tags">${traits || '<span class="muted">没有性格特质</span>'}</div>
						<div class="inline" style="margin-top:10px"><button data-share>分享我的进度</button></div></div>`,
					mood: `<div class="card"><h3>心情 ${mb.total}（${tier.name}，检定 ${tier.check >= 0 ? '+' : ''}${tier.check}）</h3>
						<div style="margin-top:6px">
							<div class="mood-row"><span>生活需求（最低的一项拉低整体）</span><b>${mb.needs}</b></div>
							${mb.traits ? `<div class="mood-row"><span>性格特质</span><b class="${mb.traits > 0 ? 'up' : 'down'}">${mb.traits > 0 ? '+' : ''}${mb.traits}</b></div>` : ''}
							${mb.home ? `<div class="mood-row"><span>住处</span><b class="up">+${mb.home}</b></div>` : ''}
							${mb.moodlets.map((x) => `<div class="mood-row"><span>${x.def.icon} ${esc(x.def.name)} <span class="muted">还剩 ${x.minutesLeft >= 120 ? Math.round(x.minutesLeft / 60) + ' 小时' : Math.max(1, Math.round(x.minutesLeft)) + ' 分钟'}</span></span><b class="${x.def.value > 0 ? 'up' : 'down'}">${x.def.value > 0 ? '+' : ''}${x.def.value}</b></div>`).join('')}
						</div>
						${mb.moodlets.length ? '' : '<p style="margin-top:6px">做点开心的事——好好吃一顿、睡个好觉、完成心愿、去新地方——会留下几小时到几天的好心情。</p>'}
						${mindHtml()}
					</div>`,
					daily: (() => {
						// 一周 7 格：今天在第几格；明天接着来能领多少
						const pos = ((Math.max(1, s.daily.streak) - 1) % DAILY.cap) + 1;
						const tomorrow = dailyReward(s.daily.streak + 1);
						const dots = Array.from({ length: DAILY.cap }, (_, i) => `<span class="dot${i < pos ? ' on' : ''}${i === DAILY.cap - 1 ? ' big' : ''}" aria-hidden="true">${i === DAILY.cap - 1 ? '🎁' : i + 1}</span>`).join('');
						return `<div class="card"><h3>每日奖励 · 连续 ${s.daily.streak} 天</h3><div class="streak" role="img" aria-label="这一轮 7 天里已到第 ${pos} 天">${dots}</div>
							<p style="margin-top:8px">明天接着来能领 $${tomorrow.cash}${tomorrow.full ? `（满 ${DAILY.cap} 天大礼，含额外 $${DAILY.bonus}）` : ''}。断一天从头算（$${DAILY.base} 起）。</p></div>`;
					})(),
					world: worldCard(dayOf(s.clock)), // 世界事件（第 43 批）
					assets: `<div class="card"><h3>资产 · 净值 $${netWorth(s).toLocaleString()}</h3><p>现金 $${s.cash.toLocaleString()}${vdef ? ` · ${esc(vdef.name)} $${resaleValue(vdef.id, s.car.km).toLocaleString()}` : ''}${furnitureValue(s) ? ` · 家具 $${furnitureValue(s)}` : ''}${holdingsValue(s) ? ` · 理财 $${holdingsValue(s).toLocaleString()}` : ''}${bankDebt(s.bank) ? ` · 欠银行 −$${bankDebt(s.bank).toLocaleString()}` : ''}</p>${estate || emptyArt('empty:estate') + '<p>还没有房产。在卡尔古利、珀斯、弗里曼特尔、玛格丽特河可以买房。</p>'}</div>${taxCard(s, esc)}`,
					invest: investCard(s),
					bank: bankCardHtml(s, esc), // 银行、信用分和贷款（banking.md）
					album: `<div class="card"><h3>收藏册 ${s.collected.length}/${EXPERIENCES.length}</h3>${titles.length ? `<div class="tags">${titles.map((t) => `<span class="tag">🏅 ${esc(t)}</span>`).join('')}</div>` : '<p>在各地体验收费项目，集齐一个片区可获得称号。</p>'}${album}</div>`,
					life: `<div class="card"><h3>工作与住处</h3>${life}</div>`,
					ins: insuranceCard(s, !!vdef, esc),
					rels: `<div class="card"><h3>人际关系</h3>${rels || emptyArt('empty:rels') + '<p>还没认识什么人。去各地看看谁在那里。</p>'}</div>${duoHtml}`,
					bag: `<div class="card"><h3>背包</h3>${bag || emptyArt('empty:bag') + '<p>空的。在地点页的商店里买东西。</p>'}</div>`,
					skills: `<div class="card"><h3>能力</h3><p>用得越多涨得越快。</p>${skills}</div>`,
					derived: `<div class="card"><h3>派生属性</h3>${(() => {
						const d = derivedStats(s);
						return `<p>体质 ${d.fitness}（体能 50% + 力量 30% + 游泳 20%）</p>
							<p>吸引力 ${d.appeal}（魅力 + 体质 15% + 心情修正${s.needs.hygiene < 30 ? ' − 邋遢 10' : ''}）</p>
							<p>体力消耗 ×${d.exertion} · 恢复 ×${d.recovery}（上班、活动消耗的精力乘消耗，睡觉回的精力乘恢复）</p>
							<p>精力上限 ${Math.round(energyCap(s))}（80 + 体质 × 0.2，练体能、力量、游泳会永久提高）</p>
							<p>身心紧绷 ${Math.round(stress(s) * 100)}%（娱乐或社交低于 40 开始有，越紧绷饿得越快；和心事里的「压力」不是一回事）</p>
							<p>状态系数 ×${d.efficiency.total}（心情 ×${d.efficiency.mood} · 健康 ×${d.efficiency.health} · 疲劳 ×${d.efficiency.fatigue}），训练收益和工作表现都乘它</p>`;
					})()}</div>`,
				};
				if (view === 'grow') {
					// 人生等级：声望到下一级的进度；满级不画进度条
					const pct = lv.next !== null ? Math.min(100, Math.round(s.respect / lv.next * 100)) : 100;
					const lvHtml = `<div class="card grow-head"><span class="lv-badge" aria-hidden="true">${lv.lv}</span><span class="name"><b>Lv${lv.lv} ${esc(lv.title)}</b><span>声望 ${fmtHalf(s.respect)}${lv.next !== null ? ` / ${lv.next} · 离下一级还差 ${fmtHalf(Math.max(0, lv.next - s.respect))}` : ' · 已到最高级'}</span>${lv.next !== null ? `<span class="bar" role="img" aria-label="升级进度 ${pct}%"><i style="width:${pct}%"></i></span>` : ''}</span></div>`;
					return banner('banner:grow') + lvHtml + ['quests', 'daily', 'ach', 'titles', 'hobby', 'collect', 'album', 'photo', 'dex', 'fish', 'story', 'trail'].map((k) => card[k as keyof typeof card]).join('');
				}
				const sections: Record<string, string[]> = { overview: ['mood', 'me', 'visa', 'skills', 'derived'], assets: ['assets', 'invest', 'bank', 'life', 'ins', 'bag', 'world'], people: ['rels'] };
				const head = `<div class="card me-head"><span class="avatar">${s.avatar}</span><span class="name"><b>${esc(s.name)}</b><span>${esc(origin.name)}${s.traits.length ? ' · ' + s.traits.map((id) => esc(getTrait(id)?.name ?? '')).join(' · ') : ''} · 第 ${dayOf(s.clock) + 1} 天</span></span></div>`;
				// 「更新」页（第 48 轮）：打开时记下已读；没看过的批次在标签上标「新」
				void loadNews();
				if (news && meTab === 'news') store.set(news.NEWS_SEEN_KEY, String(news.CHANGELOG_LATEST));
				const fresh = news ? news.unseenNews(news.parseNewsSeen(store.get(news.NEWS_SEEN_KEY))) : 0;
				const seg = `<div class="seg" role="tablist">${ME_TABS.map(([id, label]) => `<button role="tab" data-metab="${id}" class="${meTab === id ? 'on' : ''}" aria-selected="${meTab === id}">${tx(label)}${id === 'news' && fresh ? `<span class="new-tag">${tx('me.news.new')}</span>` : ''}</button>`).join('')}</div>`;
				const bodyHtml = meTab === 'career' ? panelCareer() : meTab === 'log' ? panelLog() : meTab === 'sync' ? panelSync() : meTab === 'news' ? panelNews() : (sections[meTab] ?? sections.overview).map((k) => card[k as keyof typeof card]).join('');
				return head + seg + bodyHtml;
			}

			/** 共同事件：这里的队伍（加入/开始/退出）和这里能发起的事 */
			function coopCard(s: PlayerState) {
				loadCoop();
				const loc = getLocation(region, s.loc)!;
				const others = [...peers.values()].filter((p) => p.loc === s.loc && p.id !== myPeerId).length;
				const defs = coopsAt(s, region);
				const inLobby = coopLobbies.some((l) => l.mine);
				if (!defs.length && !coopLobbies.length) return `<div class="card coop"><h3>一起做点什么</h3><p class="muted">${esc(loc.name)}没有能和别人一起做的事。海滩、城里、小镇、港口、峡谷和内陆都有。</p></div>`;
				const lobbies = coopLobbies.map((l) => {
					const def = getCoop(l.coop);
					if (!def) return '';
					const blocked = coopBlocked(s, region, def);
					const members = l.members.map((m) => `<span class="tag">${esc(m.avatar)} ${esc(m.name)}${m.me ? '（你）' : ''} · ${esc(def.roles[m.role]?.label ?? '')}</span>`).join('');
					const canStart = l.host && l.members.length >= def.min;
					const lid = esc(l.id);
					const where = l.loc ? getLocation(region, l.loc)?.name ?? '' : '';
					const actions = l.starting
						? '<span class="muted">正在开始…</span>'
						: l.mine && l.away
						? `<span class="muted">队伍在${esc(where)}，你已经走开了，回去才能参加</span><button data-coop="leave" data-lobby="${lid}">${l.host ? '解散' : '退出'}</button>`
						: l.mine
						? `${l.host ? `<button class="primary" data-coop="start" data-lobby="${lid}" ${canStart ? '' : 'disabled'}>${canStart ? `开始（${l.members.length} 人）` : `等人加入（至少 ${def.min} 人）`}</button>` : '<span class="muted">等发起人开始</span>'}<button data-coop="leave" data-lobby="${lid}">${l.host ? '解散' : '退出'}</button>`
						: l.members.length >= def.max ? '<span class="muted">人满了</span>'
						: inLobby ? '<span class="muted">你已经在别的队伍里</span>'
						: def.roles.map((r, i) => `<button data-coop="join" data-lobby="${lid}" data-role="${i}" ${blocked ? 'disabled' : ''}>加入：${esc(r.label)}</button>`).join('');
					return `<div class="coop-item"><b>${def.icon} ${esc(def.title)}</b> <span class="muted">${l.members.length}/${def.max} 人${coopCostLabel(def)}</span><div class="tags">${members}</div>${blocked && !l.mine ? `<p class="muted">${esc(blocked)}</p>` : ''}<div class="inline">${actions}</div></div>`;
				}).join('');
				const open = inLobby ? '' : defs.filter(({ def }) => !coopLobbies.some((l) => l.coop === def.id)).map(({ def, blocked }) => `<div class="coop-item"><b>${def.icon} ${esc(def.title)}</b> <span class="muted">${def.min}–${def.max} 人${coopCostLabel(def)}</span><p>${esc(def.text)}</p>${blocked ? `<p class="muted">${esc(blocked)}</p>` : ''}
					<div class="inline">${def.roles.map((r, i) => `<button data-coop="open" data-coop-id="${def.id}" data-role="${i}" ${blocked ? 'disabled' : ''}>发起：${esc(r.label)}</button>`).join('')}</div></div>`).join('');
				return `<div class="card coop"><h3>一起做点什么</h3><p>和同一地点的玩家一起做：每人选一个分工，合起来检定，人越多越容易成功。${others ? `这里现在有 ${others} 位其他玩家。` : '这里暂时没有其他玩家：可以先发起，5 分钟内有人来就能开始。'}</p>
					${lobbies}${open}<div class="inline" style="margin-top:10px"><button data-coop="list" ${coopLoading ? 'disabled' : ''}>刷新</button></div></div>`;
			}

			/** 全服周目标：进度条、我出的力、领奖 */
			function weekCard(s: PlayerState) {
				loadWeek();
				if (!weekView) return '';
				const { goal, count, daysLeft, mine } = weekView;
				const pct = Math.min(100, Math.round((count / goal.target) * 100));
				// 我这边的份数以存档为准（刚做完的事服务端已经记上）
				const n = s.weekly?.week === weekView.week ? Math.max(s.weekly.n, mine.n) : mine.n;
				const why = mine.claimed ? '这周的奖励已经领过了。' : count < goal.target ? `全服还差 ${goal.target - count} 次。` : n < 1 ? '这周还没出过力，先去做一次吧。' : '';
				return `<div class="card week"><h3>${goal.icon} 全服周目标：${esc(goal.title)}</h3><p>${esc(goal.desc)}。还剩 ${daysLeft} 天。</p>
					<div class="bar" role="progressbar" aria-valuenow="${Math.min(count, goal.target)}" aria-valuemin="0" aria-valuemax="${goal.target}"><i style="width:${pct}%"></i></div>
					<p class="muted">全服 ${Math.min(count, goal.target)} / ${goal.target} · 我出了 ${n} 份力 · 达成后出过力的人各领 $${goal.reward.cash}、声望 +${goal.reward.respect}</p>
					<div class="inline" style="margin-top:8px"><button class="primary" data-week="claim" ${why ? 'disabled' : ''}>${mine.claimed ? '已领取' : '领奖'}</button>${why && !mine.claimed ? `<span class="muted">${esc(why)}</span>` : ''}</div></div>`;
			}

			/** 常遇见的人：一起做过共同事件、交易过的玩家；在线的标出在哪 */
			function metCard(s: PlayerState) {
				const list = metList(s);
				if (!list.length) return '';
				const today = realDayOf(srvNow());
				const rows = list.slice(0, 12).map((m) => {
					const p = peers.get(m.hash);
					const where = p ? (p.loc === s.loc ? '就在这里' : `在线 · ${esc(getLocation(region, p.loc)?.name ?? '')}`) : today - m.last <= 0 ? '今天见过' : `${today - m.last} 天前见过`;
					return `<div class="row"><span class="ico">${esc(m.avatar)}</span><span class="body">${esc(m.name)}<small>一起做过 ${m.n} 次事 · ${where}</small></span>${p && p.loc === s.loc && p.id !== myPeerId && !isBlocked(s, m.hash) ? `<span class="meta"><button data-giftpick="${esc(m.hash)}" data-gift-name="${esc(m.name)}" aria-label="送${esc(m.name)}一件东西">🎁</button> <button data-swappick="${esc(m.hash)}" data-gift-name="${esc(m.name)}" aria-label="和${esc(m.name)}面交换东西">🤝</button></span>` : ''}</div>`;
				}).join('');
				return `<div class="card"><h3>常遇见的人</h3><p class="muted">一起做过共同事件、送过礼或做过买卖的玩家。</p><div class="list" style="margin-top:8px">${rows}</div></div>`;
			}

			/** 送礼与二手摊：选要送的东西、别人送我的、我挂出去的 */
			function tradeCard(s: PlayerState) {
				loadTrade();
				const day = realDayOf(srvNow());
				const parts: string[] = [];
				const owned = Object.entries(s.inventory).filter(([, n]) => n > 0).map(([id]) => getItem(id)).filter((x): x is NonNullable<typeof x> => !!x);
				if (sellPick) {
					// 每件给三个价：最低、商店价、最高（在 50%–150% 之间）
					const rows = owned.map((it) => {
						const why = giveBlocked(s, it.id, day);
						const r = saleRange(it.id)!;
						const prices = [...new Set([r.min, Math.min(r.max, Math.max(r.min, it.price)), r.max])];
						return `<div class="row"><span class="ico">${it.icon}</span><span class="body">${esc(it.name)} ×${s.inventory[it.id]}<small>${why ? esc(why) : `商店价 $${it.price}`}</small></span><span class="meta">${prices.map((pr) => `<button data-trade="sale" data-item="${it.id}" data-price="${pr}" ${why ? 'disabled' : ''}>$${pr}</button>`).join(' ')}</span></div>`;
					}).join('');
					parts.push(`<div class="trade-pick"><b>摆到${esc(getLocation(region, s.loc)!.name)}的二手摊，卖多少？</b>${rows ? `<div class="list" style="margin-top:8px">${rows}</div>` : '<p class="muted">背包里没有能卖的东西。</p>'}<div class="inline" style="margin-top:8px"><button data-trade="pickcancel">不卖了</button></div></div>`);
				}
				if (giftTo) {
					const rows = owned.map((it) => {
						const why = giveBlocked(s, it.id, day);
						return `<button class="row" data-trade="gift" data-item="${it.id}" ${why ? 'disabled' : ''}><span class="ico">${it.icon}</span><span class="body">${esc(it.name)} ×${s.inventory[it.id]}${why ? `<small>${esc(why)}</small>` : ''}</span></button>`;
					}).join('');
					parts.push(`<div class="trade-pick"><b>送给${esc(giftTo.name)}什么？</b>${rows ? `<div class="list" style="margin-top:8px">${rows}</div>` : '<p class="muted">背包里没有能送的东西。</p>'}<div class="inline" style="margin-top:8px"><button data-trade="pickcancel">不送了</button></div></div>`);
				}
				if (swapPick) parts.push(swapPicker(esc, s, swapPick));
				for (const o of tradeOffers) {
					const it = getItem(o.item);
					if (!it) continue;
					const lid = esc(o.id);
					if (o.kind === 'swap') {
						// 面交换物：结算时服务端再查双方背包和额度，这里只显示
						parts.push(o.mine
							? `<div class="row"><span class="body">🤝 等${esc(o.toName)}回应：${swapDesc(esc, o.give, o.want)}</span><span class="meta">${o.taking ? '正在交接…' : `<button data-trade="cancel" data-offer="${lid}">撤回</button>`}</span></div>`
							: `<div class="row"><span class="ico">${esc(o.avatar)}</span><span class="body">🤝 ${esc(o.name)}想面交：${swapDesc(esc, o.give, o.want)}<small>${(() => { const why = swapReceiverBlocked(s, o.give!, o.want!, realDayOf(srvNow())); return why ? esc(why) : '先当面核对清楚；带钱的交易按商店价限价'; })()}</small></span><span class="meta"><button class="primary" data-trade="accept" data-offer="${lid}" ${o.taking || swapReceiverBlocked(s, o.give!, o.want!, realDayOf(srvNow())) ? 'disabled' : ''}>同意</button> <button data-trade="decline" data-offer="${lid}" ${o.taking ? 'disabled' : ''}>不换</button></span></div>`);
						continue;
					}
					if (o.mine) {
						const where = o.loc !== s.loc ? `（在${esc(getLocation(region, o.loc)?.name ?? '')}）` : '';
						const what = o.kind === 'gift' ? `等${esc(o.toName)}收下 ${it.icon} ${esc(it.name)}` : `二手摊上的 ${it.icon} ${esc(it.name)} · $${o.price}`;
						parts.push(`<div class="row"><span class="body">${what}${where}</span><span class="meta">${o.taking ? '正在交接…' : `<button data-trade="cancel" data-offer="${lid}">撤回</button>`}</span></div>`);
					} else if (o.kind === 'gift') {
						const why = takeBlocked(s, o.item, 0, day);
						parts.push(`<div class="row"><span class="ico">${esc(o.avatar)}</span><span class="body">${esc(o.name)}想送你 ${it.icon} ${esc(it.name)}${why ? `<small>${esc(why)}</small>` : ''}</span><span class="meta"><button class="primary" data-trade="accept" data-offer="${lid}" ${why || o.taking ? 'disabled' : ''}>收下</button> <button data-trade="decline" data-offer="${lid}" ${o.taking ? 'disabled' : ''}>不要</button></span></div>`);
					} else {
						const why = takeBlocked(s, o.item, o.price, day);
						parts.push(`<div class="row"><span class="ico">${esc(o.avatar)}</span><span class="body">${esc(o.name)}的二手摊 · ${it.icon} ${esc(it.name)}<small>${why ? esc(why) : `商店价 $${it.price}`}</small></span><span class="meta"><button class="primary" data-trade="accept" data-offer="${lid}" ${why || o.taking ? 'disabled' : ''}>$${o.price} 买下</button></span></div>`);
					}
				}
				const sellBtn = !sellPick && !giftTo && !swapPick && owned.length ? `<div class="inline" style="margin-top:8px"><button data-trade="sellpick">摆个二手摊</button></div>` : '';
				if (!parts.length && !sellBtn) return '';
				return `<div class="card trade"><h3>🎁 送礼与二手摊</h3><p class="muted">每人每天最多送出、收下各 5 次（买卖也算）；挂着的单 30 分钟没人接就撤下，价格在商店价的一半到一倍半之间。</p>${parts.join('')}${sellBtn}</div>`;
			}

			function boardCard() {
				loadBoard();
				return lbCardHtml(board, { loading: boardLoading, error: boardError, ...lbUi }, esc);
			}

			// 手机上打字麻烦：本地频道的快捷短语，点一下直接发
			const QUICK_CHAT = ['你好！', '有人一起吗？', '这里天气不错', '谢谢！', '回头见'];
			function panelSocial() {
				const s = state!;
				const online = ws?.readyState === WebSocket.OPEN;
				const here = [...peers.values()].filter((p) => p.loc === s.loc && p.id !== myPeerId && !isBlocked(s, p.id));
				// 人很多时只列前 PEERS_SHOWN 位（每人一排按钮），其余写个数
				const PEERS_SHOWN = 30;
				const more = here.length > PEERS_SHOWN ? `<p class="muted" style="margin-top:6px">还有 ${here.length - PEERS_SHOWN} 位玩家在这里</p>` : '';
				const people = here.length ? here.slice(0, PEERS_SHOWN).map((p) => `<div class="row"><span class="ico">${esc(p.avatar)}</span><span class="body">${esc(p.name)}</span>
					<span class="emotes">${emotes.map((e) => `<button data-emote="${esc(e)}" data-to="${esc(p.id)}" aria-label="向${esc(p.name)}发送 ${esc(e)}">${esc(e)}</button>`).join(' ')} <button data-giftpick="${esc(p.id)}" data-gift-name="${esc(p.name)}" aria-label="送${esc(p.name)}一件东西">🎁</button> <button data-swappick="${esc(p.id)}" data-gift-name="${esc(p.name)}" aria-label="和${esc(p.name)}面交换东西">🤝</button> <button data-safety="block" data-peer="${esc(p.id)}" aria-label="屏蔽${esc(p.name)}">屏蔽</button> <button data-report-pick="peer" data-peer="${esc(p.id)}" data-name="${esc(p.name)}" aria-label="举报${esc(p.name)}">举报</button></span></div>`).join('') : '<p class="muted">这里暂时只有你一个人。</p>';
				// 认识的当地人今天在哪：就在这里的标出来，在别处的可以直接看去那里的走法
				const presentIds = new Set(npcsAt(s, region).map((x) => x.npc.id));
				const known = Object.entries(s.relations)
					.map(([id, r]) => ({ npc: NPCS.find((n) => n.id === id), r }))
					.filter((x): x is { npc: (typeof NPCS)[number]; r: (typeof s.relations)[string] } => !!x.npc)
					.sort((a, b) => b.r.score - a.r.score);
				const knownHtml = known.length ? `<div class="card"><h3>认识的人今天在哪</h3><div class="list" style="margin-top:8px">${known.map(({ npc, r }) => {
					// 和引擎同一套判断（跨午夜沿用前一天的作息）
					const { plan, state: st } = npcStatus(npc, s.clock);
					const where = getLocation(region, plan.loc)?.name ?? '';
					const here = presentIds.has(npc.id);
					const ask = favorToday(s, npc.id, dayOf(s.clock));
					const sub = `${ask ? `🙋 想托你带${esc(getItem(ask.item)?.name ?? '')} · ` : ''}${isFading(r, dayOf(s.clock)) ? '好久没见 · ' : ''}${r.bond !== undefined ? '🫶 知己' : relationTier(r.score)} ${Math.round(r.score)} · ${here ? '就在这里' : st === 'away' ? '今天不在' : `${esc(where)} ${hoursLabel(plan.hours)}${st === 'after' ? '（今天已经走了）' : ''}`}${plan.note ? ` · ${esc(plan.note)}` : ''}`;
					if (st === 'away') return `<div class="row"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${sub}</small></span><span class="meta">请假了</span></div>`;
					return here
						? `<button class="row" data-tab="place"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${sub}</small></span><span class="meta"><b>去打招呼</b></span></button>`
						: plan.loc === s.loc
							? `<div class="row"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${sub}</small></span><span class="meta">${st === 'after' ? '今天已经走了' : '还没到时间'}</span></div>`
							: `<button class="row" data-loc="${plan.loc}"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${sub}</small></span><span class="meta"><b>怎么去</b></span></button>`;
				}).join('')}</div></div>` : '';
				return `${banner('banner:social')}${reportPick && !reportPick.note ? reportCard() : ''}${knownHtml}<div class="card"><h3>${esc(getLocation(region, s.loc)!.name)}的人</h3><p>${online ? `全区在线 ${peers.size} 人` : '未连接，稍后自动重连…'}</p><div class="list" style="margin-top:8px">${people}</div>${more}</div>
					${weekCard(s)}
					${tradeCard(s)}
					${cred && !credBad ? (loadMarket(), marketCard(esc, s, market, marketPick, srvNow())) : ''}
					${coopCard(s)}
					${metCard(s)}
					<div class="card"><h3>本地频道</h3><p>只有同一地点的玩家能看到。不能发网址、电话、账号和坐标；别人看不到你的真实位置。</p>
						<div class="chat" id="chat">${chats.filter((c) => !isBlocked(s, c.id)).map((c) => `<div>${esc(c.avatar)} <b>${esc(c.name)}</b> ${esc(c.text)}${c.id !== myPeerId ? ` <button class="mini" data-report-pick="peer" data-peer="${esc(c.id)}" data-name="${esc(c.name)}" data-quote="${esc(c.text)}" aria-label="举报这句话">举报</button>` : ''}</div>`).join('')}</div>
						<div class="quick">${QUICK_CHAT.map((q, i) => `<button data-quick="${i}" ${online ? '' : 'disabled'}>${q}</button>`).join('')}</div>
						<form class="inline" id="chat-form"><input id="chat-input" maxlength="120" placeholder="说点什么…" aria-label="聊天消息" autocomplete="off" ${online ? '' : 'disabled'} /><button class="primary" ${online ? '' : 'disabled'}>发送</button></form></div>
					${boardCard()}`;
			}

			function panelLog() {
				// 按游戏日分组，新的在上面；每组一个日期标题
				const groups = new Map<number, typeof state.journal>();
				for (const j of [...state!.journal].reverse()) {
					const d = dayOf(j.t);
					if (!groups.has(d)) groups.set(d, []);
					groups.get(d)!.push(j);
				}
				const rows = [...groups].map(([d, items]) => `<h4 class="log-day">第 ${d + 1} 天 · ${dateLabel(d * 1440)}</h4>${items.map((j) => `<div class="log-row"><span class="t">${formatClock(j.t).split(' ')[1] ?? ''}</span><span>${esc(j.text)}</span></div>`).join('')}`).join('');
				return `<div class="card"><h3>人生日志</h3><p>最近 ${state!.journal.length} 条</p>${rows}</div>`;
			}

			/** 主要路线（v22）：跟着主线本人走一遍真实街区。站名、简介都来自数据，一律经过 esc() */
			function trailCards(s: PlayerState) {
				const views = trailsIn(s, curArea());
				if (!views.length) return '';
				const rows = views.map(({ trail, open, done, at, next }) => {
					const live = open && !done;
					const city = getLocation(region, trail.loc)?.name ?? trail.loc;
					const away = live && next && nearFix ? ` · 离下一站约 ${distM(next, nearFix.lat, nearFix.lon)} 米` : '';
					const status = done ? '已走完' : !open ? `主线第 ${trail.chapter + 1} 章开放` : `${at}/${trail.stops.length} 站${away}`;
					const stops = trail.stops.map((st, i) => `<li>${i < at ? '✅' : live && i === at ? '➡️' : '⬜'} ${esc(st.name)}</li>`).join('');
					const btn = live ? `<div class="inline" style="margin-top:8px"><button data-trail="${esc(trail.id)}">📍 我到了 / 沿途看看</button></div>` : '';
					return `<details class="card"${live ? ' open' : ''}><summary><b>🚶 ${esc(trail.title)}</b> <span class="muted">${esc(city)} · ${esc(status)}</span></summary>${live ? `<p>${esc(trail.intro)}</p>` : ''}<ul class="story-steps">${stops}</ul>${btn}</details>`;
				}).join('');
				return `<div class="card"><h3>主要路线</h3><p>跟着主线，本人把真实街区走一遍：按顺序到站，路上也可能遇到事。只在你点按钮时定位一次，存档只记走到第几站，不记轨迹；不开定位也不影响主线。</p></div>${rows}`;
			}

			function panelNear() {
				needVenues();
				const s = state!;
				const intro = `<div class="card"><h3>附近能做的事</h3><p>人在真实的餐馆、健身房、公园、图书馆、超市……打开定位，就能在游戏里吃饭、训练、打卡上班。服务端会检查定位精度、距离和移动速度。</p>
					${nearFix ? '<div class="inline" style="margin-top:8px"><button data-locate>📍 重新定位</button></div>' : '<button class="primary wide" data-locate>📍 打开定位，看看附近</button><p style="margin-top:6px">点店里的动作时，定位会发给服务器核对你是不是在店里；存档只记最近一次的大致位置（约 100 米），用来检查移动速度。</p>'}
					${nearFix ? `<p style="margin-top:6px" class="muted">定位误差约 ${Math.round(nearFix.acc)} 米 · ${Math.max(0, Math.round((Date.now() - nearFix.at) / 60000))} 分钟前</p>` : ''}</div>` + trailCards(s);
				const ci = s.clockIn;
				const ciVenue = ci ? region.venues.find((v) => v.id === ci.venue) : undefined;
				// 上班中：深色卡，大字计时、离 8 小时上限的进度；人在这家店范围内时直接给「打下班卡」大按钮
				const clockCard = (clockOutBtn: string) => {
					if (!ci) return '';
					const mins = Math.max(0, Math.round((srvNow() - ci.at) / 60000));
					const stale = clockStale(s, srvNow());
					const pct = Math.min(100, Math.round(mins / FIX_RULES.shiftMaxMin * 100));
					const note = stale ? '这张卡太久没打下班卡，已经过期，不计薪：在任何带上班按钮的地点点一下就会作废；那里还能上班的话，会顺便打一张新卡。'
						: mins < FIX_RULES.clockInMinMin ? `至少上满 ${FIX_RULES.clockInMinMin} 分钟才能打下班卡。`
						: `离开前在这家店打下班卡（一次最多计 ${FIX_RULES.shiftMaxMin / 60} 小时）。`;
					return `<div class="next clock"><span class="lbl">${stale ? '上班卡已过期' : '上班中'}${ci.career ? ` · ${esc(getCareer(ci.career)?.name ?? '')}` : ' · 零工'}</span>
						<div class="clock-time"><b>${Math.floor(mins / 60)}:${String(mins % 60).padStart(2, '0')}</b><span>${esc(ciVenue?.name ?? ci.venue)}</span></div>
						<div class="bar dark"><i style="width:${pct}%"></i></div><p>${note}</p>${clockOutBtn}</div>`;
				};
				const clockHtml = clockCard('');
				const vs = venuesState();
				if (vs === 'loading' || vs === 'idle') return intro + clockHtml + '<div class="card"><p class="muted">正在载入附近的真实地点……</p></div>';
				if (vs === 'failed') return intro + clockHtml + '<div class="card"><p>真实地点数据没载入（可能断网了），联网后再试。</p><div class="inline"><button data-venues-retry>重试</button></div></div>';
				// 按所在区域判断有没有收录真实地点：西澳收了几百个，不代表南澳也有（第 9 批审查问题 4）
				const areaLocs = new Set(curArea().locations.map((l) => l.id));
				if (!region.venues.some((v) => areaLocs.has(v.loc))) return intro + clockHtml + `<div class="card"><p>${esc(curArea().name)}的真实地点数据还在采集中（来自 OpenStreetMap）。</p></div>`;
				if (!nearFix) return intro + clockHtml;
				const list = venuesNear(s, region, nearFix.lat, nearFix.lon, nearFix.acc, srvNow());
				if (!list.length) return intro + clockHtml + '<div class="card"><p>1.5 公里内没有收录的地点。</p></div>';
				// 赞助只加标签和优惠说明，不改排序（仍按距离）、不改任何数值
				const sponsored = activeSponsors(SPONSORS, srvNow());
				const today = realDayOf(srvNow());
				// 在店里：没领过给「使用优惠」按钮，今天领过直接给核销卡
				const sponsorBox = (venueId: string, inRange: boolean) => {
					const deal = sponsored.get(venueId);
					if (!deal) return '';
					const got = redeemed.get(deal.id);
					if (got && got.day === today) return redeemCardHtml(got);
					return sponsorOfferHtml(deal) + (inRange ? `<button class="row" data-redeem="${esc(deal.id)}"><span class="ico">🎟️</span><span class="body">使用优惠<small>服务器核对你在店里后，出一个今天有效的核销码给店员看</small></span></button>` : '');
				};
				const cards = list.slice(0, 20).map(({ venue, type, distM, inRange, ops }) => `<div class="card"><h3>${type.icon} ${esc(venue.name)}${sponsored.has(venue.id) ? sponsorTagHtml() : ''} <span class="muted">${esc(type.name)} · ${distM} 米</span></h3>${sponsorBox(venue.id, inRange)}
					${inRange ? ops.map(({ op, outcome, blocked, voids, renews }) => {
						const clockOut = op.id === 'work' && s.clockIn?.venue === venue.id;
						const label = op.id === 'work' ? (voids ? '作废上班卡' : renews ? '作废旧卡并重新打卡' : clockOut ? '打下班卡' : '打上班卡') : op.name;
						const detail = blocked ?? (voids ? voids : renews ? renews : outcome ? outcome.notes.join(' · ') : op.desc);
						return `<button class="row" data-venue="${esc(venue.id)}" data-venue-op="${op.id}" ${blocked ? 'disabled' : ''}><span class="ico">${op.icon}</span><span class="body">${label}<small>${esc(detail)}</small></span></button>`;
					}).join('') : `<p>再走近 ${Math.max(0, distM - type.radiusM)} 米就能${ops.map((o) => o.op.name).join('、')}。</p>`}</div>`).join('');
				const here = ci ? list.find((x) => x.venue.id === ci.venue && x.inRange) : undefined;
				const outOp = here?.ops.find((o) => o.op.id === 'work');
				const outBtn = here && outOp && !outOp.blocked && !outOp.voids && !outOp.renews ? `<button data-venue="${esc(here.venue.id)}" data-venue-op="work">打下班卡</button>` : '';
				return intro + clockCard(outBtn) + cards;
			}

			// 玩法说明（静态文字，放在「设置」里）
			const HELP: [string, string][] = [
				['生活需求', '饱食、精力、清洁、娱乐、社交会随时间下降，最低的那项最影响心情；饱食或精力见底会掉健康。今天页的「下一步」会告诉你先做什么。'],
				['生病和看病', '淋雨、风暴、热天在外、累过头、饿肚子、不洗澡都会让你更容易生病，受伤会扭伤。病中有些事做不了，病好前心情也差。小病去药房、看 GP，重的去急诊；有 Medicare 或 OSHC 的能报销一部分。'],
				['出行与事件', '在「出行」选地方和交通方式。第一次到一个地方常有专属事件，选项上标了花费和成功率。'],
				['真实地点', '本人走进真实的餐馆、健身房、公园、超市，在「出行 · 附近」打开定位就能在游戏里吃饭、训练、打卡上班。'],
				['工作与住处', '在城镇应聘、每天上一个班；租房后回家睡觉恢复更多。每 7 天一次周结算，付房租、房贷和车辆保险。'],
				['天气', '每个地方每天的天气不一样，所有玩家看到的一样。风暴天海上活动取消，但可以去海边看风暴；抵达时会按天气收一张照片。'],
				['多设备', '同步码等同于密码：在另一台设备选「用同步码恢复」，或用相机扫「我 · 同步」里的二维码，就能接着玩。存档一直在服务器上，换设备只是把同步码带过去；改本机数据没有用。怀疑同步码被别人看到了，可以在「多设备同步」里更换。'],
			];
			// 大字模式：整页放大约 12%，只记在本机
			// 更新日志和「新」标记按需加载（第 41 批，性能）：日志每批都在变长，不进首屏脚本，第一次打开「我」页时再下。
			// 下载失败（断网）时页面照常画，「新」标记先不显示；30 秒后再画「我」页时重试，不会连着重试刷屏
			type NewsMod = typeof import('../game/ui/news.ts') & Pick<typeof import('../game/data/changelog.ts'), 'CHANGELOG' | 'CHANGELOG_LATEST'>;
			let news: NewsMod | null = null;
			let newsLoad: Promise<void> | null = null;
			let newsFailedAt = -Infinity;
			function loadNews() {
				if (news || Date.now() - newsFailedAt < 30000) return newsLoad;
				newsLoad ??= Promise.all([import('../game/ui/news.ts'), import('../game/data/changelog.ts')])
					.then(([n, c]) => { news = { ...n, CHANGELOG: c.CHANGELOG, CHANGELOG_LATEST: c.CHANGELOG_LATEST }; if (state && (tab === 'me' || (tab === 'place' && returnView(state, state.daily.day) && !obHidden.has('back')))) renderPanel(); })
					.catch(() => { newsLoad = null; newsFailedAt = Date.now(); if (state && tab === 'me') renderPanel(); });
				return newsLoad;
			}
			// 「我 · 生涯」（career-stats.md）：页面和分享卡按需加载，不进首屏；失败时 30 秒后再画这一页时重试
			let career: typeof import('../game/ui/career.ts') | null = null;
			let careerLoad: Promise<void> | null = null;
			let careerFailedAt = -Infinity;
			function panelCareer() {
				if (!career && Date.now() - careerFailedAt >= 30000) careerLoad ??= import('../game/ui/career.ts')
					.then((m) => { career = m; if (state && tab === 'me') renderPanel(); })
					.catch(() => { careerLoad = null; careerFailedAt = Date.now(); if (state && tab === 'me') renderPanel(); });
				if (!career) return `<div class="card"><p class="muted">${careerLoad ? '生涯档案加载中…' : '生涯档案没加载出来，联网后再打开这一页。'}</p></div>`;
				return career.careerHtml(state!, (id) => getLocation(region, id)?.name ?? '已关闭的地点');
			}
			/** 分享卡：画成 PNG，能分享文件就调系统分享，不能就下载 */
			async function shareCareer(kind: string) {
				if (!career || !state || (kind !== 'week' && kind !== 'year' && kind !== 'lastyear')) return;
				try {
					const blob = await career.cardPng(career.cardSvg(state, kind));
					const file = new File([blob], `earth-life-${kind}.png`, { type: 'image/png' });
					const nav = navigator as Navigator & { canShare?: (d: { files: File[] }) => boolean; share?: (d: { files: File[]; title: string }) => Promise<void> };
					if (nav.canShare?.({ files: [file] }) && nav.share) { try { await nav.share({ files: [file], title: '地球人生' }); return; } catch (e) { if ((e as Error)?.name === 'AbortError') return; } } // 系统分享被拒（手势过期等）：往下走，直接下载图片
					const a = document.createElement('a');
					a.href = URL.createObjectURL(blob);
					a.download = file.name;
					a.click();
					setTimeout(() => URL.revokeObjectURL(a.href), 10_000);
					toast('分享图已保存');
				} catch (e) {
					if ((e as Error)?.name !== 'AbortError') toast('分享图没生成出来，换个浏览器试试');
				}
			}
			/** 「我 · 更新」：游戏内更新日志，新的在前 */
