---
// 「地球人生 / Terra Life」第一阶段客户端：西澳大利亚。
// 手机优先的单页应用；规则在 src/game/core/engine.ts（纯函数），本页只负责渲染、输入、同步。
const title = '地球人生 · 西澳';
const description = '在真实地图上生活的在线人生模拟：出行、打工、探索，到达地点触发事件，多端云同步。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#0d1b2a" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<div id="app">
			<section id="create" class="hidden">
				<h1>🌏 地球人生</h1>
				<p class="sub">第一阶段 · 西澳大利亚</p>
				<label class="field">名字<input id="c-name" maxlength="12" placeholder="给自己起个名字" autocomplete="off" /></label>
				<div class="field">形象<div id="c-avatars" class="chips"></div></div>
				<div class="field">出身<div id="c-origins"></div></div>
				<div class="field">性格特质（选 2 个）<div id="c-traits" class="chips"></div></div>
				<button id="c-start" class="primary">开始生活</button>
				<details class="import">
					<summary>已有存档？用同步码恢复</summary>
					<input id="c-code" placeholder="粘贴同步码" autocomplete="off" />
					<button id="c-import">从云端恢复</button>
				</details>
			</section>

			<section id="game" class="hidden">
				<header id="hud"></header>
				<div id="map-wrap"><svg id="map" role="img" aria-label="西澳地图"></svg></div>
				<nav id="tabs"></nav>
				<main id="panel"></main>
			</section>
		</div>
		<div id="modal" class="hidden"></div>
		<div id="toast" class="hidden"></div>

		<style is:global>
			:root {
				--bg: #0d1b2a; --card: #16283c; --card2: #1e3550; --line: #2b4563; --text: #e8eef5; --dim: #8fa3b8;
				--accent: #f4a340; --ocean: #0a2540; --land: #c98a4b; --ok: #4ecb8f; --bad: #ef6464;
			}
			* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
			html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 15px/1.45 system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
			#app { max-width: 560px; margin: 0 auto; min-height: 100dvh; display: flex; flex-direction: column; }
			.hidden { display: none !important; }
			body.busy #panel, body.busy #modal { opacity: 0.6; pointer-events: none; }
			button { font: inherit; color: var(--text); background: var(--card2); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; cursor: pointer; }
			button:disabled { opacity: 0.45; cursor: not-allowed; }
			button.primary { background: var(--accent); border-color: var(--accent); color: #1a1205; font-weight: 700; }
			input { font: inherit; color: var(--text); background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; width: 100%; min-width: 0; }

			#create { padding: 24px 16px calc(24px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 14px; }
			#create h1 { margin: 12px 0 0; font-size: 28px; }
			.sub { margin: 0; color: var(--dim); }
			.field { display: flex; flex-direction: column; gap: 6px; color: var(--dim); font-size: 13px; }
			.chips { display: flex; flex-wrap: wrap; gap: 8px; }
			.chip { font-size: 22px; padding: 6px 10px; }
			.chip.on, .origin.on { border-color: var(--accent); background: #3a2c14; }
			.origin { display: block; width: 100%; text-align: left; margin-bottom: 8px; }
			.origin small { display: block; color: var(--dim); }
			.import { color: var(--dim); font-size: 13px; }
			#c-traits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
			.trait { font-size: 13px; padding: 8px 10px; text-align: left; }
			.trait small { display: block; color: var(--dim); font-size: 11px; }
			.trait.on { border-color: var(--accent); background: #3a2c14; }
			.tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
			.tag { font-size: 12px; padding: 3px 8px; border-radius: 10px; background: #0a1522; color: var(--text); }
			.import input { margin: 8px 0; }

			#game { flex: 1; display: flex; flex-direction: column; min-height: 100dvh; }
			#hud { padding: calc(8px + env(safe-area-inset-top)) 12px 8px; background: var(--card); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
			.hud-row { display: flex; align-items: center; gap: 10px; justify-content: space-between; font-variant-numeric: tabular-nums; }
			.hud-row .who { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.hud-row .stat { white-space: nowrap; font-size: 13px; }
			.needs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; margin-top: 6px; }
			.need { font-size: 11px; color: var(--dim); text-align: center; }
			.bar { height: 5px; border-radius: 3px; background: #0a1522; overflow: hidden; margin-top: 2px; }
			.bar i { display: block; height: 100%; background: var(--ok); }
			.bar i.mid { background: var(--accent); }
			.bar i.low { background: var(--bad); }

			#map-wrap { background: var(--ocean); border-bottom: 1px solid var(--line); }
			#map { display: block; width: 100%; height: 42vh; min-height: 240px; touch-action: manipulation; }
			#map .land { fill: var(--land); stroke: #8a5a2b; stroke-width: 1; }
			#map .route { stroke: #5b3c1c; stroke-width: 1; fill: none; opacity: 0.55; }
			#map .route.air { stroke: #cfe3ff; stroke-dasharray: 2 4; opacity: 0.25; }
			#map .route.ferry { stroke: #cfe3ff; stroke-dasharray: 1 2; }
			#map .route.track { stroke-dasharray: 4 2; }
			#map .route.live { stroke: #fff; opacity: 0.95; stroke-width: 1.6; }
			#map .route.air.live { opacity: 0.6; }
			#map .dot { fill: #fff; stroke: #23405e; stroke-width: 1.2; }
			#map .dot.new { fill: #23405e; stroke: #fff; }
			#map .dot.sel { stroke: var(--accent); stroke-width: 2.5; }
			#map .here { fill: var(--accent); stroke: #fff; stroke-width: 1.5; }
			#map .pulse { fill: none; stroke: var(--accent); stroke-width: 1.5; animation: pulse 1.8s ease-out infinite; transform-box: fill-box; transform-origin: center; }
			@keyframes pulse { from { transform: scale(0.6); opacity: 1; } to { transform: scale(2.4); opacity: 0; } }
			@media (prefers-reduced-motion: reduce) { #map .pulse { animation: none; } }
			#map text { font-size: 9px; fill: #fff; paint-order: stroke; stroke: rgba(0, 0, 0, 0.65); stroke-width: 2.4px; pointer-events: none; }
			#map text.cnt { fill: var(--accent); font-weight: 700; }
			#map .hit { fill: transparent; cursor: pointer; }

			#tabs { display: flex; background: var(--card); border-bottom: 1px solid var(--line); }
			#tabs button { flex: 1; border: 0; border-radius: 0; background: none; padding: 10px 0; font-size: 12px; color: var(--dim); border-bottom: 2px solid transparent; }
			#tabs button.on { color: var(--text); border-bottom-color: var(--accent); }
			#panel { flex: 1; padding: 12px 12px calc(20px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 10px; }
			.card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px; }
			.card h3 { margin: 0 0 4px; font-size: 16px; }
			.card p { margin: 0; color: var(--dim); font-size: 13px; }
			.hero { height: 120px; border-radius: 10px; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; font-size: 48px; background: linear-gradient(135deg, #1d4e6e, #c98a4b); overflow: hidden; }
			.hero img { width: 100%; height: 100%; object-fit: cover; }
			.row { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; }
			.row .ico { font-size: 22px; width: 30px; text-align: center; flex: none; }
			.row .body { flex: 1; min-width: 0; }
			.row .body small { display: block; color: var(--dim); font-size: 12px; }
			.row .meta { font-size: 12px; color: var(--dim); text-align: right; white-space: nowrap; flex: none; }
			.row.sel { border-color: var(--accent); }
			.list { display: flex; flex-direction: column; gap: 8px; }
			.skill { display: grid; grid-template-columns: 30px 1fr 44px; align-items: center; gap: 8px; margin: 8px 0; font-size: 13px; }
			.skill .bar { height: 8px; }
			.skill .bar i { background: var(--accent); }
			.muted { color: var(--dim); font-size: 13px; }
			.chat { display: flex; flex-direction: column; gap: 4px; max-height: 180px; overflow-y: auto; font-size: 13px; margin: 8px 0; }
			.chat b { color: var(--accent); font-weight: 600; }
			.inline { display: flex; gap: 8px; }
			.inline button { flex: none; }
			.code { font-family: ui-monospace, monospace; font-size: 12px; word-break: break-all; background: #0a1522; padding: 8px; border-radius: 8px; margin: 8px 0; user-select: all; }
			.emotes button { padding: 4px 8px; font-size: 16px; }

			#modal { position: fixed; inset: 0; background: rgba(4, 10, 18, 0.78); display: flex; align-items: flex-end; justify-content: center; z-index: 20; }
			#modal .sheet { background: var(--card); border: 1px solid var(--line); border-radius: 16px 16px 0 0; padding: 16px 16px calc(16px + env(safe-area-inset-bottom)); width: 100%; max-width: 560px; max-height: 88dvh; overflow-y: auto; }
			#modal h2 { margin: 0 0 8px; font-size: 19px; }
			#modal .list { margin-top: 12px; }
			#toast { position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom)); transform: translateX(-50%); background: #000d; color: #fff; padding: 10px 16px; border-radius: 20px; font-size: 14px; z-index: 30; max-width: 88vw; text-align: center; }
		</style>

		<script>
			import { AVATARS, NEED_META, ORIGINS, SKILL_META, formatClock, sanitizeState } from '../game/core/character.ts';
			import type { GameAction } from '../game/core/actions.ts';
			import { activitiesAt, careersAt, getCareer, getHome, homesAt, npcsAt, promotionStatus, relationTier, getLocation, getPendingEvent, shiftBlocked, shopAt, travelOptions } from '../game/core/engine.ts';
			import { PROMOTE_GOOD, PROMOTE_SHIFTS } from '../game/data/careers.ts';
			import { dayOf, hoursLabel } from '../game/core/time.ts';
			import { checkScore, getItem, getTrait, level, mood, moodTier, validTraits, wantedStars } from '../game/core/attributes.ts';
			import { MAX_TRAITS, TRAITS } from '../game/data/traits.ts';
			import { NPCS } from '../game/data/npcs.ts';
			import { period } from '../game/core/time.ts';
			import { makeProjection } from '../game/core/geo.ts';
			import { NEED_KEYS, SKILL_KEYS } from '../game/core/types.ts';
			import type { NpcAction, PlayerState, TravelMode } from '../game/core/types.ts';
			import { WA } from '../game/data/wa.ts';

			const region = WA;
			const LOC_IDS = new Set(region.locations.map((l) => l.id));
			const SAVE_KEY = 'earth.save.v1';
			const CRED_KEY = 'earth.cred.v1';
			const KIND_ICON: Record<string, string> = { city: '🏙️', port: '⚓', island: '🏝️', coast: '🌊', outback: '🏜️', mining: '⛏️', park: '🏞️', town: '🏘️' };
			const TABS = [['place', '📍 地点'], ['go', '🧭 出行'], ['me', '👤 角色'], ['social', '💬 社交'], ['log', '📓 日志'], ['sync', '☁️ 同步']];

			type Cred = { id: string; key: string };
			type Peer = { id: string; name: string; avatar: string; loc: string };
			type Chat = { name: string; avatar: string; text: string };

			let state: PlayerState | null = null;
			let cred: Cred | null = null;
			let tab = 'place';
			let selected: string | null = null;
			let lastOutcome: string | null = null;
			let cgi: Record<string, string> = {};
			let ws: WebSocket | null = null;
			let myPeerId = '';
			let peers = new Map<string, Peer>();
			let chats: Chat[] = [];
			let emotes: string[] = [];
			let syncStatus = '未同步';
			// 珀斯一带地点密集，标签手动错开：[dx, dy, anchor]
			const LABEL: Record<string, [number, number, string]> = { perth: [8, -3, 'start'], fremantle: [-8, 9, 'end'], rottnest: [-9, -1, 'end'] };

			const $ = (id: string) => document.getElementById(id)!;
			const esc = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
			const store = {
				get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
				set(k: string, v: string) { try { localStorage.setItem(k, v); } catch {} },
			};
			const randId = (n: number) => {
				const a = new Uint8Array(n);
				crypto.getRandomValues(a);
				return [...a].map((b) => 'abcdefghijklmnopqrstuvwxyz0123456789'[b % 36]).join('');
			};

			let toastTimer = 0;
			function toast(msg: string) {
				const el = $('toast');
				el.textContent = msg;
				el.classList.remove('hidden');
				clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => el.classList.add('hidden'), 2600);
			}

			// ---------- 存档与云同步 ----------
			// 服务端权威：本机只缓存最近一次服务器返回的存档用于显示，所有动作都由服务器结算
			function cache() {
				if (state) store.set(SAVE_KEY, JSON.stringify(state));
			}
			async function api(body: unknown) {
				const res = await fetch('/api/earth/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
				return { status: res.status, data: (await res.json()) as any };
			}
			/** 采用服务器返回的存档；位置变了就通知在线频道 */
			function adopt(remote: unknown, why?: string) {
				const clean = sanitizeState(remote, LOC_IDS);
				if (!clean) return false;
				const moved = !state || state.loc !== clean.loc;
				state = clean;
				syncStatus = `已同步 · 版本 ${clean.rev}`;
				cache();
				if (moved && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'move', loc: state.loc }));
				if (why) toast(why);
				return true;
			}
			async function pullCloud() {
				if (!cred) return;
				try {
					const { data } = await api({ action: 'get', id: cred.id, key: cred.key });
					// 本机缓存只用于离线显示，联网时一律以服务器为准（即使版本号相同，缓存也可能被改过）
					if (data.ok) {
						const newer = !!state && data.state.rev !== state.rev;
						adopt(data.state, newer ? '已载入最新进度' : undefined);
						render();
					} else syncStatus = '同步失败：' + (data.msg || '');
				} catch {
					syncStatus = '离线：可以查看，联网后才能行动';
				}
				if (tab === 'sync') renderPanel();
			}

			// ---------- 在线状态 ----------
			function connect() {
				if (!state || !cred || (ws && ws.readyState <= WebSocket.OPEN)) return;
				const q = new URLSearchParams({ region: region.id, id: cred.id, name: state.name, avatar: state.avatar, loc: state.loc });
				const sock = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/api/earth/ws?${q}`);
				ws = sock;
				sock.onmessage = (e) => {
					let m: any;
					try { m = JSON.parse(e.data); } catch { return; }
					if (m.t === 'hello') {
						myPeerId = m.you;
						emotes = m.emotes || [];
						peers = new Map((m.players as Peer[]).map((p) => [p.id, p]));
					} else if (m.t === 'join') peers.set(m.p.id, m.p);
					else if (m.t === 'leave') peers.delete(m.id);
					else if (m.t === 'move') { const p = peers.get(m.id); if (p) p.loc = m.loc; }
					else if (m.t === 'chat') { chats.push(m); chats = chats.slice(-50); if (tab !== 'social') toast(`${m.name}: ${m.text}`); }
					else if (m.t === 'emote') toast(`${m.name} 向你 ${m.kind}`);
					else return;
					renderMap();
					if (tab === 'social') renderPanel();
				};
				sock.onclose = () => { if (ws === sock) { ws = null; peers.clear(); setTimeout(connect, 5000); } };
			}
			setInterval(() => { if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'ping' })); }, 20000);

			// ---------- 动作（发给服务器结算） ----------
			let busy = false;
			async function act(a: GameAction): Promise<{ ok: boolean; msg: string } | null> {
				if (!state || !cred || busy) return null;
				busy = true;
				document.body.classList.add('busy');
				try {
					const { status, data } = await api({ action: 'act', id: cred.id, key: cred.key, rev: state.rev, act: a });
					if (status === 409 && data.state) { adopt(data.state, data.msg); render(); return null; }
					if (data.state) adopt(data.state);
					if (!data.ok) { toast(data.msg || '操作失败'); render(); return null; }
					return { ok: true, msg: data.msg };
				} catch {
					toast('网络断开了，联网后才能行动');
					return null;
				} finally {
					busy = false;
					document.body.classList.remove('busy');
				}
			}

			// ---------- 渲染 ----------
			function barCls(v: number) { return v < 25 ? 'low' : v < 50 ? 'mid' : ''; }
			function renderHud() {
				const s = state!;
				const needs = NEED_KEYS.map((k) => `<div class="need">${NEED_META[k].icon}${NEED_META[k].name}<div class="bar"><i class="${barCls(s.needs[k])}" style="width:${s.needs[k]}%"></i></div></div>`).join('');
				$('hud').innerHTML = `
					<div class="hud-row">
						<span class="who">${s.avatar} ${esc(s.name)}</span>
						<span class="stat">💵 $${s.cash.toLocaleString()}</span>
						<span class="stat">Lv${level(s.respect).lv}</span>
						<span class="stat" title="心情">${moodTier(mood(s)).name}</span>
						<span class="stat" title="通缉星级">${'★'.repeat(wantedStars(s.heat)) || '☆'}</span>
						<span class="stat">🕗 ${formatClock(s.clock)} ${period(s.clock).name}</span>
					</div>
					<div class="needs">
						<div class="need">❤️健康<div class="bar"><i class="${barCls(s.health)}" style="width:${s.health}%"></i></div></div>${needs}
					</div>`;
			}

			const proj = makeProjection(region);
			function renderMap() {
				const s = state!;
				const pt = (id: string) => { const l = getLocation(region, id)!; return proj.project(l.lon, l.lat); };
				const outline = region.outline.map(([lon, lat]) => proj.project(lon, lat).join(',')).join(' ');
				const routes = region.routes.map((r) => {
					const [x1, y1] = pt(r.a), [x2, y2] = pt(r.b);
					const live = r.a === s.loc || r.b === s.loc ? ' live' : '';
					return `<line class="route ${r.mode}${live}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`;
				}).join('');
				const counts = new Map<string, number>();
				for (const p of peers.values()) if (p.id !== myPeerId) counts.set(p.loc, (counts.get(p.loc) || 0) + 1);
				const dots = region.locations.map((l) => {
					const [x, y] = proj.project(l.lon, l.lat);
					const here = l.id === s.loc;
					const cls = here ? 'here' : `dot${s.visited[l.id] ? '' : ' new'}${selected === l.id ? ' sel' : ''}`;
					const [dx, dy, anchor] = LABEL[l.id] ?? (x > proj.width * 0.7 ? [-8, 3, 'end'] : [8, 3, 'start']);
					const n = counts.get(l.id);
					return `${here ? `<circle class="pulse" cx="${x}" cy="${y}" r="7"/>` : ''}
						<circle class="${cls}" cx="${x}" cy="${y}" r="${here ? 6 : 4.5}"/>
						<text x="${x + dx}" y="${y + dy}" text-anchor="${anchor}">${esc(l.name)}${n ? ` <tspan class="cnt">👥${n}</tspan>` : ''}</text>
						<circle class="hit" data-loc="${l.id}" cx="${x}" cy="${y}" r="15"/>`;
				}).join('');
				const map = $('map');
				map.setAttribute('viewBox', `0 0 ${proj.width} ${proj.height}`);
				map.innerHTML = `<polygon class="land" points="${outline}"/>${routes}${dots}`;
			}

			function hero(key: string, fallback: string) {
				return `<div class="hero">${cgi[key] ? `<img src="${esc(cgi[key])}" alt="" loading="lazy" />` : fallback}</div>`;
			}

			function panelPlace() {
				const s = state!;
				const loc = getLocation(region, s.loc)!;
				const acts = activitiesAt(s, region).map(({ act, blocked }) => `
					<button class="row" data-act="${act.id}" ${blocked ? 'disabled' : ''}>
						<span class="ico">${act.icon}</span>
						<span class="body">${esc(act.name)}<small>${esc(blocked ?? act.desc)}</small></span>
						<span class="meta">${act.fx.cash ? (act.fx.cash > 0 ? '+' : '−') + '$' + Math.abs(act.fx.cash) : '免费'}<br/>${act.minutes >= 60 ? (act.minutes / 60).toFixed(act.minutes % 60 ? 1 : 0) + ' 小时' : act.minutes + ' 分钟'}</span>
					</button>`).join('');
				const pois = region.pois.filter((p) => p.loc === loc.id);
				const poiHtml = pois.length ? `<div class="card"><h3>打卡点</h3><p>人到现场、打开定位即可打卡（${pois.filter((p) => s.checkins.includes(p.id)).length}/${pois.length}）</p>
					<div class="list" style="margin-top:8px">${pois.map((p) => `<div class="row"><span class="ico">${s.checkins.includes(p.id) ? '✅' : '📌'}</span><span class="body">${esc(p.name)}<small>${esc(p.category)}</small></span></div>`).join('')}</div></div>` : '';
				const people = npcsAt(s, region);
				const away = NPCS.filter((n) => n.loc === loc.id && !people.some((a) => a.npc.id === n.id));
				const peopleHtml = people.length || away.length ? `<div class="card"><h3>这里的人</h3>${people.map(({ npc, rel, tier, blocked }) => `
					<div style="margin-top:10px"><div class="row"><span class="body">${esc(npc.name)} · ${esc(npc.role)}<small>${esc(npc.bio)}</small></span><span class="meta">${tier}<br/>${Math.round(rel.score)}/100</span></div>
					<div class="inline" style="margin-top:6px">${(['chat', 'gift', 'help'] as const).map((a) => `<button data-npc="${npc.id}" data-npc-act="${a}" ${blocked[a] ? `disabled title="${esc(blocked[a])}"` : ''}>${{ chat: '聊天', gift: '送礼', help: '帮忙' }[a]}</button>`).join('')}</div>
					${Object.values(blocked).some(Boolean) ? `<p style="margin-top:4px">${esc([...new Set(Object.values(blocked).filter(Boolean))].join('；'))}</p>` : ''}</div>`).join('')}
					${away.map((n) => `<p style="margin-top:8px">${esc(n.name)}（${esc(n.role)}）现在不在，通常 ${n.hours[0]}:00–${n.hours[1] % 24}:00 在这里。</p>`).join('')}</div>` : '';
				const job = s.job;
				const career = job ? getCareer(job.career) : undefined;
				const workHere = job && job.loc === loc.id && career;
				const offers = careersAt(s, region).filter((o) => !(workHere && o.career.id === job!.career));
				const shiftWhy = shiftBlocked(s);
				const workHtml = workHere || offers.length ? `<div class="card"><h3>工作</h3>
					${workHere ? `<div class="row" style="margin-top:8px"><span class="body">${esc(career!.name)} · ${esc(career!.levels[job!.level].title)}<small>每班 $${career!.levels[job!.level].pay} · ${Math.round(career!.minutes / 60)} 小时 · ${hoursLabel(career!.start)} 开工</small></span><button class="primary" data-job="work" ${shiftWhy ? 'disabled' : ''}>上班</button></div>${shiftWhy ? `<p style="margin-top:4px">${esc(shiftWhy)}</p>` : ''}` : ''}
					${offers.map(({ career: c, blocked }) => `<div class="row" style="margin-top:8px"><span class="body">${esc(c.name)} · 招${esc(c.levels[0].title)}<small>${esc(blocked ?? `每班 $${c.levels[0].pay}，最高可升到${c.levels[c.levels.length - 1].title}`)}</small></span><button data-job="apply" data-career="${c.id}" ${blocked ? 'disabled' : ''}>${job ? '跳槽' : '应聘'}</button></div>`).join('')}</div>` : '';
				const homeHere = s.home && s.home.loc === loc.id ? getHome(s.home.type) : undefined;
				const rentals = homesAt(s, region);
				const homeHtml = homeHere || rentals.length ? `<div class="card"><h3>住处</h3>
					${homeHere ? `<div class="row" style="margin-top:8px"><span class="body">你的${esc(homeHere.name)}<small>房租付到第 ${s.home!.paidUntil + 1} 天 · 每周 $${homeHere.rentWeek}</small></span><button class="primary" data-home="sleep">回家睡觉</button></div>` : ''}
					${rentals.filter((o) => !(homeHere && o.home.id === s.home!.type)).map(({ home, blocked }) => `<div class="row" style="margin-top:8px"><span class="body">${esc(home.name)} · $${home.rentWeek}/周<small>${esc(blocked ?? `${home.desc}${home.comfort ? ` 心情 +${home.comfort}` : ''}`)}</small></span><button data-home="rent" data-home-id="${home.id}" ${blocked ? 'disabled' : ''}>${s.home ? '搬来' : '租下'}</button></div>`).join('')}</div>` : '';
				const shop = shopAt(s, region);
				const shopHtml = shop.length ? `<div class="card"><h3>商店</h3><div class="list" style="margin-top:8px">${shop.map(({ item, price, blocked }) => `
					<button class="row" data-buy="${item.id}" ${blocked ? 'disabled' : ''}><span class="ico">${item.icon}</span>
					<span class="body">${esc(item.name)}${s.inventory[item.id] ? ` ×${s.inventory[item.id]}` : ''}<small>${esc(blocked ?? item.desc)}</small></span><span class="meta">$${price}</span></button>`).join('')}</div></div>` : '';
				return `
					<div class="card">${hero(loc.id, KIND_ICON[loc.kind])}
						<h3>${esc(loc.name)} <span class="muted">${esc(loc.en)}</span></h3><p>${esc(loc.blurb)}</p>
						${lastOutcome ? `<p style="margin-top:8px;color:var(--text)">💡 ${esc(lastOutcome)}</p>` : ''}
					</div>
					<button class="row" data-gps><span class="ico">📡</span><span class="body">真实定位打卡<small>你本人到了某个地点？直接抵达并触发事件</small></span></button>
					${peopleHtml}${workHtml}${homeHtml}<div class="list">${acts}</div>${shopHtml}${poiHtml}`;
			}

			function panelGo() {
				const s = state!;
				const opts = travelOptions(s, region);
				const note = selected && selected !== s.loc && !opts.some((o) => o.to === selected)
					? `<p class="muted">从这里没有直达${esc(getLocation(region, selected)!.name)}的路线，需要中转。</p>` : '';
				const rows = opts.map((o) => {
					const to = getLocation(region, o.to)!;
					const h = Math.floor(o.minutes / 60), m = o.minutes % 60;
					return `<button class="row${selected === o.to ? ' sel' : ''}" data-go="${o.to}" data-mode="${o.mode}" ${o.available ? '' : 'disabled'}>
						<span class="ico">${KIND_ICON[to.kind]}</span>
						<span class="body">${esc(to.name)}${s.visited[o.to] ? '' : ' 🆕'}<small>${o.label} · ${o.km} km${o.reason ? ' · ' + esc(o.reason) : ''}</small></span>
						<span class="meta">$${o.cost}<br/>${h ? h + ' 小时 ' : ''}${m} 分</span></button>`;
				}).join('');
				return `${note}<div class="list">${rows}</div><p class="muted">点地图上的地点可以高亮对应路线。虚线是航班，长虚线是越野土路（需四驱）。</p>`;
			}

			function panelMe() {
				const s = state!;
				const origin = ORIGINS.find((o) => o.id === s.origin)!;
				const skills = SKILL_KEYS.map((k) => `<div class="skill"><span>${SKILL_META[k].icon}</span><div>${SKILL_META[k].name} <span class="muted">${SKILL_META[k].hint}</span><div class="bar"><i style="width:${s.skills[k]}%"></i></div></div><b title="含特质、装备、心情的检定分">${checkScore(s, k).total}</b></div>`).join('');
				const veh = { none: '无（坐巴士）', car: '🚗 二手轿车', '4wd': '🚙 四驱越野' }[s.vehicle];
				const lv = level(s.respect);
				const m = mood(s);
				const tier = moodTier(m);
				const traits = s.traits.map((id) => getTrait(id)).filter(Boolean).map((t) => `<span class="tag" title="${esc(t!.desc)}">${esc(t!.name)}</span>`).join('');
				const jc = s.job ? getCareer(s.job.career) : undefined;
				const promo = promotionStatus(s);
				const hd = s.home ? getHome(s.home.type) : undefined;
				const life = `
					<p>${jc ? `${esc(jc.name)}（${esc(getLocation(region, s.job!.loc)!.name)}）· ${esc(jc.levels[s.job!.level].title)} · 每班 $${jc.levels[s.job!.level].pay}` : '无业。到城镇、海滩、矿区等地方找工作。'}</p>
					${promo ? `<p>升职到${esc(promo.next.title)}：已上 ${promo.shifts}/${PROMOTE_SHIFTS} 班，表现好 ${promo.good}/${PROMOTE_GOOD} 班${promo.blocked ? `，还需${esc(promo.blocked)}` : ''}</p>` : jc ? '<p>已是最高职位。</p>' : ''}
					<p>${hd ? `住在${esc(getLocation(region, s.home!.loc)!.name)}的${esc(hd.name)}，每周 $${hd.rentWeek}，房租还剩 ${Math.max(0, s.home!.paidUntil - dayOf(s.clock))} 天` : '没有住处。在城镇可以租房，回家睡觉免费且恢复更多。'}</p>
					<div class="inline" style="margin-top:8px">${jc ? '<button data-job="quit">辞职</button>' : ''}${hd ? '<button data-home="leave">退租</button>' : ''}</div>`;
				const rels = Object.entries(s.relations).map(([id, r]) => {
					const npc = NPCS.find((n) => n.id === id);
					if (!npc) return '';
					const where = getLocation(region, npc.loc)?.name ?? '';
					return `<div class="skill"><span></span><div>${esc(npc.name)} <span class="muted">${esc(npc.role)} · ${esc(where)}</span><div class="bar"><i style="width:${Math.max(0, r.score)}%"></i></div></div><b title="${relationTier(r.score)}">${relationTier(r.score)}</b></div>`;
				}).join('');
				const bag = Object.entries(s.inventory).map(([id, n]) => {
					const it = getItem(id);
					if (!it) return '';
					return `<div class="row" style="margin-top:8px"><span class="ico">${it.icon}</span><span class="body">${esc(it.name)} ×${n}<small>${esc(it.desc)}</small></span>${it.use ? `<button data-use="${it.id}">使用</button>` : '<span class="meta">装备中</span>'}</div>`;
				}).join('');
				return `<div class="card"><h3>${s.avatar} ${esc(s.name)}</h3><p>${origin.icon} ${origin.name} · 座驾：${veh}</p>
					<p>已探索 ${Object.keys(s.visited).length}/${region.locations.length} 个地点 · 麻烦值 ${Math.round(s.heat)}/100（${wantedStars(s.heat)} 星）</p>
						<p>Lv${lv.lv} ${lv.title} · 声望 ${Math.floor(s.respect)}${lv.next !== null ? ` / ${lv.next}` : ''} · 心情 ${m}（${tier.name}，检定 ${tier.check >= 0 ? '+' : ''}${tier.check}）</p>
						<div class="tags">${traits || '<span class="muted">没有性格特质</span>'}</div></div>
					<div class="card"><h3>工作与住处</h3>${life}</div>
					<div class="card"><h3>人际关系</h3>${rels || '<p>还没认识什么人。去各地看看谁在那里。</p>'}</div>
					<div class="card"><h3>背包</h3>${bag || '<p>空的。在地点页的商店里买东西。</p>'}</div>
					<div class="card"><h3>能力</h3><p>用得越多涨得越快。</p>${skills}</div>`;
			}

			function panelSocial() {
				const s = state!;
				const online = ws?.readyState === WebSocket.OPEN;
				const here = [...peers.values()].filter((p) => p.loc === s.loc && p.id !== myPeerId);
				const people = here.length ? here.map((p) => `<div class="row"><span class="ico">${esc(p.avatar)}</span><span class="body">${esc(p.name)}</span>
					<span class="emotes">${emotes.map((e) => `<button data-emote="${e}" data-to="${esc(p.id)}">${e}</button>`).join(' ')}</span></div>`).join('') : '<p class="muted">这里暂时只有你一个人。</p>';
				return `<div class="card"><h3>${esc(getLocation(region, s.loc)!.name)}的人</h3><p>${online ? `全区在线 ${peers.size} 人` : '未连接，稍后自动重连…'}</p><div class="list" style="margin-top:8px">${people}</div></div>
					<div class="card"><h3>本地频道</h3><p>只有同一地点的玩家能看到。</p>
						<div class="chat" id="chat">${chats.map((c) => `<div>${esc(c.avatar)} <b>${esc(c.name)}</b> ${esc(c.text)}</div>`).join('')}</div>
						<form class="inline" id="chat-form"><input id="chat-input" maxlength="120" placeholder="说点什么…" autocomplete="off" ${online ? '' : 'disabled'} /><button class="primary" ${online ? '' : 'disabled'}>发送</button></form></div>`;
			}

			function panelLog() {
				const rows = [...state!.journal].reverse().map((j) => `<div class="row"><span class="body">${esc(j.text)}<small>${formatClock(j.t)}</small></span></div>`).join('');
				return `<div class="card"><h3>人生日志</h3><div class="list" style="margin-top:8px">${rows}</div></div>`;
			}

			function panelSync() {
				return `<div class="card"><h3>多设备同步</h3><p>${esc(syncStatus)}</p>
						<p style="margin-top:8px">在另一台手机或电脑打开本页，选择“用同步码恢复”，粘贴下面这串码即可接着玩。</p>
						<div class="code">${esc(cred!.id)}.${esc(cred!.key)}</div>
						<div class="inline"><button data-copy>复制同步码</button><button data-pull>立即同步</button></div>
						<p style="margin-top:8px">同步码等同于密码，不要发给别人。</p></div>
					<div class="card"><h3>重新开始</h3><p>清除本机存档并创建新角色（云端旧档仍可用同步码找回）。</p><button data-reset style="margin-top:8px">删除本机存档</button></div>`;
			}

			function renderPanel() {
				$('tabs').innerHTML = TABS.map(([id, label]) => `<button data-tab="${id}" class="${tab === id ? 'on' : ''}">${label}</button>`).join('');
				const html = { place: panelPlace, go: panelGo, me: panelMe, social: panelSocial, log: panelLog, sync: panelSync }[tab]!();
				$('panel').innerHTML = html;
				const chat = document.getElementById('chat');
				if (chat) chat.scrollTop = chat.scrollHeight;
			}

			function renderEvent() {
				const ev = state ? getPendingEvent(state) : null;
				const modal = $('modal');
				if (!ev) { modal.classList.add('hidden'); return; }
				const s = state!;
				modal.innerHTML = `<div class="sheet" role="dialog" aria-modal="true">${hero('event:' + ev.id, ev.icon)}
					<h2>${ev.icon} ${esc(ev.title)}</h2><p>${esc(ev.text)}</p>
					<div class="list">${ev.choices.map((c, i) => `<button class="row" data-choice="${i}"><span class="body">${esc(c.label)}${c.check ? `<small>${SKILL_META[c.check.skill].icon} ${SKILL_META[c.check.skill].name}检定（你 ${checkScore(s, c.check.skill).total} + 随机 0–60 / 难度 ${c.check.dc}）</small>` : ''}</span></button>`).join('')}</div></div>`;
				modal.classList.remove('hidden');
			}

			function render() {
				if (!state) { $('game').classList.add('hidden'); $('create').classList.remove('hidden'); return; }
				$('create').classList.add('hidden');
				$('game').classList.remove('hidden');
				renderHud();
				renderMap();
				renderPanel();
				renderEvent();
			}

			// ---------- 输入 ----------
			document.addEventListener('click', (e) => {
				const t = (e.target as Element).closest<HTMLElement>('[data-tab],[data-act],[data-go],[data-loc],[data-choice],[data-gps],[data-emote],[data-copy],[data-pull],[data-reset],[data-buy],[data-use],[data-npc],[data-job],[data-home]');
				if (!t || !state || (t as HTMLButtonElement).disabled) return;
				const d = t.dataset;
				if (d.tab) { tab = d.tab; renderPanel(); }
				else if (d.npc && d.npcAct) act({ t: 'npc', npc: d.npc, act: d.npcAct as NpcAction }).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				else if (d.job) {
					if (d.job === 'quit' && !confirm('确定辞职？当前等级的进度会清零。')) return;
					const a: GameAction = d.job === 'apply' ? { t: 'job', op: 'apply', career: d.career! } : { t: 'job', op: d.job as 'work' | 'quit' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.home) {
					if (d.home === 'leave' && !confirm('确定退租？已付的房租不退。')) return;
					const a: GameAction = d.home === 'rent' ? { t: 'home', op: 'rent', home: d.homeId! } : { t: 'home', op: d.home as 'sleep' | 'leave' };
					act(a).then((r) => { if (r) { lastOutcome = r.msg; toast(r.msg); render(); } });
				}
				else if (d.buy) act({ t: 'buy', item: d.buy }).then((r) => { if (r) { toast(r.msg); render(); } });
				else if (d.use) act({ t: 'use', item: d.use }).then((r) => { if (r) { toast(r.msg); render(); } });
				else if (d.act) act({ t: 'activity', id: d.act }).then((r) => { if (r) { lastOutcome = null; toast(r.msg); render(); } });
				else if (d.go) {
					act({ t: 'travel', to: d.go, mode: d.mode as TravelMode }).then((r) => { if (r) { selected = null; lastOutcome = null; tab = 'place'; if (!state!.pending) toast(r.msg); render(); window.scrollTo({ top: 0 }); } });
				}
				else if (d.loc) { selected = d.loc === state.loc ? null : d.loc; tab = selected ? 'go' : 'place'; renderMap(); renderPanel(); }
				else if (d.choice) act({ t: 'event', choice: +d.choice }).then((r) => { if (r) { lastOutcome = r.msg; tab = 'place'; render(); } });
				else if ('gps' in d) checkIn();
				else if (d.emote && d.to) { ws?.send(JSON.stringify({ t: 'emote', to: d.to, kind: d.emote })); toast(`你向对方 ${d.emote}`); }
				else if ('copy' in d) navigator.clipboard?.writeText(`${cred!.id}.${cred!.key}`).then(() => toast('已复制'), () => toast('复制失败，请长按手动复制'));
				else if ('pull' in d) pullCloud();
				else if ('reset' in d) {
					if (!confirm('确定删除本机存档？请先记下同步码。')) return;
					try { localStorage.removeItem(SAVE_KEY); localStorage.removeItem(CRED_KEY); } catch {}
					location.reload();
				}
			});
			document.addEventListener('submit', (e) => {
				if ((e.target as Element).id !== 'chat-form') return;
				e.preventDefault();
				const input = $('chat-input') as HTMLInputElement;
				const text = input.value.trim();
				if (text && ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ t: 'chat', text }));
				input.value = '';
			});

			function checkIn() {
				if (!navigator.geolocation) return toast('这台设备不支持定位');
				toast('正在定位…');
				navigator.geolocation.getCurrentPosition(
					(pos) => {
						if (!state) return;
						act({ t: 'gps', lat: pos.coords.latitude, lon: pos.coords.longitude }).then((r) => { if (r) { if (!state!.pending) toast(r.msg); render(); } });
					},
					() => toast('无法获取定位，请检查定位权限'),
					{ enableHighAccuracy: true, timeout: 10000 },
				);
			}

			// ---------- 创建角色 ----------
			let pickAvatar = AVATARS[0];
			let pickOrigin = ORIGINS[0].id;
			let pickTraits: string[] = [];
			function renderCreate() {
				$('c-avatars').innerHTML = AVATARS.map((a) => `<button class="chip${a === pickAvatar ? ' on' : ''}" data-avatar="${a}">${a}</button>`).join('');
				$('c-origins').innerHTML = ORIGINS.map((o) => `<button class="origin${o.id === pickOrigin ? ' on' : ''}" data-origin="${o.id}">${o.icon} ${o.name} · 起始 $${o.cash}${o.vehicle !== 'none' ? ' · 有车' : ''}<small>${o.desc}</small></button>`).join('');
				$('c-traits').innerHTML = TRAITS.map((t) => {
					const on = pickTraits.includes(t.id);
					const ok = on || validTraits([...pickTraits, t.id], MAX_TRAITS);
					return `<button class="trait${on ? ' on' : ''}" data-trait="${t.id}" ${ok ? '' : 'disabled'}>${esc(t.name)}<small>${esc(t.desc)}</small></button>`;
				}).join('');
				($('c-start') as HTMLButtonElement).disabled = pickTraits.length !== MAX_TRAITS;
				$('c-start').textContent = pickTraits.length === MAX_TRAITS ? '开始生活' : `再选 ${MAX_TRAITS - pickTraits.length} 个性格特质`;
			}
			$('create').addEventListener('click', (e) => {
				const t = (e.target as Element).closest<HTMLElement>('[data-avatar],[data-origin],[data-trait]');
				if (!t || (t as HTMLButtonElement).disabled) return;
				if (t.dataset.avatar) pickAvatar = t.dataset.avatar;
				if (t.dataset.origin) pickOrigin = t.dataset.origin;
				const tr = t.dataset.trait;
				if (tr) pickTraits = pickTraits.includes(tr) ? pickTraits.filter((x) => x !== tr) : [...pickTraits, tr];
				renderCreate();
			});
			function begin() { render(); connect(); }
			$('c-start').addEventListener('click', async () => {
				const btn = $('c-start') as HTMLButtonElement;
				const c = { id: 'p' + randId(15), key: randId(24) };
				const profile = { name: ($('c-name') as HTMLInputElement).value, avatar: pickAvatar, origin: pickOrigin, traits: pickTraits };
				btn.disabled = true;
				try {
					const { data } = await api({ action: 'create', id: c.id, key: c.key, profile });
					if (!data.ok) return toast(data.msg || '创建失败');
					cred = c;
					store.set(CRED_KEY, JSON.stringify(cred));
					if (adopt(data.state)) begin();
				} catch {
					toast('需要联网才能创建角色');
				} finally {
					btn.disabled = false;
				}
			});
			$('c-import').addEventListener('click', async () => {
				const m = /^([a-zA-Z0-9_-]{6,40})\.([a-zA-Z0-9]{16,64})$/.exec(($('c-code') as HTMLInputElement).value.trim());
				if (!m) return toast('同步码格式不对');
				try {
					const { data } = await api({ action: 'get', id: m[1], key: m[2] });
					if (!data.ok) return toast(data.msg || '恢复失败');
					cred = { id: m[1], key: m[2] };
					store.set(CRED_KEY, JSON.stringify(cred));
					if (adopt(data.state, '已恢复云端存档')) { render(); begin(); }
					else toast('云端存档已损坏');
				} catch { toast('网络错误，请稍后再试'); }
			});

			// ---------- 启动 ----------
			try { cred = JSON.parse(store.get(CRED_KEY) || 'null'); } catch {}
			try { state = sanitizeState(JSON.parse(store.get(SAVE_KEY) || 'null'), LOC_IDS); } catch {}
			if (!cred || !state || state.id !== cred.id) { state = null; cred = null; }
			renderCreate();
			render();
			fetch('/earth/cgi/manifest.json').then((r) => (r.ok ? r.json() : {})).then((m: any) => { cgi = m.images || {}; if (state) { renderPanel(); renderEvent(); } }).catch(() => {});
			if (state) { connect(); pullCloud(); }
			document.addEventListener('visibilitychange', () => { if (!document.hidden && state) { connect(); pullCloud(); } });
		</script>
	</body>
</html>
