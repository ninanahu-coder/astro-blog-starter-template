---
// 百家乐在线多人牌桌 — WebSocket 客户端，服务端（Durable Object）权威结算。
// 虚拟筹码，仅供娱乐。
const title = '百家乐 · 在线同桌';
const description = '多人在线百家乐牌桌：同一副牌实时同步、下注互见、自动开局。虚拟筹码仅供娱乐。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
		/>
		<meta name="theme-color" content="#0b3d2e" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/icons/baccarat-180.png" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<div id="app">
			<header class="topbar">
				<a class="back" href="/baccarat" aria-label="返回单机版">‹</a>
				<div class="logo">🌐 在线同桌</div>
				<span class="room-pill" id="room-pill"></span>
				<div class="balance-box">
					<span class="coin">🪙</span>
					<strong id="balance">-</strong>
				</div>
			</header>

			<div class="phasebar">
				<div class="phasebar-fill" id="phase-fill"></div>
				<span class="phasebar-text" id="phase-text">连接中…</span>
			</div>

			<section class="players-strip" id="players-strip"></section>

			<section class="table">
				<div class="table-info">
					<span id="shoe-info">牌靴 —</span>
					<span class="free-note">虚拟筹码 · 仅供娱乐</span>
				</div>
				<div class="hands">
					<div class="hand" id="hand-banker">
						<div class="hand-head">
							<span class="tag tag-banker">庄</span>
							<span class="pts" id="pts-banker"></span>
						</div>
						<div class="cards" id="cards-banker"></div>
					</div>
					<div class="vs">VS</div>
					<div class="hand" id="hand-player">
						<div class="hand-head">
							<span class="tag tag-player">闲</span>
							<span class="pts" id="pts-player"></span>
						</div>
						<div class="cards" id="cards-player"></div>
					</div>
				</div>
				<div class="banner hidden" id="banner">
					<div class="banner-title" id="banner-title"></div>
					<div class="banner-sub" id="banner-sub"></div>
				</div>
				<div class="msg" id="msg">正在进入牌桌…</div>
			</section>

			<section class="road-wrap">
				<div class="stats">
					<span class="stat stat-banker">庄 <b id="stat-banker">0</b></span>
					<span class="stat stat-player">闲 <b id="stat-player">0</b></span>
					<span class="stat stat-tie">和 <b id="stat-tie">0</b></span>
				</div>
				<div class="road" id="road"></div>
			</section>

			<section class="bets">
				<button class="spot spot-side" data-bet="ppair">
					<span class="spot-name">闲对</span>
					<span class="spot-odds">1:11</span>
					<span class="spot-total" data-total="ppair"></span>
					<span class="spot-amt" data-amt="ppair"></span>
				</button>
				<button class="spot spot-player" data-bet="player">
					<span class="spot-name">闲</span>
					<span class="spot-odds">1:1</span>
					<span class="spot-total" data-total="player"></span>
					<span class="spot-amt" data-amt="player"></span>
				</button>
				<button class="spot spot-tie" data-bet="tie">
					<span class="spot-name">和</span>
					<span class="spot-odds">1:8</span>
					<span class="spot-total" data-total="tie"></span>
					<span class="spot-amt" data-amt="tie"></span>
				</button>
				<button class="spot spot-banker" data-bet="banker">
					<span class="spot-name">庄</span>
					<span class="spot-odds">1:0.95</span>
					<span class="spot-total" data-total="banker"></span>
					<span class="spot-amt" data-amt="banker"></span>
				</button>
				<button class="spot spot-side" data-bet="bpair">
					<span class="spot-name">庄对</span>
					<span class="spot-odds">1:11</span>
					<span class="spot-total" data-total="bpair"></span>
					<span class="spot-amt" data-amt="bpair"></span>
				</button>
			</section>

			<section class="chips" id="chips"></section>

			<section class="actions">
				<button class="btn btn-ghost" id="btn-clear">清除</button>
				<button class="btn btn-ghost" id="btn-chat">聊天 <span class="chat-badge hidden" id="chat-badge"></span></button>
				<button class="btn btn-gold hidden" id="btn-topup">补充筹码</button>
			</section>
		</div>

		<!-- 入桌 -->
		<div class="overlay" id="join">
			<div class="sheet">
				<div class="sheet-head"><span>进入牌桌</span></div>
				<p class="sim-note">和朋友输入相同房间号即可同桌 · 虚拟筹码仅供娱乐 · 余额按房间保存</p>
				<label class="field">
					<span>昵称</span>
					<input id="in-name" maxlength="8" placeholder="最多 8 个字符" />
				</label>
				<label class="field">
					<span>房间号</span>
					<input id="in-room" maxlength="8" placeholder="默认 LOBBY（公共大厅）" />
				</label>
				<button class="btn btn-gold btn-buy" id="btn-join">进入牌桌</button>
			</div>
		</div>

		<!-- 聊天 -->
		<div class="overlay hidden" id="chat">
			<div class="sheet">
				<div class="sheet-head">
					<span>牌桌聊天</span>
					<button class="x" data-close="chat" aria-label="关闭">×</button>
				</div>
				<div class="chat-list" id="chat-list"></div>
				<div class="chat-row">
					<input id="chat-input" maxlength="60" placeholder="说点什么…" />
					<button class="btn-mini" id="chat-send">发送</button>
				</div>
			</div>
		</div>

		<!-- 断线 -->
		<div class="overlay hidden" id="reconnect">
			<div class="sheet center">
				<div class="result-icon">📡</div>
				<div class="result-title">连接已断开</div>
				<div class="result-sub" id="reconnect-sub">正在重新连接…</div>
			</div>
		</div>

		<div class="toast" id="toast"></div>

		<script>
			// ---------- 常量 ----------
			const CHIP_VALUES = [10, 50, 100, 500, 1000];
			const CHIP_COLORS: Record<number, string> = {
				10: '#3d9be9',
				50: '#3cb878',
				100: '#e14b4b',
				500: '#9b59b6',
				1000: '#e9b83d',
			};
			type Spot = 'ppair' | 'player' | 'tie' | 'banker' | 'bpair';
			type Card = { rank: string; suit: string; v: number };

			// ---------- 状态 ----------
			let ws: WebSocket | null = null;
			let joined = false;
			let leaving = false;
			let reconnectDelay = 1500;
			let selectedChip = 100;
			let balance = 0;
			let myBets: Record<Spot, number> = { ppair: 0, player: 0, tie: 0, banker: 0, bpair: 0 };
			let phase = 'idle';
			let endsAt = 0;
			let phaseDur = 1;
			let clockOffset = 0; // serverNow - clientNow
			let dealTimers: ReturnType<typeof setTimeout>[] = [];
			let unread = 0;
			let shoeNo = 0;
			let lastNet: number | null = null; // settle 时服务端私发的本局净输赢
			let curDeal: { p: Card[]; b: Card[] } | null = null; // 本局牌面（result 时兜底补全）

			const pid = (() => {
				let v = localStorage.getItem('baccarat_pid');
				if (!v) {
					v = Array.from(crypto.getRandomValues(new Uint8Array(12)), (b) =>
						b.toString(16).padStart(2, '0'),
					).join('');
					localStorage.setItem('baccarat_pid', v);
				}
				return v;
			})();

			// ---------- DOM ----------
			const $ = (id: string) => document.getElementById(id)!;
			const fmt = (n: number) => n.toLocaleString('zh-CN');
			const clearBtn = $('btn-clear') as HTMLButtonElement;
			const topupBtn = $('btn-topup') as HTMLButtonElement;

			let toastTimer = 0;
			function toast(text: string) {
				const el = $('toast');
				el.textContent = text;
				el.classList.add('show');
				clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => el.classList.remove('show'), 2200);
			}
			function setMsg(text: string, cls = '') {
				$('msg').textContent = text;
				$('msg').className = 'msg' + (cls ? ' ' + cls : '');
			}

			// ---------- 渲染 ----------
			function renderBalance() {
				$('balance').textContent = fmt(balance);
				topupBtn.classList.toggle('hidden', !(balance <= 0 && totalMyBet() === 0));
			}
			function totalMyBet() {
				return myBets.ppair + myBets.player + myBets.tie + myBets.banker + myBets.bpair;
			}
			function renderMyBets() {
				for (const key of Object.keys(myBets) as Spot[]) {
					const el = document.querySelector<HTMLElement>(`[data-amt="${key}"]`)!;
					el.textContent = myBets[key] > 0 ? fmt(myBets[key]) : '';
					el.classList.toggle('on', myBets[key] > 0);
				}
				clearBtn.disabled = !(phase === 'bet' && totalMyBet() > 0);
			}
			function renderTotals(totals: Record<Spot, number>) {
				for (const key of Object.keys(totals) as Spot[]) {
					const el = document.querySelector<HTMLElement>(`[data-total="${key}"]`)!;
					el.textContent = totals[key] > 0 ? `桌 ${fmt(totals[key])}` : '';
				}
			}
			function renderPlayers(players: { name: string; balance: number; online: boolean; betting: boolean }[]) {
				const strip = $('players-strip');
				strip.innerHTML = '';
				for (const p of players) {
					const div = document.createElement('div');
					div.className = 'pl' + (p.online ? '' : ' off') + (p.betting ? ' betting' : '');
					div.innerHTML = `<span class="pl-name"></span><span class="pl-bal">${fmt(p.balance)}</span>`;
					div.querySelector('.pl-name')!.textContent = p.name;
					strip.appendChild(div);
				}
			}
			function renderRoad(road: { r: string; pp: boolean; bp: boolean }[]) {
				const roadEl = $('road');
				roadEl.innerHTML = '';
				for (const r of road) {
					const cell = document.createElement('span');
					cell.className = 'bead bead-' + r.r;
					cell.textContent = r.r === 'B' ? '庄' : r.r === 'P' ? '闲' : '和';
					if (r.bp) cell.appendChild(Object.assign(document.createElement('i'), { className: 'dot dot-b' }));
					if (r.pp) cell.appendChild(Object.assign(document.createElement('i'), { className: 'dot dot-p' }));
					roadEl.appendChild(cell);
				}
				roadEl.scrollLeft = roadEl.scrollWidth;
				$('stat-banker').textContent = String(road.filter((h) => h.r === 'B').length);
				$('stat-player').textContent = String(road.filter((h) => h.r === 'P').length);
				$('stat-tie').textContent = String(road.filter((h) => h.r === 'T').length);
			}
			function renderShoe(left: number, no?: number) {
				if (typeof no === 'number') shoeNo = no;
				$('shoe-info').textContent = `第 ${shoeNo} 靴 · 剩 ${left} 张`;
			}

			function cardEl(card: Card) {
				const div = document.createElement('div');
				const red = card.suit === '♥' || card.suit === '♦';
				div.className = 'card' + (red ? ' red' : '');
				div.innerHTML = `<span class="corner">${card.rank}<br/>${card.suit}</span><span class="pip">${card.suit}</span>`;
				return div;
			}
			function clearHands() {
				$('cards-player').innerHTML = '';
				$('cards-banker').innerHTML = '';
				$('pts-player').textContent = '';
				$('pts-banker').textContent = '';
				$('hand-player').classList.remove('win');
				$('hand-banker').classList.remove('win');
				$('banner').classList.add('hidden');
				document.querySelectorAll('.spot.won').forEach((s) => s.classList.remove('won'));
			}
			function clearDealTimers() {
				dealTimers.forEach(clearTimeout);
				dealTimers = [];
			}
			function putCard(side: 'player' | 'banker', card: Card, hand: Card[], upto: number) {
				$(`cards-${side}`).appendChild(cardEl(card));
				$(`pts-${side}`).textContent =
					`${hand.slice(0, upto).reduce((s, c) => s + c.v, 0) % 10} 点`;
			}
			function renderHandsInstant(p: Card[], b: Card[]) {
				clearHands();
				p.forEach((c, i) => putCard('player', c, p, i + 1));
				b.forEach((c, i) => putCard('banker', c, b, i + 1));
			}
			function animateDeal(p: Card[], b: Card[], stepMs: number) {
				clearHands();
				clearDealTimers();
				// 顺序：闲庄闲庄，然后闲三、庄三
				const seq: ['player' | 'banker', Card, Card[], number][] = [
					['player', p[0], p, 1],
					['banker', b[0], b, 1],
					['player', p[1], p, 2],
					['banker', b[1], b, 2],
				];
				if (p.length > 2) seq.push(['player', p[2], p, 3]);
				if (b.length > 2) seq.push(['banker', b[2], b, 3]);
				seq.forEach(([side, card, hand, upto], i) => {
					dealTimers.push(setTimeout(() => putCard(side, card, hand, upto), i * stepMs));
				});
			}

			function showBanner(outcome: string, pts: number, net: number | null) {
				$('banner-title').textContent =
					outcome === 'B' ? `庄赢 · ${pts} 点` : outcome === 'P' ? `闲赢 · ${pts} 点` : `和局 · ${pts} 点`;
				$('banner-sub').textContent =
					net === null ? '' : net > 0 ? `+${fmt(net)}` : net < 0 ? `-${fmt(-net)}` : '±0';
				$('banner').className = 'banner banner-' + outcome;
			}

			// ---------- 倒计时 ----------
			setInterval(() => {
				const fill = $('phase-fill');
				const text = $('phase-text');
				const remain = Math.max(0, endsAt - (Date.now() + clockOffset));
				const pct = phaseDur > 0 ? Math.min(100, (remain / phaseDur) * 100) : 0;
				if (phase === 'bet') {
					fill.style.width = pct + '%';
					fill.className = 'phasebar-fill' + (remain < 5000 ? ' urgent' : '');
					text.textContent = `请下注 · ${Math.ceil(remain / 1000)} 秒`;
				} else if (phase === 'deal') {
					fill.style.width = '100%';
					fill.className = 'phasebar-fill dealing';
					text.textContent = '发牌中…';
				} else if (phase === 'settle') {
					fill.style.width = '100%';
					fill.className = 'phasebar-fill settling';
					text.textContent = '开奖 · 下一局即将开始';
				} else {
					fill.style.width = '0%';
					text.textContent = joined ? '等待玩家…' : '未连接';
				}
			}, 200);

			function setPhase(ph: string, ends: number, now: number, dur?: number) {
				phase = ph;
				endsAt = ends;
				clockOffset = now - Date.now();
				phaseDur = Math.max(1, dur || ends - now);
				renderMyBets();
			}

			// ---------- WebSocket ----------
			let curRoom = '';
			let curName = '';
			function connect(room: string, name: string) {
				curRoom = room;
				curName = name;
				const proto = location.protocol === 'https:' ? 'wss' : 'ws';
				const url = `${proto}://${location.host}/api/baccarat/ws?room=${encodeURIComponent(room)}&id=${pid}&name=${encodeURIComponent(name)}`;
				ws = new WebSocket(url);
				ws.addEventListener('open', () => {
					reconnectDelay = 1500;
					$('reconnect').classList.add('hidden');
				});
				ws.addEventListener('message', (e) => {
					try {
						onServer(JSON.parse(String(e.data)));
					} catch {}
				});
				ws.addEventListener('close', () => {
					if (leaving) return;
					if (joined) {
						$('reconnect').classList.remove('hidden');
						$('reconnect-sub').textContent = `正在重新连接…`;
					}
					setTimeout(() => connect(room, name), reconnectDelay);
					reconnectDelay = Math.min(10000, reconnectDelay * 1.6);
				});
			}
			function sendMsg(data: unknown) {
				if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify(data));
			}
			setInterval(() => sendMsg({ t: 'ping' }), 20000);

			function onServer(m: any) {
				switch (m.t) {
					case 'welcome': {
						joined = true;
						clearDealTimers(); // 重连时清理旧动画定时器，防止叠加重复牌
						lastNet = null;
						balance = m.you.balance;
						myBets = m.you.bets;
						setPhase(m.phase, m.endsAt, m.now, m.dur);
						renderBalance();
						renderMyBets();
						renderTotals(m.totals);
						renderPlayers(m.players);
						renderRoad(m.road);
						renderShoe(m.shoeLeft, m.shoeNo);
						curDeal = m.deal ? { p: m.deal.p, b: m.deal.b } : null;
						if (m.deal) {
							renderHandsInstant(m.deal.p, m.deal.b);
							if (m.phase === 'settle') {
								showBanner(m.deal.outcome, m.deal.outcome === 'B' ? m.deal.bt : m.deal.pt, null);
								$('banner').classList.remove('hidden');
							}
						} else {
							clearHands();
						}
						setMsg(m.phase === 'bet' ? '点击下注区下注' : '');
						break;
					}
					case 'phase': {
						setPhase(m.phase, m.endsAt, m.now, m.dur);
						if (m.phase === 'bet') {
							clearHands();
							clearDealTimers();
							curDeal = null;
							myBets = { ppair: 0, player: 0, tie: 0, banker: 0, bpair: 0 };
							renderMyBets();
							renderTotals(m.totals);
							renderPlayers(m.players);
							renderShoe(m.shoeLeft, m.shoeNo);
							if (m.road) renderRoad(m.road); // 换靴时服务端附带空路单
							setMsg('点击下注区下注');
							renderBalance();
						}
						break;
					}
					case 'bets': {
						renderTotals(m.totals);
						renderPlayers(m.players);
						break;
					}
					case 'you': {
						balance = m.balance;
						myBets = m.bets;
						renderBalance();
						renderMyBets();
						if (typeof m.net === 'number') lastNet = m.net;
						break;
					}
					case 'deal': {
						setPhase('deal', m.endsAt, m.now);
						curDeal = { p: m.p, b: m.b };
						renderShoe(m.shoeLeft);
						setMsg('');
						animateDeal(m.p, m.b, m.stepMs);
						break;
					}
					case 'result': {
						setPhase('settle', m.endsAt, m.now);
						clearDealTimers();
						if (curDeal) renderHandsInstant(curDeal.p, curDeal.b); // 动画未播完时兜底补全牌面
						showBanner(m.outcome, m.outcome === 'B' ? m.bt : m.pt, lastNet);
						$('banner').classList.remove('hidden');
						if (m.outcome === 'P') $('hand-player').classList.add('win');
						if (m.outcome === 'B') $('hand-banker').classList.add('win');
						const wonKeys: Spot[] = [];
						if (m.outcome === 'P') wonKeys.push('player');
						if (m.outcome === 'B') wonKeys.push('banker');
						if (m.outcome === 'T') wonKeys.push('tie');
						if (m.ppair) wonKeys.push('ppair');
						if (m.bpair) wonKeys.push('bpair');
						for (const k of wonKeys) document.querySelector(`[data-bet="${k}"]`)?.classList.add('won');
						const extras = [m.ppair ? '闲对' : '', m.bpair ? '庄对' : ''].filter(Boolean).join(' · ');
						setMsg(extras);
						renderRoad(m.road);
						renderPlayers(m.players);
						renderShoe(m.shoeLeft, m.shoeNo);
						lastNet = null;
						break;
					}
					case 'players':
						renderPlayers(m.players);
						break;
					case 'chat': {
						addChatLine(m.name, m.text);
						if ($('chat').classList.contains('hidden')) {
							unread++;
							const badge = $('chat-badge');
							badge.textContent = String(unread);
							badge.classList.remove('hidden');
						}
						break;
					}
					case 'err':
						toast(m.msg);
						break;
				}
			}
			// ---------- 聊天 ----------
			function addChatLine(name: string, text: string) {
				const list = $('chat-list');
				const div = document.createElement('div');
				div.className = 'chat-line';
				const b = document.createElement('b');
				b.textContent = name + '：';
				const span = document.createElement('span');
				span.textContent = text;
				div.append(b, span);
				list.appendChild(div);
				while (list.children.length > 50) list.removeChild(list.firstChild!);
				list.scrollTop = list.scrollHeight;
			}
			$('btn-chat').addEventListener('click', () => {
				$('chat').classList.remove('hidden');
				unread = 0;
				$('chat-badge').classList.add('hidden');
				($('chat-input') as HTMLInputElement).focus();
			});
			function sendChat() {
				const input = $('chat-input') as HTMLInputElement;
				const text = input.value.trim();
				if (!text) return;
				sendMsg({ t: 'chat', text });
				input.value = '';
			}
			$('chat-send').addEventListener('click', sendChat);
			$('chat-input').addEventListener('keydown', (e) => {
				if ((e as KeyboardEvent).key === 'Enter') sendChat();
			});

			// ---------- 下注操作 ----------
			document.querySelectorAll<HTMLElement>('.spot').forEach((spot) => {
				spot.addEventListener('click', () => {
					if (phase !== 'bet') return toast('等待下一局下注');
					if (selectedChip > balance) return toast('余额不足');
					sendMsg({ t: 'bet', spot: spot.dataset.bet, amt: selectedChip });
				});
			});
			clearBtn.addEventListener('click', () => sendMsg({ t: 'clear' }));
			topupBtn.addEventListener('click', () => sendMsg({ t: 'topup' }));

			function initChips() {
				const chipsEl = $('chips');
				for (const v of CHIP_VALUES) {
					const btn = document.createElement('button');
					btn.className = 'chip';
					btn.style.setProperty('--chip-color', CHIP_COLORS[v]);
					btn.innerHTML = `<span>${v >= 1000 ? `${v / 1000}K` : v}</span>`;
					if (v === selectedChip) btn.classList.add('sel');
					btn.addEventListener('click', () => {
						selectedChip = v;
						chipsEl.querySelectorAll('.chip').forEach((c) => c.classList.remove('sel'));
						btn.classList.add('sel');
					});
					chipsEl.appendChild(btn);
				}
			}

			// ---------- 入桌 ----------
			document.querySelectorAll<HTMLElement>('[data-close]').forEach((btn) => {
				btn.addEventListener('click', () => $(btn.dataset.close!).classList.add('hidden'));
			});
			$('btn-join').addEventListener('click', () => {
				const name = ($('in-name') as HTMLInputElement).value.trim().slice(0, 8) || '玩家' + pid.slice(-4);
				const room =
					($('in-room') as HTMLInputElement).value.trim().toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 8) ||
					'LOBBY';
				localStorage.setItem('baccarat_name', name);
				localStorage.setItem('baccarat_room', room);
				$('room-pill').textContent = room === 'LOBBY' ? '大厅' : '房 ' + room;
				$('join').classList.add('hidden');
				connect(room, name);
			});

			initChips();
			($('in-name') as HTMLInputElement).value = localStorage.getItem('baccarat_name') || '';
			($('in-room') as HTMLInputElement).value = localStorage.getItem('baccarat_room') || '';
			window.addEventListener('beforeunload', () => {
				leaving = true;
				ws?.close();
			});
			// bfcache 恢复：beforeunload 已置 leaving，需要重新激活连接
			window.addEventListener('pageshow', (e) => {
				if ((e as PageTransitionEvent).persisted && leaving && curRoom) {
					leaving = false;
					if (!ws || ws.readyState >= WebSocket.CLOSING) connect(curRoom, curName);
				}
			});
